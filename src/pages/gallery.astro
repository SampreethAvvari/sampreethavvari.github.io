---
import BaseLayout from "../layouts/BaseLayout.astro";
import { optimizedSources, canonicalImageList } from "../utils/optimizedImage";
import fs from "node:fs";
import path from "node:path";

const title = "SA: Gallery";
const description =
  "Screenshots and documents from the production systems Sampreeth Avvari builds and runs, organized by project.";

/*
  Filesystem driven gallery.

  Drop screenshots (png / jpg / jpeg / webp / gif / avif) and documents (pdf)
  into public/gallery/<project-slug>/ and they appear here on the next build.
  - File order: alphabetical with numeric awareness. Prefix "01 ", "02 " to control order.
  - Captions: derived from the filename. "01 analytics - doctor performance.png"
    reads "Analytics · doctor performance".
  - New project: create a new folder under public/gallery/. It shows up on its
    own with a title derived from the folder name. Add it to PROJECTS below
    whenever you want a custom title or blurb.
*/

const PROJECTS = [
  {
    slug: "doc-coach",
    title: "Doc Coach",
    blurb:
      "Every implant consultation, graded on the CEO's seven criterion rubric and delivered as a color coded coaching report.",
  },
  {
    slug: "treatment-estimator",
    title: "Treatment Estimator",
    blurb:
      "The quoting platform treatment coordinators use during the consult, with price locks the database itself enforces.",
  },
  {
    slug: "cowork-dashboard",
    title: "Cowork Dashboard",
    blurb: "Two clinics, six tabs, one set of numbers everyone finally trusts.",
  },
  {
    slug: "npc-coach",
    title: "NPC Coach",
    blurb:
      "Every new patient call, found among thousands and graded against the practice playbook with a quoted line behind each score.",
  },
  {
    slug: "ai-hour",
    title: "AI Hour",
    blurb: "The weekly hands on lab where the whole corporate team learns what AI can actually do.",
  },
  {
    slug: "cbct-scan-validator",
    title: "CBCT Scan Validator",
    blurb: "The quality gate that catches bad dental CT scans before they ever reach the design queue.",
  },
];

const workRoot = path.join(process.cwd(), "public", "gallery");
const IMG_RE = /\.(png|jpe?g|webp|gif|avif)$/i;
const PDF_RE = /\.pdf$/i;

const listDir = (slug: string): string[] => {
  try {
    return fs.readdirSync(path.join(workRoot, slug));
  } catch {
    return [];
  }
};

const humanSize = (bytes: number): string => {
  if (bytes >= 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  if (bytes >= 1024) return `${Math.round(bytes / 1024)} KB`;
  return `${bytes} B`;
};

// "01 analytics - doctor performance.png" -> "Analytics · doctor performance".
// Sentence case, and a spaced hyphen in a filename becomes a middot.
const captionFor = (file: string): string => {
  const text = file
    .replace(/\.[^/.]+$/, "")
    .replace(/^\d+[-_. ]+/, "")
    .replace(/\s+-\s+/g, " · ")
    .replace(/[-_]+/g, " ")
    .replace(/\s{2,}/g, " ")
    .trim();
  return text.charAt(0).toUpperCase() + text.slice(1);
};

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

const titleFromSlug = (slug: string): string =>
  slug.replace(/[-_]+/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

// Folders on disk that aren't configured above still get a section.
let discovered: string[] = [];
try {
  discovered = fs
    .readdirSync(workRoot, { withFileTypes: true })
    .filter((d) => d.isDirectory())
    .map((d) => d.name);
} catch {
  discovered = [];
}
const known = new Set(PROJECTS.map((p) => p.slug));
const extras = discovered
  .filter((slug) => !known.has(slug))
  .sort()
  .map((slug) => ({ slug, title: titleFromSlug(slug), blurb: "" }));

const sections = [...PROJECTS, ...extras].map((cfg, idx) => {
  const files = listDir(cfg.slug).sort((a, b) =>
    a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" })
  );
  const images = canonicalImageList(files.filter((f) => IMG_RE.test(f)))
    .sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" }))
    .map((f) => {
      const src = `/gallery/${encodeURIComponent(cfg.slug)}/${encodeURIComponent(f)}`;
      return { src, opt: optimizedSources(src), caption: captionFor(f) };
    });
  const docs = files
    .filter((f) => PDF_RE.test(f))
    .map((f) => {
      let size = "";
      try {
        size = humanSize(fs.statSync(path.join(workRoot, cfg.slug, f)).size);
      } catch {
        size = "";
      }
      return {
        href: `/gallery/${encodeURIComponent(cfg.slug)}/${encodeURIComponent(f)}`,
        name: captionFor(f),
        size,
      };
    });
  const number = String(idx + 1).padStart(2, "0");
  const meta = [
    number,
    images.length ? plural(images.length, "screenshot", "screenshots") : "",
    docs.length ? plural(docs.length, "document", "documents") : "",
  ]
    .filter(Boolean)
    .join(" · ");
  return {
    ...cfg,
    number,
    meta,
    images,
    docs,
    count: images.length + docs.length,
  };
});

const totalImages = sections.reduce((n, s) => n + s.images.length, 0);
const totalDocs = sections.reduce((n, s) => n + s.docs.length, 0);
const liveSections = sections.filter((s) => s.count > 0).length;
---

<BaseLayout title={title} description={description}>
  <!-- Page top -->
  <section class="page-top gal-top">
    <div class="tone-atmos" aria-hidden="true"></div>
    <div class="wrap on-top">
      <p class="kicker">Gallery</p>
      <h1 class="t-title gal-title">
        Proof of work.
        <span class="t-tail">Live software, up close.</span>
      </h1>
      <p class="t-lede gal-lede">
        Screenshots and documents straight from the systems I build and run in
        production, organized by project. Everything here is live software that
        real people at a real company use every week.
      </p>
      <p class="t-meta gal-count">
        {plural(totalImages, "screenshot", "screenshots")} · {plural(totalDocs, "document", "documents")} · {liveSections} of {sections.length} projects live
      </p>
    </div>
  </section>

  <!-- Project bar: jumps to a project and marks the one in view. -->
  <nav class="gal-rail" aria-label="Projects on this page">
    <div class="wrap">
      <div class="gal-bar lg">
        <div class="gal-track">
          {sections.map((s) => (
            <a href={`#p-${s.slug}`} class="chip gal-chip" data-chip={s.slug}>
              <span>{s.title}</span>
              {s.count > 0 && <span class="gal-chip-count">{s.count}</span>}
            </a>
          ))}
        </div>
      </div>
    </div>
  </nav>

  <!-- Projects -->
  <div class="wrap gal-body">
    {sections.map((s) => (
      <section id={`p-${s.slug}`} data-spy={s.slug} class="gal-section" aria-labelledby={`t-${s.slug}`}>
        <div class="gal-head" data-reveal>
          <p class="t-meta">{s.meta}</p>
          <h2 id={`t-${s.slug}`} class="gal-name">{s.title}</h2>
          {s.blurb && <p class="t-body gal-blurb">{s.blurb}</p>}
        </div>

        {s.count === 0 ? (
          <p class="inset t-small gal-empty" data-reveal>
            Curating screenshots for this one. Soon.
          </p>
        ) : (
          <>
            {s.images.length > 0 && (
              <ul class="shots" data-reveal>
                {s.images.map((img, i) => (
                  <li>
                    <figure class="surface surface-link shot">
                      <button
                        type="button"
                        class="shot-btn"
                        data-shot
                        data-group={s.slug}
                        data-index={i}
                        data-full={img.opt?.avif ?? img.src}
                        data-caption={img.caption}
                        aria-label={`View screenshot: ${img.caption}`}
                      >
                        {img.opt ? (
                          <picture>
                            <source srcset={img.opt.avif} type="image/avif" />
                            <source srcset={img.opt.webp} type="image/webp" />
                            <img
                              src={img.opt.webp}
                              alt={img.caption || `${s.title} screenshot`}
                              loading="lazy"
                              decoding="async"
                              class="shot-img"
                            />
                          </picture>
                        ) : (
                          <img
                            src={img.src}
                            alt={img.caption || `${s.title} screenshot`}
                            loading="lazy"
                            decoding="async"
                            class="shot-img"
                          />
                        )}
                      </button>
                      <figcaption class="t-small shot-cap">{img.caption}</figcaption>
                    </figure>
                  </li>
                ))}
              </ul>
            )}

            {s.docs.length > 0 && (
              <div class="docs-block" data-reveal>
                {s.images.length > 0 && <h3 class="t-h4 docs-label">Documents</h3>}
                <ul class="docs">
                  {s.docs.map((doc) => (
                    <li>
                      <a href={doc.href} target="_blank" rel="noreferrer" class="surface doc">
                        <span class="doc-icon" aria-hidden="true">
                          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                            <path d="M14 2v4a2 2 0 0 0 2 2h4M16 13H8M16 17H8M10 9H8" />
                          </svg>
                        </span>
                        <span class="min-w-0">
                          <span class="block t-h4 doc-name">{doc.name}</span>
                          <span class="block t-meta mt-1">PDF{doc.size ? ` · ${doc.size}` : ""}</span>
                        </span>
                        <span class="doc-arrow" aria-hidden="true">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7m0 0H8m9 0v9" /></svg>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </>
        )}
      </section>
    ))}
  </div>

  <!-- Screenshot viewer -->
  <div id="wlb" class="lb" hidden role="dialog" aria-modal="true" aria-label="Screenshot viewer">
    <div class="lb-backdrop" data-wlb-close></div>
    <button type="button" class="lb-btn lb-close lg" data-wlb-close aria-label="Close viewer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
    <figure class="lb-stage">
      <img id="wlb-img" class="lb-img" alt="" />
      <figcaption class="lb-cap">
        <span id="wlb-cap" class="t-small"></span>
      </figcaption>
    </figure>
    <div class="lb-bar lg">
      <button type="button" class="lb-btn" data-wlb-prev aria-label="Previous screenshot">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <span id="wlb-count" class="t-meta lb-count"></span>
      <button type="button" class="lb-btn" data-wlb-next aria-label="Next screenshot">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  // Viewer: click a screenshot to open it, arrows or swipe to move within
  // its project, Escape or the backdrop to close.
  const wlb = document.getElementById("wlb");
  const wlbImg = document.getElementById("wlb-img") as HTMLImageElement | null;
  const wlbCap = document.getElementById("wlb-cap");
  const wlbCount = document.getElementById("wlb-count");

  type Item = { src: string; caption: string };
  let items: Item[] = [];
  let cursor = 0;
  let opener: HTMLElement | null = null;

  const collect = (group: string): Item[] =>
    Array.from(document.querySelectorAll<HTMLElement>(`[data-shot][data-group="${group}"]`)).map((el) => ({
      src: el.dataset.full || "",
      caption: el.dataset.caption || "",
    }));

  const preload = (i: number) => {
    const it = items[i];
    if (it) new Image().src = it.src;
  };

  const render = () => {
    if (!wlbImg || !wlbCap || !wlbCount) return;
    const it = items[cursor];
    if (!it) return;
    wlbImg.classList.remove("is-in");
    wlbImg.onload = () => wlbImg.classList.add("is-in");
    wlbImg.src = it.src;
    wlbImg.alt = it.caption;
    wlbCap.textContent = it.caption;
    wlbCount.textContent = `${cursor + 1} / ${items.length}`;
    preload(cursor + 1);
    preload(cursor - 1);
  };

  const open = (el: HTMLElement) => {
    if (!wlb) return;
    opener = el;
    items = collect(el.dataset.group || "");
    cursor = Math.min(Math.max(Number(el.dataset.index || 0), 0), items.length - 1);
    wlb.hidden = false;
    requestAnimationFrame(() => wlb.classList.add("is-open"));
    document.documentElement.classList.add("lb-lock");
    render();
    wlb.querySelector<HTMLElement>(".lb-close")?.focus();
  };

  const close = () => {
    if (!wlb || wlb.hidden) return;
    wlb.classList.remove("is-open");
    document.documentElement.classList.remove("lb-lock");
    window.setTimeout(() => {
      wlb.hidden = true;
    }, 220);
    opener?.focus();
  };

  const step = (delta: number) => {
    if (!items.length) return;
    cursor = (cursor + delta + items.length) % items.length;
    render();
  };

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const shot = target.closest<HTMLElement>("[data-shot]");
    if (shot) {
      open(shot);
      return;
    }
    if (target.closest("[data-wlb-close]")) close();
    if (target.closest("[data-wlb-prev]")) step(-1);
    if (target.closest("[data-wlb-next]")) step(1);
  });

  document.addEventListener("keydown", (e) => {
    if (!wlb || wlb.hidden) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") step(-1);
    if (e.key === "ArrowRight") step(1);
  });

  // Swipe on touch screens.
  let touchX: number | null = null;
  wlb?.addEventListener("touchstart", (e) => (touchX = e.touches[0]?.clientX ?? null), { passive: true });
  wlb?.addEventListener(
    "touchend",
    (e) => {
      if (touchX === null) return;
      const dx = (e.changedTouches[0]?.clientX ?? touchX) - touchX;
      if (Math.abs(dx) > 48) step(dx < 0 ? 1 : -1);
      touchX = null;
    },
    { passive: true }
  );

  // The project bar follows the section in view.
  const chips = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>("[data-chip]").forEach((chip) => chips.set(chip.dataset.chip || "", chip));

  const setActive = (slug: string) => {
    chips.forEach((chip, key) => {
      const on = key === slug;
      chip.classList.toggle("is-on", on);
      if (on) {
        chip.setAttribute("aria-current", "true");
        // Scroll only the bar, never the page: scrollIntoView walks every
        // scrollable ancestor and would tug the page while someone scrolls.
        const track = chip.closest<HTMLElement>(".gal-track");
        if (track) {
          const left = chip.offsetLeft - (track.clientWidth - chip.offsetWidth) / 2;
          track.scrollTo({ left: Math.max(0, left), behavior: "smooth" });
        }
      } else {
        chip.removeAttribute("aria-current");
      }
    });
  };

  if ("IntersectionObserver" in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive((entry.target as HTMLElement).dataset.spy || "");
        });
      },
      { rootMargin: "-25% 0px -65% 0px" }
    );
    document.querySelectorAll<HTMLElement>("[data-spy]").forEach((el) => spy.observe(el));
  }
</script>

<style>
  /* Page top */
  .gal-title { margin-top: 22px; }
  .gal-lede { margin-top: 22px; }
  .gal-count { margin-top: 18px; }

  /* The project bar: clear glass, sticky under the floating nav. */
  .gal-rail {
    position: sticky;
    top: 80px;
    z-index: 40;
    margin-top: 40px;
    pointer-events: none;
  }
  .gal-bar {
    display: flex;
    width: fit-content;
    max-width: 100%;
    border-radius: 9999px;
    overflow: hidden;
    pointer-events: auto;
  }
  .gal-track {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .gal-track::-webkit-scrollbar { display: none; }
  /* On narrow screens the bar scrolls sideways; soft edges say so. */
  @media (max-width: 1099px) {
    .gal-track {
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 14px), transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0, #000 14px, #000 calc(100% - 14px), transparent 100%);
    }
  }
  .gal-chip { flex: none; height: 32px; padding: 0 14px; background: transparent; border-color: transparent; }
  .gal-chip:hover { background: var(--wash-strong); }
  .gal-chip.is-on, .gal-chip.is-on:hover { color: #000; background: var(--ink); border-color: var(--ink); }
  .gal-chip-count {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }
  .gal-chip.is-on .gal-chip-count { color: rgba(0, 0, 0, 0.55); }

  /* Projects: a hairline between each, the head, then the frames. */
  .gal-body { padding-top: clamp(32px, 4vw, 48px); padding-bottom: clamp(72px, 9vw, 120px); }
  .gal-section {
    padding-top: clamp(48px, 6vw, 72px);
    margin-top: clamp(48px, 6vw, 72px);
    border-top: 1px solid var(--line);
    /* The page already pads 88px for the nav; this clears the project bar too. */
    scroll-margin-top: 56px;
  }
  .gal-section:first-child { margin-top: 0; border-top: 0; padding-top: 0; }
  .gal-head { max-width: 46rem; margin-bottom: 28px; }
  .gal-name {
    margin-top: 10px;
    font-size: clamp(1.625rem, 2.6vw, 2.125rem);
    line-height: 1.12;
    letter-spacing: -0.028em;
    font-weight: 600;
    color: var(--ink);
  }
  .gal-blurb { margin-top: 10px; font-size: 1rem; }
  .gal-empty { padding: 20px 24px; }

  /* Screenshots: one frame shape, the whole shot visible inside it. */
  .shots {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) { .shots { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  .shots > li { display: flex; }
  .shot { display: flex; flex-direction: column; width: 100%; margin: 0; overflow: hidden; }
  .shot-btn {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 14px;
    background:
      radial-gradient(70% 80% at 50% 0%, rgba(255, 255, 255, 0.035) 0%, rgba(255, 255, 255, 0.0341) 7%, rgba(255, 255, 255, 0.0317) 14%, rgba(255, 255, 255, 0.0278) 21%, rgba(255, 255, 255, 0.0229) 28%, rgba(255, 255, 255, 0.0175) 35%, rgba(255, 255, 255, 0.0121) 42%, rgba(255, 255, 255, 0.0072) 49%, rgba(255, 255, 255, 0.0033) 56%, rgba(255, 255, 255, 0.0009) 63%, rgba(255, 255, 255, 0) 70%),
      #07080b;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 19px 19px 0 0;
    cursor: zoom-in;
  }
  .shot-btn:focus-visible { outline: none; box-shadow: inset 0 0 0 3px rgba(var(--tone-rgb), 0.5); }
  .shot-img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 12px 30px -16px rgba(0, 0, 0, 0.9);
    transition: transform 600ms var(--ease-glass);
  }
  .shot:hover .shot-img { transform: scale(1.015); }
  .shot-cap { padding: 14px 18px 16px; }

  /* Documents */
  .docs-block { margin-top: 28px; }
  .docs-label { margin-bottom: 14px; }
  .docs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .docs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .docs { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; } }
  .docs > li { display: flex; }
  .doc {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    width: 100%;
    padding: 16px 18px;
  }
  .doc-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--wash);
    border: 1px solid var(--line);
    color: var(--ink);
  }
  .doc-name { overflow-wrap: anywhere; }
  .doc-arrow { color: var(--ink-faint); transition: color 150ms var(--ease-glass), transform 250ms var(--ease-glass); }
  .doc:hover .doc-arrow { color: var(--tone); transform: translate(1px, -1px); }

  /* Viewer: a dark room, the screenshot, and quiet glass controls. */
  :global(html.lb-lock), :global(html.lb-lock body) { overflow: hidden; }
  .lb {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 72px 16px 104px;
    opacity: 0;
    transition: opacity 220ms var(--ease-glass);
  }
  .lb[hidden] { display: none; }
  .lb.is-open { opacity: 1; }
  .lb-backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.9); }
  .lb-stage {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: min(1400px, 100%);
    max-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    pointer-events: none;
  }
  .lb-img {
    max-width: 100%;
    max-height: calc(100svh - 220px);
    object-fit: contain;
    border-radius: 12px;
    border: 1px solid var(--line);
    opacity: 0;
    transform: scale(0.985);
    transition: opacity 280ms var(--ease-glass), transform 280ms var(--ease-glass);
    pointer-events: auto;
  }
