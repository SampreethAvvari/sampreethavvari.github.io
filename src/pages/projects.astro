---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { info } from "../data/info";
import Picture from "../components/common/Picture.astro";
import Icon from "../components/common/Icon.astro";

const title = "SA: Projects";

const projects: any[] = info.projects;

const slug = (t: string) =>
  t
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/-+/g, "-")
    .replace(/^-|-$/g, "")
    .slice(0, 60);

const cleanTitle = (t: string) =>
  t
    .replace(/\s*\(Hybridge Implants LLC\)\s*$/i, "")
    .replace(/\s*[—-]\s*Hybridge Implants LLC\s*$/i, "")
    .replace(/\s*[—-]\s*Hybridge[^—-]*$/i, "")
    .replace(/\s*-\s*Research\s*$/i, "")
    .trim();

// A cover only renders when its file exists, so a project whose art is still
// being made shows a calm tone panel instead of a broken image. The repo
// keeps the optimised .avif/.webp siblings, not always the .png.
const hasPublic = (p?: string) =>
  !!p &&
  [p, p.replace(/\.(png|jpe?g)$/i, ".avif"), p.replace(/\.(png|jpe?g)$/i, ".webp")].some((f) =>
    fs.existsSync(path.join(process.cwd(), "public", f)),
  );

// Posts. An entry's own `post` field wins; the title map below covers the
// entries that predate that field. A link only renders when the post file
// is really there, so a renamed post never leaves a dead link behind.
const POST_FOR: Record<string, string> = {
  "Patient Dashboard": "/posts/patient-dashboard",
  "Capacity Planner": "/posts/capacity-planner",
  "Treatment Sequence": "/posts/treatment-sequence",
  "Daily Sales Report": "/posts/daily-sales-report",
  "Marketing Data Warehouse": "/posts/marketing-warehouse",
  "Enterprise Search": "/posts/enterprise-search",
  "JobPilot": "/posts/jobpilot-v2",
  "CBCT Scan Validator": "/posts/cbct-scan-validator",
  "Treatment Estimator": "/posts/treatment-estimator",
  "Cowork Dashboard": "/posts/cowork-dashboard",
  "Doc Coach": "/posts/clinical-rag",
  "Consultation QA": "/posts/clinical-rag",
  "NPC": "/posts/npc-coach",
  "Reconciliation": "/posts/reconciliation",
  "Centralized Diagnostic Filter": "/posts/cdf-diagnostic-filter",
  "Loan Radar": "/posts/loan-radar-mlops",
  "LLM Persuasion": "/posts/llama-rlhf",
  "Fake News": "/posts/fake-news-sentiment",
  "ResNet": "/posts/resnet-under-5m",
  "Customer Segmentation": "/posts/recsys-spark-bigdata",
};
const postsDir = path.join(process.cwd(), "src", "pages", "posts");
const postExists = (href: string) => {
  const name = href.replace(/^\/posts\//, "").replace(/\/$/, "");
  return [".md", ".mdx", ".astro"].some((ext) => fs.existsSync(path.join(postsDir, name + ext)));
};
const postFor = (p: any): string | null => {
  let href: string | null = p.post || null;
  if (!href) {
    const key = Object.keys(POST_FOR).find((k) => p.title.includes(k));
    href = key ? POST_FOR[key] : null;
  }
  return href && postExists(href) ? href : null;
};

// Per-project gallery deep links. A project gets a "Screenshots" link only
// when public/gallery/<slug>/ actually holds images or docs. Most projects
// map to their title slug; the few whose folder name differs are listed.
const GALLERY_SLUG_FOR: Record<string, string> = {
  "Doc Coach": "doc-coach",
};
const gallerySlugFor = (t: string) => {
  const key = Object.keys(GALLERY_SLUG_FOR).find((k) => t.includes(k));
  return key ? GALLERY_SLUG_FOR[key] : slug(t);
};
const galleryRoot = path.join(process.cwd(), "public", "gallery");
const MEDIA_RE = /\.(png|jpe?g|webp|gif|avif|pdf)$/i;
const liveGallerySlugs = new Set<string>();
try {
  for (const d of fs.readdirSync(galleryRoot, { withFileTypes: true })) {
    if (!d.isDirectory()) continue;
    const hasMedia = fs.readdirSync(path.join(galleryRoot, d.name)).some((f) => MEDIA_RE.test(f));
    if (hasMedia) liveGallerySlugs.add(d.name);
  }
} catch {
  // No gallery folder yet, so no Screenshots links.
}
const galleryFor = (t: string) => {
  const s = gallerySlugFor(t);
  return liveGallerySlugs.has(s) ? s : null;
};

// Status, read from what each entry says about itself. Industry work that
// is still running is live unless its own write up says it is not deployed
// yet (in build) or runs on sample data (a prototype).
type Status = { label: string; cls: string; live: boolean };
const statusOf = (p: any): Status => {
  if (p.tier === "personal") return { label: "Open source", cls: "", live: false };
  if (p.tier === "research") return { label: "Research", cls: "", live: false };
  if (p.tier === "academic") return { label: "Academic", cls: "", live: false };
  const d = p.details || {};
  const said = [d.summary_short, d.star?.result, p.description].filter(Boolean).join(" ");
  if (/\bnot deployed\b/i.test(said) || /^in build\b/i.test(d.star?.result || "")) {
    return { label: "In build", cls: "badge-build", live: false };
  }
  if (/\bon sample data\b/i.test(said)) return { label: "Prototype", cls: "", live: false };
  if (/present/i.test(p.date || "")) return { label: "Live", cls: "badge-live", live: true };
  return { label: "Shipped", cls: "", live: false };
};

// "Jun 2026 - Present" reads as "Since Jun 2026"; other ranges use "to".
const fmtDate = (d?: string) => {
  if (!d) return "";
  const open = d.match(/^(.*?)\s*[-–—]\s*present$/i);
  if (open) return `Since ${open[1]}`;
  return d.replace(/\s*[-–—]\s*/g, " to ");
};

const altOf = (p: any) => (p.img_alt || p.title).replace(/\s+[-–—]\s+/g, ", ");

// The one sentence a card shows when it is closed. Long descriptions are cut
// at a natural break (listed here where the first sentence runs long), or
// the shorter summary is used where it reads better. The full description
// is always in the case study.
const CUT_AFTER: Record<string, string> = {
  "Patient Dashboard": "one row per patient",
  "Doc Coach": "from its Zoom call",
  "Centralized Diagnostic Filter": "standardized system",
  "NPC Coach": "coaching platform",
  "Treatment Estimator": "frozen with the estimate",
  "Treatment Sequence": "shared packages",
  "Reconciliation": "with an engine",
  "Enterprise Data Project": "on AWS",
  "Daily Sales Report": "automated pipeline",
  "Marketing Data Warehouse": "booked patients",
  "Hybridge Forms": "Monday chain",
  "Case Intake": "earlier scan case",
  "Teaching Llama to Argue Better": "counter-arguments",
  "Loan Radar": "loan-default scoring",
};
const SHORT_READS_BETTER = ["Capacity Planner", "Cowork Dashboard"];
const wordCount = (s: string) => s.trim().split(/\s+/).filter(Boolean).length;
const firstSentence = (s?: string) => {
  const t = (s || "").trim();
  return t.match(/^.*?[.!?](?=\s|$)/)?.[0] || t;
};
const asSentence = (s: string) => s.trim().replace(/[,:;\s]+$/, "").replace(/[^.!?]$/, (m) => m + ".");
const oneLine = (p: any) => {
  const desc = (p.description || "").trim();
  const short = firstSentence(p.details?.summary_short);
  if (short && SHORT_READS_BETTER.some((k) => p.title.includes(k))) return short;
  const key = Object.keys(CUT_AFTER).find((k) => p.title.includes(k));
  if (key) {
    const i = desc.indexOf(CUT_AFTER[key]);
    if (i > 0) return asSentence(desc.slice(0, i + CUT_AFTER[key].length));
  }
  const first = firstSentence(desc);
  if (wordCount(first) <= 22) return first;
  const beforeColon = first.split(":")[0];
  if (beforeColon !== first && wordCount(beforeColon) >= 6) return asSentence(beforeColon);
  if (short && wordCount(short) <= 22) return short;
  return first;
};

// A stat caption on a closed card fits one line: it is cut at a comma, or
// else at a small word, never mid phrase. The full caption is in the case
// study, and anything still too long ends in an ellipsis.
const CAPTION_MAX = 46;
const STRONG_BREAKS = [", ", "; ", " ("];
const SOFT_BREAKS = [" with ", " after ", " across ", " before ", " in a ", " in the ", " of the ", " to a ", " for ", " vs ", " as ", " from ", " per "];
const cutAt = (s: string, breaks: string[]) => {
  let best = "";
  for (const b of breaks) {
    for (let i = s.indexOf(b); i > 0; i = s.indexOf(b, i + 1)) {
      if (i <= CAPTION_MAX && i >= 14 && i > best.length) best = s.slice(0, i);
    }
  }
  return best;
};
const shortCaption = (s: string) =>
  s.length <= CAPTION_MAX ? s : cutAt(s, STRONG_BREAKS) || cutAt(s, SOFT_BREAKS) || s;

const card = (p: any) => {
  const d = p.details || {};
  return {
    id: slug(p.title),
    title: cleanTitle(p.title),
    line: oneLine(p) || d.summary_short || "",
    description: (p.description || "") as string,
    date: fmtDate(p.date),
    status: statusOf(p),
    cover: hasPublic(p.img_path) ? (p.img_path as string) : null,
    alt: altOf(p),
    imageStyle: p.imageStyle as string | undefined,
    post: postFor(p),
    demo: (p.demo as string) || null,
    gallery: galleryFor(p.title),
    link: (p.link as string) || null,
    linkLabel: p.tier === "personal" ? "View on GitHub" : "Open the project",
    tech: (p.tech as string[]) || [],
    stats: (d.stats as { value: string; label: string }[]) || [],
    star: d.star as { problem: string; solution: string; process: string; result: string } | undefined,
    summary: (d.summary || "") as string,
    highlights: (d.highlights as string[]) || [],
  };
};
type Card = ReturnType<typeof card>;

// Industry: the flagships first, by flagshipRank, then the rest in array
// order with the live ones ahead (Array.sort is stable).
const industry = projects.filter((p) => p.tier === "industry");
const flagships = industry
  .filter((p) => p.flagshipRank != null)
  .sort((a, b) => a.flagshipRank - b.flagshipRank)
  .map(card);
const rest = industry
  .filter((p) => p.flagshipRank == null)
  .map(card)
  .sort((a, b) => Number(b.status.live) - Number(a.status.live));
const research = projects.filter((p) => p.tier === "research");
const academic = projects.filter((p) => p.tier === "academic");
const personal = projects.filter((p) => p.tier === "personal");
const liveCount = [...flagships, ...rest].filter((c) => c.status.live).length;

const WORDS = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve"];
const numWord = (n: number) => WORDS[n] ?? String(n);

type Section = { id: string; variant: "flag" | "tile"; title: string; tail?: string; items: Card[] };
const sections: Section[] = [
  {
    id: "industry",
    variant: "flag",
    title: "At Hybridge Implants.",
    tail: `The ${numWord(flagships.length)} I'd walk you through first.`,
    items: flagships,
  },
  { id: "more", variant: "tile", title: "More from Hybridge.", tail: "From daily tools to ones still in build.", items: rest },
  {
    id: "academic",
    variant: "tile",
    title: "From the NYU days.",
    tail: "The work that taught me how.",
    items: [...research, ...academic].map(card),
  },
  { id: "open-source", variant: "flag", title: "Built in the open.", tail: "The one I build for myself.", items: personal.map(card) },
].filter((s) => s.items.length > 0) as Section[];

const counts = [
  { n: industry.length, label: "industry", href: "#industry" },
  { n: academic.length, label: "academic", href: "#academic" },
  { n: research.length, label: "research", href: "#academic" },
  { n: personal.length, label: "open source", href: "#open-source" },
].filter((c) => c.n > 0);

const STAR_PARTS = [
  ["problem", "Problem"],
  ["solution", "Solution"],
  ["process", "Process"],
  ["result", "Result"],
] as const;
// Numbers shown on a closed card. The case study lists them all in full.
const FACE_STATS = { flag: 2, tile: 1 };
---

<BaseLayout title={title}>
  <!-- ── Page top ─────────────────────────────────────────────────────── -->
  <section id="projects-top" class="page-top proj-top relative overflow-hidden">
    <div class="tone-atmos" aria-hidden="true"></div>
    <div class="wrap on-top">
      <p class="kicker">Projects</p>
      <h1 class="t-title proj-title">
        Things I've built.
        <span class="t-tail">Most of them run a dental practice every day.</span>
      </h1>
      <p class="t-lede proj-lede">
        Tools I built on my own at Hybridge, plus the research and class
        projects that taught me how.
      </p>
      <nav class="proj-counts" aria-label="Jump to a group">
        {liveCount > 0 && <span class="chip chip-live">{liveCount} live in production</span>}
        {counts.map((c) => (
          <a href={c.href} class="chip">
            <span class="chip-n">{c.n}</span> {c.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- ── Groups ───────────────────────────────────────────────────────── -->
  {sections.map((sec) => (
    <section id={sec.id} class="section-tight proj-sec">
      <div class="wrap">
        <div class="sec-head">
          <div class="sec-head-main">
            <h2 class="t-h2 proj-h2">
              {sec.title}
              {sec.tail && <span class="t-tail">{sec.tail}</span>}
            </h2>
          </div>
          <p class="t-meta">
            {sec.items.length} {sec.items.length === 1 ? "project" : "projects"}
          </p>
        </div>

        <div class={sec.variant === "flag" ? "flags" : "tiles"}>
          {sec.items.map((c) => {
            const flag = sec.variant === "flag";
            const nFace = FACE_STATS[sec.variant];
            const faceStats = c.stats.slice(0, nFace);
            const hasLinks = !!(c.post || c.demo || c.gallery || c.link);
            return (
              <article id={c.id} class={`surface pcard ${flag ? "pflag" : "ptile"}`} data-reveal>
                <div class="pc-main">
                  <div class={flag ? "pc-media pc-media-inset" : "surface-media pc-media"}>
                    {c.cover ? (
                      <Picture
                        src={c.cover}
                        alt={c.alt}
                        width={flag ? 800 : 640}
                        height={flag ? 500 : 400}
                        style={c.imageStyle}
                      />
                    ) : (
                      <div class="media-fallback" aria-hidden="true">
                        <span>{c.title}</span>
                      </div>
                    )}
                  </div>

                  <div class="pc-body">
                    <p class="t-meta pc-meta">
                      <span class={`badge ${c.status.cls}`}>{c.status.label}</span>
                      {c.date && <span>{c.date}</span>}
                    </p>
                    <h3 class="pc-title">
                      {c.post ? <a href={c.post}>{c.title}</a> : c.title}
                    </h3>
                    <p class="pc-line">{c.line}</p>

                    {faceStats.length > 0 && (
                      <ul class="pc-stats" aria-label="In numbers">
                        {faceStats.map((s) => (
                          <li>
                            <span class="pc-stat-v">{s.value}</span>
                            <span class="pc-stat-l" title={s.label}>{shortCaption(s.label)}</span>
                          </li>
                        ))}
                      </ul>
                    )}

                    {c.post && (
                      <a href={c.post} class="tlink pc-go">
                        Read the write up <Icon name="arrow-right" size={14} />
                      </a>
                    )}
                  </div>
                </div>

                <details class="pmore">
                  <summary>
                    <span class="pmore-label">{c.star ? "Case study" : "Details"}</span>
                    {flag && c.star && (
                      <span class="t-meta pmore-hint">Problem, solution, process, result</span>
                    )}
                    <svg class="pmore-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                  </summary>
                  <div class="pm">
                    {c.description && <p class="pm-lede">{c.description}</p>}

                    {c.stats.length > 0 && (
                      <ul class="pm-stats" aria-label="In numbers">
                        {c.stats.map((s) => (
                          <li>
                            <span class="pm-stat-v">{s.value}</span>
                            <span class="pm-stat-l">{s.label}</span>
                          </li>
                        ))}
                      </ul>
                    )}

                    {c.star ? (
                      <div class="pm-star">
                        {STAR_PARTS.map(([k, label]) =>
                          c.star && c.star[k] ? (
                            <div>
                              <p class="t-meta pm-label">{label}</p>
                              <p class="t-small pm-text">{c.star[k]}</p>
                            </div>
                          ) : null,
                        )}
                      </div>
                    ) : (
                      c.summary && <p class="t-small pm-text">{c.summary}</p>
                    )}

                    {c.highlights.length > 0 && (
                      <div>
                        <p class="t-meta pm-label">Highlights</p>
                        <ul class="pm-hl">
                          {c.highlights.map((h) => <li class="t-small">{h}</li>)}
                        </ul>
                      </div>
                    )}

                    {c.tech.length > 0 && (
                      <div>
                        <p class="t-meta pm-label">Built with</p>
                        <ul class="pm-tech">
                          {c.tech.map((t) => <li class="badge">{t}</li>)}
                        </ul>
                      </div>
                    )}

                    {hasLinks && (
                      <div class="pm-links">
                        {c.post && (
                          <a href={c.post} class="tlink">
                            Read the write up <Icon name="arrow-right" size={14} />
                          </a>
                        )}
                        {c.demo && (
                          <a href={c.demo} class="xlink">
                            Live demo <Icon name="arrow-right" size={13} />
                          </a>
                        )}
                        {c.gallery && <a href={`/gallery#p-${c.gallery}`} class="xlink">Screenshots</a>}
                        {c.link && (
                          <a href={c.link} target="_blank" rel="noopener" class="xlink">
                            {c.linkLabel} <Icon name="arrow-up-right" size={13} />
                          </a>
                        )}
                      </div>
                    )}
                  </div>
                </details>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  ))}

  <!-- ── Closer ───────────────────────────────────────────────────────── -->
  <section class="section-tight proj-close">
    <div class="wrap">
      <div class="surface surface-pad close-card" data-reveal>
        <div>
          <h2 class="t-h2 proj-h2">
            Let's build something.
            <span class="t-tail">Tell me what you're working on.</span>
          </h2>
          <p class="t-body close-text">
            Hiring for applied AI, or for the last mile where software meets the
            people who use it? I'd love to hear about it.
          </p>
        </div>
        <div class="close-actions">
          <a href="/#contact" class="btn btn-primary">Get in touch</a>
          <a href="/posts" class="btn btn-glass">
            Read the writing <Icon name="arrow-right" size={15} class="arrow-r" />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Page top */
  .proj-top { padding-bottom: clamp(16px, 3vw, 40px); }
  .proj-title { margin-top: 24px; }
  .proj-lede { margin-top: 24px; max-width: 34rem; }
  .proj-counts { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 8px; }
  .chip-n { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }

  /* Section heads one step quieter than the page title. */
  .proj-h2 { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  .proj-sec .sec-head { margin-bottom: clamp(24px, 3vw, 32px); }

  /* ── Card shell ────────────────────────────────────────────────────────
     A closed card is what a reader takes in at a glance: status and date,
     the name, one sentence, a number or two, and the write up. Everything
     else is in the case study, flush along the card's bottom edge. */
  .pcard { overflow: hidden; display: flex; flex-direction: column; }
  .pc-main { display: flex; flex-direction: column; flex: 1; }
  .pc-body { display: flex; flex-direction: column; align-items: flex-start; flex: 1; min-width: 0; }

  .pc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .pc-title {
    margin-top: 8px;
    font-weight: 600;
    color: var(--ink);
    text-wrap: balance;
  }
  .pc-title a { color: inherit; text-decoration: none; }
  .pc-title a:hover {
    transform: none;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--ink-ghost);
  }
  .pc-line {
    margin-top: 8px;
    max-width: 36rem;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pc-stats {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    width: 100%;
    max-width: 36rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .pc-stats > li {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 12px;
    border-left: 1px solid var(--line-strong);
  }
  .pc-stat-v {
    font-size: 1.0625rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .pc-stat-l {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pc-go { margin-top: 16px; font-size: 0.875rem; }
  .ptile .pc-go { margin-top: auto; padding-top: 16px; }

  /* ── Flagships: one per row, the cover in a 16:10 frame at about 40% ── */
  .flags { display: grid; gap: 16px; }
  @media (min-width: 1024px) { .flags { gap: 20px; } }
  .pflag { --pad: 16px; }
  @media (min-width: 640px) { .pflag { --pad: 24px; } }
  @media (min-width: 900px) { .pflag { --pad: 28px; } }
  .pflag .pc-main { display: grid; gap: 16px; padding: var(--pad); }
  .pflag .pc-body { padding: 0 4px 4px; }
  @media (min-width: 900px) {
    .pflag .pc-main { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 40px; align-items: center; }
    .pflag .pc-body { padding: 0; }
  }
  .pc-media-inset {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: #07080b;
  }
  .pc-media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .pflag .pc-title { font-size: 1.5rem; line-height: 1.25; letter-spacing: -0.022em; }
  .pflag .pc-line { font-size: 0.9375rem; line-height: 1.6; }
  .pflag .pc-stats { max-width: 40rem; gap: 24px; }
  /* On a phone two numbers side by side leave no room for their captions. */
  @media (max-width: 519px) { .pc-stats { grid-auto-flow: row; gap: 12px; } }

