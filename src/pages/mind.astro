---
import BaseLayout from "../layouts/BaseLayout.astro";
import { mindGraphs } from "../data/mind/graph";

// Escape "<" so a stray "</script>" in any blurb can never break out of the
// JSON data island.
const dataJson = JSON.stringify(mindGraphs).replace(/</g, "\\u003c");
---

<BaseLayout
  title="Mind · Sampreeth Avvari"
  description="A living star map of my work: projects, disciplines, the tools they share, and every repository I have contributed to."
  footerVariant="minimal"
>
  <div class="mind-root" role="region" aria-label="Mind, an interactive map of my work">
    <canvas id="mind-canvas" class="mind-canvas" aria-hidden="true"></canvas>

    <!-- The panel floats over the map, so it is navigation layer glass. -->
    <aside class="mind-panel lg lg-thick" data-mind-panel>
      <div class="mind-top">
        <p class="kicker">Mind</p>
        <!-- Folds the panel down to this row so the whole map shows. -->
        <button
          class="mind-fold"
          data-mind-fold
          aria-controls="mind-panel-body"
          aria-expanded="true"
          aria-label="Hide panel"
          title="Hide panel"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
        </button>
      </div>

      <div class="mind-body" id="mind-panel-body">
        <header class="mind-head">
          <h1 class="mind-title">
            A star map of my work.
            <span class="t-tail">Everything I've built, and what ties it together.</span>
          </h1>
          <p class="mind-sub" data-mind-sub>Loading the sky…</p>
        </header>

        <div class="mind-modes" role="tablist" aria-label="Which map">
          <button class="mind-mode is-active" data-mode="portfolio" role="tab" aria-selected="true">
            Portfolio graph
          </button>
          <button class="mind-mode" data-mode="repo" role="tab" aria-selected="false">
            Git mind
          </button>
        </div>

        <div class="mind-detail" data-mind-detail>
          <p class="mind-detail-hint">Fly through the map. Tap a star to open it.</p>
        </div>

        <div class="mind-filter">
          <p class="mind-filter-label">Show on the map</p>
          <ul class="mind-legend" data-mind-legend role="group" aria-label="Show on the map"></ul>
        </div>

        <p class="mind-hint">
          <span>Scroll or pinch to fly</span><span class="mind-dot">·</span><span>drag to turn</span
          ><span class="mind-dot">·</span><span>right drag or two fingers to move</span
          ><span class="mind-dot">·</span><span>tap a star</span>
        </p>
      </div>
    </aside>

    <button class="mind-reset lg" data-mind-reset title="Reset view" aria-label="Reset view">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
    </button>

    <!-- A star's card: opens over the map when a star is tapped. -->
    <aside class="mind-card" data-mind-card hidden>
      <div class="mind-card-frame" role="dialog" aria-labelledby="mind-card-name">
        <span class="mind-card-corner tl" aria-hidden="true"></span>
        <span class="mind-card-corner tr" aria-hidden="true"></span>
        <span class="mind-card-corner bl" aria-hidden="true"></span>
        <span class="mind-card-corner br" aria-hidden="true"></span>
        <button class="mind-card-close" data-mind-card-close aria-label="Close" title="Close">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
        <div class="mind-card-body" data-mind-card-body></div>
      </div>
    </aside>

    <script type="application/json" id="mind-data" set:html={dataJson}></script>
  </div>

  <script>
    import { mountMind } from "../scripts/mind-stage";
    mountMind();
  </script>
</BaseLayout>

<style>
  .mind-root {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    /* A soft wash of the Mind tab's violet, nothing else. */
    background:
      radial-gradient(56% 50% at 4% 0%, rgba(var(--tone-rgb), 0.12) 0%, rgba(var(--tone-rgb), 0.1171) 6.4%, rgba(var(--tone-rgb), 0.1085) 12.8%, rgba(var(--tone-rgb), 0.0953) 19.2%, rgba(var(--tone-rgb), 0.0785) 25.6%, rgba(var(--tone-rgb), 0.06) 32%, rgba(var(--tone-rgb), 0.0415) 38.4%, rgba(var(--tone-rgb), 0.0247) 44.8%, rgba(var(--tone-rgb), 0.0115) 51.2%, rgba(var(--tone-rgb), 0.0029) 57.6%, rgba(var(--tone-rgb), 0) 64%),
      radial-gradient(52% 48% at 100% 100%, rgba(var(--tone-rgb), 0.08) 0%, rgba(var(--tone-rgb), 0.078) 6.4%, rgba(var(--tone-rgb), 0.0724) 12.8%, rgba(var(--tone-rgb), 0.0635) 19.2%, rgba(var(--tone-rgb), 0.0524) 25.6%, rgba(var(--tone-rgb), 0.04) 32%, rgba(var(--tone-rgb), 0.0276) 38.4%, rgba(var(--tone-rgb), 0.0165) 44.8%, rgba(var(--tone-rgb), 0.0076) 51.2%, rgba(var(--tone-rgb), 0.002) 57.6%, rgba(var(--tone-rgb), 0) 64%);
  }

  .mind-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
    cursor: grab;
  }
  .mind-canvas.is-panning { cursor: grabbing; }
  .mind-canvas.is-over { cursor: pointer; }

  /* The control panel. */
  .mind-panel {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 88px);
    left: var(--gutter);
    width: min(344px, calc(100vw - 48px));
    padding: 22px 20px 18px;
    border-radius: 24px;
    z-index: 6;
    display: flex;
    flex-direction: column;
    gap: 16px;
    animation: mind-rise 500ms var(--ease-glass) both;
  }

  /* Top row: the kicker, and the fold button at the far end. */
  .mind-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .mind-fold {
    width: 30px;
    height: 30px;
    margin: -6px -6px -6px 0;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    display: grid;
    place-items: center;
    flex: none;
    color: var(--ink-faint);
    background: var(--wash);
    cursor: pointer;
    transition: color 150ms var(--ease-glass), background-color 150ms var(--ease-glass);
  }
  .mind-fold:hover { color: var(--ink); background: var(--wash-strong); }
  .mind-fold:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--tone-rgb), 0.45); }
  .mind-fold svg { transition: transform 250ms var(--ease-glass); }
  .mind-body { display: flex; flex-direction: column; gap: 16px; }

  /* Folded: only the top row stays, a small pill over the map. */
  .mind-panel.is-folded {
    width: auto;
    padding: 10px 10px 10px 16px;
    border-radius: 9999px;
    gap: 0;
    cursor: pointer;
  }
  .mind-panel.is-folded .mind-body { display: none; }
  .mind-panel.is-folded .mind-fold { margin: -4px; }
  .mind-panel.is-folded .mind-fold svg { transform: rotate(180deg); }

  .mind-head { display: flex; flex-direction: column; }
  .mind-title {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.16;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: var(--ink);
    text-wrap: balance;
  }
  .mind-sub {
    margin: 12px 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-soft);
    min-height: 1.3em;
  }

  /* Segmented control: a quiet track, the lens marks where you are. */
  .mind-modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 4px;
    border-radius: 9999px;
    background: var(--wash);
    border: 1px solid var(--line);
  }
  .mind-mode {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 12px;
    border-radius: 9999px;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.006em;
    color: var(--ink-soft);
    background: transparent;
    border: 0;
    cursor: pointer;
    white-space: nowrap;
    transition: color 150ms var(--ease-glass), background-color 150ms var(--ease-glass), box-shadow 250ms var(--ease-glass);
  }
  .mind-mode:hover { color: var(--ink); transform: none; }
  .mind-mode:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--tone-rgb), 0.45); }
  .mind-mode.is-active {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.11);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 -1px 0 rgba(0, 0, 0, 0.2),
      0 2px 8px -2px rgba(0, 0, 0, 0.6);
  }

  /* The detail card. Its contents are written by the script, so they are
     styled with :global(). */
  .mind-detail {
    border-radius: 16px;
    background: var(--wash);
    border: 1px solid var(--line);
    padding: 14px 16px;
    min-height: 92px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .mind-detail :global(.mind-detail-hint) {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-faint);
    text-wrap: pretty;
  }
  .mind-detail :global(.mind-detail-kind) {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .mind-detail :global(.mind-detail-kind::before) {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--nc, var(--ink-faint));
    flex: none;
  }
  .mind-detail :global(.mind-detail-title) {
    margin: 0;
    font-size: 1rem;
    line-height: 1.35;
    letter-spacing: -0.012em;
    font-weight: 600;
    color: var(--ink);
  }
  .mind-detail :global(.mind-detail-blurb) {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .mind-detail :global(.mind-chips) { display: flex; flex-wrap: wrap; gap: 6px; }
  .mind-detail :global(.mind-chip) {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 9px;
    border-radius: 9999px;
    font-size: 0.71875rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    color: var(--ink-soft);
    background: var(--wash-strong);
  }
  .mind-detail :global(.mind-detail-link) {
    align-self: flex-start;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 13px;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03)),
      rgba(10, 11, 15, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: border-color 150ms var(--ease-glass), background-color 150ms var(--ease-glass), transform 250ms var(--ease-glass);
  }
  .mind-detail :global(.mind-links) { display: flex; flex-wrap: wrap; gap: 6px; }
  .mind-detail :global(.mind-links .mind-detail-link) { margin-top: 0; }
  .mind-detail :global(.mind-near-title) { margin-top: 4px; }
  .mind-detail :global(.mind-hop) {
    gap: 6px;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.71875rem;
    font-weight: 500;
    transition: background-color 150ms var(--ease-glass), color 150ms var(--ease-glass);
  }
  .mind-detail :global(.mind-hop::before) {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--hc, currentColor);
    box-shadow: 0 0 8px var(--hc, transparent);
  }
  .mind-detail :global(.mind-hop:hover) { color: var(--ink); background: rgba(255, 255, 255, 0.12); }
  .mind-detail :global(.mind-hop:focus-visible) { outline: none; box-shadow: 0 0 0 2px rgba(var(--tone-rgb), 0.55); }
  .mind-detail :global(.mind-detail-link:hover) { border-color: rgba(255, 255, 255, 0.26); transform: translateY(-1px); }
  .mind-detail :global(.mind-detail-link svg) { transition: transform 250ms var(--ease-glass); }
  .mind-detail :global(.mind-detail-link:hover svg) { transform: translate(1px, -1px); }

  /* Legend: what each colour of star is. Written by the script too. */
  .mind-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }
  .mind-legend :global(li) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }
  .mind-legend :global(li::before) {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--lc);
    box-shadow: 0 0 8px 0 var(--lc);
    flex: none;
  }


  /* Filter: the legend's kinds of star, each a switch; the anchors stay. */
  .mind-filter { display: grid; gap: 8px; }
  .mind-filter-label {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .mind-legend :global(li:has(.mind-filter-btn))::before { display: none; }
  .mind-legend :global(.mind-filter-btn) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 28px;
    padding: 0 11px 0 9px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: background-color 150ms var(--ease-glass), color 150ms var(--ease-glass), border-color 150ms var(--ease-glass);
  }
  .mind-legend :global(.mind-filter-btn::before) {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--lc);
    box-shadow: 0 0 8px 0 var(--lc);
    transition: opacity 150ms var(--ease-glass);
  }
  .mind-legend :global(.mind-filter-btn[aria-pressed="false"]) {
    color: var(--ink-faint);
    background: transparent;
    border-color: rgba(255, 255, 255, 0.08);
  }
  .mind-legend :global(.mind-filter-btn[aria-pressed="false"]::before) { opacity: 0.25; box-shadow: none; }
  .mind-legend :global(.mind-filter-btn:hover) { border-color: rgba(255, 255, 255, 0.26); }
  .mind-legend :global(.mind-filter-btn:focus-visible) { outline: none; box-shadow: 0 0 0 2px rgba(var(--tone-rgb), 0.55); }
  .mind-legend :global(.mind-filter-fixed) { height: 28px; }

  /* The card: a dossier on one star, floating in the space beside the map.
     Its edge glows in the star's own colour. */
  .mind-card {
    position: absolute;
    z-index: 7;
    right: max(var(--gutter), env(safe-area-inset-right, 0px));
    /* centred in the band between the nav and the chat button */
    top: 96px;
    bottom: 112px;
    width: min(380px, calc(100% - 2 * var(--gutter)));
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .mind-card[hidden] { display: none; }
  .mind-card-frame {
    --c: var(--nc, #5b8def);
    --c-rgb: var(--nc-rgb, 91, 141, 239);
    position: relative;
    width: 100%;
    max-height: 100%;
    overflow: auto;
    overscroll-behavior: contain;
    pointer-events: auto;
    padding: 22px 20px 20px;
    border-radius: 18px;
    color: var(--ink);
    background:
      radial-gradient(120% 70% at 0% 0%, rgba(var(--c-rgb), 0.22), transparent 60%),
      radial-gradient(90% 60% at 100% 100%, rgba(var(--c-rgb), 0.1), transparent 70%),
      rgba(7, 9, 15, 0.82);
    border: 1px solid rgba(var(--c-rgb), 0.45);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 0 0 1px rgba(0, 0, 0, 0.4),
      0 0 42px -10px rgba(var(--c-rgb), 0.6),
      0 30px 80px -30px rgba(0, 0, 0, 0.9);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    display: grid;
    gap: 14px;
    scrollbar-width: thin;
  }
  /* a light that sweeps down the card as it opens */
  .mind-card-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0%, rgba(var(--c-rgb), 0.18) 48%, rgba(255, 255, 255, 0.08) 50%, transparent 52%);
    background-size: 100% 220%;
    background-position: 0 120%;
    opacity: 0;
  }
  .mind-card.is-in .mind-card-frame { animation: mc-in 420ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  .mind-card.is-in .mind-card-frame::after { animation: mc-scan 900ms ease-out 120ms both; }
  @keyframes mc-in {
    from { opacity: 0; transform: translateX(18px) scale(0.97); filter: blur(6px); }
    to { opacity: 1; transform: none; filter: none; }
  }
  @keyframes mc-scan {
    0% { opacity: 1; background-position: 0 120%; }
    100% { opacity: 0; background-position: 0 -20%; }
  }
  .mind-card-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid rgba(var(--c-rgb), 0.9);
    pointer-events: none;
  }
  .mind-card-corner.tl { top: 7px; left: 7px; border-top-width: 2px; border-left-width: 2px; border-top-left-radius: 6px; }
  .mind-card-corner.tr { top: 7px; right: 7px; border-top-width: 2px; border-right-width: 2px; border-top-right-radius: 6px; }
  .mind-card-corner.bl { bottom: 7px; left: 7px; border-bottom-width: 2px; border-left-width: 2px; border-bottom-left-radius: 6px; }
  .mind-card-corner.br { bottom: 7px; right: 7px; border-bottom-width: 2px; border-right-width: 2px; border-bottom-right-radius: 6px; }
  .mind-card-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 1;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink-soft);
    cursor: pointer;
    transition: color 150ms var(--ease-glass), border-color 150ms var(--ease-glass);
  }
  .mind-card-close:hover { color: var(--ink); border-color: rgba(var(--c-rgb), 0.7); }
  .mind-card-close:focus-visible { outline: none; box-shadow: 0 0 0 2px rgba(var(--c-rgb), 0.7); }
  .mind-card-body { display: grid; gap: 14px; }

  .mind-card :global(.mc-head) { display: flex; align-items: center; gap: 14px; padding-right: 30px; }
  .mind-card :global(.mc-orb) {
    position: relative;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    background: radial-gradient(circle at 34% 30%, #fff 0, rgba(var(--c-rgb), 1) 34%, rgba(var(--c-rgb), 0.35) 70%, rgba(var(--c-rgb), 0.05) 100%);
    box-shadow: 0 0 22px 2px rgba(var(--c-rgb), 0.65), 0 0 60px 4px rgba(var(--c-rgb), 0.25);
  }
  .mind-card :global(.mc-orb.is-planet::after) {
    content: "";
    position: absolute;
    left: -14px;
    right: -14px;
    top: 50%;
    height: 14px;
    margin-top: -7px;
    border-radius: 50%;
    border: 2px solid rgba(var(--c-rgb), 0.85);
    transform: rotate(-20deg);
  }
  .mind-card :global(.mc-id) { min-width: 0; display: grid; gap: 4px; }
  .mind-card :global(.mc-class) {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c);
  }
  .mind-card :global(.mc-name) {
    margin: 0;
    font-size: 1.375rem;
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .mind-card :global(.mc-stats) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .mind-card :global(.mc-stat) {
    display: grid;
    gap: 3px;
    padding: 9px 10px 10px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .mind-card :global(.mc-k) {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .mind-card :global(.mc-stat b) { font-size: 1.25rem; line-height: 1; font-weight: 700; font-variant-numeric: tabular-nums; }
  .mind-card :global(.mc-stat i) {
    display: block;
    height: 3px;
    margin-top: 4px;
    border-radius: 9999px;
    background: linear-gradient(90deg, rgba(var(--c-rgb), 1) calc(var(--v) * 100%), rgba(255, 255, 255, 0.1) calc(var(--v) * 100%));
    box-shadow: 0 0 8px rgba(var(--c-rgb), 0.45);
  }
  .mind-card :global(.mc-bio) { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--ink-soft); max-width: 46ch; }
  .mind-card :global(.mc-count) {
    display: grid;
    gap: 8px;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(var(--c-rgb), 0.08);
    border: 1px solid rgba(var(--c-rgb), 0.28);
  }
  .mind-card :global(.mc-count-row) { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .mind-card :global(.mc-count-item) { font-size: 0.875rem; color: var(--ink-soft); white-space: nowrap; }
