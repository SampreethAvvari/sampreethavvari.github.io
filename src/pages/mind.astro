---
import BaseLayout from "../layouts/BaseLayout.astro";
import { mindGraphs } from "../data/mind/graph";

// Escape "<" so a stray "</script>" in any blurb can never break out of the
// JSON data island.
const dataJson = JSON.stringify(mindGraphs).replace(/</g, "\\u003c");
---

<BaseLayout
  title="Mind — Sampreeth Avvari"
  description="A living star map of my work: projects, disciplines, the tools they share, and every repository I have contributed to."
  footerVariant="minimal"
>
  <main class="mind-root" aria-label="Mind, an interactive map of my work">
    <canvas id="mind-canvas" class="mind-canvas" aria-hidden="true"></canvas>

    <aside class="mind-panel pane pane-rim" data-mind-panel>
      <header class="mind-head">
        <p class="mind-eyebrow">Constellation</p>
        <h1 class="mind-title">Mind</h1>
        <p class="mind-sub" data-mind-sub>Loading the sky…</p>
      </header>

      <div class="mind-modes" role="tablist" aria-label="Which map">
        <button class="mind-mode is-active" data-mode="portfolio" role="tab" aria-selected="true">
          <span class="mind-mode-dot" style="--d:#34D399"></span>Portfolio Graph
        </button>
        <button class="mind-mode" data-mode="repo" role="tab" aria-selected="false">
          <span class="mind-mode-dot" style="--d:#22D3EE"></span>Git Mind
        </button>
      </div>

      <div class="mind-detail" data-mind-detail>
        <p class="mind-detail-hint">Drift through the map. Tap a star to open it.</p>
      </div>

      <ul class="mind-legend" data-mind-legend aria-hidden="true"></ul>

      <p class="mind-hint">
        <span>Scroll to zoom</span><span class="mind-dot">·</span><span>drag to pan</span
        ><span class="mind-dot">·</span><span>tap a star</span>
      </p>
    </aside>

    <button class="mind-reset pane" data-mind-reset title="Reset view" aria-label="Reset view">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
    </button>

    <script type="application/json" id="mind-data" set:html={dataJson}></script>
  </main>

  <script>
    import { mountMind } from "../scripts/mind-stage";
    mountMind();
  </script>
</BaseLayout>

<style>
  .mind-root {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    /* faint aurora in the four discipline colours, one per quadrant:
       FDE amber (top-left), SDE red (top-right),
       AIE emerald (bottom-left), MLE purple (bottom-right). */
    background:
      radial-gradient(58% 52% at 6% 6%, rgba(245, 165, 36, 0.1), transparent 62%),
      radial-gradient(58% 52% at 94% 6%, rgba(244, 63, 94, 0.11), transparent 62%),
      radial-gradient(58% 52% at 6% 94%, rgba(52, 211, 153, 0.11), transparent 62%),
      radial-gradient(58% 52% at 94% 94%, rgba(167, 139, 250, 0.11), transparent 62%);
  }

  /* Git Mind: tech-stack corners. AI/ML emerald (TL), Frontend cyan (TR),
     Backend amber (BL), Data blue (BR). */
  .mind-root[data-graph="repo"] {
    background:
      radial-gradient(58% 52% at 6% 6%, rgba(52, 211, 153, 0.11), transparent 62%),
      radial-gradient(58% 52% at 94% 6%, rgba(34, 211, 238, 0.11), transparent 62%),
      radial-gradient(58% 52% at 6% 94%, rgba(245, 165, 36, 0.1), transparent 62%),
      radial-gradient(58% 52% at 94% 94%, rgba(91, 141, 239, 0.11), transparent 62%);
  }

  .mind-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
    cursor: grab;
  }
  .mind-canvas.is-panning { cursor: grabbing; }
  .mind-canvas.is-over { cursor: pointer; }

  /* Liquid-glass control panel, echoing the site's .pane cards. */
  .mind-panel {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 84px);
    left: 24px;
    width: min(340px, calc(100vw - 48px));
    padding: 22px 22px 18px;
    z-index: 6;
    display: flex;
    flex-direction: column;
    gap: 16px;
    animation: mind-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .mind-head { display: flex; flex-direction: column; gap: 2px; }
  .mind-eyebrow {
    font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(245, 245, 247, 0.5);
    margin: 0;
  }
  .mind-title {
    font-size: 2.1rem;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0;
    background: linear-gradient(120deg, #f5f5f7 20%, #34d399 60%, #22d3ee 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .mind-sub {
    font-size: 0.82rem;
    line-height: 1.4;
    color: rgba(245, 245, 247, 0.62);
    margin: 4px 0 0;
    min-height: 1.1em;
  }

  .mind-modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 4px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .mind-mode {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 9px 8px;
    border-radius: 10px;
    font-size: 0.78rem;
    font-weight: 550;
    color: rgba(245, 245, 247, 0.66);
    background: transparent;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    white-space: nowrap;
  }
  .mind-mode:hover { color: #f5f5f7; }
  .mind-mode.is-active {
    color: #f5f5f7;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow: 0 6px 18px -12px rgba(0, 0, 0, 0.7);
  }
  .mind-mode-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--d);
    box-shadow: 0 0 10px 1px var(--d);
    flex: none;
  }

  .mind-detail {
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015));
    padding: 14px 15px;
    min-height: 96px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .mind-detail-hint {
    font-size: 0.8rem;
    color: rgba(245, 245, 247, 0.45);
    margin: 0;
    line-height: 1.5;
  }
  .mind-detail-kind {
    font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--nc, #34d399);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .mind-detail-kind::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--nc, #34d399);
    box-shadow: 0 0 9px 1px var(--nc, #34d399);
  }
  .mind-detail-title {
    font-size: 1.02rem;
    font-weight: 600;
    color: #f5f5f7;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .mind-detail-blurb {
    font-size: 0.82rem;
    line-height: 1.5;
    color: rgba(245, 245, 247, 0.66);
    margin: 0;
  }
  .mind-detail-link {
    align-self: flex-start;
    margin-top: 2px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    font-weight: 550;
    color: var(--nc, #34d399);
    text-decoration: none;
    padding: 5px 11px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--nc, #34d399) 42%, transparent);
    background: color-mix(in srgb, var(--nc, #34d399) 12%, transparent);
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .mind-detail-link:hover { background: color-mix(in srgb, var(--nc, #34d399) 22%, transparent); transform: translateY(-1px); }

  .mind-chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .mind-chip {
    font-family: "SF Mono", ui-monospace, Menlo, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.02em;
    color: rgba(245, 245, 247, 0.72);
    padding: 3px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--nc, #34d399) 12%, rgba(255, 255, 255, 0.04));
    border: 1px solid color-mix(in srgb, var(--nc, #34d399) 26%, rgba(255, 255, 255, 0.06));
  }

  .mind-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
  }
  .mind-legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.7rem;
    color: rgba(245, 245, 247, 0.5);
  }
  .mind-legend li::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lc);
    box-shadow: 0 0 8px 0 var(--lc);
  }

  .mind-hint {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
    font-size: 0.68rem;
    color: rgba(245, 245, 247, 0.4);
    margin: 0;
  }
  .mind-dot { opacity: 0.5; }

  .mind-reset {
    position: absolute;
    right: 24px;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 24px);
    z-index: 6;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: rgba(245, 245, 247, 0.7);
    cursor: pointer;
    padding: 0;
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .mind-reset:hover { color: #f5f5f7; transform: rotate(-40deg); }

  @keyframes mind-rise {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 640px) {
    .mind-panel {
      top: auto;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
      left: 16px;
      right: 16px;
      width: auto;
      padding: 16px 16px 14px;
      gap: 12px;
    }
    .mind-title { font-size: 1.7rem; }
    .mind-reset { right: 16px; bottom: auto; top: calc(env(safe-area-inset-top, 0px) + 84px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mind-panel { animation: none; }
  }
</style>
