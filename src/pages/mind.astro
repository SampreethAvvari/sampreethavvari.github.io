---
import BaseLayout from "../layouts/BaseLayout.astro";
import { mindGraphs } from "../data/mind/graph";

// Escape "<" so a stray "</script>" in any blurb can never break out of the
// JSON data island.
const dataJson = JSON.stringify(mindGraphs).replace(/</g, "\\u003c");
---

<BaseLayout
  title="Mind · Sampreeth Avvari"
  description="A living star map of my work: projects, disciplines, the tools they share, and every repository I have contributed to."
  footerVariant="minimal"
>
  <div class="mind-root" role="region" aria-label="Mind, an interactive map of my work">
    <canvas id="mind-canvas" class="mind-canvas" aria-hidden="true"></canvas>

    <!-- The panel floats over the map, so it is navigation layer glass. -->
    <aside class="mind-panel lg lg-thick" data-mind-panel>
      <div class="mind-top">
        <p class="kicker">Mind</p>
        <div class="mind-top-actions">
        <!-- Replays the first visit tour. -->
        <button class="mind-tour-open" data-mind-tour-open type="button" title="Take the space tour" aria-label="Take the space tour">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="m15.8 8.2-2.1 5.5-5.5 2.1 2.1-5.5 5.5-2.1Z"/></svg><span>Space tour</span>
        </button>
        <!-- Folds the panel down to this row so the whole map shows. -->
        <button
          class="mind-fold"
          data-mind-fold
          aria-controls="mind-panel-body"
          aria-expanded="true"
          aria-label="Hide panel"
          title="Hide panel"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
        </button>
        </div>
      </div>

      <div class="mind-body" id="mind-panel-body">
        <header class="mind-head">
          <h1 class="mind-title">
            A star map of my work.
            <span class="t-tail">Everything I've built, and what ties it together.</span>
          </h1>
          <p class="mind-sub" data-mind-sub>Loading the sky…</p>
        </header>

        <div class="mind-modes" role="tablist" aria-label="Which map">
          <button class="mind-mode is-active" data-mode="portfolio" role="tab" aria-selected="true">
            Portfolio graph
          </button>
          <button class="mind-mode" data-mode="repo" role="tab" aria-selected="false">
            Git mind
          </button>
        </div>

        <div class="mind-detail" data-mind-detail>
          <p class="mind-detail-hint">Fly through the map. Tap a star to open it.</p>
        </div>

        <div class="mind-filter">
          <p class="mind-filter-label">Show on the map</p>
          <ul class="mind-legend" data-mind-legend role="group" aria-label="Show on the map"></ul>
        </div>

        <p class="mind-hint">
          <span>Scroll or pinch to fly</span><span class="mind-dot">·</span><span>drag to turn</span
          ><span class="mind-dot">·</span><span>right drag or two fingers to move</span
          ><span class="mind-dot">·</span><span>tap a star</span>
        </p>
      </div>
    </aside>

    <button class="mind-reset lg" data-mind-reset title="Reset view" aria-label="Reset view">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
    </button>

    <!-- A star's card: opens over the map when a star is tapped. -->
    <aside class="mind-card" data-mind-card hidden>
      <div class="mind-card-frame" role="dialog" aria-labelledby="mind-card-name">
        <span class="mind-card-corner tl" aria-hidden="true"></span>
        <span class="mind-card-corner tr" aria-hidden="true"></span>
        <span class="mind-card-corner bl" aria-hidden="true"></span>
        <span class="mind-card-corner br" aria-hidden="true"></span>
        <button class="mind-card-close" data-mind-card-close aria-label="Close" title="Close">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
        <div class="mind-card-body" data-mind-card-body></div>
      </div>
    </aside>

    <!-- First visit tour: a few short steps that show how to read the map. -->
    <div class="mind-tour" data-mind-tour hidden role="dialog" aria-labelledby="mind-tour-title" aria-describedby="mind-tour-text">
      <div class="mind-tour-frame">
        <p class="mind-tour-count" data-tour-count></p>
        <h2 class="mind-tour-title" id="mind-tour-title" data-tour-title></h2>
        <p class="mind-tour-text" id="mind-tour-text" data-tour-text></p>
        <div class="mind-tour-bar">
          <div class="mind-tour-dots" data-tour-dots aria-hidden="true"></div>
          <div class="mind-tour-actions">
            <button type="button" class="mind-tour-skip" data-tour-skip>Skip</button>
            <button type="button" class="mind-tour-back" data-tour-back>Back</button>
            <button type="button" class="mind-tour-next" data-tour-next>Next</button>
          </div>
        </div>
      </div>
    </div>

    <script type="application/json" id="mind-data" set:html={dataJson}></script>
  </div>

  <script>
    import { onPage } from "../scripts/lifecycle";
    import { mountMind } from "../scripts/mind-stage";
    // Mounted each time the page is shown; the disposer it returns stops the
    // render loop and its listeners when the page is swapped away.
    onPage("mind", () => mountMind());
  </script>
</BaseLayout>

<style>
  .mind-root {
    position: relative;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    /* A soft wash of the Mind tab's violet, nothing else. */
    background:
      radial-gradient(56% 50% at 4% 0%, rgba(var(--tone-rgb), 0.12) 0%, rgba(var(--tone-rgb), 0.1171) 6.4%, rgba(var(--tone-rgb), 0.1085) 12.8%, rgba(var(--tone-rgb), 0.0953) 19.2%, rgba(var(--tone-rgb), 0.0785) 25.6%, rgba(var(--tone-rgb), 0.06) 32%, rgba(var(--tone-rgb), 0.0415) 38.4%, rgba(var(--tone-rgb), 0.0247) 44.8%, rgba(var(--tone-rgb), 0.0115) 51.2%, rgba(var(--tone-rgb), 0.0029) 57.6%, rgba(var(--tone-rgb), 0) 64%),
      radial-gradient(52% 48% at 100% 100%, rgba(var(--tone-rgb), 0.08) 0%, rgba(var(--tone-rgb), 0.078) 6.4%, rgba(var(--tone-rgb), 0.0724) 12.8%, rgba(var(--tone-rgb), 0.0635) 19.2%, rgba(var(--tone-rgb), 0.0524) 25.6%, rgba(var(--tone-rgb), 0.04) 32%, rgba(var(--tone-rgb), 0.0276) 38.4%, rgba(var(--tone-rgb), 0.0165) 44.8%, rgba(var(--tone-rgb), 0.0076) 51.2%, rgba(var(--tone-rgb), 0.002) 57.6%, rgba(var(--tone-rgb), 0) 64%);
  }

  .mind-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
    cursor: grab;
  }
  .mind-canvas.is-panning { cursor: grabbing; }
  .mind-canvas.is-over { cursor: pointer; }

  /* The control panel. */
  .mind-panel {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 88px);
    left: var(--gutter);
    width: min(344px, calc(100vw - 48px));
    padding: 22px 20px 18px;
    border-radius: 24px;
    z-index: 6;
    display: flex;
    flex-direction: column;
    gap: 16px;
    animation: mind-rise 500ms var(--ease-glass) both;
  }

  /* Top row: the kicker, and the fold button at the far end. */
  .mind-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
  .mind-fold {
    width: 30px;
    height: 30px;
    margin: -6px -6px -6px 0;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    display: grid;
    place-items: center;
    flex: none;
    color: var(--ink-faint);
    background: var(--wash);
    cursor: pointer;
    transition: color 150ms var(--ease-glass), background-color 150ms var(--ease-glass);
  }
  .mind-fold:hover { color: var(--ink); background: var(--wash-strong); }
  .mind-fold:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--tone-rgb), 0.45); }
  .mind-fold svg { transition: transform 250ms var(--ease-glass); }
  .mind-body { display: flex; flex-direction: column; gap: 16px; }
  .mind-top-actions { display: flex; align-items: center; gap: 8px; }
  .mind-tour-open {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    margin: -6px 0;
    padding: 0 11px 0 9px;
    border: 1px solid rgba(var(--c-mind-rgb), 0.35);
    border-radius: 9999px;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    color: #ddd6fe;
    background: rgba(var(--c-mind-rgb), 0.12);
    cursor: pointer;
    transition: background-color 150ms var(--ease-glass), border-color 150ms var(--ease-glass);
  }
  .mind-tour-open:hover { background: rgba(var(--c-mind-rgb), 0.22); border-color: rgba(var(--c-mind-rgb), 0.6); }
  .mind-tour-open:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--c-mind-rgb), 0.45); }

  /* The tour: one small glass card, the map stays live behind it. */
  .mind-tour {
    position: fixed;
    left: calc(50% - min(220px, 50vw - 16px));
    top: calc(100% - 214px);
    z-index: 9;
    width: min(440px, calc(100vw - 32px));
    transition: left 520ms var(--ease-glass), top 520ms var(--ease-glass), width 520ms var(--ease-glass);
  }
  .mind-tour[hidden] { display: none; }
  .mind-tour-frame {
    position: relative;
    padding: 18px 20px 16px;
    border-radius: 20px;
    border: 1px solid rgba(var(--c-mind-rgb), 0.38);
    background:
      radial-gradient(120% 90% at 0% 0%, rgba(var(--c-mind-rgb), 0.2), transparent 60%),
      rgba(10, 10, 18, 0.86);
    -webkit-backdrop-filter: blur(14px) saturate(1.5);
    backdrop-filter: blur(14px) saturate(1.5);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.04) inset, 0 18px 50px -18px rgba(0, 0, 0, 0.9), 0 0 40px -16px rgba(var(--c-mind-rgb), 0.7);
    animation: mind-tour-in 380ms var(--ease-glass) both;
  }
  .mind-tour.is-step .mind-tour-frame { animation: mind-tour-step 300ms var(--ease-glass) both; }
  .mind-tour-count {
    margin: 0 0 6px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #c4b5fd;
  }
  .mind-tour-title { margin: 0; font-size: 1.0625rem; font-weight: 650; line-height: 1.3; color: var(--ink); letter-spacing: -0.01em; }
  .mind-tour-text { margin: 6px 0 0; font-size: 0.875rem; line-height: 1.55; color: var(--ink-soft); }
  .mind-tour-bar { margin-top: 14px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .mind-tour-dots { display: flex; gap: 5px; }
  .mind-tour-dots :global(i) { width: 6px; height: 6px; border-radius: 9999px; background: rgba(255, 255, 255, 0.18); transition: background-color 200ms, width 200ms; }
  .mind-tour-dots :global(i.on) { width: 16px; background: #a78bfa; }
  .mind-tour-actions { display: flex; align-items: center; gap: 6px; }
  .mind-tour-actions button {
    height: 32px;
    padding: 0 13px;
    border-radius: 9999px;
    border: 1px solid transparent;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 150ms var(--ease-glass), color 150ms var(--ease-glass), box-shadow 150ms var(--ease-glass);
  }
  .mind-tour-skip { color: var(--ink-faint); background: transparent; }
  .mind-tour-skip:hover { color: var(--ink); }
  .mind-tour-back { color: var(--ink-soft); background: var(--wash); }
  .mind-tour-back:hover { color: var(--ink); background: var(--wash-strong); }
  .mind-tour-back[hidden] { display: none; }
  .mind-tour-next {
    color: #fff;
    background: linear-gradient(135deg, #a78bfa, #7c3aed);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 6px 18px -8px rgba(124, 58, 237, 0.9);
  }
  .mind-tour-next:hover { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 8px 22px -8px rgba(139, 92, 246, 1); }
  .mind-tour-actions button:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--c-mind-rgb), 0.5); }
  /* During the tour the panel fades back, except what the step is about. */
  .mind-panel.is-touring .mind-top,
  .mind-panel.is-touring .mind-body > * { opacity: 0.14; transition: opacity 300ms var(--ease-glass); }
  .mind-panel.is-touring .mind-body > :has(.is-tour-target),
  .mind-panel.is-touring .mind-body > .is-tour-target { opacity: 1; }
  :global(body.mind-touring .chat-launcher), .mind-root:has(.mind-tour:not([hidden])) .mind-reset { opacity: 0.15; transition: opacity 300ms; }
  /* what a step is about, ringed in the panel */
  /* one ring 10px outside the group, an even tint inside, so no text ever
     sits on an edge */
  :global(.is-tour-target) { position: relative; }
  :global(.is-tour-target)::after {
    content: "";
    position: absolute;
    inset: -10px;
    border-radius: 18px;
    border: 2px solid rgba(167, 139, 250, 0.85);
    background: rgba(167, 139, 250, 0.06);
    box-shadow: 0 0 30px 2px rgba(167, 139, 250, 0.3);
    pointer-events: none;
    animation: mind-tour-ring 1.6s ease-in-out infinite;
  }
  @keyframes mind-tour-in { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }
  @keyframes mind-tour-step { from { opacity: 0.4; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  @keyframes mind-tour-ring { 50% { border-color: rgba(167, 139, 250, 0.45); box-shadow: 0 0 38px 4px rgba(167, 139, 250, 0.18); } }

  /* Folded: only the top row stays, a small pill over the map. */
  .mind-panel.is-folded {
    width: auto;
    padding: 10px 10px 10px 16px;
    border-radius: 9999px;
    gap: 0;
    cursor: pointer;
  }
  .mind-panel.is-folded .mind-body { display: none; }
  .mind-panel.is-folded .mind-fold { margin: -4px; }
  .mind-panel.is-folded .mind-fold svg { transform: rotate(180deg); }

  .mind-head { display: flex; flex-direction: column; }
  .mind-title {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.16;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: var(--ink);
    text-wrap: balance;
  }
  .mind-sub {
    margin: 12px 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-soft);
    min-height: 1.3em;
  }

  /* Segmented control: a quiet track, the lens marks where you are. */
  .mind-modes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 4px;
    border-radius: 9999px;
    background: var(--wash);
    border: 1px solid var(--line);
  }
  .mind-mode {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    padding: 0 12px;
    border-radius: 9999px;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.006em;
    color: var(--ink-soft);
    background: transparent;
    border: 0;
    cursor: pointer;
    white-space: nowrap;
    transition: color 150ms var(--ease-glass), background-color 150ms var(--ease-glass), box-shadow 250ms var(--ease-glass);
  }
  .mind-mode:hover { color: var(--ink); transform: none; }
  .mind-mode:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--tone-rgb), 0.45); }
  .mind-mode.is-active {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.11);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      inset 0 -1px 0 rgba(0, 0, 0, 0.2),
      0 2px 8px -2px rgba(0, 0, 0, 0.6);
  }

  /* The detail card. Its contents are written by the script, so they are
     styled with :global(). */
  .mind-detail {
    border-radius: 16px;
    background: var(--wash);
    border: 1px solid var(--line);
    padding: 14px 16px;
    min-height: 92px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .mind-detail :global(.mind-detail-hint) {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-faint);
    text-wrap: pretty;
  }
  .mind-detail :global(.mind-detail-kind) {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }
  .mind-detail :global(.mind-detail-kind::before) {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--nc, var(--ink-faint));
    flex: none;
  }
  .mind-detail :global(.mind-detail-title) {
    margin: 0;
    font-size: 1rem;
    line-height: 1.35;
    letter-spacing: -0.012em;
    font-weight: 600;
    color: var(--ink);
  }
  .mind-detail :global(.mind-detail-blurb) {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .mind-detail :global(.mind-chips) { display: flex; flex-wrap: wrap; gap: 6px; }
  .mind-detail :global(.mind-chip) {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 9px;
    border-radius: 9999px;
    font-size: 0.71875rem;
    font-weight: 500;
    line-height: 1;
    white-space: nowrap;
    color: var(--ink-soft);
    background: var(--wash-strong);
  }
  .mind-detail :global(.mind-detail-link) {
    align-self: flex-start;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 13px;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.03)),
      rgba(10, 11, 15, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2);
    transition: border-color 150ms var(--ease-glass), background-color 150ms var(--ease-glass), transform 250ms var(--ease-glass);
  }
  .mind-detail :global(.mind-links) { display: flex; flex-wrap: wrap; gap: 6px; }
  .mind-detail :global(.mind-links .mind-detail-link) { margin-top: 0; }
  .mind-detail :global(.mind-near-title) { margin-top: 4px; }
  .mind-detail :global(.mind-hop) {
    gap: 6px;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.71875rem;
    font-weight: 500;
    transition: background-color 150ms var(--ease-glass), color 150ms var(--ease-glass);
  }
  .mind-detail :global(.mind-hop::before) {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--hc, currentColor);
    box-shadow: 0 0 8px var(--hc, transparent);
  }
  .mind-detail :global(.mind-hop:hover) { color: var(--ink); background: rgba(255, 255, 255, 0.12); }
  .mind-detail :global(.mind-hop:focus-visible) { outline: none; box-shadow: 0 0 0 2px rgba(var(--tone-rgb), 0.55); }
  .mind-detail :global(.mind-detail-link:hover) { border-color: rgba(255, 255, 255, 0.26); transform: translateY(-1px); }
  .mind-detail :global(.mind-detail-link svg) { transition: transform 250ms var(--ease-glass); }
  .mind-detail :global(.mind-detail-link:hover svg) { transform: translate(1px, -1px); }

  /* Legend: what each colour of star is. Written by the script too. */
  .mind-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }
  .mind-legend :global(li) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink-soft);
  }
  .mind-legend :global(li::before) {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--lc);
    box-shadow: 0 0 8px 0 var(--lc);
    flex: none;
  }


  /* Filter: the legend's kinds of star, each a switch; the anchors stay. */
  .mind-filter { display: grid; gap: 8px; }
  .mind-filter-label {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .mind-legend :global(li:has(.mind-filter-btn))::before { display: none; }
  .mind-legend :global(.mind-filter-btn) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 28px;
    padding: 0 11px 0 9px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
    color: var(--ink);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
    transition: background-color 150ms var(--ease-glass), color 150ms var(--ease-glass), border-color 150ms var(--ease-glass);
  }
  .mind-legend :global(.mind-filter-btn::before) {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--lc);
    box-shadow: 0 0 8px 0 var(--lc);
    transition: opacity 150ms var(--ease-glass);
  }
  .mind-legend :global(.mind-filter-btn[aria-pressed="false"]) {
    color: var(--ink-faint);
    background: transparent;
    border-color: rgba(255, 255, 255, 0.08);
  }
  .mind-legend :global(.mind-filter-btn[aria-pressed="false"]::before) { opacity: 0.25; box-shadow: none; }
  .mind-legend :global(.mind-filter-btn:hover) { border-color: rgba(255, 255, 255, 0.26); }
