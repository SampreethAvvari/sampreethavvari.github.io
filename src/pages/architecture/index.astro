---
// Every architecture drawing on the site, as an endless wall of glass cards
// on a gently curved surface: drag or scroll to move it, a card opens its
// drawing at /architecture/<slug>. Under the wall sits the plain list of
// every system as real links, with the same filters (the List view).
import BaseLayout from "../../layouts/BaseLayout.astro";
import NextStep from "../../components/common/NextStep.astro";
import GlassWall from "../../components/architecture/observatory/GlassWall.astro";
import { architectures } from "../../data/architecture";
import { itemListNode } from "../../utils/seo";

const listSchema = [
  itemListNode(
    Astro.site!.toString(),
    "/architecture",
    "System architecture drawings by Sampreeth Avvari",
    architectures.map((a) => ({ name: a.name + " architecture", path: "/architecture/" + a.slug })),
  ),
];
---

<BaseLayout
  title="Architecture"
  description="Every system I run, drawn: the parts, what each one does when it fails, and a measured cost where billing has one."
  tone="architecture"
  schema={listSchema}
  crumbs={[{ name: "Home", path: "/" }, { name: "Architecture", path: "/architecture" }]}
>
  <GlassWall>
    <NextStep next={{ href: "/posts", label: "Read the writing" }} />
  </GlassWall>
</BaseLayout>
