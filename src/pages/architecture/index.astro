---
// Every architecture drawing on the site, as an observatory: each system is
// a world in one galaxy, its real parts in orbit, and the scroll flies from
// world to world. Under the 3D sits the plain list of every system, in the
// same order, with filters for the four kinds of work. Each world opens its
// drawing at /architecture/<slug>.
import BaseLayout from "../../layouts/BaseLayout.astro";
import NextStep from "../../components/common/NextStep.astro";
import Observatory from "../../components/architecture/observatory/Observatory.astro";
import { architectures } from "../../data/architecture";
import { itemListNode } from "../../utils/seo";

const listSchema = [
  itemListNode(
    Astro.site!.toString(),
    "/architecture",
    "System architecture drawings by Sampreeth Avvari",
    architectures.map((a) => ({ name: a.name + " architecture", path: "/architecture/" + a.slug })),
  ),
];
---

<BaseLayout
  title="Architecture"
  description="Every system I run, drawn: the parts, what each one does when it fails, and what it costs a month."
  tone="architecture"
  schema={listSchema}
  crumbs={[{ name: "Home", path: "/" }, { name: "Architecture", path: "/architecture" }]}
>
  <Observatory />
  <NextStep next={{ href: "/posts", label: "Read the writing" }} />
</BaseLayout>
