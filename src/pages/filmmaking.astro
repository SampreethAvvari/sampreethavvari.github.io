      radial-gradient(34% 60% at calc(100% - var(--nx)) calc(100% - var(--ny)), rgba(var(--blood), 0.32) 0%, rgba(var(--blood), 0.14) 50%, rgba(var(--blood), 0) 100%),
      radial-gradient(120% 90% at 50% 120%, rgba(90, 8, 26, 0.55) 0%, rgba(90, 8, 26, 0.2) 40%, rgba(90, 8, 26, 0) 70%),
