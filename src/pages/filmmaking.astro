---
import BaseLayout from "../layouts/BaseLayout.astro";
import fs from "node:fs";
import path from "node:path";
import SmartImage from "../components/common/SmartImage.astro";
import Icon from "../components/common/Icon.astro";
import { canonicalImageList } from "../utils/optimizedImage";

const title = "SA: Filmmaking";
const description =
  "Films by Sampreeth Avvari. Among Monsters, an independent crime drama shot in New York, plus the full slate, stills, cast and crew.";
const playlistUrl = "https://hi.switchy.io/gB-4";
const screenplayUrl = "/among-monsters-screenplay.pdf";
const imdbUrl = "https://hi.switchy.io/q94P";
const photographyUrl = "https://hi.switchy.io/q3TE";

const posterSrc = "/among-monsters-poster.jpg";

const IMG_RE = /\.(png|jpe?g|webp|gif|avif)$/i;
const readImages = (dir) => {
  try {
    return canonicalImageList(fs.readdirSync(dir).filter((file) => IMG_RE.test(file))).sort((a, b) =>
      a.localeCompare(b)
    );
  } catch (error) {
    return [];
  }
};

// Among Monsters stills. Filenames carry the edit's clip numbers
// ("Carl 1_1.90.1"), so the readable part is everything before them.
const galleryDir = path.join(process.cwd(), "public", "Photo Gallery");
const stillName = (file) =>
  file
    .replace(/\.[^/.]+$/, "")
    .replace(/_[\d.]+$/, "")
    .replace(/[-_]+/g, " ")
    .trim();
const stills = readImages(galleryDir).map((file) => ({
  src: `/Photo%20Gallery/${encodeURIComponent(file)}`,
  alt: `Among Monsters still, ${stillName(file)}`,
}));

const swechchaStills = readImages(path.join(galleryDir, "Swechcha")).map((file, i) => ({
  src: `/Photo%20Gallery/Swechcha/${encodeURIComponent(file)}`,
  alt: `Swechcha still ${i + 1}`,
}));

const crewPhoto = (filename) => ({
  src: `/Crew%20Photos/${encodeURIComponent(filename)}`,
  alt: filename.replace(/\.[^/.]+$/, ""),
});

const instagramUrl = (handle) => (handle ? `https://instagram.com/${handle.replace(/^@/, "")}` : "");

// Cast and crew without a real headshot get a clean initials panel rather
// than reusing an on set still, so no scene is passed off as a portrait.
const pickGalleryImage = () => ({ placeholder: true });
const initials = (name) =>
  (name || "")
    .split(/\s+/)
    .map((w) => w[0])
    .filter(Boolean)
    .slice(0, 2)
    .join("")
    .toUpperCase();

const keyCreators = [
  {
    role: "Director · Writer",
    name: "Sampreeth Sharma",
    image: crewPhoto("Sampreeth.JPG"),
    instagram: "@sampreeth.sharma",
  },
  {
    role: "Director of photography",
    name: "Isaac Chipe",
    image: crewPhoto("Isaac.jpg"),
    instagram: "@isaacchipedop",
  },
  {
    role: "Co writer",
    name: "Akash Munji",
    image: crewPhoto("Akash.jpg"),
    instagram: "@akumunji",
  },
];

const mainCast = [
  {
    name: "Sam Velletri",
    role: "John Reese · Harold Finch",
    image: crewPhoto("Sam Velletri.jpg"),
    instagram: "@samvelletri",
  },
  {
    name: "Matt Ehrmann",
    role: "",
    image: pickGalleryImage(),
    instagram: "@mattspaceship",
  },
  {
    name: "Kendall Hobson",
    role: "Carl",
    image: crewPhoto("Kendall.jpeg"),
    instagram: "@kenny.flair",
  },
  {
    name: "Lazaro Clapp",
    role: "",
    image: crewPhoto("Lazaro.png"),
    imageStyle: "object-position: 28% center;",
    instagram: "@lazaroclapp",
  },
  {
    name: "Alex Murray",
    role: "Sam",
    image: crewPhoto("Alex.jpeg"),
    instagram: "@cooldudemurray",
  },
  {
    name: "Evan Beskin",
    role: "Agent David",
    image: crewPhoto("Evan.png"),
    imageStyle: "object-position: 65% 60%; transform: scale(1.12);",
    instagram: "",
  },
];

const supportingCast = [
  {
    name: "Asli Mumtas",
    role: "Grace",
    image: crewPhoto("Asli.png"),
    imageStyle: "object-position: 70% center;",
    instagram: "@asliimumtas",
  },
  {
    name: "Tom Velletri",
    role: "Faith",
    image: crewPhoto("Tom Velletri.jpeg"),
    imageStyle: "object-position: 30% center; transform: scale(1.05);",
    instagram: "@tomvelletri",
  },
  {
    name: "Jordyn Andrea",
    role: "Sarah",
    image: crewPhoto("Jordyn.jpeg"),
    imageStyle: "transform: scale(1.05);",
    instagram: "@jordyn.andrea",
  },
  {
    name: "Luke Johnson",
    role: "Marcus",
    image: crewPhoto("Luke.jpeg"),
    instagram: "@lukeabjohnson",
  },
  {
    name: "Riyaan Jiwani",
    role: "Max",
    image: crewPhoto("Max.jpeg"),
    instagram: "@riyaan.jiwani",
  },
  {
    name: "Dylan Redford",
    role: "Unnamed FBI agent",
    image: pickGalleryImage(),
    instagram: "@dylanredford",
  },
];

const musicCredits = [
  {
    name: "Sai Charan Thota",
    role: "PRO-JECT 53",
    image: pickGalleryImage(),
    instagram: "@charan_af",
  },
  {
    name: "Eknath Sravanam",
    role: "PRO-JECT 53",
    image: pickGalleryImage(),
    instagram: "@eknath_sravanam",
  },
];

const crewGroups = [
  { label: "Above the line", people: keyCreators },
  { label: "Cast", people: [...mainCast, ...supportingCast] },
  { label: "Music", people: musicCredits },
];

// The slate, newest first. Credits read as sentence case with middots.
const filmography = [
  { title: "Among Monsters", year: "2026", roles: ["Director", "Writer", "Editor", "Music"] },
  { title: "Extraordinary Lives", year: "upcoming", roles: ["Director", "Writer"] },
  { title: "Pupa", year: "upcoming", roles: ["Writer"] },
  { title: "Solstice", year: "2025", roles: ["Editor"] },
  { title: "Swechcha", year: "2024", roles: ["Editor"] },
  { title: "Tiger Man", year: "2022", roles: ["Director", "Writer", "Editor"] },
  { title: "Strangers", year: "2019", roles: ["Cinematographer", "Music"] },
];
const yearLabel = (year) => (year === "upcoming" ? "Soon" : year);

// The same films seen by the job I did on each.
const roles = [
  {
    title: "Director",
    image: "/Creative%20Roles/Director.jpg",
    films: ["Extraordinary Lives", "Among Monsters", "Tiger Man"],
  },
  {
    title: "Writer",
    image: "/Creative%20Roles/Write.jpg",
    films: ["Extraordinary Lives", "Pupa", "Among Monsters", "Tiger Man"],
  },
  {
    title: "Editor",
    image: "/Creative%20Roles/Editor.jpg",
    films: ["Among Monsters", "Solstice", "Swechcha", "Tiger Man"],
  },
  {
    title: "Cinematographer",
    image: "/Creative%20Roles/Cinematographer.jpg",
    films: ["Among Monsters", "Strangers"],
  },
  {
    title: "Music composer",
    image: "/Creative%20Roles/Music.jpg",
    films: ["Among Monsters", "Strangers"],
  },
];

const featureFacts = [
  { label: "My roles", value: "Director · Writer · Editor · Music" },
  { label: "Year", value: "2026" },
  { label: "Status", value: "Premiering in NYC" },
  { label: "Shot", value: "New York City, 2024 and 2025" },
  { label: "Genre", value: "Independent crime drama" },
];

const links = [
  {
    title: "Among Monsters playlist",
    line: "The film's playlist on YouTube.",
    href: playlistUrl,
    icon: "youtube",
  },
  {
    title: "Screenplay",
    line: "Read the Among Monsters script as a PDF.",
    href: screenplayUrl,
    icon: "file",
  },
  {
    title: "Photography",
    line: "My photography page on Instagram.",
    href: photographyUrl,
    icon: "instagram",
  },
  {
    title: "IMDb",
    line: "Among Monsters on IMDb.",
    href: imdbUrl,
    icon: "imdb",
  },
];
---

<BaseLayout title={title} description={description} footerVariant="filmmaking">
  <!-- Page top and the current feature -->
  <section class="page-top film-top">
    <div class="tone-atmos" aria-hidden="true"></div>
    <div class="wrap on-top">
      <div class="film-intro">
        <p class="kicker">Film</p>
        <h1 class="t-title film-title">
          Gray characters and tight spaces.
          <span class="t-tail">The chaos hiding inside ordinary lives.</span>
        </h1>
        <p class="t-lede film-lede">
          I write, direct, edit and score. Among Monsters is the independent
          crime drama I made in New York, and below it is the rest of the
          slate, back to 2019.
        </p>
      </div>

      <article id="among-monsters" class="surface feature" aria-labelledby="feature-title">
        <div class="feature-media">
          <SmartImage
            src={posterSrc}
            alt="Among Monsters poster with the full credits"
            class="feature-img"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="feature-body">
          <div class="feature-copy">
            <div class="feature-badges">
              <span class="badge badge-tone">Current feature</span>
              <span class="badge">Premieres 2026</span>
            </div>
            <h2 id="feature-title" class="t-h2 feature-name">Among Monsters</h2>
            <p class="feature-logline">
              A criminal trapped in a coward's body sets out to take revenge at
              any cost. Guns and drugs don't save people. The question isn't
              whether he breaks, it's how long he can keep going before the
              chaos finishes him.
            </p>
            <p class="t-body feature-note">
              I wrote, directed, edited, and scored it. We shot it across New
              York City in 2024 and 2025, in real living rooms and motel
              parking lots and the kind of streets the script kept asking for.
              Premieres in NYC in 2026.
            </p>
            <div class="feature-actions">
              <a href={imdbUrl} target="_blank" rel="noreferrer" class="btn btn-glass">
                <span class="imdb-wordmark">IMDb</span> On IMDb
                <Icon name="arrow-up-right" size={15} class="arrow-ur" />
              </a>
              <a href={screenplayUrl} target="_blank" rel="noreferrer" class="btn btn-glass">
                Read the screenplay
              </a>
              <a href={playlistUrl} target="_blank" rel="noreferrer" class="btn btn-ghost">
                Watch the playlist
                <Icon name="arrow-up-right" size={15} class="arrow-ur" />
              </a>
            </div>
          </div>

          <dl class="facts">
            {featureFacts.map((f) => (
              <div class="fact">
                <dt class="t-meta">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </article>
    </div>
  </section>

  <!-- The slate -->
  <section class="section" aria-labelledby="slate-title">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <div class="sec-head-main">
          <h2 id="slate-title" class="t-h2">
            Seven films, in order.
            <span class="t-tail">Some are out, some are in the cut, some are still pages.</span>
          </h2>
        </div>
      </div>

      <div class="group-head" data-reveal>
        <h3 class="t-h4">By year</h3>
        <span class="t-meta">{filmography.length} films</span>
      </div>
      <ul class="rows slate" data-reveal>
        {filmography.map((film) => (
          <li class="slate-row">
            <span class="slate-year t-meta">{yearLabel(film.year)}</span>
            <span class="slate-title">{film.title}</span>
            <span class="slate-roles t-meta">{film.roles.join(" · ")}</span>
          </li>
        ))}
      </ul>

      <div class="group-head group-gap" data-reveal>
        <h3 class="t-h4">By role</h3>
        <span class="t-meta">{roles.length} jobs on set</span>
      </div>
      <ul class="roles" data-reveal>
        {roles.map((role) => (
          <li class="surface role">
            <div class="role-media">
              <SmartImage src={role.image} alt={`${role.title} at work`} class="role-img" loading="lazy" />
            </div>
            <div class="role-body">
              <h4 class="t-h4">{role.title}</h4>
              <ul class="role-films">
                {role.films.map((film) => (
                  <li class="t-small">{film}</li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Stills -->
  <section class="section section-flush" aria-labelledby="stills-title">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <div class="sec-head-main">
          <h2 id="stills-title" class="t-h2">
            On set.
            <span class="t-tail">Frames from the films.</span>
          </h2>
        </div>
      </div>

      <div class="group-head" data-reveal>
        <h3 class="t-h4">Among Monsters <span class="t-meta">2026</span></h3>
        <span class="t-meta">{stills.length} stills</span>
      </div>
      {stills.length ? (
        <ul class="stills" data-reveal>
          {stills.map((item, i) => (
            <li>
              <button
                type="button"
                class="still"
                data-still
                data-group="am"
                data-index={i}
                data-full={item.src}
                data-caption="Among Monsters"
                aria-label={`View still ${i + 1} of ${stills.length} from Among Monsters`}
              >
                <SmartImage src={item.src} alt={item.alt} class="still-img" loading="lazy" />
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="t-small inset empty">Stills coming soon.</p>
      )}

      <div id="swechcha" class="group-head group-gap" data-reveal>
        <div>
          <h3 class="t-h4">Swechcha <span class="t-meta">2024</span></h3>
          <p class="t-small mt-1">Earlier work. A short film I edited and color graded in 2024.</p>
        </div>
        <span class="t-meta">{swechchaStills.length} stills</span>
      </div>
      {swechchaStills.length ? (
        <ul class="stills stills-wide" data-reveal>
          {swechchaStills.map((item, i) => (
            <li>
              <button
                type="button"
                class="still"
                data-still
                data-group="swechcha"
                data-index={i}
                data-full={item.src}
                data-caption="Swechcha"
                aria-label={`View still ${i + 1} of ${swechchaStills.length} from Swechcha`}
              >
                <SmartImage src={item.src} alt={item.alt} class="still-img" loading="lazy" />
              </button>
            </li>
          ))}
        </ul>
      ) : (
        <p class="t-small inset empty">Swechcha stills coming soon.</p>
      )}
    </div>
  </section>

  <!-- Cast and crew -->
  <section class="section" aria-labelledby="crew-title">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <div class="sec-head-main">
          <h2 id="crew-title" class="t-h2">
            The people who made the scene work.
            <span class="t-tail">Cast and crew of Among Monsters.</span>
          </h2>
        </div>
      </div>

      {crewGroups.map((group, gi) => (
        <div class:list={["crew-group", gi > 0 && "group-gap"]}>
          <div class="group-head" data-reveal>
            <h3 class="t-h4">{group.label}</h3>
            <span class="t-meta">{group.people.length}</span>
          </div>
          <ul class="people" data-reveal>
            {group.people.map((person) => {
              const Tag = person.instagram ? "a" : "div";
              const linkProps = person.instagram
                ? {
                    href: instagramUrl(person.instagram),
                    target: "_blank",
                    rel: "noreferrer",
                    "aria-label": `${person.name} on Instagram`,
                  }
                : {};
              return (
                <li>
                  <Tag class="surface person" {...linkProps}>
                    <div class="person-media">
                      {person.image?.placeholder ? (
                        <div class="person-ph" aria-hidden="true">
                          <span>{initials(person.name)}</span>
                        </div>
                      ) : (
                        <SmartImage
                          src={person.image.src}
                          alt={`${person.name} portrait`}
                          class="person-img"
                          style={person.imageStyle}
                          loading="lazy"
                        />
                      )}
                    </div>
                    <div class="person-body">
                      <div class="min-w-0">
                        <p class="person-name">{person.name}</p>
                        <p class="t-meta person-role">{person.role || "Cast"}</p>
                      </div>
                      {person.instagram && (
                        <span class="person-ig" aria-hidden="true">
                          <Icon name="instagram" size={14} />
                        </span>
                      )}
                    </div>
                  </Tag>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Links -->
  <section class="section section-last" aria-labelledby="links-title">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <div class="sec-head-main">
          <h2 id="links-title" class="t-h2">
            Watch and read.
            <span class="t-tail">The playlist, the screenplay and the photography.</span>
          </h2>
        </div>
      </div>
      <ul class="links" data-reveal>
        {links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noreferrer" class="surface link-card">
              <span class="link-icon" aria-hidden="true">
                {l.icon === "imdb" && <span class="imdb-wordmark">IMDb</span>}
                {l.icon === "instagram" && <Icon name="instagram" size={18} />}
                {l.icon === "youtube" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                  </svg>
                )}
                {l.icon === "file" && (
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                    <path d="M14 2v4a2 2 0 0 0 2 2h4M16 13H8M16 17H8M10 9H8" />
                  </svg>
                )}
              </span>
              <span class="min-w-0">
                <span class="block t-h4">{l.title}</span>
                <span class="block t-small mt-1">{l.line}</span>
              </span>
              <span class="link-arrow" aria-hidden="true">
                <Icon name="arrow-up-right" size={16} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Still viewer -->
  <div id="flb" class="lb" hidden role="dialog" aria-modal="true" aria-label="Still viewer">
    <div class="lb-backdrop" data-lb-close></div>
    <button type="button" class="lb-btn lb-close lg" data-lb-close aria-label="Close viewer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
    <figure class="lb-stage">
      <img id="flb-img" class="lb-img" alt="" />
      <figcaption class="lb-cap">
        <span id="flb-cap" class="t-small"></span>
      </figcaption>
    </figure>
    <div class="lb-bar lg">
      <button type="button" class="lb-btn" data-lb-prev aria-label="Previous still">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <span id="flb-count" class="t-meta lb-count"></span>
      <button type="button" class="lb-btn" data-lb-next aria-label="Next still">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  // A calm viewer for the stills: click to open, arrows or swipe to move,
  // Escape or the backdrop to close. Focus goes back to the still you opened.
  const lb = document.getElementById("flb");
  const img = document.getElementById("flb-img") as HTMLImageElement | null;
  const cap = document.getElementById("flb-cap");
  const count = document.getElementById("flb-count");

  type Item = { src: string; caption: string; alt: string };
  let items: Item[] = [];
  let cursor = 0;
  let opener: HTMLElement | null = null;

  const collect = (group: string): Item[] =>
    Array.from(document.querySelectorAll<HTMLElement>(`[data-still][data-group="${group}"]`)).map((el) => ({
      src: el.dataset.full || "",
      caption: el.dataset.caption || "",
      alt: el.querySelector("img")?.getAttribute("alt") || "",
    }));

  const preload = (i: number) => {
    const it = items[i];
    if (it) new Image().src = it.src;
  };

  const render = () => {
    if (!img || !cap || !count) return;
    const it = items[cursor];
    if (!it) return;
    img.classList.remove("is-in");
    img.onload = () => img.classList.add("is-in");
    img.src = it.src;
    img.alt = it.alt;
    cap.textContent = it.caption;
    count.textContent = `${cursor + 1} / ${items.length}`;
    preload(cursor + 1);
    preload(cursor - 1);
  };

  const open = (el: HTMLElement) => {
    if (!lb) return;
    opener = el;
    items = collect(el.dataset.group || "");
    cursor = Math.min(Math.max(Number(el.dataset.index || 0), 0), items.length - 1);
    lb.hidden = false;
    requestAnimationFrame(() => lb.classList.add("is-open"));
    document.documentElement.classList.add("lb-lock");
    render();
    lb.querySelector<HTMLElement>(".lb-close")?.focus();
  };

  const close = () => {
    if (!lb || lb.hidden) return;
    lb.classList.remove("is-open");
    document.documentElement.classList.remove("lb-lock");
    window.setTimeout(() => {
      lb.hidden = true;
    }, 220);
    opener?.focus();
  };

  const step = (delta: number) => {
    if (!items.length) return;
    cursor = (cursor + delta + items.length) % items.length;
    render();
  };

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const still = target.closest<HTMLElement>("[data-still]");
    if (still) {
      open(still);
      return;
    }
    if (target.closest("[data-lb-close]")) close();
    if (target.closest("[data-lb-prev]")) step(-1);
    if (target.closest("[data-lb-next]")) step(1);
  });

  document.addEventListener("keydown", (e) => {
    if (!lb || lb.hidden) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") step(-1);
    if (e.key === "ArrowRight") step(1);
  });

  let touchX: number | null = null;
  lb?.addEventListener("touchstart", (e) => (touchX = e.touches[0]?.clientX ?? null), { passive: true });
  lb?.addEventListener(
    "touchend",
    (e) => {
      if (touchX === null) return;
      const dx = (e.changedTouches[0]?.clientX ?? touchX) - touchX;
      if (Math.abs(dx) > 48) step(dx < 0 ? 1 : -1);
      touchX = null;
    },
    { passive: true }
  );
</script>

