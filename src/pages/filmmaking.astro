---
// The filmmaking page. Among Monsters leads as the coming feature, the rest
// of the slate arrives as you scroll, then frames from the film, the jobs I
// do on set and where to watch and read. Every film has its own page; the
// facts for all of them live in src/data/films.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import SmartImage from "../components/common/SmartImage.astro";
import Icon from "../components/common/Icon.astro";
import Reel from "../components/film/Reel.astro";
import StillViewer from "../components/film/StillViewer.astro";
import {
  films,
  crafts,
  filmPath,
  filmBySlug,
  filmByTitle,
  filmStills,
  yearLabel,
  rolesLine,
  photographyUrl,
  reelItems,
  type Film,
} from "../data/films";
import { filmNodes, itemListNode } from "../utils/seo";

const title = "SA: Filmmaking";
const description =
  "Films by Sampreeth Avvari. Among Monsters, an independent crime drama shot in New York, plus the full slate, stills, cast and crew.";

const feature = filmBySlug("among-monsters")!;
const { imdb, screenplay, playlist } = feature.links!;
const stills = filmStills(feature);
const keyCreators = feature.credits?.find((g) => g.label === "Above the line")?.people ?? [];

// The reel at the top: one film per screen, its clip or its stills.
const reel = reelItems();
const reelPreload = reel[0]?.poster.replace(/\.(jpe?g|webp|png)$/i, ".avif");

// The timeline: each film's poster, a frame from it, or a title card. A title
// card is plainly a card (the title set in type on a red field between
// letterbox bars), never dressed up as a poster.
const swechcha = filmBySlug("swechcha")!;
const swechchaFrame = filmStills(swechcha)[4] ?? filmStills(swechcha)[0];
const art = (film: Film) =>
  film.poster ? "poster" : film.slug === "swechcha" && swechchaFrame ? "still" : "card";
// Where each card's nebula and eclipse sit, so no two cards look alike.
const SEEDS = [
  [24, 40, 76, 58],
  [70, 34, 26, 66],
  [36, 64, 78, 30],
  [78, 56, 22, 38],
  [50, 28, 30, 70],
  [26, 60, 70, 36],
  [62, 66, 34, 30],
  [40, 32, 74, 64],
  [72, 44, 24, 56],
];
const metaLine = (film: Film) =>
  film.status === "dated"
    ? yearLabel(film)
    : `${yearLabel(film)} · ${film.statusNote ?? (film.status === "upcoming" ? "Upcoming" : "Released")}`;

const instagramUrl = (handle?: string) => (handle ? `https://instagram.com/${handle.replace(/^@/, "")}` : "");
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .filter(Boolean)
    .slice(0, 2)
    .join("")
    .toUpperCase();

const links = [
  { title: "Among Monsters playlist", line: "The film's playlist on YouTube.", href: playlist!, icon: "youtube" },
  { title: "Screenplay", line: "Read the Among Monsters script as a PDF.", href: screenplay!, icon: "file" },
  { title: "Photography", line: "My photography page on Instagram.", href: photographyUrl, icon: "instagram" },
  { title: "IMDb", line: "Among Monsters on IMDb.", href: imdb!, icon: "imdb" },
];

const base = Astro.site!.toString();
---

<BaseLayout
  title={title}
  description={description}
  footerVariant="filmmaking"
  ogImage="/og/film.jpg"
  preloadImage={reelPreload?.endsWith(".avif") ? reelPreload : undefined}
  schema={[
    ...filmNodes(base),
    itemListNode(base, "/filmmaking", "Films by Sampreeth Avvari", films.map((f) => ({ name: f.title, path: filmPath(f.slug) }))),
  ]}
  crumbs={[{ name: "Home", path: "/" }, { name: "Filmmaking", path: "/filmmaking" }]}
>
  <div class="fm">
    <!-- The reel: one film per screen -->
    <Reel items={reel} after="#slate" />

    <!-- The slate, one film at a time -->
    <section id="slate" class="section fm-slate" aria-labelledby="slate-title">
      <span class="fm-haze fm-haze-left" aria-hidden="true"></span>
      <div class="wrap on-top">
        <div class="sec-head" data-reveal>
          <div class="sec-head-main">
            <h2 id="slate-title" class="t-h2">
              Gray characters and tight spaces.
              <span class="t-tail">The chaos hiding inside ordinary lives.</span>
            </h2>
            <p class="t-lede">
              I write, direct, edit and score. Among Monsters is the independent
              crime drama I made in New York, and the rest of the slate goes back
              to 2019.
            </p>
          </div>
        </div>

        <div class="fm-group-head" data-reveal>
          <p class="t-h4">Nine films, in order</p>
          <p class="t-meta">Some are out, some are in the cut, some are still pages.</p>
        </div>

        <ol class="tl" data-timeline>
          {films.map((film, i) => {
            const [nx, ny, sx, sy] = SEEDS[i % SEEDS.length];
            const kind = art(film);
            return (
              <li class="tl-item" data-side={i % 2 ? "right" : "left"}>
                <a href={filmPath(film.slug)} class="tl-card">
                  <div class="tl-frame-wrap">
                    <span class="tl-mark" aria-hidden="true">
                      <span class="tl-dot"></span>
                      <span class="tl-year">{yearLabel(film)}</span>
                    </span>
                    <span class="tl-glow" aria-hidden="true"></span>
                    <div class="tl-frame">
                      {kind === "poster" ? (
                        <SmartImage src={film.poster!.src} alt={`${film.title} poster`} class="tl-img" loading="lazy" />
                      ) : (
                        <div
                          class:list={["tc", kind === "still" && "tc-has-still"]}
                          style={`--nx:${nx}%;--ny:${ny}%;--sx:${sx}%;--sy:${sy}%;`}
                        >
                          <span class="tc-bar" aria-hidden="true">{film.year ?? "In development"}</span>
                          <span class="tc-field">
                            {kind === "still" ? (
                              <SmartImage src={swechchaFrame!.src} alt={swechchaFrame!.alt} class="tc-still" loading="lazy" />
                            ) : (
                              <span class="tc-sun" aria-hidden="true"></span>
                            )}
                            <span class="tc-dust" aria-hidden="true"></span>
                            <span class="tc-title" aria-hidden="true">{film.title}</span>
                          </span>
                          <span class="tc-bar" aria-hidden="true">{rolesLine(film)}</span>
                        </div>
                      )}
                      <span class="tl-veil" aria-hidden="true"></span>
                    </div>
                  </div>
                  <div class="tl-meta">
                    <div class="min-w-0">
                      <h3 class="tl-title">{film.title}</h3>
                      <p class="t-meta tl-when">{metaLine(film)}</p>
                      <p class="tl-roles">{rolesLine(film)}</p>
                    </div>
                    <span class="tl-go" aria-hidden="true"><Icon name="arrow-right" size={16} /></span>
                  </div>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <!-- Frames from the film -->
    <section id="stills" class="section fm-stills" aria-labelledby="stills-title">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <div class="sec-head-main">
            <h2 id="stills-title" class="t-h2">
              On set.
              <span class="t-tail">Frames from Among Monsters.</span>
            </h2>
          </div>
          <a href={`${filmPath(feature.slug)}#stills`} class="tlink">
            All {stills.length} stills, cast and crew <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      {stills.length ? (
        <div class="strip" data-strip>
          <ul class="strip-track" data-strip-track aria-label={`Among Monsters, ${stills.length} stills`}>
            {stills.map((item, i) => (
              <li class="strip-item">
                <button
                  type="button"
                  class="strip-still"
                  data-still
                  data-group="am"
                  data-index={i}
                  data-full={item.src}
                  data-caption="Among Monsters"
                  aria-label={`View still ${i + 1} of ${stills.length} from Among Monsters`}
                >
                  <SmartImage src={item.src} alt={item.alt} class="strip-img" loading="lazy" />
                </button>
              </li>
            ))}
          </ul>
          <div class="wrap strip-ctrl">
            <span class="t-meta">{stills.length} stills · open any frame to see it whole</span>
            <div class="strip-btns">
              <button type="button" class="strip-btn" data-strip-prev aria-label="Earlier stills">
                <Icon name="arrow-left" size={16} />
              </button>
              <button type="button" class="strip-btn" data-strip-next aria-label="Later stills">
                <Icon name="arrow-right" size={16} />
              </button>
            </div>
          </div>
        </div>
      ) : (
        <div class="wrap"><p class="t-small">Stills coming soon.</p></div>
      )}

      <div class="wrap">
        <div class="fm-team" data-reveal>
          <p class="t-meta fm-team-label">Made with</p>
          <ul class="fm-team-list">
            {keyCreators.map((p) => {
              const Tag = p.instagram ? "a" : "div";
              const linkProps = p.instagram
                ? { href: instagramUrl(p.instagram), target: "_blank", rel: "noreferrer", "aria-label": `${p.name} on Instagram` }
                : {};
              return (
                <li>
                  <Tag class="fm-person" {...linkProps}>
                    <span class="fm-person-face">
                      {p.photo ? (
                        <SmartImage src={p.photo} alt={`${p.name} portrait`} class="fm-person-img" loading="lazy" />
                      ) : (
                        <span aria-hidden="true">{initials(p.name)}</span>
                      )}
                    </span>
                    <span class="min-w-0">
                      <span class="block fm-person-name">{p.name}</span>
                      <span class="block t-meta">{p.role}</span>
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>
          <a href={`${filmPath(feature.slug)}#cast`} class="tlink fm-team-more">
            Full cast and crew <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </section>

    <!-- The jobs -->
    <section id="crafts" class="section fm-crafts" aria-labelledby="crafts-title">
      <span class="fm-haze fm-haze-right" aria-hidden="true"></span>
      <div class="wrap on-top">
        <div class="sec-head" data-reveal>
          <div class="sec-head-main">
            <h2 id="crafts-title" class="t-h2">
              Five jobs on set.
              <span class="t-tail">The same films, seen by the job I did on each.</span>
            </h2>
          </div>
        </div>
        <ul class="crafts" data-reveal>
          {crafts.map((craft) => (
            <li class="surface craft">
              <div class="craft-media">
                <SmartImage src={craft.image} alt={`${craft.title} at work`} class="craft-img" loading="lazy" />
                <span class="craft-shade" aria-hidden="true"></span>
                <h3 class="craft-title">{craft.title}</h3>
              </div>
              <ul class="craft-films">
                {craft.films.map((name) => {
                  const f = filmByTitle(name);
                  return (
                    <li>
                      {f ? (
                        <a href={filmPath(f.slug)} class="craft-film">
                          <span>{name}</span>
                          <span class="t-meta">{yearLabel(f)}</span>
                        </a>
                      ) : (
                        <span class="craft-film">{name}</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Links -->
    <section id="links" class="section fm-links-sec" aria-labelledby="links-title">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <div class="sec-head-main">
            <h2 id="links-title" class="t-h2">
              Watch and read.
              <span class="t-tail">The playlist, the screenplay and the photography.</span>
            </h2>
          </div>
        </div>
        <ul class="links" data-reveal>
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noreferrer" class="surface link-card">
                <span class="link-icon" aria-hidden="true">
                  {l.icon === "imdb" && <span class="imdb-wordmark">IMDb</span>}
                  {l.icon === "instagram" && <Icon name="instagram" size={18} />}
                  {l.icon === "youtube" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                    </svg>
                  )}
                  {l.icon === "file" && (
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                      <path d="M14 2v4a2 2 0 0 0 2 2h4M16 13H8M16 17H8M10 9H8" />
                    </svg>
                  )}
                </span>
                <span class="min-w-0">
                  <span class="block t-h4">{l.title}</span>
                  <span class="block t-small mt-1">{l.line}</span>
                </span>
                <span class="link-arrow" aria-hidden="true">
                  <Icon name="arrow-up-right" size={16} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <StillViewer />
</BaseLayout>

<script>
  import { onPage } from "../scripts/lifecycle";

  onPage("filmmaking", (signal) => {
    const timeline = document.querySelector<HTMLElement>("[data-timeline]");
    if (!timeline) return;
    const html = document.documentElement;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // The timeline. Browsers with scroll driven animations tie each card's
    // rise to the scroll in CSS; the rest get the same arrival from an
    // observer.
    let io: IntersectionObserver | null = null;
    const timelines = typeof CSS !== "undefined" && CSS.supports?.("animation-timeline: view()");
    if (!timelines && !reduce && "IntersectionObserver" in window) {
      html.classList.add("fm-io");
      io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.classList.add("is-in");
            io?.unobserve(e.target);
          }),
        { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
      );
      timeline.querySelectorAll(".tl-card").forEach((el) => io?.observe(el));
    }

    // The stills strip: arrows step a screen at a time and dim at the ends.
    document.querySelectorAll<HTMLElement>("[data-strip]").forEach((strip) => {
      const track = strip.querySelector<HTMLElement>("[data-strip-track]");
      const prev = strip.querySelector<HTMLButtonElement>("[data-strip-prev]");
      const next = strip.querySelector<HTMLButtonElement>("[data-strip-next]");
      if (!track || !prev || !next) return;
      const step = (dir: number) =>
        track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: reduce ? "auto" : "smooth" });
      const ends = () => {
        prev.disabled = track.scrollLeft < 4;
        next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
      };
      prev.addEventListener("click", () => step(-1), { signal });
      next.addEventListener("click", () => step(1), { signal });
      track.addEventListener("scroll", ends, { passive: true, signal });
      window.addEventListener("resize", ends, { passive: true, signal });
      ends();
    });

    return () => {
      io?.disconnect();
      html.classList.remove("fm-io");
    };
  });
</script>

<style>
  /* =========================================================================
     Red space below the reel: crimson haze, title cards on red fields, and
     frames in letterbox. Gradients and transforms only, and no backdrop
     blur anywhere on this page, so phones stay light.
     ========================================================================= */
  .fm {
    --crimson: 244, 63, 94;
    --blood: 159, 18, 57;
    --ember: 255, 99, 122;
    position: relative;
    overflow-x: clip;
  }

  /* Quiet haze behind a section, so the red carries down the page. */
  .fm-haze { position: absolute; pointer-events: none; z-index: 0; border-radius: 50%; }
  .fm-haze-left {
    width: 60vw;
    height: 60vw;
    left: -30vw;
    top: 30%;
    background: radial-gradient(closest-side, rgba(var(--blood), 0.28), rgba(var(--blood), 0.16) 35%, rgba(var(--blood), 0.07) 62%, rgba(var(--blood), 0.015) 85%, rgba(var(--blood), 0));
  }
  .fm-haze-right {
    width: 54vw;
    height: 54vw;
    right: -26vw;
    top: -10%;
    background: radial-gradient(closest-side, rgba(var(--crimson), 0.16), rgba(var(--crimson), 0.09) 38%, rgba(var(--crimson), 0.035) 66%, rgba(var(--crimson), 0.008) 86%, rgba(var(--crimson), 0));
  }

  /* The timeline ------------------------------------------------------- */
  .fm-group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 20px;
    padding-bottom: 14px;
    margin-bottom: clamp(36px, 5vw, 56px);
    border-bottom: 1px solid var(--line);
  }
  .tl { position: relative; list-style: none; margin: 0; padding: 0; }
  /* The spine the films hang from. */
  .tl::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 11px;
    width: 1px;
    background: linear-gradient(180deg, rgba(var(--crimson), 0) 0%, rgba(var(--crimson), 0.55) 6%, rgba(var(--crimson), 0.3) 70%, rgba(var(--crimson), 0) 100%);
  }
  .tl-item { position: relative; display: flex; pointer-events: none; padding-left: 36px; }
  .tl-item + .tl-item { margin-top: 36px; }
  .tl-card {
    pointer-events: auto;
    display: block;
    width: 100%;
    color: var(--ink);
    text-decoration: none;
    view-timeline: --tl block;
  }
  .tl-frame-wrap { position: relative; }
  .tl-mark {
    position: absolute;
    top: 50%;
    left: -25px;
    display: flex;
    align-items: center;
    gap: 10px;
    transform: translate(-50%, -50%);
  }
  .tl-dot {
    width: 9px;
    height: 9px;
    border-radius: 9999px;
    background: var(--tone);
    box-shadow: 0 0 0 4px rgba(var(--crimson), 0.16), 0 0 14px rgba(var(--crimson), 0.9);
    flex: none;
  }
  .tl-year { display: none; font-size: 0.8125rem; font-weight: 500; color: var(--ink-soft); font-variant-numeric: tabular-nums; white-space: nowrap; }

  @media (min-width: 900px) {
    .tl::before { left: 50%; }
    .tl-item { padding-left: 0; }
    .tl-item[data-side="right"] { justify-content: flex-end; }
    /* Each film starts beside the one before it, so the list reads as a
       staggered reel rather than rows. */
    .tl-item + .tl-item { margin-top: calc(-13% - 20px); }
    .tl-card { width: calc(50% - 56px); }
    .tl-item[data-side="left"] .tl-mark { left: auto; right: -56px; transform: translate(50%, -50%); }
    .tl-item[data-side="right"] .tl-mark { left: -56px; transform: translate(-50%, -50%); flex-direction: row-reverse; }
    .tl-year { display: block; position: absolute; left: 22px; }
    .tl-item[data-side="right"] .tl-year { left: auto; right: 22px; }
  }

  .tl-glow {
    position: absolute;
    inset: -14% -8%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(var(--crimson), 0.32), rgba(var(--crimson), 0.14) 50%, rgba(var(--crimson), 0.04) 78%, rgba(var(--crimson), 0));
    opacity: 0.5;
  }
  .tl-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    overflow: hidden;
    background: #050002;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 30px 60px -36px rgba(0, 0, 0, 0.95);
    transition: transform 600ms var(--ease-glass), box-shadow 400ms var(--ease-glass);
  }
  .tl-frame :global(.tl-img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .tl-veil { position: absolute; inset: 0; background: #000; opacity: 0; pointer-events: none; }
  .tl-card:hover .tl-frame { transform: translateY(-4px); box-shadow: 0 0 0 1px rgba(var(--crimson), 0.45), 0 0 40px -6px rgba(var(--crimson), 0.45), 0 30px 60px -36px rgba(0, 0, 0, 0.95); }
  .tl-card:focus-visible { outline: none; }
  .tl-card:focus-visible .tl-frame { box-shadow: 0 0 0 3px rgba(var(--crimson), 0.8); }

  .tl-meta { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 16px 2px 0; }
  .tl-title { font-size: clamp(1.125rem, 1.6vw, 1.375rem); font-weight: 600; letter-spacing: -0.022em; line-height: 1.2; color: var(--ink); }
  .tl-when { margin-top: 4px; }
  .tl-roles { margin-top: 6px; font-size: 0.9375rem; color: var(--ink-soft); }
  .tl-go {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9999px;
    color: var(--ink-faint);
    border: 1px solid var(--line);
    transition: color 200ms var(--ease-glass), border-color 200ms var(--ease-glass), transform 300ms var(--ease-glass);
  }
  .tl-card:hover .tl-go { color: var(--tone); border-color: rgba(var(--crimson), 0.5); transform: translateX(3px); }

  /* Arrival. Tied to scroll where the browser can; an observer otherwise. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .tl-card { animation: tl-rise linear both; animation-timeline: --tl; animation-range: entry 0% cover 34%; }
      .tl-veil { animation: tl-light linear both; animation-timeline: --tl; animation-range: entry 10% cover 46%; }
      .tl-glow { animation: tl-glow linear both; animation-timeline: --tl; animation-range: entry 20% cover 55%; }
      .tc-sun { animation: tc-rise linear both; animation-timeline: --tl; animation-range: entry 10% cover 50%; }
    }
  }
  @keyframes tl-rise {
    from { opacity: 0; transform: translateY(90px) scale(0.9); }
    to { opacity: 1; transform: none; }
  }
  @keyframes tl-light { from { opacity: 0.85; } to { opacity: 0; } }
  @keyframes tl-glow { from { opacity: 0; } 70% { opacity: 1; } to { opacity: 0.6; } }
  @keyframes tc-rise {
    from { opacity: 0.15; transform: translate(-50%, -38%) scale(0.82); }
    to { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }
  :global(html.fm-io) .tl-card { transition: opacity 900ms var(--ease-glass), transform 900ms var(--ease-glass); }
  :global(html.fm-io) .tl-card:not(.is-in) { opacity: 0; transform: translateY(70px) scale(0.93); }
  :global(html.fm-io) .tl-veil { transition: opacity 1200ms var(--ease-glass) 200ms; }
