      radial-gradient(1.5px 1.5px at 91% 68%, rgba(255, 140, 160, 0.8), transparent),
      radial-gradient(1px 1px at 22% 48%, rgba(255, 235, 238, 0.5), transparent),
      radial-gradient(1px 1px at 72% 58%, rgba(255, 235, 238, 0.5), transparent);
