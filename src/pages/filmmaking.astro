  }
  .tc-sun {
    position: absolute;
    left: var(--sx);
    top: var(--sy);
    width: 34cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle closest-side, #060002 0%, #060002 88%, rgba(255, 180, 192, 0.9) 90%, rgba(var(--ember), 0.6) 92%, rgba(var(--crimson), 0.26) 95%, rgba(var(--crimson), 0.08) 98%, rgba(var(--crimson), 0) 100%);
    box-shadow: 0 0 7cqw rgba(var(--crimson), 0.22);
  }
  .tc-title {
    position: relative;
    z-index: 1;
    padding: 0 8%;
    text-align: center;
    font-size: clamp(1.25rem, 8.4cqw, 6rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: #fff;
    text-wrap: balance;
    text-shadow: 0 0 2.4cqw rgba(var(--crimson), 0.55), 0 2px 18px rgba(0, 0, 0, 0.7);
