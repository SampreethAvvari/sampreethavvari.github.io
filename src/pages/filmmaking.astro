---
// The filmmaking page. Among Monsters leads as the coming feature, the rest
// of the slate arrives as you scroll, then frames from the film, the jobs I
// do on set and where to watch and read. Every film has its own page; the
// facts for all of them live in src/data/films.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import SmartImage from "../components/common/SmartImage.astro";
import Icon from "../components/common/Icon.astro";
import {
  films,
  crafts,
  filmPath,
  filmBySlug,
  filmByTitle,
  filmStills,
  yearLabel,
  rolesLine,
  photographyUrl,
  type Film,
} from "../data/films";
import { filmNodes, itemListNode } from "../utils/seo";

const title = "SA: Filmmaking";
const description =
  "Films by Sampreeth Avvari. Among Monsters, an independent crime drama shot in New York, plus the full slate, stills, cast and crew.";

const feature = filmBySlug("among-monsters")!;
const { imdb, screenplay, playlist } = feature.links!;
const stills = filmStills(feature);
const keyCreators = feature.credits?.find((g) => g.label === "Above the line")?.people ?? [];
// The logline's first sentence carries the film on its own.
const loglineLead = (feature.logline!.match(/^.+?[.!?](?=\s|$)/) || [feature.logline!])[0];

const featureFacts = [
  { label: "Year", value: feature.year! },
  { label: "Status", value: feature.statusNote! },
  { label: "Shot", value: `${feature.shot!.place}, ${feature.shot!.when}` },
  { label: "Genre", value: feature.genre! },
];

// The reel: each film's poster, a frame from it, or a title card. A title
// card is plainly a card (the title set in type on a red field between
// letterbox bars), never dressed up as a poster.
const swechcha = filmBySlug("swechcha")!;
const swechchaFrame = filmStills(swechcha)[4] ?? filmStills(swechcha)[0];
const art = (film: Film) =>
  film.poster ? "poster" : film.slug === "swechcha" && swechchaFrame ? "still" : "card";
// Where each card's nebula and eclipse sit, so no two cards look alike.
const SEEDS = [
  [24, 40, 76, 58],
  [70, 34, 26, 66],
  [36, 64, 78, 30],
  [78, 56, 22, 38],
  [50, 28, 30, 70],
  [26, 60, 70, 36],
  [62, 66, 34, 30],
  [40, 32, 74, 64],
  [72, 44, 24, 56],
];
const metaLine = (film: Film) =>
  film.status === "dated"
    ? yearLabel(film)
    : `${yearLabel(film)} · ${film.statusNote ?? (film.status === "upcoming" ? "Upcoming" : "Released")}`;

const instagramUrl = (handle?: string) => (handle ? `https://instagram.com/${handle.replace(/^@/, "")}` : "");
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .filter(Boolean)
    .slice(0, 2)
    .join("")
    .toUpperCase();

const links = [
  { title: "Among Monsters playlist", line: "The film's playlist on YouTube.", href: playlist!, icon: "youtube" },
  { title: "Screenplay", line: "Read the Among Monsters script as a PDF.", href: screenplay!, icon: "file" },
  { title: "Photography", line: "My photography page on Instagram.", href: photographyUrl, icon: "instagram" },
  { title: "IMDb", line: "Among Monsters on IMDb.", href: imdb!, icon: "imdb" },
];

const base = Astro.site!.toString();
---

<BaseLayout
  title={title}
  description={description}
  footerVariant="filmmaking"
  ogImage="/og/film.jpg"
  preloadImage="/among-monsters-poster.avif"
  schema={[
    ...filmNodes(base),
    itemListNode(base, "/filmmaking", "Films by Sampreeth Avvari", films.map((f) => ({ name: f.title, path: filmPath(f.slug) }))),
  ]}
  crumbs={[{ name: "Home", path: "/" }, { name: "Filmmaking", path: "/filmmaking" }]}
>
  <div class="fm">
    <!-- The coming feature -->
    <section id="among-monsters" class="fm-hero" aria-labelledby="fm-title">
      <div class="fm-space" aria-hidden="true">
        <span class="fm-nebula fm-nebula-a"></span>
        <span class="fm-nebula fm-nebula-b"></span>
        <span class="fm-beam"></span>
        <canvas class="fm-dust" data-fm-dust></canvas>
      </div>

      <div class="wrap">
        <div class="fm-stage">
          <div class="fm-hero-top">
            <p class="kicker">Film</p>
            <div class="fm-badges">
              <span class="badge badge-tone">Current feature</span>
              <span class="badge">Premieres 2026</span>
            </div>
          </div>

          <div class="fm-screen-wrap">
            <span class="fm-sun" aria-hidden="true"><span class="fm-corona"></span></span>
            <a href={filmPath(feature.slug)} class="fm-screen" aria-label="Among Monsters, open the film's page">
              <SmartImage
                src={feature.poster!.src}
                alt={feature.poster!.alt}
                class="fm-screen-img"
                loading="eager"
                fetchpriority="high"
              />
            </a>
            <span class="fm-floor" aria-hidden="true"></span>
          </div>

          <div class="fm-credits">
            <div>
              <h1 id="fm-title" class="fm-title">Among Monsters</h1>
              <p class="fm-roles">
                <span class="fm-label">My roles</span>
                {rolesLine(feature)}
              </p>
            </div>
            <p class="fm-logline">{loglineLead}</p>
          </div>
          <div class="fm-actions">
            <a href="#stills" class="btn btn-primary">
              See the stills <Icon name="arrow-down" size={15} />
            </a>
            <a href={screenplay} target="_blank" rel="noreferrer" class="btn btn-tone">Read the screenplay</a>
            <a href={imdb} target="_blank" rel="noreferrer" class="btn btn-ghost">
              <span class="imdb-wordmark">IMDb</span> On IMDb
              <Icon name="arrow-up-right" size={15} class="arrow-ur" />
            </a>
            <a href={playlist} target="_blank" rel="noreferrer" class="btn btn-ghost">
              Watch the playlist <Icon name="arrow-up-right" size={15} class="arrow-ur" />
            </a>
          </div>

          <dl class="fm-facts">
            {featureFacts.map((f) => (
              <div class="fm-fact">
                <dt class="t-meta">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- The slate, one film at a time -->
    <section id="slate" class="section fm-slate" aria-labelledby="slate-title">
      <span class="fm-haze fm-haze-left" aria-hidden="true"></span>
      <div class="wrap on-top">
        <div class="sec-head" data-reveal>
          <div class="sec-head-main">
            <h2 id="slate-title" class="t-h2">
              Gray characters and tight spaces.
              <span class="t-tail">The chaos hiding inside ordinary lives.</span>
            </h2>
            <p class="t-lede">
              I write, direct, edit and score. Among Monsters is the independent
              crime drama I made in New York, and the rest of the slate goes back
              to 2019.
            </p>
          </div>
        </div>

        <div class="fm-group-head" data-reveal>
          <p class="t-h4">Nine films, in order</p>
          <p class="t-meta">Some are out, some are in the cut, some are still pages.</p>
        </div>

        <ol class="reel">
          {films.map((film, i) => {
            const [nx, ny, sx, sy] = SEEDS[i % SEEDS.length];
            const kind = art(film);
            return (
              <li class="reel-item" data-side={i % 2 ? "right" : "left"}>
                <a href={filmPath(film.slug)} class="reel-card">
                  <div class="reel-frame-wrap">
                    <span class="reel-mark" aria-hidden="true">
                      <span class="reel-dot"></span>
                      <span class="reel-year">{yearLabel(film)}</span>
                    </span>
                    <span class="reel-glow" aria-hidden="true"></span>
                    <div class="reel-frame">
                      {kind === "poster" ? (
                        <SmartImage src={film.poster!.src} alt={`${film.title} poster`} class="reel-img" loading="lazy" />
                      ) : (
                        <div
                          class:list={["tc", kind === "still" && "tc-has-still"]}
                          style={`--nx:${nx}%;--ny:${ny}%;--sx:${sx}%;--sy:${sy}%;`}
                        >
                          <span class="tc-bar" aria-hidden="true">{film.year ?? "In development"}</span>
                          <span class="tc-field">
                            {kind === "still" ? (
                              <SmartImage src={swechchaFrame!.src} alt={swechchaFrame!.alt} class="tc-still" loading="lazy" />
                            ) : (
                              <span class="tc-sun" aria-hidden="true"></span>
                            )}
                            <span class="tc-dust" aria-hidden="true"></span>
                            <span class="tc-title" aria-hidden="true">{film.title}</span>
                          </span>
                          <span class="tc-bar" aria-hidden="true">{rolesLine(film)}</span>
                        </div>
                      )}
                      <span class="reel-veil" aria-hidden="true"></span>
                    </div>
                  </div>
                  <div class="reel-meta">
                    <div class="min-w-0">
                      <h3 class="reel-title">{film.title}</h3>
                      <p class="t-meta reel-when">{metaLine(film)}</p>
                      <p class="reel-roles">{rolesLine(film)}</p>
                    </div>
                    <span class="reel-go" aria-hidden="true"><Icon name="arrow-right" size={16} /></span>
                  </div>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <!-- Frames from the film -->
    <section id="stills" class="section fm-stills" aria-labelledby="stills-title">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <div class="sec-head-main">
            <h2 id="stills-title" class="t-h2">
              On set.
              <span class="t-tail">Frames from Among Monsters.</span>
            </h2>
          </div>
          <a href={`${filmPath(feature.slug)}#stills`} class="tlink">
            All {stills.length} stills, cast and crew <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      {stills.length ? (
        <div class="strip" data-strip>
          <ul class="strip-track" data-strip-track aria-label={`Among Monsters, ${stills.length} stills`}>
            {stills.map((item, i) => (
              <li class="strip-item">
                <button
                  type="button"
                  class="strip-still"
                  data-still
                  data-group="am"
                  data-index={i}
                  data-full={item.src}
                  data-caption="Among Monsters"
                  aria-label={`View still ${i + 1} of ${stills.length} from Among Monsters`}
                >
                  <SmartImage src={item.src} alt={item.alt} class="strip-img" loading="lazy" />
                </button>
              </li>
            ))}
          </ul>
          <div class="wrap strip-ctrl">
            <span class="t-meta">{stills.length} stills · open any frame to see it whole</span>
            <div class="strip-btns">
              <button type="button" class="strip-btn" data-strip-prev aria-label="Earlier stills">
                <Icon name="arrow-left" size={16} />
              </button>
              <button type="button" class="strip-btn" data-strip-next aria-label="Later stills">
                <Icon name="arrow-right" size={16} />
              </button>
            </div>
          </div>
        </div>
      ) : (
        <div class="wrap"><p class="t-small">Stills coming soon.</p></div>
      )}

      <div class="wrap">
        <div class="fm-team" data-reveal>
          <p class="t-meta fm-team-label">Made with</p>
          <ul class="fm-team-list">
            {keyCreators.map((p) => {
              const Tag = p.instagram ? "a" : "div";
              const linkProps = p.instagram
                ? { href: instagramUrl(p.instagram), target: "_blank", rel: "noreferrer", "aria-label": `${p.name} on Instagram` }
                : {};
              return (
                <li>
                  <Tag class="fm-person" {...linkProps}>
                    <span class="fm-person-face">
                      {p.photo ? (
                        <SmartImage src={p.photo} alt={`${p.name} portrait`} class="fm-person-img" loading="lazy" />
                      ) : (
                        <span aria-hidden="true">{initials(p.name)}</span>
                      )}
                    </span>
                    <span class="min-w-0">
                      <span class="block fm-person-name">{p.name}</span>
                      <span class="block t-meta">{p.role}</span>
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>
          <a href={`${filmPath(feature.slug)}#cast`} class="tlink fm-team-more">
            Full cast and crew <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </section>

    <!-- The jobs -->
    <section id="crafts" class="section fm-crafts" aria-labelledby="crafts-title">
      <span class="fm-haze fm-haze-right" aria-hidden="true"></span>
      <div class="wrap on-top">
        <div class="sec-head" data-reveal>
          <div class="sec-head-main">
            <h2 id="crafts-title" class="t-h2">
              Five jobs on set.
              <span class="t-tail">The same films, seen by the job I did on each.</span>
            </h2>
          </div>
        </div>
        <ul class="crafts" data-reveal>
          {crafts.map((craft) => (
            <li class="surface craft">
              <div class="craft-media">
                <SmartImage src={craft.image} alt={`${craft.title} at work`} class="craft-img" loading="lazy" />
                <span class="craft-shade" aria-hidden="true"></span>
                <h3 class="craft-title">{craft.title}</h3>
              </div>
              <ul class="craft-films">
                {craft.films.map((name) => {
                  const f = filmByTitle(name);
                  return (
                    <li>
                      {f ? (
                        <a href={filmPath(f.slug)} class="craft-film">
                          <span>{name}</span>
                          <span class="t-meta">{yearLabel(f)}</span>
                        </a>
                      ) : (
                        <span class="craft-film">{name}</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Links -->
    <section id="links" class="section fm-links-sec" aria-labelledby="links-title">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <div class="sec-head-main">
            <h2 id="links-title" class="t-h2">
              Watch and read.
              <span class="t-tail">The playlist, the screenplay and the photography.</span>
            </h2>
          </div>
        </div>
        <ul class="links" data-reveal>
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noreferrer" class="surface link-card">
                <span class="link-icon" aria-hidden="true">
                  {l.icon === "imdb" && <span class="imdb-wordmark">IMDb</span>}
                  {l.icon === "instagram" && <Icon name="instagram" size={18} />}
                  {l.icon === "youtube" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                    </svg>
                  )}
                  {l.icon === "file" && (
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                      <path d="M14 2v4a2 2 0 0 0 2 2h4M16 13H8M16 17H8M10 9H8" />
                    </svg>
                  )}
                </span>
                <span class="min-w-0">
                  <span class="block t-h4">{l.title}</span>
                  <span class="block t-small mt-1">{l.line}</span>
                </span>
                <span class="link-arrow" aria-hidden="true">
                  <Icon name="arrow-up-right" size={16} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <!-- Still viewer -->
  <div id="flb" class="lb" hidden role="dialog" aria-modal="true" aria-label="Still viewer">
    <div class="lb-backdrop" data-lb-close></div>
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Close viewer">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
    <figure class="lb-stage">
      <img id="flb-img" class="lb-img" alt="" />
      <figcaption class="lb-cap">
        <span id="flb-cap" class="t-small"></span>
      </figcaption>
    </figure>
    <div class="lb-bar">
      <button type="button" class="lb-btn" data-lb-prev aria-label="Previous still">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <span id="flb-count" class="t-meta lb-count" aria-live="polite"></span>
      <button type="button" class="lb-btn" data-lb-next aria-label="Next still">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Star dust over the feature: one small 2D canvas. Motes drift up slowly
  // and twinkle; it sleeps when the feature is off screen or the tab is
  // hidden, and draws one still frame for people who asked for less motion.
  const dust = document.querySelector<HTMLCanvasElement>("[data-fm-dust]");
  const ctx = dust?.getContext("2d");
  if (dust && ctx) {
    const phone = window.matchMedia("(max-width: 767px)").matches;
    const dprCap = phone ? 1.5 : 2;
    type Mote = { x: number; y: number; r: number; a: number; tw: number; ts: number; vx: number; vy: number; red: boolean };
    const spawn = (anywhere: boolean): Mote => ({
      x: Math.random(),
      y: anywhere ? Math.random() : 1.02,
      r: Math.random() ** 2.2 * 1.5 + 0.35,
      a: 0.25 + Math.random() * 0.7,
      tw: Math.random() * Math.PI * 2,
      ts: 0.5 + Math.random() * 1.4,
      vx: (Math.random() - 0.5) * 0.006,
      vy: -(0.003 + Math.random() * 0.01),
      red: Math.random() < 0.4,
    });
    const motes = Array.from({ length: phone ? 70 : 160 }, () => spawn(true));
    let w = 0;
    let h = 0;
    const resize = () => {
      const rect = dust.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, dprCap);
      w = rect.width;
      h = rect.height;
      dust.width = Math.max(1, Math.round(w * dpr));
      dust.height = Math.max(1, Math.round(h * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const draw = (t: number, dt: number) => {
      ctx.clearRect(0, 0, w, h);
      for (const m of motes) {
        m.x += m.vx * dt;
        m.y += m.vy * dt;
        if (m.y < -0.02 || m.x < -0.02 || m.x > 1.02) Object.assign(m, spawn(false), { x: Math.random() });
        // Fade out toward the bottom of the feature so the dust has no edge.
        const fade = Math.max(0, Math.min(1, (1 - m.y) / 0.3));
        const twinkle = 0.55 + 0.45 * Math.sin(t * m.ts + m.tw);
        ctx.globalAlpha = m.a * twinkle * fade;
        ctx.fillStyle = m.red ? "#ff5d78" : "#ffe6ea";
        ctx.beginPath();
        ctx.arc(m.x * w, m.y * h, m.r, 0, Math.PI * 2);
        ctx.fill();
        if (m.r > 1.3) {
          ctx.globalAlpha *= 0.18;
          ctx.beginPath();
          ctx.arc(m.x * w, m.y * h, m.r * 3.2, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    };

    let running = false;
    let onScreen = true;
    let last = 0;
    let raf = 0;
    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000 || 0);
      last = now;
      draw(now / 1000, dt);
      raf = requestAnimationFrame(frame);
    };
    const sync = () => {
      const want = !reduce && onScreen && !document.hidden;
      if (want && !running) {
        running = true;
        last = performance.now();
        raf = requestAnimationFrame(frame);
      } else if (!want && running) {
        running = false;
        cancelAnimationFrame(raf);
      }
    };
    resize();
    draw(0, 0);
    new ResizeObserver(() => {
      resize();
      if (!running) draw(performance.now() / 1000, 0);
    }).observe(dust);
    new IntersectionObserver((entries) => {
      onScreen = entries[0]?.isIntersecting ?? true;
      sync();
    }).observe(dust);
    document.addEventListener("visibilitychange", sync);
    sync();
  }

  // The reel. Browsers with scroll driven animations tie each card's rise to
  // the scroll in CSS; the rest get the same arrival from an observer.
  const timelines = typeof CSS !== "undefined" && CSS.supports?.("animation-timeline: view()");
  if (!timelines && !reduce && "IntersectionObserver" in window) {
    document.documentElement.classList.add("fm-io");
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add("is-in");
          io.unobserve(e.target);
        }),
      { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
    );
    document.querySelectorAll(".reel-card").forEach((el) => io.observe(el));
  }

  // The stills strip: arrows step a screen at a time and dim at the ends.
  document.querySelectorAll<HTMLElement>("[data-strip]").forEach((strip) => {
    const track = strip.querySelector<HTMLElement>("[data-strip-track]");
    const prev = strip.querySelector<HTMLButtonElement>("[data-strip-prev]");
    const next = strip.querySelector<HTMLButtonElement>("[data-strip-next]");
    if (!track || !prev || !next) return;
    const step = (dir: number) =>
      track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: reduce ? "auto" : "smooth" });
    const ends = () => {
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
    };
    prev.addEventListener("click", () => step(-1));
    next.addEventListener("click", () => step(1));
    track.addEventListener("scroll", ends, { passive: true });
    window.addEventListener("resize", ends, { passive: true });
    ends();
  });

  // A calm viewer for the stills: click to open, arrows or swipe to move,
  // Escape or the backdrop to close. Focus stays inside while it is open and
  // goes back to the still you opened.
  const lb = document.getElementById("flb");
  const img = document.getElementById("flb-img") as HTMLImageElement | null;
  const cap = document.getElementById("flb-cap");
  const count = document.getElementById("flb-count");

  type Item = { src: string; caption: string; alt: string };
  let items: Item[] = [];
  let cursor = 0;
  let opener: HTMLElement | null = null;

  const collect = (group: string): Item[] =>
    Array.from(document.querySelectorAll<HTMLElement>(`[data-still][data-group="${group}"]`)).map((el) => ({
      src: el.dataset.full || "",
      caption: el.dataset.caption || "",
      alt: el.querySelector("img")?.getAttribute("alt") || "",
    }));
  const preload = (i: number) => {
    const it = items[i];
    if (it) new Image().src = it.src;
  };
  const render = () => {
    if (!img || !cap || !count) return;
    const it = items[cursor];
    if (!it) return;
    img.classList.remove("is-in");
    img.onload = () => img.classList.add("is-in");
    img.src = it.src;
    img.alt = it.alt;
    cap.textContent = it.caption;
    count.textContent = `${cursor + 1} / ${items.length}`;
    preload(cursor + 1);
    preload(cursor - 1);
  };
  const open = (el: HTMLElement) => {
    if (!lb) return;
    opener = el;
    items = collect(el.dataset.group || "");
    cursor = Math.min(Math.max(Number(el.dataset.index || 0), 0), items.length - 1);
    lb.hidden = false;
    requestAnimationFrame(() => lb.classList.add("is-open"));
    document.documentElement.classList.add("lb-lock");
    render();
    lb.querySelector<HTMLElement>(".lb-close")?.focus();
  };
  const close = () => {
    if (!lb || lb.hidden) return;
    lb.classList.remove("is-open");
    document.documentElement.classList.remove("lb-lock");
    window.setTimeout(() => {
      lb.hidden = true;
    }, 220);
    opener?.focus();
  };
  const step = (delta: number) => {
    if (!items.length) return;
    cursor = (cursor + delta + items.length) % items.length;
    render();
  };

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const still = target.closest<HTMLElement>("[data-still]");
    if (still) {
      open(still);
      return;
    }
    if (target.closest("[data-lb-close]")) close();
    if (target.closest("[data-lb-prev]")) step(-1);
    if (target.closest("[data-lb-next]")) step(1);
  });
  document.addEventListener("keydown", (e) => {
    if (!lb || lb.hidden) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") step(-1);
    if (e.key === "ArrowRight") step(1);
    if (e.key === "Tab") {
      const stops = Array.from(lb.querySelectorAll<HTMLElement>("button"));
      const at = stops.indexOf(document.activeElement as HTMLElement);
      e.preventDefault();
      stops[(at + (e.shiftKey ? -1 : 1) + stops.length) % stops.length]?.focus();
    }
  });
  let touchX: number | null = null;
  lb?.addEventListener("touchstart", (e) => (touchX = e.touches[0]?.clientX ?? null), { passive: true });
  lb?.addEventListener(
    "touchend",
    (e) => {
      if (touchX === null) return;
      const dx = (e.changedTouches[0]?.clientX ?? touchX) - touchX;
      if (Math.abs(dx) > 48) step(dx < 0 ? 1 : -1);
      touchX = null;
    },
    { passive: true },
  );
</script>

<style>
