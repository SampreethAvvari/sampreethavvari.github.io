---
// The filmmaking page. Among Monsters leads as the coming feature, the rest
// of the slate arrives as you scroll, then frames from the film, the jobs I
// do on set and where to watch and read. Every film has its own page; the
// facts for all of them live in src/data/films.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import SmartImage from "../components/common/SmartImage.astro";
import Icon from "../components/common/Icon.astro";
import Reel from "../components/film/Reel.astro";
import StillViewer from "../components/film/StillViewer.astro";
import FilmStrip from "../components/film/FilmStrip.astro";
import {
  films,
  crafts,
  filmPath,
  filmBySlug,
  filmByTitle,
  filmStills,
  yearLabel,
  photographyUrl,
  reelItems,
} from "../data/films";
import { filmNodes, itemListNode } from "../utils/seo";
import { coverSizes } from "../utils/optimizedImage";

const title = "SA: Filmmaking";
const description =
  "Films by Sampreeth Avvari. Among Monsters, an independent crime drama shot in New York, plus the full slate, stills, cast and crew.";

const feature = filmBySlug("among-monsters")!;
const { imdb, screenplay, playlist } = feature.links!;
const stills = filmStills(feature);
const keyCreators = feature.credits?.find((g) => g.label === "Above the line")?.people ?? [];

// The reel at the top: one film per screen, its clip, its stills or its
// title card. The rest of the slate follows on a strip below it.
const reel = reelItems();
const rest = films.filter((f) => !reel.some((r) => r.slug === f.slug)).map((f) => f.slug);
const reelPreload = reel[0]?.poster?.replace(/\.(jpe?g|webp|png)$/i, ".avif");

const instagramUrl = (handle?: string) => (handle ? `https://instagram.com/${handle.replace(/^@/, "")}` : "");
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .filter(Boolean)
    .slice(0, 2)
    .join("")
    .toUpperCase();

const links = [
  { title: "Among Monsters playlist", line: "The film's playlist on YouTube.", href: playlist!, icon: "youtube" },
  { title: "Screenplay", line: "Read the Among Monsters script as a PDF.", href: screenplay!, icon: "file" },
  { title: "Photography", line: "My photography page on Instagram.", href: photographyUrl, icon: "instagram" },
  { title: "IMDb", line: "Among Monsters on IMDb.", href: imdb!, icon: "imdb" },
];

const base = Astro.site!.toString();
---

<BaseLayout
  title={title}
  description={description}
  footerVariant="filmmaking"
  ogImage="/og/film.jpg"
  preloadImage={reelPreload?.endsWith(".avif") ? reelPreload : undefined}
  schema={[
    ...filmNodes(base),
    itemListNode(base, "/filmmaking", "Films by Sampreeth Avvari", films.map((f) => ({ name: f.title, path: filmPath(f.slug) }))),
  ]}
  crumbs={[{ name: "Home", path: "/" }, { name: "Filmmaking", path: "/filmmaking" }]}
>
  <div class="fm">
    <!-- The reel: one film per screen -->
    <Reel items={reel} after="#slate" />

    <!-- The slate: one strip of film -->
    <section id="slate" class="section fm-slate" aria-labelledby="slate-title">
      <span class="fm-haze fm-haze-left" aria-hidden="true"></span>
      <div class="wrap on-top">
        <div class="sec-head fm-slate-head" data-reveal>
          <div class="sec-head-main">
            <h2 id="slate-title" class="t-h2">
              Gray characters and tight spaces.
              <span class="t-tail">The chaos hiding inside ordinary lives.</span>
            </h2>
            <p class="t-lede">
              I write, direct, shoot, edit and score. Making films since 2014, with
              nine credits since 2019. Among Monsters is the independent crime
              drama I made in New York.
            </p>
          </div>
        </div>
        <div class="fm-group-head" data-reveal>
          <div>
            <p class="t-h4">Also on the slate</p>
            <p class="t-meta">Six films in the reel above, {rest.length} more here.</p>
          </div>
          <div class="fm-strip-ctrl">
            <span class="t-meta fm-drag-hint">Drag, swipe or scroll sideways</span>
            <button type="button" class="strip-btn" data-fs-prev aria-label="Earlier on the strip">
              <Icon name="arrow-left" size={16} />
            </button>
            <button type="button" class="strip-btn" data-fs-next aria-label="Later on the strip">
              <Icon name="arrow-right" size={16} />
            </button>
          </div>
        </div>
      </div>
      <div class="on-top">
        <FilmStrip slugs={rest} start={reel.length + 1} />
      </div>
    </section>

    <!-- Frames from the film -->
    <section id="stills" class="section fm-stills" aria-labelledby="stills-title">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <div class="sec-head-main">
            <h2 id="stills-title" class="t-h2">
              On set.
              <span class="t-tail">Frames from Among Monsters.</span>
            </h2>
          </div>
          <a href={`${filmPath(feature.slug)}#stills`} class="tlink">
            All {stills.length} stills, cast and key crew <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>

      {stills.length ? (
        <div class="strip" data-strip>
          <ul class="strip-track" data-strip-track aria-label={`Among Monsters, ${stills.length} stills`}>
            {stills.map((item, i) => (
              <li class="strip-item">
                <button
                  type="button"
                  class="strip-still"
                  data-still
                  data-group="am"
                  data-index={i}
                  data-full={item.src}
                  data-caption="Among Monsters"
                  aria-label={`View still ${i + 1} of ${stills.length} from Among Monsters`}
                >
                  <SmartImage src={item.src} alt={item.alt} class="strip-img" loading="lazy" sizes="(min-width: 1024px) 700px, (min-width: 768px) 410px, 82vw" />
                </button>
              </li>
            ))}
          </ul>
          <div class="wrap strip-ctrl">
            <span class="t-meta">{stills.length} stills · open any frame to see it whole</span>
            <div class="strip-btns">
              <button type="button" class="strip-btn" data-strip-prev aria-label="Earlier stills">
                <Icon name="arrow-left" size={16} />
              </button>
              <button type="button" class="strip-btn" data-strip-next aria-label="Later stills">
                <Icon name="arrow-right" size={16} />
              </button>
            </div>
          </div>
        </div>
      ) : (
        <div class="wrap"><p class="t-small">Stills coming soon.</p></div>
      )}

      <div class="wrap">
        <div class="fm-team" data-reveal>
          <p class="t-meta fm-team-label">Made with</p>
          <ul class="fm-team-list">
            {keyCreators.map((p) => {
              const Tag = p.instagram ? "a" : "div";
              const linkProps = p.instagram
                ? { href: instagramUrl(p.instagram), target: "_blank", rel: "noreferrer", "aria-label": `${p.name} on Instagram` }
                : {};
              return (
                <li>
                  <Tag class="fm-person" {...linkProps}>
                    <span class="fm-person-face">
                      {p.photo ? (
                        <SmartImage src={p.photo} alt={`${p.name} portrait`} class="fm-person-img" loading="lazy" sizes={coverSizes(p.photo, [[0, 44, 59]], 1.3)} />
                      ) : (
                        <span aria-hidden="true">{initials(p.name)}</span>
                      )}
                    </span>
                    <span class="min-w-0">
                      <span class="block fm-person-name">{p.name}</span>
                      <span class="block t-meta">{p.role}</span>
                    </span>
                  </Tag>
                </li>
              );
            })}
          </ul>
          <a href={`${filmPath(feature.slug)}#cast`} class="tlink fm-team-more">
            Cast and key crew <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </section>

    <!-- The jobs -->
    <section id="crafts" class="section fm-crafts" aria-labelledby="crafts-title">
      <span class="fm-haze fm-haze-right" aria-hidden="true"></span>
      <div class="wrap on-top">
        <div class="sec-head" data-reveal>
          <div class="sec-head-main">
            <h2 id="crafts-title" class="t-h2">
              The jobs I do on set.
              <span class="t-tail">The same films, seen by the job I did on each.</span>
            </h2>
          </div>
        </div>
        <ul class="crafts" data-reveal>
          {crafts.map((craft) => (
            <li class="surface craft">
              <div class:list={["craft-media", { "is-card": !craft.image }]}>
                {craft.image && <SmartImage src={craft.image} alt={`${craft.title} at work`} class="craft-img" loading="lazy" sizes={coverSizes(craft.image, [[1280, 198, 149], [900, 400, 300], [640, 343, 257], [0, 400, 300]], 1.05)} />}
                <span class="craft-shade" aria-hidden="true"></span>
                <h3 class="craft-title">{craft.title}</h3>
              </div>
              <ul class="craft-films">
                {craft.films.map((name) => {
                  const f = filmByTitle(name);
                  return (
                    <li>
                      {f ? (
                        <a href={filmPath(f.slug)} class="craft-film">
                          <span>{name}</span>
                          <span class="t-meta">{yearLabel(f)}</span>
                        </a>
                      ) : (
                        <span class="craft-film">{name}</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Links -->
    <section id="links" class="section fm-links-sec" aria-labelledby="links-title">
      <div class="wrap">
        <div class="sec-head" data-reveal>
          <div class="sec-head-main">
            <h2 id="links-title" class="t-h2">
              Watch and read.
              <span class="t-tail">The playlist, the screenplay and the photography.</span>
            </h2>
          </div>
        </div>
        <ul class="links" data-reveal>
          {links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noreferrer" class="surface link-card">
                <span class="link-icon" aria-hidden="true">
                  {l.icon === "imdb" && <span class="imdb-wordmark">IMDb</span>}
                  {l.icon === "instagram" && <Icon name="instagram" size={18} />}
                  {l.icon === "youtube" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                    </svg>
                  )}
                  {l.icon === "file" && (
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                      <path d="M14 2v4a2 2 0 0 0 2 2h4M16 13H8M16 17H8M10 9H8" />
                    </svg>
                  )}
                </span>
                <span class="min-w-0">
                  <span class="block t-h4">{l.title}</span>
                  <span class="block t-small mt-1">{l.line}</span>
                </span>
                <span class="link-arrow" aria-hidden="true">
                  <Icon name="arrow-up-right" size={16} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <StillViewer />
</BaseLayout>

<script>
  import { onPage } from "../scripts/lifecycle";

  onPage("filmmaking", (signal) => {
    if (!document.querySelector("[data-strip]")) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // The stills strip: arrows step a screen at a time and dim at the ends.
    document.querySelectorAll<HTMLElement>("[data-strip]").forEach((strip) => {
      const track = strip.querySelector<HTMLElement>("[data-strip-track]");
      const prev = strip.querySelector<HTMLButtonElement>("[data-strip-prev]");
      const next = strip.querySelector<HTMLButtonElement>("[data-strip-next]");
      if (!track || !prev || !next) return;
      const step = (dir: number) =>
        track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: reduce ? "auto" : "smooth" });
      const ends = () => {
        prev.disabled = track.scrollLeft < 4;
        next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
      };
      prev.addEventListener("click", () => step(-1), { signal });
      next.addEventListener("click", () => step(1), { signal });
      track.addEventListener("scroll", ends, { passive: true, signal });
      window.addEventListener("resize", ends, { passive: true, signal });
      ends();
    });

  });
</script>

<style>
  /* =========================================================================
     Red space below the reel: crimson haze, title cards on red fields, and
     frames in letterbox. Gradients and transforms only, and no backdrop
     blur anywhere on this page, so phones stay light.
     ========================================================================= */
  .fm {
    --crimson: 244, 63, 94;
    --blood: 159, 18, 57;
    --ember: 255, 99, 122;
    position: relative;
    overflow-x: clip;
  }

  /* Quiet haze behind a section, so the red carries down the page. */
  .fm-haze { position: absolute; pointer-events: none; z-index: 0; border-radius: 50%; }
  .fm-haze-left {
    width: 60vw;
    height: 60vw;
    left: -30vw;
    top: 30%;
    background: radial-gradient(closest-side, rgba(var(--blood), 0.28), rgba(var(--blood), 0.16) 35%, rgba(var(--blood), 0.07) 62%, rgba(var(--blood), 0.015) 85%, rgba(var(--blood), 0));
  }
  .fm-haze-right {
    width: 54vw;
    height: 54vw;
    right: -26vw;
    top: -10%;
    background: radial-gradient(closest-side, rgba(var(--crimson), 0.16), rgba(var(--crimson), 0.09) 38%, rgba(var(--crimson), 0.035) 66%, rgba(var(--crimson), 0.008) 86%, rgba(var(--crimson), 0));
  }

  /* The slate head: the strip below it fits in one screen. */
  .fm-slate { padding-bottom: clamp(48px, 6vw, 80px); }
  .fm-slate-head { margin-bottom: clamp(20px, 3vw, 32px); }
  .fm-group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px 20px;
    margin-bottom: 20px;
  }
  .fm-strip-ctrl { display: flex; align-items: center; gap: 8px; }
  .fm-drag-hint { margin-right: 6px; }
  @media (max-width: 639px) { .fm-drag-hint { display: none; } }

  /* Stills strip -------------------------------------------------------- */
  .fm-stills { overflow: clip; }
  .strip { position: relative; }
  .strip-track {
    --edge: max(var(--gutter), calc((100vw - var(--max)) / 2));
    list-style: none;
    margin: 0;
    display: flex;
    gap: 6px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: var(--edge);
    padding: 22px var(--edge);
    scrollbar-width: none;
    /* Film stock: sprocket holes along both edges, riding with the frames. */
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.13) 0 9px, transparent 9px 22px) 0 7px / 22px 8px repeat-x local,
      linear-gradient(90deg, rgba(255, 255, 255, 0.13) 0 9px, transparent 9px 22px) 0 calc(100% - 7px) / 22px 8px repeat-x local,
      #070204;
    border-block: 1px solid rgba(var(--crimson), 0.16);
  }
  .strip-track::-webkit-scrollbar { display: none; }
  .strip-item { flex: none; scroll-snap-align: start; }
  .strip-still {
    display: block;
    height: clamp(132px, 22vw, 290px);
    aspect-ratio: 2.39 / 1;
    padding: 0;
    border: 0;
    border-radius: 3px;
    overflow: hidden;
    background: #050002;
    cursor: zoom-in;
    view-timeline: --frame inline;
    transition: box-shadow 300ms var(--ease-glass);
  }
  .strip-still :global(.strip-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-glass), filter 500ms var(--ease-glass);
  }
  .strip-still:hover :global(.strip-img) { transform: scale(1.04); }
  .strip-still:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--crimson), 0.8); }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .strip-still :global(.strip-img) { animation: frame-light linear both; animation-timeline: --frame; animation-range: entry 0% cover 30%; }
    }
  }
  @keyframes frame-light { from { filter: brightness(0.35) saturate(0.6); } to { filter: none; } }
  .strip-ctrl { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-top: 16px; }
  .strip-btns { display: flex; gap: 8px; }
  .strip-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    color: var(--ink);
    background: rgba(18, 8, 11, 0.9);
    border: 1px solid var(--line-strong);
    cursor: pointer;
    transition: border-color 150ms var(--ease-glass), color 150ms var(--ease-glass), opacity 200ms var(--ease-glass);
  }
  .strip-btn:hover:not(:disabled) { border-color: rgba(var(--crimson), 0.6); color: var(--tone); }
  .strip-btn:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--crimson), 0.6); }
  .strip-btn:disabled { opacity: 0.35; cursor: default; }

  /* The key creators, a short line under the stills. */
  .fm-team {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: clamp(36px, 5vw, 56px);
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .fm-team-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 28px; }
  .fm-person { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); }
  .fm-person-face {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    overflow: hidden;
    background: #12070a;
    box-shadow: 0 0 0 1px var(--line-strong);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-faint);
    transition: box-shadow 200ms var(--ease-glass);
  }
  .fm-person-face :global(picture), .fm-person-face :global(.fm-person-img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .fm-person-name { font-size: 0.9375rem; font-weight: 600; letter-spacing: -0.012em; }
  a.fm-person:hover .fm-person-face { box-shadow: 0 0 0 2px rgba(var(--crimson), 0.7); }
  a.fm-person:focus-visible { outline: none; }
  a.fm-person:focus-visible .fm-person-face { box-shadow: 0 0 0 3px rgba(var(--crimson), 0.8); }
  .fm-team-more { margin-left: auto; }
  @media (max-width: 639px) { .fm-team-more { margin-left: 0; } }

  /* Crafts -------------------------------------------------------------- */
  .crafts { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .crafts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 900px) { .crafts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1280px) { .crafts { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 18px; } }
  .craft { overflow: hidden; display: flex; flex-direction: column; }
  .craft-media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: #050002; }
  /* A job with no photo of its own: the title on the film's dark, like a title card. */
  .craft-media.is-card { background: radial-gradient(120% 100% at 22% 16%, rgba(var(--crimson), 0.2), transparent 62%), #050002; }
  .craft-media :global(picture) { display: block; width: 100%; height: 100%; }
  .craft-media :global(.craft-img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.7) brightness(0.8);
    transition: filter 500ms var(--ease-glass), transform 700ms var(--ease-glass);
  }
  .craft:hover .craft-media :global(.craft-img) { filter: none; transform: scale(1.03); }
  .craft-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(5, 0, 2, 0.88) 0%, rgba(5, 0, 2, 0.3) 45%, rgba(5, 0, 2, 0) 70%), linear-gradient(180deg, rgba(var(--blood), 0.25), rgba(var(--blood), 0));
  }
  .craft-title { position: absolute; left: 16px; right: 12px; bottom: 12px; margin: 0; line-height: 1.2; font-size: 1.125rem; font-weight: 600; letter-spacing: -0.02em; color: #fff; }
  .craft-films { list-style: none; margin: 0; padding: 8px 8px 10px; display: grid; gap: 2px; }
  .craft-film {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    padding: 7px 8px;
    border-radius: 8px;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: none;
    transition: background-color 150ms var(--ease-glass), color 150ms var(--ease-glass);
  }
  a.craft-film:hover { color: var(--ink); background: var(--wash-strong); }
  a.craft-film:focus-visible { outline: none; box-shadow: 0 0 0 2px rgba(var(--crimson), 0.7); color: var(--ink); }

  /* Links --------------------------------------------------------------- */
  .fm-links-sec { padding-bottom: clamp(56px, 7vw, 96px); }
  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 768px) { .links { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  .links > li { display: flex; }
  .link-card { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto; align-items: center; gap: 16px; width: 100%; padding: 18px 20px; }
  @media (min-width: 640px) { .link-card { padding: 22px 24px; } }
  .link-icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(var(--crimson), 0.08);
    border: 1px solid rgba(var(--crimson), 0.2);
    color: var(--ink);
  }
  .link-icon .imdb-wordmark { margin: 0; font-size: 0.6875rem; }
  .link-arrow { color: var(--ink-faint); transition: color 150ms var(--ease-glass), transform 250ms var(--ease-glass); }
  .link-card:hover .link-arrow { color: var(--tone); transform: translate(1px, -1px); }

  @media (prefers-reduced-motion: reduce) {
    .strip-still :global(.strip-img), .craft-media :global(.craft-img), .link-arrow { transition: none; }
  }
</style>
