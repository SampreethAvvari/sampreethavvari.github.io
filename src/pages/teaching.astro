---
import BaseLayout from "../layouts/BaseLayout.astro";
import TeachingBrowser from "../components/teaching/TeachingBrowser.tsx";
import Picture from "../components/common/Picture.astro";
import { teaching } from "../data/teaching";
import { optimizedSources } from "../utils/optimizedImage";
// Only these pages download these stylesheets.
import "../styles/teaching.css";
import "../styles/teaching-hub.css";
import "../styles/solid-glass.css";

// The opening shows the newest materials as objects in space. No preload for the
// first cover: the browser finds it soon enough, it cannot paint before the styles
// arrive anyway, and on a slow connection it would only hold the styles up.
const shown = [...teaching].sort((a, b) => b.addedAt.localeCompare(a.addedAt)).slice(0, 2);
const sizesFor = ["(min-width: 1024px) 76vw, 170vw", "(min-width: 1024px) 54vw, 120vw"];
const covers = Object.fromEntries(
  teaching.map((m) => {
    const o = optimizedSources(m.cover);
    return [m.slug, { avifSet: o?.avifSet, webpSet: o?.webpSet }];
  }),
);
---

<BaseLayout
  title="SA: Teaching"
  description="Two free guides on retrieval and AI systems, shared by Sampreeth Avvari."
>
  <div data-teaching>
    <header class="ts-hero teach-hero" data-ts-hero data-ts-section="opening" data-rgb="52,211,153" data-seed="0.61">
      <div class="ts-stage">
        {shown.map((m, i) => (
          <figure
            class:list={["ts-art", i === 0 ? "teach-art-a" : "teach-art-b"]}
            data-art={m.cover.replace(/\.(png|jpe?g|webp|avif)$/i, "")}
            data-z={i === 0 ? "0" : "-7"}
            aria-hidden="true"
          >
            <Picture
              src={m.cover}
              alt=""
              width={1344}
              height={768}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "low"}
              sizes={sizesFor[i]}
            />
          </figure>
        ))}
        <canvas class="ts-gl" aria-hidden="true"></canvas>
        <div class="ts-scrim" aria-hidden="true"></div>
        <div class="wrap ts-copy">
          <div class="teach-main">
            <p class="kicker">Teaching</p>
            <h1 class="teach-title">
              Guides I study from.
              <span class="t-tail">Free to read, for engineers who ship AI.</span>
            </h1>
            <p class="t-lede teach-lede">
              Two free guides on retrieval and AI systems. Read them right here, or download the PDF.
            </p>
          </div>
        </div>
        <div class="ts-cue" aria-hidden="true"><i></i></div>
      </div>
    </header>

    <section class="teach-browse" data-ts-section="materials">
      <div class="wrap">
        <TeachingBrowser client:load entries={teaching} covers={covers} />
      </div>
    </section>
  </div>

  <script>
    import "../scripts/teaching/index";
  </script>
</BaseLayout>
