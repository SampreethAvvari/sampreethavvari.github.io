---
import BaseLayout from "../layouts/BaseLayout.astro";
import TeachingBrowser from "../components/teaching/TeachingBrowser.tsx";
import { teaching } from "../data/teaching";
---

<BaseLayout
  title="SA: Teaching"
  description="Free handbooks, notes and videos on building real engineering systems, by Sampreeth Avvari."
>
  <section class="page-top teach-top relative overflow-hidden">
    <div class="tone-atmos" aria-hidden="true"></div>
    <div class="wrap on-top">
      <p class="kicker">Teaching</p>
      <h1 class="t-title teach-title">
        What I've learned, written down.
        <span class="t-tail">Free guides for engineers who ship AI.</span>
      </h1>
      <p class="t-lede teach-lede">
        Handbooks, notes and videos on building real engineering systems,
        grouped by discipline. Read them right here, and grab the PDF if it
        earns a spot on your shelf.
      </p>
    </div>
  </section>

  <section class="teach-browse">
    <div class="wrap">
      <TeachingBrowser client:load entries={teaching} />
    </div>
  </section>
</BaseLayout>

<style>
  .teach-title { margin-top: 22px; }
  .teach-lede { margin-top: 22px; }
  .teach-browse { position: relative; z-index: 1; padding-top: clamp(40px, 5vw, 56px); padding-bottom: clamp(72px, 9vw, 120px); }

  /* The browser is a React island, so its markup is styled from here. */

  /* Toolbar: the stream filter is a glass bar, the sort a glass pill. */
  .teach-browse :global(.tb-bar) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    margin-bottom: clamp(24px, 3vw, 32px);
  }
  .teach-browse :global(.tb-filter) {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    padding: 5px;
    border-radius: 9999px;
    max-width: 100%;
  }
  .teach-browse :global(.tb-filter .chip) {
    height: 32px;
    padding: 0 14px;
    border-color: transparent;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
  }
  .teach-browse :global(.tb-filter .chip:not(.is-on):hover) { background: var(--wash-strong); }
  .teach-browse :global(.tb-filter .chip.is-on) { color: #000; background: var(--ink); border-color: var(--ink); }
  .teach-browse :global(.tb-filter .chip.is-quiet:not(.is-on)) { color: var(--ink-faint); }
  .teach-browse :global(.chip:focus-visible) { outline: none; box-shadow: 0 0 0 3px rgba(var(--tone-rgb), 0.45); }

  .teach-browse :global(.tb-sort) {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .teach-browse :global(.tb-sort-select) {
    appearance: none;
    -webkit-appearance: none;
    height: 42px;
    padding: 0 38px 0 16px;
    border-radius: 9999px;
    border: 0;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
  }
  .teach-browse :global(.tb-sort-select:focus-visible) { outline: none; box-shadow: 0 0 0 3px rgba(var(--tone-rgb), 0.45); }
  .teach-browse :global(.tb-sort-select option) { background: #0e0f14; color: var(--ink); }
  .teach-browse :global(.tb-sort-chev) {
    position: absolute;
    right: 15px;
    top: 50%;
    width: 12px;
    height: 12px;
    margin-top: -6px;
    pointer-events: none;
    color: var(--ink-soft);
    z-index: 1;
  }

  /* The cards */
  .teach-browse :global(.tb-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) { .teach-browse :global(.tb-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .teach-browse :global(.tb-grid) { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; } }
  .teach-browse :global(.tb-card) { display: flex; flex-direction: column; }
  .teach-browse :global(.tb-cover) { aspect-ratio: 16 / 10; }
  .teach-browse :global(.tb-body) { display: flex; flex-direction: column; flex: 1; }
  .teach-browse :global(.tb-badges) { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; }
  .teach-browse :global(.tb-badges .t-meta) { margin-left: 2px; }
  .teach-browse :global(.tb-title) { margin-top: 14px; }
  .teach-browse :global(.tb-desc) {
    margin-top: 8px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .teach-browse :global(.tb-foot) {
    margin-top: auto;
    padding-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }

  /* Nothing in this stream yet */
  .teach-browse :global(.tb-empty) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 22px 24px;
  }
  .teach-browse :global(.tb-empty-dot) {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--tone);
    box-shadow: 0 0 12px rgba(var(--tone-rgb), 0.7);
    flex: none;
  }
</style>
