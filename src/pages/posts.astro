---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import NextStep from "../components/common/NextStep.astro";
import CaseHeroes from "../components/writing/CaseHeroes.astro";
import WritingArchive from "../components/writing/WritingArchive.astro";
import type { CaseHero, ArchivePost } from "../components/writing/types";
import { readingTime } from "../utils/readingTime";
import { teaching } from "../data/teaching";
import { itemListNode } from "../utils/seo";
import {
  disciplinesFor,
  impactRank,
  slugOf,
  formatPostDate,
  hasPublic,
} from "../utils/postTopics";

const allPosts = await Astro.glob("../pages/posts/*.md");

// Teaching left the top bar and lives here: the guides are writing too.
const guides = [...teaching].sort((a, b) => b.addedAt.localeCompare(a.addedAt));
allPosts.sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime(),
);

// The six case studies that open the page, in the order they play. Picked
// for what each one shows and for range across the work: the whole
// platform, the patient records under it, the scan checker (machine
// learning), the consult grader (AI on real calls), the open source job
// hunt app, and the cited company search. `short` names it in the index;
// `stat` picks which of the post's own stats sits beside the button.
const FEATURED: Array<{ slug: string; short: string; stat: number }> = [
  { slug: "platform", short: "The platform", stat: 0 },
  { slug: "patient-dashboard", short: "Patient records", stat: 0 },
  { slug: "cbct-scan-validator", short: "Scan checker", stat: 2 },
  { slug: "clinical-rag", short: "Doc Coach", stat: 0 },
  { slug: "jobpilot-v2", short: "JobPilot", stat: 0 },
  { slug: "enterprise-search", short: "Company search", stat: 0 },
];

// A post's frontmatter tone as a colour for the light around its art.
const TONE_RGB: Record<string, string> = {
  blue: "91,141,239",
  emerald: "52,211,153",
  violet: "167,139,250",
  amber: "245,165,36",
  cyan: "34,211,238",
  film: "244,63,94",
};
const WRITING_RGB = "52,211,153";

// Tags as this page shows them. A tag that shares its name with a tab of
// the site reads as that tab, so it gets a plain name here. The posts'
// frontmatter is unchanged.
const TAG_LABEL: Record<string, string> = { Architecture: "Systems" };
const tagLabel = (t?: string) => (t ? TAG_LABEL[t] || t : "Notes");

// The hero art lives in public/writing/<slug>-<width>.avif and .webp. A
// post without it falls back to its own cover.
const artFor = (slug: string) => {
  const base = `/writing/${slug}`;
  const ok = fs.existsSync(path.join(process.cwd(), "public", `${base}-2560.avif`));
  return ok ? base : undefined;
};

// Small covers for the map live in public/writing/thumbs/<name>.avif/.webp.
const thumbFor = (img?: string) => {
  if (!img) return undefined;
  const name = img.replace(/^.*\//, "").replace(/\.(png|jpe?g|webp|avif)$/i, "");
  const base = `/writing/thumbs/${name}`;
  return fs.existsSync(path.join(process.cwd(), "public", `${base}.avif`)) ? base : undefined;
};

const bySlug = new Map(allPosts.map((p) => [slugOf(p.url), p]));
const heroes: CaseHero[] = FEATURED.flatMap((f) => {
  const post = bySlug.get(f.slug);
  if (!post) return [];
  const fm = post.frontmatter;
  const stat = Array.isArray(fm.stats) ? fm.stats[f.stat] ?? fm.stats[0] : undefined;
  return [
    {
      slug: f.slug,
      short: f.short,
      url: post.url!,
      title: fm.title,
      description: fm.description,
      date: formatPostDate(fm.date),
      isoDate: fm.date,
      minutes: readingTime(post.rawContent()),
      tag: tagLabel(fm.tag),
      rgb: TONE_RGB[fm.tone] || WRITING_RGB,
      art: artFor(f.slug),
      cover: hasPublic(fm.img_path) ? fm.img_path : undefined,
      alt: fm.img_alt || fm.title,
      stat: stat ? { value: String(stat.value), label: String(stat.label) } : undefined,
    },
  ];
});
const featuredSlugs = new Set(heroes.map((h) => h.slug));

// Every post for the list below the heroes. The six are in it too, hidden
// in the default view so nothing shows twice, and shown when a filter or
// the impact order is on so those views are complete.
const posts: ArchivePost[] = allPosts.map((post) => {
  const slug = slugOf(post.url);
  const fm = post.frontmatter;
  return {
    slug,
    url: post.url!,
    title: fm.title,
    description: fm.description,
    date: formatPostDate(fm.date),
    time: new Date(fm.date).getTime(),
    minutes: readingTime(post.rawContent()),
    img: hasPublic(fm.img_path) ? fm.img_path : undefined,
    alt: fm.img_alt || fm.title,
    fallback: (Array.isArray(fm.stats) && fm.stats[0]?.value) || fm.tag || "",
    dx: disciplinesFor[slug] || [],
    impact: impactRank(slug),
    featured: featuredSlugs.has(slug),
    tag: tagLabel(fm.tag),
    year: String(fm.date).slice(0, 4),
    thumb: thumbFor(fm.img_path),
  };
});

// The first hero's art is the largest thing on the first screen.
const firstArt = heroes[0]?.art;

---

<BaseLayout
  title="SA: Writing"
  description="Notes from the systems Sampreeth Avvari builds: real numbers, real screwups, real fixes."
  preloadImage={firstArt ? `${firstArt}-2560.avif` : undefined}
  schema={[
    itemListNode(
      Astro.site!.toString(),
      "/posts",
      "Writing by Sampreeth Avvari",
      allPosts.map((p) => ({ name: p.frontmatter.title, path: `/posts/${slugOf(p.url)}` })),
    ),
  ]}
  crumbs={[{ name: "Home", path: "/" }, { name: "Writing", path: "/posts" }]}
>
  <div class="wx-page">
    <!-- The page opens on the first case study; its title rides on it. -->
    <CaseHeroes
      items={heroes}
      heading="Notes from the work."
      tail="Real numbers, real screwups, real fixes."
      lede={`Six case studies, then ${allPosts.length} posts and ${guides.length} guides.`}
    />

    <WritingArchive posts={posts} guides={guides} />

    <NextStep next={{ href: "/architecture", label: "See the drawings" }} />
  </div>
</BaseLayout>

<style>
  /* clip, not hidden: hidden would make this a scroll box and stop the
     pinned heroes from sticking. */
  .wx-page { position: relative; overflow-x: clip; }
  .wx-page :global(.next-step) { padding-bottom: clamp(72px, 9vw, 120px); }
</style>
