---
import BaseLayout from "../layouts/BaseLayout.astro";
import Picture from "../components/common/Picture.astro";
import Icon from "../components/common/Icon.astro";
import { readingTime } from "../utils/readingTime";
import {
  disciplinesFor,
  impactRank,
  slugOf,
  formatPostDate,
  hasPublic,
} from "../utils/postTopics";

const allPosts = await Astro.glob("../pages/posts/*.md");
allPosts.sort(
  (a, b) =>
    new Date(b.frontmatter.date).getTime() -
    new Date(a.frontmatter.date).getTime(),
);

const [featured] = allPosts;
const featuredSlug = slugOf(featured?.url);
const featuredHasCover = hasPublic(featured?.frontmatter.img_path);
// Preload the featured cover (the LCP element) as AVIF, only when it exists.
const featuredPreload = featuredHasCover
  ? featured.frontmatter.img_path.replace(/\.(png|jpe?g)$/i, ".avif")
  : undefined;

// The filters. Plain words on neutral chips: the selected one turns white.
const filters = [
  { key: "all", label: "All", title: "Every post" },
  { key: "aie", label: "AIE", title: "AI engineering" },
  { key: "mle", label: "MLE", title: "Machine learning engineering" },
  { key: "fde", label: "FDE", title: "Working on site with the people who use it" },
  { key: "sde", label: "SDE", title: "Software engineering" },
];

// While a post's cover is still being made, its panel shows the post's
// headline number, or its tag when it has none.
const fallbackText = (fm: Record<string, any>) =>
  (Array.isArray(fm.stats) && fm.stats[0]?.value) || fm.tag || "";

// Comets in the writing colour, placed for this page.
const comets = [
  { w: 143, top: "26%", pos: "right:5%", rz: -14 },
  { w: 115, top: "78%", pos: "left:8%", rz: 10 },
];
const gridComets = [
  { w: 130, top: "4%", pos: "left:2%", rz: 12 },
  { w: 112, top: "50%", pos: "right:3%", rz: -12 },
  { w: 118, top: "22%", pos: "left:36%", rz: 8 },
  { w: 106, top: "76%", pos: "right:30%", rz: -16 },
];
const WRITING_RGB = "52,211,153";
---

<BaseLayout
  title="SA: Writing"
  description="Notes from the systems Sampreeth Avvari builds: real numbers, real screwups, real fixes."
  preloadImage={featuredPreload}
>
  <div class="wr-page relative overflow-hidden">
    <span class="glow" style="width:630px;height:630px;--gc:#34D399;top:-100px;left:-120px;" aria-hidden="true"></span>
    <span class="glow glow-2" style="width:570px;height:570px;--gc:#34D399;top:34%;right:-110px;" aria-hidden="true"></span>
    <span class="glow glow-3" style="width:510px;height:510px;--gc:#34D399;bottom:-80px;left:22%;" aria-hidden="true"></span>

    <!-- Page top -->
    <section class="page-top wr-top relative">
      <div class="tone-atmos" aria-hidden="true"></div>
      {comets.map((c) => (
        <span class="space-el" style={`width:${c.w}px;height:${Math.round(c.w * 0.27)}px;top:${c.top};${c.pos};`} aria-hidden="true"><span class="comet-glow" style={`--sr-rgb:${WRITING_RGB};`}></span><span class="space-comet" style={`--sr-rgb:${WRITING_RGB};--rz:${c.rz}deg;`}></span></span>
      ))}
      <div class="wrap on-top">
        <p class="kicker">Writing</p>
        <h1 class="t-title wr-title">
          Notes from the work.
          <span class="t-tail">Real numbers, real screwups, real fixes.</span>
        </h1>
        <p class="t-lede wr-lede">
          How the systems I build actually got built: who needed them, what
          broke on the way, and the numbers that say whether it worked.
        </p>
      </div>
    </section>

    <!-- Featured: the latest post. Shown in the default view only. -->
    {
      featured && (
        <div id="featured-panel" class="wrap on-top">
          <a href={featured.url} class="surface wr-feat" data-reveal>
            <div class="wr-feat-media">
              {featuredHasCover ? (
                <Picture
                  src={featured.frontmatter.img_path}
                  alt={featured.frontmatter.img_alt || featured.frontmatter.title}
                  width={900}
                  height={506}
                  loading="eager"
                  fetchpriority="high"
                />
              ) : (
                <div class="media-fallback" aria-hidden="true">
                  <span class="fb-num">{fallbackText(featured.frontmatter)}</span>
                </div>
              )}
            </div>
            <div class="wr-feat-body">
              <p class="t-meta wr-meta">
                <span class="badge badge-tone">Latest</span>
                <span>
                  {formatPostDate(featured.frontmatter.date)} · {readingTime(featured.rawContent())} min read
                </span>
              </p>
              <h2 class="wr-feat-title">{featured.frontmatter.title}</h2>
              <p class="t-body wr-feat-desc">{featured.frontmatter.description}</p>
              <span class="tlink wr-feat-link">
                Read the post <Icon name="arrow-right" size={14} />
              </span>
            </div>
          </a>
        </div>
      )
    }

    <!-- Filters and sort -->
    <div class="wrap on-top wr-controls-wrap">
      <div class="wr-controls">
        <div class="lg wr-bar" role="group" aria-label="Filter posts by kind of work">
          {filters.map((f) => (
            <button
              type="button"
              class={`chip wr-filter ${f.key === "all" ? "is-on" : ""}`}
              data-filter={f.key}
              aria-pressed={f.key === "all" ? "true" : "false"}
              title={f.title}
            >
              {f.label}
            </button>
          ))}
        </div>
        <div class="lg wr-bar" role="group" aria-label="Sort posts">
          <button type="button" class="chip wr-sort is-on" data-sort="date" aria-pressed="true">Newest</button>
          <button type="button" class="chip wr-sort" data-sort="impact" aria-pressed="false">Impact</button>
        </div>
        <p class="t-meta wr-count" id="wr-count" aria-live="polite">{allPosts.length} posts</p>
      </div>
      <p id="impact-note" class="t-small wr-note" hidden>
        Posts ranked by how much the project behind each one moved the company.
      </p>
    </div>

    <!-- Every post -->
    <section class="wrap on-top wr-list relative" aria-label="All posts">
      {gridComets.map((c) => (
        <span class="space-el" style={`width:${c.w}px;height:${Math.round(c.w * 0.27)}px;top:${c.top};${c.pos};`} aria-hidden="true"><span class="comet-glow" style={`--sr-rgb:${WRITING_RGB};`}></span><span class="space-comet" style={`--sr-rgb:${WRITING_RGB};--rz:${c.rz}deg;`}></span></span>
      ))}
      <div id="wr-grid" class="wr-grid">
        {allPosts.map((post) => {
          const slug = slugOf(post.url);
          const fm = post.frontmatter;
          const dx = disciplinesFor[slug] || [];
          return (
            <a
              href={post.url}
              class="surface wr-card"
              data-reveal
              data-slug={slug}
              data-date={new Date(fm.date).getTime()}
              data-impact={impactRank(slug)}
              data-dx={dx.join(" ")}
              data-latest={slug === featuredSlug ? "1" : undefined}
            >
              <div class="surface-media wr-card-media">
                {hasPublic(fm.img_path) ? (
                  <Picture
                    src={fm.img_path}
                    alt={fm.img_alt || fm.title}
                    width={600}
                    height={338}
                  />
                ) : (
                  <div class="media-fallback" aria-hidden="true">
                    <span class="fb-num fb-num-sm">{fallbackText(fm)}</span>
                  </div>
                )}
              </div>
              <div class="wr-card-body">
                <p class="t-meta">
                  {formatPostDate(fm.date)} · {readingTime(post.rawContent())} min read
                </p>
                <h3 class="wr-card-title">{fm.title}</h3>
                <p class="t-small wr-card-desc">{fm.description}</p>
              </div>
            </a>
          );
        })}
      </div>
      <p id="wr-empty" class="t-body wr-empty" hidden>
        No posts in this one yet.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  /* Page top */
  .wr-top { padding-bottom: clamp(40px, 5vw, 64px); }
  .wr-title { margin-top: 24px; }
  .wr-lede { margin-top: 24px; }

  /* Featured latest post */
  .wr-feat {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .wr-feat { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  }
  .wr-feat-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #07080b;
    border-bottom: 1px solid var(--line);
    border-radius: 19px 19px 0 0;
  }
  @media (min-width: 1024px) {
    .wr-feat-media {
      aspect-ratio: auto;
      min-height: 400px;
      border-bottom: 0;
      border-right: 1px solid var(--line);
      border-radius: 19px 0 0 19px;
    }
  }
  .wr-feat-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 600ms var(--ease-glass);
  }
  .wr-feat:hover .wr-feat-media :global(img) { transform: scale(1.03); }
  .wr-feat-media .media-fallback { position: absolute; inset: 0; }
  .wr-feat-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 24px;
  }
  @media (min-width: 640px) { .wr-feat-body { padding: 32px; } }
  @media (min-width: 1024px) { .wr-feat-body { padding: 40px; } }
  .wr-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .wr-feat-title {
    margin-top: 16px;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.14;
    letter-spacing: -0.03em;
    font-weight: 600;
    color: var(--ink);
    text-wrap: balance;
  }
  .wr-feat-desc {
    margin-top: 12px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }
  .wr-feat-link { margin-top: 24px; }
  .wr-feat:hover .wr-feat-link :global(svg) { transform: translateX(3px); }

  /* The calm panel that stands in for a cover still being made. */
  .media-fallback {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 24px;
    background:
      radial-gradient(70% 90% at 20% 10%, rgba(var(--tone-rgb), 0.2), transparent 70%),
      radial-gradient(60% 80% at 90% 100%, rgba(var(--tone-rgb), 0.09), transparent 70%),
      #07080b;
  }
  .fb-num {
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: center;
    text-wrap: balance;
    color: var(--ink-ghost);
  }
  .fb-num-sm { font-size: clamp(1.375rem, 2vw, 1.625rem); }

  /* Filters and sort: glass bars in the navigation layer. */
  .wr-controls-wrap { margin-top: clamp(40px, 5vw, 56px); }
  .wr-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
  }
  .wr-bar {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 5px;
    border-radius: 9999px;
  }
  .wr-bar .chip { cursor: pointer; background: transparent; border-color: transparent; }
  .wr-bar .chip:hover { transform: none; }
  .wr-bar .chip:not(.is-on):hover { background: var(--wash-strong); border-color: transparent; }
  .wr-bar .chip.is-on { color: #000; background: var(--ink); border-color: var(--ink); }
  .wr-bar .chip:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--tone-rgb), 0.45); }
  .wr-count { margin-left: 4px; }
  .wr-note { margin-top: 14px; max-width: 40rem; }

  /* The list */
  .wr-list { margin-top: 24px; padding-bottom: clamp(72px, 9vw, 120px); }
  .wr-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 720px) { .wr-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .wr-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; } }
  .wr-card { display: flex; flex-direction: column; height: 100%; }
  .wr-card-media { aspect-ratio: 16 / 9; }
  .wr-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 22px 24px;
  }
  .wr-card-title {
    margin-top: 10px;
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.018em;
    font-weight: 600;
    color: var(--ink);
    text-wrap: balance;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .wr-card-desc {
    margin-top: 10px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .wr-empty { margin-top: 32px; color: var(--ink-faint); }

  /* Toggled by the filter script. Beats the display of a.surface. */
  [hidden] { display: none !important; }

  @media (prefers-reduced-motion: reduce) {
    .wr-feat-media :global(img) { transition: none; }
    .wr-feat:hover .wr-feat-media :global(img) { transform: none; }
  }
</style>

<script>
  // The background (stars, glows, comets) takes the writing colour from
  // BaseLayout, which starts the comets and the ambient wash for this tab.

  // Filtering and sorting. Default view: newest first with the featured
  // card pinned on top and its card hidden from the grid to avoid the
  // duplicate. Any other view hides the featured card and shows every
  // matching post in the grid.
  (function () {
    const grid = document.getElementById("wr-grid");
    const featuredPanel = document.getElementById("featured-panel");
    const impactNote = document.getElementById("impact-note");
    const empty = document.getElementById("wr-empty");
    const count = document.getElementById("wr-count");
    if (!grid) return;
    const cards = Array.from(grid.children) as HTMLElement[];
    const filterBtns = Array.from(document.querySelectorAll<HTMLElement>(".wr-filter"));
    const sortBtns = Array.from(document.querySelectorAll<HTMLElement>(".wr-sort"));

    let filter = "all";
    let sort = "date";

    const press = (btns: HTMLElement[], on: HTMLElement) =>
      btns.forEach((b) => {
        b.classList.toggle("is-on", b === on);
        b.setAttribute("aria-pressed", b === on ? "true" : "false");
      });

    const apply = () => {
      const isDefault = filter === "all" && sort === "date";
      if (featuredPanel) featuredPanel.hidden = !isDefault;
      if (impactNote) impactNote.hidden = sort !== "impact";

      const sorted = [...cards].sort((a, b) =>
        sort === "impact"
          ? parseInt(a.dataset.impact || "999") - parseInt(b.dataset.impact || "999")
          : parseInt(b.dataset.date || "0") - parseInt(a.dataset.date || "0"),
      );
      let shown = 0;
      let matching = 0;
      for (const card of sorted) {
        const dx = (card.dataset.dx || "").split(" ").filter(Boolean);
        const hideByFilter = filter !== "all" && !dx.includes(filter);
        const hideAsDup = isDefault && card.dataset.latest === "1";
        card.hidden = hideByFilter || hideAsDup;
        if (!hideByFilter) matching++;
        if (!card.hidden) shown++;
        grid.appendChild(card);
      }
      if (empty) empty.hidden = shown > 0;
      if (count) count.textContent = matching === 1 ? "1 post" : `${matching} posts`;
    };

    filterBtns.forEach((btn) =>
      btn.addEventListener("click", () => {
        filter = btn.dataset.filter || "all";
        press(filterBtns, btn);
        apply();
      }),
    );
    sortBtns.forEach((btn) =>
      btn.addEventListener("click", () => {
        sort = btn.dataset.sort || "date";
        press(sortBtns, btn);
        apply();
      }),
    );
    apply();
  })();
</script>
