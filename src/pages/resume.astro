---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResumeWorld from "../components/resume-world/ResumeWorld.astro";
import { info } from "../data/info";

const title = "SA: Resume";

const { experience, education, skills } = info.about;
---

<BaseLayout
  title={title}
  description="Sampreeth Avvari's resume: experience, education and skills."
  ownSky
  footerVariant="minimal"
>
  <ResumeWorld
    name={info.name}
    location={info.location}
    contact={info.contact}
    experience={experience}
    education={education}
    skills={skills}
  />
</BaseLayout>
