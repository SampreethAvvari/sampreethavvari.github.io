---
// /demos/jobpilot: the one demo that is the real app. It lives on Cloudflare
// Pages and allows framing (no X-Frame-Options, no frame-ancestors CSP as of
// October 2026), so it runs right here in a framed surface. Its capsule opens the
// page on the rail; once the console is up the rail stops drawing.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/common/Icon.astro";
import Picture from "../../components/common/Picture.astro";
import "../../components/tours/rail.css";
import "../../styles/solid-glass.css";

const APP = "https://jobpilot-demo.pages.dev";
---

<BaseLayout
  title="JobPilot demo · Sampreeth Avvari"
  description="The real JobPilot console, running live on fictional data. My open source job hunt autopilot."
  tone="projects"
>
  <div class="rl-flight" data-rl="flight">
    <script is:inline>
      (function () {
        var el = document.currentScript && document.currentScript.parentElement;
        if (el && "WebGL2RenderingContext" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) el.classList.add("is-live");
      })();
    </script>
    <div class="rl-sticky" aria-hidden="true">
      <canvas class="rl-gl"></canvas>
      <div class="rl-shade"></div>
    </div>

    <!-- Page top -->
    <section class="page-top jp-top rl-flight-hero" data-flight-hero>
      <div class="tone-atmos" aria-hidden="true"></div>
      <div class="rl-slab" aria-hidden="true">
        <Picture src="/jobpilot.png" alt="" width={960} height={549} loading="eager" sizes="(min-width: 1024px) 640px, 60vw" />
      </div>
      <div class="wrap on-top">
        <div class="rl-flight-copy">
          <a href="/projects" class="tlink jp-back">
            <Icon name="arrow-left" size={14} /> Projects
          </a>
          <p class="kicker jp-kicker">Live demo</p>
          <h1 class="t-title jp-title">
            JobPilot.
            <span class="t-tail">The real console, on fictional data.</span>
          </h1>
          <p class="t-lede jp-lede">
            My open source job hunt autopilot. It watched 163 company boards, scored each role against my
            profile, and tailored a resume and cover letter per match. Nothing here is a recording, so click
            anything.
          </p>
          <div class="jp-facts">
            <span class="badge badge-live">Live app</span>
            <span class="badge">Open source</span>
            <span class="t-meta">Fictional data</span>
          </div>
        </div>
      </div>
      <div class="rl-cue" aria-hidden="true"><span>Scroll</span><i></i></div>
    </section>
  </div>

  <!-- The app -->
  <section class="jp-sec" aria-labelledby="jp-app" data-depth>
    <div class="wrap">
      <h2 id="jp-app" class="sr-only">The JobPilot console</h2>
      <div class="surface jp-frame" data-jp-frame>
        <span class="jp-corner jp-corner-tl" aria-hidden="true"></span>
        <span class="jp-corner jp-corner-tr" aria-hidden="true"></span>
        <span class="jp-corner jp-corner-bl" aria-hidden="true"></span>
        <span class="jp-corner jp-corner-br" aria-hidden="true"></span>
        <div class="jp-chrome">
          <span class="jp-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="jp-url">jobpilot-demo.pages.dev</span>
          <a href={APP} target="_blank" rel="noreferrer" class="btn btn-glass btn-xs jp-full">
            Open full screen <Icon name="arrow-up-right" size={13} class="arrow-ur" />
          </a>
        </div>
        <div class="jp-screen">
          <!-- Rings charging behind the app until it has loaded. -->
          <div class="jp-boot" aria-hidden="true"><i></i><i></i><i></i></div>
          <iframe
            src={APP}
            title="JobPilot live demo"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox allow-downloads"
            allow="clipboard-write"
          ></iframe>
        </div>
      </div>
      <p class="t-meta jp-note">
        Small screen? The console is built for a desktop, so it reads best opened full screen.
      </p>
      <div class="jp-actions">
        <a href="/posts/jobpilot-v2" class="btn btn-glass">
          Read the case study <Icon name="arrow-right" size={15} class="arrow-r" />
        </a>
        <a href="https://github.com/SampreethAvvari/job-pilot" target="_blank" rel="noreferrer" class="btn btn-ghost">
          Code on GitHub <Icon name="arrow-up-right" size={15} class="arrow-ur" />
        </a>
        <a href="/demos" class="btn btn-ghost">All demos</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { onPage } from "../../scripts/lifecycle";
  import { mountRailFlight } from "../../components/tours/rail-stage";
  mountRailFlight();

  // The app is up: the rings go, and the frame's top lights say so.
  onPage("demos-jobpilot-frame", (signal) => {
    const frame = document.querySelector<HTMLElement>("[data-jp-frame]");
    const iframe = frame?.querySelector("iframe");
    if (!frame || !iframe) return;
    iframe.addEventListener("load", () => frame.classList.add("is-up"), { once: true, signal });
    return () => frame.classList.remove("is-up");
  });
</script>

<style>
  /* Page top */
  .jp-top { padding-bottom: clamp(32px, 4vw, 48px); }
  .jp-back { font-size: 0.875rem; }
  .jp-back:hover :global(svg) { transform: translateX(-3px); }
  .jp-kicker { display: flex; margin-top: 28px; }
  .jp-title { margin-top: 20px; }
  .jp-lede { margin-top: 24px; max-width: 44rem; }
  .jp-facts { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; }

  .jp-sec { position: relative; padding-top: clamp(16px, 4vh, 56px); padding-bottom: clamp(64px, 8vw, 112px); }

  /* The app in a frame: a solid surface with a quiet chrome bar, the same
     registration corners as the tour console. */
  .jp-frame { overflow: visible; box-shadow: 0 50px 110px -46px rgba(var(--tone-rgb), 0.5), 0 30px 60px -30px rgba(0, 0, 0, 0.9); }
  .jp-corner { position: absolute; z-index: 2; width: 16px; height: 16px; pointer-events: none; }
  .jp-corner-tl { top: -6px; left: -6px; border-top: 1.5px solid rgba(var(--tone-rgb), 0.8); border-left: 1.5px solid rgba(var(--tone-rgb), 0.8); border-top-left-radius: 7px; }
  .jp-corner-tr { top: -6px; right: -6px; border-top: 1.5px solid rgba(var(--tone-rgb), 0.8); border-right: 1.5px solid rgba(var(--tone-rgb), 0.8); border-top-right-radius: 7px; }
  .jp-corner-bl { bottom: -6px; left: -6px; border-bottom: 1.5px solid rgba(var(--tone-rgb), 0.8); border-left: 1.5px solid rgba(var(--tone-rgb), 0.8); border-bottom-left-radius: 7px; }
  .jp-corner-br { bottom: -6px; right: -6px; border-bottom: 1.5px solid rgba(var(--tone-rgb), 0.8); border-right: 1.5px solid rgba(var(--tone-rgb), 0.8); border-bottom-right-radius: 7px; }
  .jp-chrome {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 8px 8px 16px;
    border-bottom: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.015);
    border-radius: 19px 19px 0 0;
  }
  .jp-dots { display: inline-flex; gap: 6px; flex: none; }
  .jp-dots i { width: 9px; height: 9px; border-radius: 9999px; background: rgba(255, 255, 255, 0.14); transition: background-color 400ms var(--ease-glass), box-shadow 400ms var(--ease-glass); }
  .jp-frame:global(.is-up) .jp-dots i:first-child { background: #4ade80; box-shadow: 0 0 8px rgba(74, 222, 128, 0.7); }
  .jp-url {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .jp-full { flex: none; }
  .jp-screen { position: relative; overflow: hidden; border-radius: 0 0 19px 19px; background: #07080b; }
  .jp-screen iframe {
    position: relative;
    display: block;
    width: 100%;
    height: 80vh;
    min-height: 520px;
    max-height: 960px;
    border: 0;
  }
  .jp-boot { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; transition: opacity 400ms var(--ease-glass); }
  .jp-frame:global(.is-up) .jp-boot { opacity: 0; }
  .jp-boot i {
    grid-area: 1 / 1;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 1px solid rgba(var(--tone-rgb), 0.8);
    animation: jp-charge 2.1s cubic-bezier(0.2, 0.6, 0.2, 1) infinite;
  }
  .jp-boot i:nth-child(2) { animation-delay: 0.7s; }
  .jp-boot i:nth-child(3) { animation-delay: 1.4s; }
  @keyframes jp-charge {
    from { opacity: 0; transform: scale(2.6); }
    30% { opacity: 0.9; }
    to { opacity: 0; transform: scale(0.15); }
  }
  .jp-frame:global(.is-up) .jp-boot i { animation: none; }
  .jp-note { margin-top: 16px; }
  @media (min-width: 1024px) { .jp-note { display: none; } }
  .jp-actions { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 10px; }
  @media (prefers-reduced-motion: reduce) { .jp-boot i { animation: none; opacity: 0.4; } .jp-boot i:nth-child(n + 2) { display: none; } }
</style>
