---
// /demos: every live demo in one place, along one launch rail. JobPilot is the
// real app; the rest are guided tours that rebuild a private production system
// on synthetic data. Part of the Projects tab, so the page wears its blue.
//
// The same markup is a pinned flight down the rail and a plain page of cards:
// see components/tours/rail.css and rail-stage.ts.
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/common/Icon.astro";
import Picture from "../../components/common/Picture.astro";
import { TOURS } from "../../data/tours";
import { optimizedSources } from "../../utils/optimizedImage";
import "../../components/tours/rail.css";
import "../../styles/solid-glass.css";

// A cover only renders when its file (or its .avif/.webp sibling) exists.
const hasPublic = (p?: string) =>
  !!p &&
  [p, p.replace(/\.(png|jpe?g)$/i, ".avif"), p.replace(/\.(png|jpe?g)$/i, ".webp")].some((f) =>
    fs.existsSync(path.join(process.cwd(), "public", f)),
  );

// The card line is the pitch's first sentence. A very short opener, like a
// status note, takes the next sentence along so the card still says what it is.
const firstSentence = (s: string) => {
  const dot = s.indexOf(". ");
  if (dot < 0) return s;
  if (dot + 1 >= 40) return s.slice(0, dot + 1);
  const next = s.indexOf(". ", dot + 2);
  return next > 0 ? s.slice(0, next + 1) : s;
};
// "Delivery SLO" reads "delivery SLO" after a number; acronyms keep their case.
// Proper nouns keep theirs too: a known name first, or a later word in title
// case ("Google Cloud"), leaves the label as written.
const PROPER = /^(Google|Gemini|Denticon|Monday|BigQuery|Claude|Zoom|Vertex|Cloud)\b/;
const asTail = (label: string) =>
  PROPER.test(label) || /\s[A-Z][a-z]/.test(label)
    ? label
    : label.replace(/^([A-Z])(?![A-Z])/, (c) => c.toLowerCase());

const WORDS = ["Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Ten", "Eleven", "Twelve"];
const tourCount = WORDS[TOURS.length] ?? String(TOURS.length);
const two = (i: number) => String(i).padStart(2, "0");

// The picture on a capsule's glass: the 960 copy, which the world swaps for the
// 640 on a touch screen. Its full size only if no copy was made.
const texFor = (src?: string) => {
  const o = optimizedSources(src);
  if (!o) return "";
  const m = o.webpSet?.match(/(\S+-960\.webp)\s/);
  return m ? m[1] : o.webp;
};

// Stops along the rail: the whole rail, JobPilot, the look down the bore, each
// tour, the end of the rail.
const FIRST_TOUR = 3;
const stops = FIRST_TOUR + TOURS.length + 1;
const index = [
  { go: 1, id: "demo-jobpilot", name: "JobPilot" },
  ...TOURS.map((t, i) => ({ go: FIRST_TOUR + i, id: `demo-${t.slug}`, name: t.name })),
];
---

<BaseLayout
  title="Live demos · Sampreeth Avvari"
  description="Interactive tours of the AI systems I built at Hybridge, rebuilt on synthetic data, plus JobPilot running live."
  tone="projects"
>
  <section class="rl" data-rl="index" style={`--stops:${stops};`}>
    <script is:inline>
      (function () {
        var el = document.currentScript && document.currentScript.parentElement;
        if (el && "WebGL2RenderingContext" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) el.classList.add("is-live");
      })();
    </script>
    <div class="rl-stage">
      <div class="rl-sky" aria-hidden="true"></div>
      <canvas class="rl-gl" aria-hidden="true"></canvas>
      <div class="rl-shade" aria-hidden="true"></div>

      <!-- Page top -->
      <header class="rl-stop rl-hero" data-stop="0">
        <div class="rl-in wrap">
          <a href="/projects" class="tlink rl-back">
            <Icon name="arrow-left" size={14} /> Projects
          </a>
          <p class="kicker rl-kicker">Live demos</p>
          <h1 class="t-title rl-title">
            Click through the systems.
            <span class="t-tail">Real mechanics, synthetic data.</span>
          </h1>
          <p class="t-lede rl-lede">
            These are guided tours of systems I built at Hybridge Implants. The production code and data
            stay private, so every tour rebuilds the experience with synthetic data. The flows,
            thresholds, failure stories and architecture are real. JobPilot is the exception: that one is the
            real app.
          </p>
          <div class="rl-facts">
            <span class="chip chip-live">1 live app</span>
            <span class="chip">{TOURS.length} guided tours</span>
          </div>
        </div>
      </header>

      <!-- JobPilot -->
      <section class="rl-stop rl-bay-one" id="demo-jobpilot" data-stop="1" data-tex={texFor("/jobpilot.png")} aria-labelledby="dx-app">
        <div class="wrap">
          <div class="rl-in">
            <h2 id="dx-app" class="sr-only">The live app</h2>
            <a href="/demos/jobpilot" class="rl-card rl-card-wide" data-launch>
              <span class="rl-art" aria-hidden="true">
                <Picture src="/jobpilot.png" alt="" width={960} height={600} sizes="(min-width: 1024px) 700px, 92vw" />
              </span>
              <span class="rl-body">
                <span class="rl-badges">
                  <span class="badge badge-live">Live app</span>
                  <span class="badge">Open source</span>
                </span>
                <span class="t-h2 rl-name">JobPilot.</span>
                <span class="t-body rl-line">
                  My open source job hunt autopilot. It watches 160+ company boards, scores each role against my
                  profile, and tailors a resume and cover letter per match. The demo is the real console on
                  fictional data, so click anything.
                </span>
                <span class="rl-foot">
                  <span class="rl-go">Open the demo <Icon name="arrow-right" size={14} /></span>
                </span>
              </span>
            </a>
          </div>
        </div>
      </section>

      <!-- The tours -->
      <section class="rl-tours" aria-labelledby="dx-tours">
        <div class="wrap">
          <header class="rl-stop rl-head" data-stop="2" data-lookahead>
            <div class="rl-in">
              <div class="sec-head-main">
                <h2 id="dx-tours" class="t-h2">
                  Guided tours.
                  <span class="t-tail">{tourCount} systems, step by step.</span>
                </h2>
              </div>
              <span class="t-meta">{TOURS.length} tours</span>
            </div>
          </header>

          <ul class="rl-list">
            {TOURS.map((t, i) => (
              <li class="rl-stop rl-bay" id={`demo-${t.slug}`} data-stop={FIRST_TOUR + i} data-tex={texFor(t.cover)}>
                <div class="rl-in">
                  <a href={`/demos/${t.slug}`} class="rl-card" data-launch>
                    <span class="rl-art" aria-hidden="true">
                      {hasPublic(t.cover) ? (
                        <Picture src={t.cover ?? ""} alt="" width={640} height={400} sizes="(min-width: 1024px) 390px, (min-width: 768px) 45vw, 92vw" />
                      ) : (
                        <span class="media-fallback"></span>
                      )}
                    </span>
                    <span class="rl-body">
                      <span class="rl-no" aria-hidden="true">{two(i + 1)}<span> / {two(TOURS.length)}</span></span>
                      <span class="t-meta rl-kick">{t.kicker}</span>
                      <span class="t-h3 rl-name">{t.name}</span>
                      <span class="t-small rl-line">{firstSentence(t.pitch)}</span>
                      <span class="rl-metrics">
                        {t.metrics.slice(0, 2).map((m) => (
                          <span class="badge">
                            {m.value} · {asTail(m.label)}
                          </span>
                        ))}
                      </span>
                      <span class="rl-foot">
                        <span class="rl-go">Take the tour <Icon name="arrow-right" size={14} /></span>
                        <span class="t-meta rl-ticks">
                          {t.steps.map(() => <i aria-hidden="true"></i>)}
                          {t.steps.length} steps
                        </span>
                      </span>
                    </span>
                  </a>
                </div>
              </li>
            ))}
          </ul>

          <div class="rl-stop rl-tours-end" data-stop={stops - 1}>
            <div class="rl-in">
              <p class="t-meta rl-note">
                Every tour uses synthetic data.
              </p>
            </div>
          </div>
        </div>
      </section>

      <nav class="rl-index" aria-label="The demos on this page">
        <ol>
          {index.map((x) => (
            <li>
              <a href={`#${x.id}`} data-go={x.go} data-id={x.id}>
                <span class="rl-index-name">{x.name}</span>
                <span class="rl-index-tick" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="rl-cue" aria-hidden="true"><span>Scroll</span><i></i></div>
      <div class="rl-veil" aria-hidden="true"></div>
    </div>
  </section>
</BaseLayout>

<script>
  import { mountRailIndex } from "../../components/tours/rail-stage";
  mountRailIndex();
</script>
