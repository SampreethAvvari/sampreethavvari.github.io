      var(--surface-solid);
  }
  .proj-back::-webkit-scrollbar { display: none; }
  .proj-back-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .proj-close {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    color: var(--ink-soft);
    background: var(--wash-strong);
