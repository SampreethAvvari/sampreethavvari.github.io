    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.04)),
      rgba(10, 11, 15, 0.5);
    -webkit-backdrop-filter: blur(4px) saturate(1.7);
