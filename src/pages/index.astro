---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { info } from "../data/info";
import { disciplines } from "../data/disciplines";
import { teaching } from "../data/teaching";
import Picture from "../components/common/Picture.astro";
import Icon from "../components/common/Icon.astro";
import OrbitHero from "../components/hero/OrbitHero.astro";
import CareerTimeline from "../components/about_section/CareerTimeline.astro";
import { readingTime } from "../utils/readingTime";
import ArchTile from "../components/architecture/ArchTile.astro";
import { architectures as archAll } from "../data/architecture";
import { profilePageNode, faqNode } from "../utils/seo";

// The home page shows the three best ranked drawings; the rest live on
// /architecture with the filters.
const archShown = archAll.slice(0, 3);

// Four numbers under the hero: money, time, reach and trust, each a link to
// where it is proven. Sources: the cowork and reconciliation posts; Doc
// Coach's 471 scored consults and NPC Coach's 690 graded calls (BigQuery,
// 2026-10-29); the Google Cloud BAA tracker (16 of 16 billed Hybridge
// projects signed, 2026-10-28).
const heroProof = [
  { value: "~$460K", label: "of patient value found that no report showed", href: "/posts/cowork-dashboard" },
  { value: "70 hrs", label: "a week back for the insurance team", href: "/posts/reconciliation" },
  { value: "1,161", label: "doctor consults and patient calls graded", href: "/architecture/doc-coach" },
  { value: "16/16", label: "patient data projects under a HIPAA BAA", href: "/architecture" },
];

// A cover only renders when its file exists, so a project whose art is still
// being made shows a calm panel instead of a broken image.
// The repo keeps the optimised .avif/.webp siblings, not always the .png.
const hasPublic = (p?: string) =>
  !!p &&
  [p, p.replace(/\.(png|jpe?g)$/i, ".avif"), p.replace(/\.(png|jpe?g)$/i, ".webp")].some((f) =>
    fs.existsSync(path.join(process.cwd(), "public", f)),
  );

const allPosts = await Astro.glob("../pages/posts/*.md");
const latestPosts = allPosts
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime(),
  )
  .slice(0, 4);
const [featuredPost, ...sidePosts] = latestPosts;

// The tabs, in nav order. The hero shows them as the colour legend.
const tabs = [
  { name: "Projects", href: "#projects", tone: "projects" },
  { name: "Work", href: "#work", tone: "work" },
  { name: "Writing", href: "#writing", tone: "writing" },
  { name: "Film", href: "#film", tone: "film" },
  { name: "Teaching", href: "#teaching", tone: "teaching" },
  { name: "Mind", href: "/mind", tone: "mind" },
];


// The projects strip, newest flagship first. On wide screens the section
// pins and the strip slides sideways as you scroll; on phones it swipes.
const strip = [
  {
    title: "Patient Dashboard",
    line: "Every system at the practice named a patient differently. Now there is one row per patient, every record one click away.",
    href: "/posts/patient-dashboard",
    img: "/patient-dashboard.png",
    badge: "New",
    year: "2026",
    lead: true,
  },
  {
    title: "Capacity Planner",
    line: "Places doctors and assistants across three offices from live Denticon data, every minute.",
    href: "/posts/capacity-planner",
    img: "/capacity-planner.png",
    badge: "New",
    year: "2026",
  },
  {
    title: "Doc Coach",
    line: "Grades every recorded consult against the founder's checklist and sends the doctor a report card.",
    href: "/posts/clinical-rag",
    img: "/doc-coach.png",
    year: "2026",
  },
  {
    title: "NPC Coach",
    line: "Grades new patient calls with a quote behind every score, minutes after the call ends.",
    href: "/posts/npc-coach",
    img: "/npc-coach.png",
    year: "2026",
  },
  {
    title: "Treatment Estimator",
    line: "Prices each quote from the office's own price book and keeps every saved line at its price.",
    href: "/posts/treatment-estimator",
    img: "/treatment-estimator.png",
    year: "2026",
  },
  {
    title: "Hybridge Forms",
    line: "Moved every website lead off Tally and Zapier into our own cloud, straight to Monday.",
    href: "/posts/hybridge-forms",
    img: "/hybridge-forms.png",
    badge: "New",
    year: "2026",
  },
  {
    title: "Reconciliation",
    line: "Reads three daily exports so the insurance team only reads the exceptions.",
    href: "/posts/reconciliation",
    img: "/reconciliation.png",
    year: "2026",
  },
];
const projectCount = info.projects.length;

// The back of each card: the points, numbers and tech from the project's own
// record, so the landing page never says more than the projects page does.
const RECORD: Record<string, string> = {
  "Patient Dashboard": "Patient Dashboard",
  "Capacity Planner": "Capacity Planner",
  "Doc Coach": "Doc Coach, Consultation QA Pipeline",
  "NPC Coach": "NPC Coach",
  "Treatment Estimator": "Treatment Estimator",
  "Hybridge Forms": "Hybridge Forms",
  Reconciliation: "Reconciliation",
};
const cards = strip.map((p) => {
  const rec: any = info.projects.find((x: any) => x.title === RECORD[p.title]);
  const d = rec?.details ?? {};
  return {
    ...p,
    points: (d.highlights ?? []).slice(0, 2) as string[],
    stats: (d.stats ?? []).slice(0, 2) as { value: string; label: string }[],
    tech: (rec?.tech ?? []).slice(0, 3) as string[],
    demo: (rec?.demo as string | undefined) || undefined,
  };
});

const disciplineLines: Record<string, string> = {
  aie: "RAG, agents, evals and guardrails. Systems that answer honestly or not at all.",
  fde: "Sitting with the people who have the problem, then shipping what they needed.",
  mle: "PyTorch, vision, RLHF and forecasting. Models trained, shrunk and shipped.",
  sde: "Python and TypeScript. APIs, pipelines and infrastructure that stay up.",
};

const filmCredits = [
  { title: "Among Monsters", year: "2026", role: "Director · Writer · Editor · Music" },
  { title: "Extraordinary Lives", year: "Soon", role: "Director · Writer" },
  { title: "Tiger Man", year: "2022", role: "Director · Writer · Editor" },
  { title: "Strangers", year: "2019", role: "Cinematographer · Music" },
];

// Short answers for people who skim and for search and AI engines, which
// read the same text as an FAQ in the page's structured data.
const costed = archAll.filter((a) => a.cost);
const costedMonthly = Math.round(costed.reduce((n, a) => n + a.cost!.parts.reduce((s, p) => s + p.usd, 0), 0));
const faq = [
  {
    q: "Who is Sampreeth Avvari?",
    a: "A forward deployed engineer in New York. Sampreeth builds and runs the software at Hybridge Implants, a dental implant group, and writes and directs films as Sampreeth Sharma.",
  },
  {
    q: "What has Sampreeth built at Hybridge Implants?",
    a: "The tools staff use every day: a capacity planner that syncs the practice system every minute, a treatment estimator, Doc Coach and NPC Coach, which grade recorded doctor consults and new patient calls, lead forms that replaced Tally, a marketing warehouse Claude can query, and both public websites. Each one has its own architecture drawing.",
  },
  {
    q: "What has the work changed for the business?",
    a: "About $460K of patient value found that no report showed, about 70 hours a week back for the insurance team, and 1,161 doctor consults and patient calls graded. All 16 projects that touch patient data run under a signed Google Cloud HIPAA BAA.",
  },
  {
    q: "What does a forward deployed engineer do?",
    a: "Sits with the people who have the problem, builds the fix inside their real systems, and stays until it works for them. At Hybridge that means the front desk, finance, marketing and clinical teams, with everything shipped on Google Cloud.",
  },
  {
    q: "How much do these systems cost to run?",
    a: `The ${costed.length} systems with billing history cost about $${costedMonthly} a month together, read from the Google Cloud billing export. Each architecture page shows its own cost and what was tuned to get there.`,
  },
  {
    q: "Is Sampreeth Avvari the same person as Sampreeth Sharma?",
    a: "Yes. Film credits read Sampreeth Sharma, including Among Monsters (2026), an independent crime drama shot in New York and listed on IMDb.",
  },
];
const homeSchema = [
  profilePageNode(Astro.site!.toString(), "/"),
  faqNode(Astro.site!.toString(), "/", faq.map(({ q, a }) => ({ q, a }))),
];

const guides = [...teaching]
  .sort((a, b) => b.addedAt.localeCompare(a.addedAt))
  .slice(0, 2);

// Comets in the one fixed sky, half on each blended colour.
const sky = Array.from({ length: 6 }, (_, i) => ({
  v: i % 2 === 0 ? "--amb1" : "--amb2",
  top: [12, 64, 30, 82, 46, 20][i],
  side: i % 2 === 0 ? "right" : "left",
  inset: 4 + ((i * 11) % 22),
  w: 110 + ((i * 17) % 44),
  rz: [-16, 12, -8, 18, -12, 6][i],
}));
---

<BaseLayout title="Sampreeth Avvari" preloadImage="/pic.avif" schema={homeSchema}>
  <!-- One sky. The comets live in a fixed layer and take their colour from
       the same scroll blend as the ambient wash, so the space itself changes
       colour while the sections scroll over it. -->
  <div class="sky-comets" aria-hidden="true" data-amb>
    {sky.map((c) => (
      <span class="space-el" style={`width:${c.w}px;height:${Math.round(c.w * 0.28)}px;top:${c.top}%;${c.side}:${c.inset}%;`}><span class="comet-glow" style={`--sr-rgb:var(${c.v}, 91,141,239);`}></span><span class="space-comet" style={`--sr-rgb:var(${c.v}, 91,141,239);--rz:${c.rz}deg;`}></span></span>
    ))}
  </div>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section id="home" class="hero relative overflow-hidden" data-tone="home">
    <div class="wrap on-top hero-grid">
      <div class="hero-copy">
        <span class="chip chip-live">Forward deployed engineer · New York</span>
        <h1 class="t-display hero-title">
          I'm Sampreeth.
          <span class="t-tail">I ship in the room.</span>
        </h1>
        <p class="t-lede hero-lede">
          The only engineer at a three office dental implant practice. I find the problem next to the people who have it, build the fix, and run it in production. I also make films.
        </p>
        <ul class="hero-proof" aria-label="In numbers">
          {heroProof.map((p) => (
            <li>
              <a href={p.href}>
                <b>{p.value}</b>
                <span>{p.label}</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">
            See the projects <Icon name="arrow-down" size={15} />
          </a>
          <a href="#contact" class="btn btn-glass">
            Contact <Icon name="mail" size={15} />
          </a>
        </div>
      </div>

      <div class="hero-art">
        <OrbitHero>
          <Picture
            src={info.picture}
            alt={info.picture_alt}
            width={520}
            height={640}
            loading="eager"
            fetchpriority="high"
          />
        </OrbitHero>
      </div>
    </div>
  </section>

  <!-- ── Projects ─────────────────────────────────────────────────────── -->
  <section id="projects" class="proj" data-tone="projects">
    <div class="proj-pin">
      <div class="wrap on-top">
        <div class="sec-head proj-head">
          <div class="sec-head-main">
            <p class="kicker">Projects</p>
            <h2 class="t-h2">
              Things I've built.
              <span class="t-tail">Most of them run a dental practice.</span>
            </h2>
          </div>
          <a href="/projects" class="tlink">All projects <Icon name="arrow-right" size={14} /></a>
        </div>
      </div>

      <div class="proj-viewport on-top">
        <button type="button" class="proj-arrow is-prev" data-row-prev aria-label="Previous projects" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <button type="button" class="proj-arrow is-next" data-row-next aria-label="More projects">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
        <div class="drag-lens" aria-hidden="true">
          <svg class="drag-lens-l" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6" /></svg>
          <span class="drag-lens-label" data-lens-label>Drag</span>
          <svg class="drag-lens-r" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
        </div>
        <div class="proj-clip">
        <ul class="proj-track">
          {cards.map((p, i) => (
            <li class={`proj-item ${p.lead ? "is-lead" : ""}`}>
              <div class="proj-card" data-flip>
                <div class="proj-flip">
                  <button type="button" class="surface proj-face proj-front" data-flip-open aria-label={`${p.title}: show details`}>
                    <span class="proj-media">
                      {hasPublic(p.img) ? (
                        <Picture src={p.img} alt="" width={p.lead ? 900 : 640} height={p.lead ? 560 : 400} class="proj-img" loading={i === 0 ? "eager" : "lazy"} />
                      ) : (
                        <span class="media-fallback proj-img" aria-hidden="true"></span>
                      )}
                      <span class="proj-num t-meta tabular">{String(i + 1).padStart(2, "0")}</span>
                    </span>
                    <span class="proj-body">
                      <span class="t-meta block">
                        {p.badge && <span class="badge badge-tone mr-2">{p.badge}</span>}
                        {p.year}
                      </span>
                      <span class="t-h3 block mt-2">{p.title}</span>
                      <span class="t-small block mt-1.5 line-clamp-2">{p.line}</span>
                      <span class="proj-hint t-meta">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.5 6.2L3 16m0 5v-5h5" /></svg>
                        Details
                      </span>
                    </span>
                  </button>

                  <div class="surface proj-face proj-back" aria-hidden="true" inert>
                    <div class="proj-back-head">
                      <span class="t-meta">
                        {p.badge && <span class="badge badge-tone mr-2">{p.badge}</span>}
                        {p.year}
                      </span>
                      <button type="button" class="proj-close" data-flip-close aria-label="Turn the card back">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.5 6.2L3 16m0 5v-5h5" /></svg>
                      </button>
                    </div>
                    <h3 class="t-h3 mt-3">{p.title}</h3>
                    <p class="t-small mt-1.5">{p.line}</p>
                    {p.stats.length > 0 && (
                      <dl class="proj-stats">
                        {p.stats.map((st) => (
                          <div>
                            <dt class="proj-stat-num">{st.value}</dt>
                            <dd class="t-meta line-clamp-2">{st.label}</dd>
                          </div>
                        ))}
                      </dl>
                    )}
                    {p.points.length > 0 && (
                      <ul class="proj-points">
                        {p.points.map((pt) => <li class="line-clamp-2">{pt}</li>)}
                      </ul>
                    )}
                    {p.tech.length > 0 && (
                      <div class="proj-tech">
                        {p.tech.map((t) => <span class="badge">{t}</span>)}
                      </div>
                    )}
                    <div class="proj-actions">
                      <a href={p.href} class="btn btn-primary btn-sm">
                        Read the case study <Icon name="arrow-right" size={14} class="arrow-r" />
                      </a>
                      {p.demo && (
                        <a href={p.demo} class="btn btn-glass btn-sm">Live demo</a>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </li>
          ))}
          <li class="proj-item is-end">
            <a href="/projects" class="surface proj-card proj-end" data-flip-skip>
              <span class="stat-num">{projectCount}</span>
              <span class="t-h4 mt-3">projects in all</span>
              <span class="t-small mt-2">Every system, research project and side build, with the case study behind each one.</span>
              <span class="tlink mt-6">See them all <Icon name="arrow-right" size={14} /></span>
            </a>
          </li>
        </ul>
        </div>
      </div>

      <div class="wrap on-top proj-foot">
        <span class="proj-hint-row t-meta" data-row-hint>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5M3 12h18" /></svg>
          <span class="hint-fine">Drag, scroll sideways or use the arrows</span>
          <span class="hint-touch">Swipe for more</span>
        </span>
        <span class="proj-bar"></span>
        <span class="t-meta tabular" data-proj-count>01 / {String(strip.length + 1).padStart(2, "0")}</span>
      </div>
    </div>
  </section>

  <!-- ── Architecture ─────────────────────────────────────────────────── -->
  <section id="architecture" class="section" data-tone="architecture">
    <div class="wrap on-top">
      <div class="sec-head" data-reveal>
        <div class="sec-head-main">
          <p class="kicker">Architecture</p>
          <h2 class="t-h2">
            How it is built.
            <span class="t-tail">Every part, every failure path, every dollar a month.</span>
          </h2>
        </div>
        <a href="/architecture" class="tlink">All {archAll.length} drawings <Icon name="arrow-right" size={14} /></a>
      </div>
      <div class:list={["home-arch", `n-${archShown.length}`]}>
        {archShown.map((a, i) => (
          <div class:list={["home-arch-cell", { "is-lead": i === 0 }]} data-reveal>
            <ArchTile arch={a} featured={i === 0} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Work ─────────────────────────────────────────────────────────── -->
  <section id="work" class="section" data-tone="work">
    <div class="wrap on-top">
      <div class="sec-head" data-reveal>
        <div class="sec-head-main">
          <p class="kicker">Work</p>
          <h2 class="t-h2">
            One engineer, four kinds of work.
            <span class="t-tail">Same habit in all four: sit next to the person with the problem first.</span>
          </h2>
        </div>
        <a href="/work" class="tlink">How I work <Icon name="arrow-right" size={14} /></a>
      </div>
      <div class="grid4">
        {disciplines.map((d) => (
          <a href={`/work/${d.slug}`} class="surface surface-pad disc-card" data-reveal>
            <div class="flex items-center justify-between gap-3">
              <span class="badge">{d.acronym}</span>
              <span class="t-meta">{d.projects.length} projects</span>
            </div>
            <h3 class="t-h4 mt-5">{d.name}</h3>
            <p class="t-small mt-2">{disciplineLines[d.slug]}</p>
            <span class="tlink mt-auto pt-5">Open <Icon name="arrow-right" size={14} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Writing ──────────────────────────────────────────────────────── -->
  <section id="writing" class="section" data-tone="writing">
    <div class="wrap on-top">
      <div class="sec-head" data-reveal>
        <div class="sec-head-main">
          <p class="kicker">Writing</p>
          <h2 class="t-h2">
            Notes from the work.
            <span class="t-tail">Real numbers, real screwups, real fixes.</span>
          </h2>
        </div>
        <a href="/posts" class="tlink">All posts <Icon name="arrow-right" size={14} /></a>
      </div>

      <div class="write-grid">
        {featuredPost && (
          <a href={featuredPost.url} class="surface write-lead" data-reveal>
            <div class="surface-media write-lead-media">
              {hasPublic(featuredPost.frontmatter.img_path) ? (
                <Picture
                  src={featuredPost.frontmatter.img_path}
                  alt={featuredPost.frontmatter.img_alt || featuredPost.frontmatter.title}
                  width={900}
                  height={480}
                />
              ) : (
                <div class="media-fallback" aria-hidden="true"><span>Latest</span></div>
              )}
            </div>
            <div class="surface-pad">
              <p class="t-meta">
                <span class="badge badge-tone mr-2">Latest</span>
                {featuredPost.frontmatter.date} · {readingTime(featuredPost.rawContent())} min read
              </p>
              <h3 class="t-h3 write-lead-title">{featuredPost.frontmatter.title}</h3>
              <p class="t-body mt-2 line-clamp-3">{featuredPost.frontmatter.description}</p>
            </div>
          </a>
        )}
        <ul class="write-list">
          {sidePosts.map((post) => (
            <li data-reveal>
              <a href={post.url} class="surface write-item">
                <div class="write-thumb">
                  {hasPublic(post.frontmatter.img_path) ? (
                    <Picture src={post.frontmatter.img_path} alt="" width={240} height={180} />
                  ) : (
                    <div class="media-fallback" aria-hidden="true"></div>
                  )}
                </div>
                <div class="min-w-0">
                  <p class="t-meta">{post.frontmatter.date} · {readingTime(post.rawContent())} min</p>
                  <h3 class="t-h4 mt-1.5 line-clamp-2">{post.frontmatter.title}</h3>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── About ────────────────────────────────────────────────────────── -->
  <section id="about" class="section" data-tone="home">
    <div class="wrap on-top about-grid">
      <div data-reveal>
        <p class="kicker">About</p>
        <h2 class="t-h2 mt-5">
          An engineer
          <span class="t-tail">who happens to make movies.</span>
        </h2>
        <p class="t-body about-text mt-5">{info.about.description}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/resume" class="btn btn-glass btn-sm">Resume and toolkit</a>
          <a href="/projects" class="btn btn-ghost btn-sm">Every project</a>
        </div>
      </div>
      <div class="surface surface-pad about-timeline" data-reveal>
        <CareerTimeline />
      </div>
    </div>
  </section>

  <!-- ── Film ─────────────────────────────────────────────────────────── -->
  <section id="film" class="section" data-tone="film">
    <div class="wrap on-top">
      <div class="sec-head" data-reveal>
        <div class="sec-head-main">
          <p class="kicker">Film</p>
          <h2 class="t-h2">
            Gray characters and tight spaces.
            <span class="t-tail">The chaos hiding inside ordinary lives.</span>
          </h2>
        </div>
        <a href="/filmmaking" class="tlink">The full slate <Icon name="arrow-right" size={14} /></a>
      </div>

      <div class="film-stage">
        <a href="/filmmaking#among-monsters" class="film-poster" data-reveal aria-label="Among Monsters, the feature I wrote and directed">
          <Picture src="/among-monsters-poster.webp" alt="Among Monsters poster" width={1600} height={900} class="film-poster-img" />
          <span class="film-poster-tag">
            <span class="badge badge-tone">Premiering 2026</span>
            <span class="badge">New York</span>
          </span>
        </a>

