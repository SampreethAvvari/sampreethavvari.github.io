  .hero-proof li + li a { padding-left: 16px; }
  /* Scoped styles add an attribute to every element in a selector, so the
     reset needs the same shape (li + li) to outweigh the rule above; without
     it the third number sat 16px in from the first. */
  @media (max-width: 719px) {
    .hero-proof li:nth-child(odd) a,
