  }

  .grid4 { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .grid4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .grid4 { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; } }
  .disc-card { display: flex; flex-direction: column; }
  /* Stacked on a phone each card sizes to its words; side by side they share
     one height. */
  @media (min-width: 640px) { .disc-card { min-height: 230px; } }
  /* Four in a row: names take two lines' room, so every description starts
     on the same line. */
  @media (min-width: 1024px) { .disc-card .t-h4 { min-height: calc(2em * 1.35); } }

  /* Writing */
  .write-grid { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 1024px) { .write-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 20px; } }
  .write-lead { display: flex; flex-direction: column; }
  .write-lead-media { aspect-ratio: 2 / 1; }
  .write-lead-title { margin-top: 12px; font-size: clamp(1.25rem, 2vw, 1.5rem); line-height: 1.22; }
  .write-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  @media (min-width: 1024px) { .write-list { gap: 20px; grid-template-rows: repeat(3, 1fr); } }
  .write-item { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 16px; align-items: center; padding: 12px; height: 100%; }
  .write-thumb { width: 96px; height: 76px; border-radius: 12px; overflow: hidden; background: #07080b; border: 1px solid var(--line); }
  .write-thumb :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Film: the poster is the attention, everything else sits beside it in
     one screen. */
  .film-stage { display: grid; gap: 20px; grid-template-columns: 1fr; align-items: stretch; }
  @media (min-width: 1024px) {
    .film-stage { grid-template-columns: minmax(0, 7.2fr) minmax(0, 4.8fr); gap: 24px; }
    /* Side by side, the poster takes the height of the column beside it and
       crops around its centre, where the title and the figure are. */
    .film-poster { aspect-ratio: auto; min-height: 360px; }
    .film-poster :global(.film-poster-img) { object-position: 50% 42%; }
  }
  .film-poster {
    position: relative;
    display: block;
    align-self: stretch;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: 22px;
    aspect-ratio: 16 / 9;
    background: #07080b;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 40px 90px -40px rgba(0, 0, 0, 1),
      0 0 120px -30px rgba(var(--tone-rgb), 0.45);
    transition: transform 400ms var(--ease-glass), box-shadow 400ms var(--ease-glass), border-color 200ms var(--ease-glass);
  }
  .film-poster:hover {
    transform: translateY(-3px);
    border-color: rgba(var(--tone-rgb), 0.4);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 50px 100px -40px rgba(0, 0, 0, 1),
      0 0 140px -24px rgba(var(--tone-rgb), 0.6);
  }
  /* The image fills the frame and never sizes it, so the frame follows its
     column at every width. */
  .film-poster :global(.film-poster-img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-glass);
  }
  .film-poster:hover :global(.film-poster-img) { transform: scale(1.03); }
  .film-poster-tag { position: absolute; z-index: 1; left: 14px; top: 14px; display: flex; gap: 6px; }
  .film-poster-tag .badge { background: rgba(0, 0, 0, 0.55); }
  .film-poster-tag .badge-tone { background: rgba(var(--tone-rgb), 0.22); }
  .film-side {
    display: flex;
    flex-direction: column;
    padding: 4px 4px 0;
  }
  @media (min-width: 1024px) { .film-side { padding: 6px 4px 0 8px; } }
  .film-more { margin-top: 26px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
  .film-list { list-style: none; margin: 0; padding: 0; }
  .film-list li { border-bottom: 1px solid var(--line); }
  .film-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 11px 2px;
    text-decoration: none;
    color: var(--ink);
    transition: padding 250ms var(--ease-glass), background-color 150ms var(--ease-glass);
  }
  .film-row:hover { padding-inline: 10px; background: var(--wash); }
  .film-row-title { font-size: 0.9375rem; font-weight: 600; letter-spacing: -0.012em; }

  /* Teaching */
  .teach-grid { display: grid; gap: 16px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .teach-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; } }
  .teach-card { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 20px; padding: 16px; }
  @media (min-width: 640px) { .teach-card { grid-template-columns: 150px minmax(0, 1fr); gap: 24px; padding: 20px; } }
  .teach-cover { border-radius: 12px; overflow: hidden; aspect-ratio: 3 / 4; background: #07080b; border: 1px solid var(--line); }
  .teach-cover :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .teach-body { display: flex; flex-direction: column; align-items: flex-start; padding-block: 4px; }

  /* Quick answers: two equal lanes; an open answer grows on its own. */
  .faq-grid { display: grid; gap: 14px; grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 900px) { .faq-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 20px; } }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 18px 22px;
    cursor: pointer;
    list-style: none;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    color: var(--ink);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:focus-visible { outline: 2px solid rgba(var(--tone-rgb), 0.6); outline-offset: -2px; border-radius: 20px; }
  .faq-mark {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    transition: transform 300ms var(--ease-glass), border-color 200ms var(--ease-glass);
  }
  .faq-mark::before,
  .faq-mark::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1.5px;
    border-radius: 2px;
    background: var(--ink-soft);
    transform: translate(-50%, -50%);
  }
  .faq-mark::after { transform: translate(-50%, -50%) rotate(90deg); }
  .faq-item[open] .faq-mark { transform: rotate(45deg); border-color: rgba(var(--tone-rgb), 0.5); }
  .faq-item summary:hover .faq-mark { border-color: rgba(var(--tone-rgb), 0.5); }
  .faq-item p { padding: 0 22px 22px; margin: 0; color: var(--ink-soft); max-width: 38rem; }

  .contact-socials { display: inline-flex; align-items: center; gap: 12px; }

  /* About */
  .about-grid { display: grid; gap: 40px; grid-template-columns: 1fr; align-items: start; }
  @media (min-width: 1024px) { .about-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; } }
  .about-text { max-width: 36rem; font-size: 1rem; }
  .about-timeline { overflow: hidden; }
</style>

<script>
  import { initAmbient, initComets, pauseOffscreen } from "../scripts/spatial";

  // Cards turn around on click to show their details; nothing navigates
  // until a button on the back is chosen. One card is turned at a time, focus
  // moves to the face that is showing, and Escape turns it back.
  (function () {
    const flips = Array.from(document.querySelectorAll<HTMLElement>("[data-flip]"));
    let open: HTMLElement | null = null;
    const setFlipped = (card: HTMLElement, on: boolean, focus = true) => {
      const front = card.querySelector<HTMLElement>(".proj-front");
      const back = card.querySelector<HTMLElement>(".proj-back");
      if (!front || !back) return;
      card.classList.toggle("is-flipped", on);
      back.toggleAttribute("inert", !on);
      back.setAttribute("aria-hidden", on ? "false" : "true");
      front.toggleAttribute("inert", on);
      front.setAttribute("aria-hidden", on ? "true" : "false");
      if (focus) {
        // Move focus once the turn has passed its middle.
        window.setTimeout(() => {
          if (on) back.querySelector<HTMLElement>("a, button")?.focus({ preventScroll: true });
          else front.focus({ preventScroll: true });
        }, 260);
      }
      if (on) open = card;
      else if (open === card) open = null;
    };
    flips.forEach((card) => {
      card.querySelector("[data-flip-open]")?.addEventListener("click", () => {
        if (open && open !== card) setFlipped(open, false, false);
        setFlipped(card, true);
      });
      card.querySelector("[data-flip-close]")?.addEventListener("click", () => setFlipped(card, false));
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) setFlipped(open, false);
    });
  })();

  // The projects row. Sideways scroll comes from the trackpad, a swipe or the
  // arrows, which move one screen of cards at a time; the browser snaps each
  // card to the margin. The bar has one segment per page and fills as the row
  // moves; landing on a new page gives its segment and the counter a small
  // spring.
  (function () {
    const sec = document.getElementById("projects");
    const track = sec?.querySelector<HTMLElement>(".proj-track");
    const prev = sec?.querySelector<HTMLButtonElement>("[data-row-prev]");
    const next = sec?.querySelector<HTMLButtonElement>("[data-row-next]");
    const bar = sec?.querySelector<HTMLElement>(".proj-bar");
    const count = sec?.querySelector<HTMLElement>("[data-proj-count]");
    if (!sec || !track || !bar) return;
    const items = Array.from(track.querySelectorAll<HTMLElement>(".proj-item"));
    let segs: HTMLElement[] = [];
    let page = -1;
    let raf = 0;

    const pages = () => Math.max(1, Math.ceil((track.scrollWidth - 1) / Math.max(1, track.clientWidth)));
    const buildSegs = () => {
      const n = pages();
      if (segs.length === n) return;
      bar.innerHTML = "";
      segs = Array.from({ length: n }, () => {
        const g = document.createElement("span");
        g.className = "proj-seg";
        g.appendChild(document.createElement("i"));
        bar.appendChild(g);
        return g;
      });
      page = -1;
    };
    const tick = (el: HTMLElement | null | undefined) => {
      if (!el) return;
      el.classList.remove("tick");
      void el.offsetWidth;
      el.classList.add("tick");
    };

    const paint = () => {
      raf = 0;
      const max = Math.max(1, track.scrollWidth - track.clientWidth);
      const x = track.scrollLeft;
      if (prev) prev.disabled = x < 4;
      if (next) next.disabled = x > max - 4;
      const n = segs.length;
      const pos = (x / max) * (n - 1); // fractional page
      segs.forEach((g, i) => {
        const fill = g.firstElementChild as HTMLElement | null;
        const v = Math.min(1, Math.max(0, pos + 1 - i));
        if (fill) fill.style.transform = `scaleX(${v.toFixed(3)})`;
      });
      const now = Math.round(pos);
      if (now !== page) {
        const first = page === -1;
        page = now;
        segs.forEach((g, i) => g.classList.toggle("is-on", i === now));
        if (!first) {
          tick(segs[now]);
          tick(count);
        }
      }
      // The counter names the first card fully on screen.
      const start = items[0]?.offsetLeft ?? 0;
      let first = items.findIndex((li) => li.offsetLeft - x >= start - 8);
      if (first < 0) first = items.length - 1;
      if (x > max - 4) first = items.length - 1;
      if (count) count.textContent = `${String(first + 1).padStart(2, "0")} / ${String(items.length).padStart(2, "0")}`;
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(paint); };

    const step = (dir: number) => {
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      track.scrollBy({ left: dir * track.clientWidth * 0.8, behavior: reduce ? "auto" : "smooth" });
    };
    // The hint goes once someone has moved the row.
    const hint = sec.querySelector<HTMLElement>("[data-row-hint]");
    let interacted = false;
    const settle = () => {
      if (interacted) return;
      interacted = true;
      hint?.classList.add("is-gone");
    };
    window.setTimeout(() => hint?.classList.add("is-gone"), 12000);

    // A peek the first time the row is in view.
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce && "IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        if (!entries[0]?.isIntersecting) return;
        io.disconnect();
        if (track.scrollLeft > 4 || interacted) return;
        window.setTimeout(() => {
          track.classList.add("is-peek");
          track.addEventListener("animationend", () => track.classList.remove("is-peek"), { once: true });
        }, 350);
      }, { threshold: 0.55 });
      io.observe(track);
    }

    // Press and fling with a mouse, with momentum, then snap to a card. A
    // press that does not travel is still a click, so cards still turn.
    const lens = sec.querySelector<HTMLElement>(".drag-lens");
    const lensLabel = sec.querySelector<HTMLElement>("[data-lens-label]");
    let down = false;
    let moved = false;
    let startX = 0;
    let startLeft = 0;
    let lastX = 0;
    let lastT = 0;
    let vel = 0;
    let glideRaf = 0;
    const snapToNearest = () => {
      track.classList.remove("is-dragging");
    };
    track.addEventListener("pointerdown", (e) => {
      if (e.pointerType !== "mouse" || e.button !== 0) return;
      if ((e.target as HTMLElement).closest("a, .proj-close")) return;
      down = true;
      moved = false;
      startX = lastX = e.clientX;
      startLeft = track.scrollLeft;
      lastT = performance.now();
      vel = 0;
      cancelAnimationFrame(glideRaf);
      lens?.classList.add("is-down");
    });
    window.addEventListener("pointermove", (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (!moved && Math.abs(dx) > 6) {
        moved = true;
        track.classList.add("is-dragging");
        settle();
        if (lensLabel) lensLabel.textContent = "Drag";
      }
      if (!moved) return;
      track.scrollLeft = startLeft - dx;
      const now = performance.now();
      vel = (e.clientX - lastX) / Math.max(1, now - lastT);
      lastX = e.clientX;
      lastT = now;
    });
    window.addEventListener("pointerup", () => {
      if (!down) return;
      down = false;
      lens?.classList.remove("is-down");
      if (!moved) return;
      let v = -vel * 16;
      const glide = () => {
        v *= 0.93;
        track.scrollLeft += v;
        if (Math.abs(v) > 0.4) glideRaf = requestAnimationFrame(glide);
        else snapToNearest();
      };
      glideRaf = requestAnimationFrame(glide);
    });
    // A drag must not also click the card under it.
    track.addEventListener(
      "click",
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      },
      true,
    );

    // The lens follows the pointer and names what a press will do.
    if (lens && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      let lx = 0;
      let ly = 0;
      let lensRaf = 0;
      const place = () => {
        lensRaf = 0;
        lens.style.left = `${lx}px`;
        lens.style.top = `${ly}px`;
      };
      track.addEventListener("pointermove", (e) => {
        lx = e.clientX;
        ly = e.clientY;
        if (!lensRaf) lensRaf = requestAnimationFrame(place);
        const t = e.target as HTMLElement;
        const overLink = !!t.closest("a, .proj-close");
        lens.classList.toggle("is-off", overLink);
        lens.classList.add("is-on");
        if (!down && lensLabel) {
          const front = t.closest(".proj-front");
          const flipped = t.closest(".is-flipped");
          lensLabel.textContent = front && !flipped ? "Details" : "Drag";
        }
      });
      track.addEventListener("pointerleave", () => lens.classList.remove("is-on"));
    }
    track.addEventListener("wheel", (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) settle(); }, { passive: true });
    track.addEventListener("touchstart", settle, { passive: true, once: true });

    prev?.addEventListener("click", () => { settle(); step(-1); });
    next?.addEventListener("click", () => { settle(); step(1); });
    track.addEventListener("scroll", queue, { passive: true });
    window.addEventListener("resize", () => { buildSegs(); queue(); });
    window.addEventListener("load", () => { buildSegs(); queue(); });
    buildSegs();
    paint();
  })();

  initComets(".space-el");
  // The running drawing and the timeline's live head stop ticking while
  // they are far off screen.
  pauseOffscreen(".tile-live, .career-tl");
  // The background wash follows the section in view, so the sky takes each
  // tab's colour as you scroll past its preview.
  initAmbient(
    [
      ["91,141,239", "34,211,238"],
      ["91,141,239", "91,141,239"],
      ["34,211,238", "34,211,238"],
      ["245,165,36", "245,165,36"],
      ["52,211,153", "52,211,153"],
      ["91,141,239", "167,139,250"],
      ["244,63,94", "244,63,94"],
      ["52,211,153", "52,211,153"],
      ["91,141,239", "34,211,238"],
    ],
    // Page order: the promise, then proof (projects, drawings, how I work,
    // the notes), then the person (about, film, teaching), then contact.
    ["home", "projects", "architecture", "work", "writing", "about", "film", "teaching", "contact"],
  );
</script>
