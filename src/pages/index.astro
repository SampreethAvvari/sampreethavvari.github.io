  .proj-track.is-dragging { scroll-snap-type: none; cursor: none; user-select: none; }
  .proj-track.is-dragging .proj-item:hover .proj-card { transform: none; }
  .proj-track :global(img) { -webkit-user-drag: none; user-select: none; }
  .drag-lens {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 80;
    display: none;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding: 0 12px;
    border-radius: 9999px;
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 500;
    white-space: nowrap;
