<script>
  import {
    initGlare,
    initTilt,
    initMagnetic,
    initArrive,
    initCountUps,
    initAmbient,
    initComets,
  } from "../scripts/spatial";

  initGlare(".pane-glare");
  initTilt("[data-tilt]");
  initMagnetic("[data-magnetic]");
  initArrive("[data-arrive]");
  initCountUps("[data-count]");
  initComets(".space-el");
  // Ambient colour flow anchored to the real section positions, so each
  // section shows its own hue: hero blue/cyan, disciplines violet/amber,
  // work amber, about blue, writing emerald, film red, contact brand blue.
  initAmbient(
    [
      ["91,141,239", "34,211,238"],
      ["167,139,250", "245,165,36"],
      ["245,165,36", "245,165,36"],
      ["91,141,239", "91,141,239"],
      ["52,211,153", "91,141,239"],
      ["244,63,94", "244,63,94"],
      ["0,102,204", "34,211,238"],
    ],
    ["home", "disciplines", "work", "about", "writing", "filmmaking", "contact"],
  );

  // The work deck, derived from one number per card: its depth in the stack.
  //
  // Wide screens with motion allowed: all cards share a single grid cell,
  // stacked like a hand of cards. The deck pins to the screen while its tall
  // track scrolls past, and scroll progress becomes a front index f that runs
  // 0 to n minus 1. Each card's depth follows from f:
  //
  //   waiting (i >= f): d = i - f, sits BELOW the front card:
  //                     translateY(+YSTEP * d) scale(1 - SCALE * d)
  //   passed  (i < f):  a = min(f - i, 1), older = max(f - i - 1, 0),
  //                     lifts up and parks ABOVE the front card, wallet style,
  //                     with an extra arc of lift that peaks mid trip:
  //                     translateY(-(UPY * a + UPGAP * older + ARC * sin(pi a)))
  //                     scale(1 - UPSCALE * a - UPSCALEGAP * older)
  //
  // So the sharp front card sits in the middle, the cards still to come peek
  // out as even strips below its bottom edge, and the cards already passed
  // peek out as even strips above its top edge, the most recent one nearest.
  // Every pose is a pure function of f, so scrolling up replays the whole
  // thing in reverse and a passed card comes back down from the top strips
  // into the front slot.
  //
  // Depth cueing is brightness only. Never opacity: the cards overlap, and a
  // translucent card lets the text behind it bleed through.
  (function () {
    const section = document.getElementById("work");
    const track = document.querySelector<HTMLElement>(".deck-track");
    const pin = document.querySelector<HTMLElement>(".deck-pin");
    const deckEl = document.querySelector<HTMLElement>(".deck");
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(".deck-item"),
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(".deck-card"),
    );
    const n = cards.length;
    if (!track || !pin || !deckEl || n < 2 || items.length !== n) return;

    // Reduced motion: the CSS lays the cards out as a plain vertical list.
    // Clear anything inline and stay out of the way.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      track.style.height = "";
      pin.style.top = "";
      cards.forEach((c) => {
        c.style.transform = "";
        c.style.transformOrigin = "";
        c.style.filter = "";
        c.style.pointerEvents = "";
      });
      items.forEach((li) => {
        li.style.zIndex = "";
      });
      return;
    }

    // The whole feel lives in these numbers.
    const STEP = 0.85; // screens of scroll per handoff
    const HOLD = 0.3; // fraction of a step where the front card holds still
    const YSTEP = 24; // px of drop per unit of waiting depth
    const SCALE = 0.045; // shrink per unit of waiting depth
    const UPY = 20; // px the newest passed card peeks above the front card
    const UPGAP = 12; // extra lift per earlier passed card
    const ARC = 36; // extra mid trip lift: the card pulls out, then settles
    const UPSCALE = 0.06; // shrink of a freshly passed card
    const UPSCALEGAP = 0.02; // extra shrink per earlier passed card

    const desktop = () => window.innerWidth >= 1024;

    // Arm the desktop stacking CSS. Without JS the class never lands, the
    // grid overlap never applies, and the page stays a readable list.
    track.classList.add("deck-on");

    // The section decor reads its colour from the front card, crossfading
    // between the two cards involved in the current handoff.
    const rgbs = items.map((li) =>
      (li.dataset.rgb || "245,165,36").split(",").map((v) => parseFloat(v)),
    );
    const tint = (a: number, b: number, f: number) => {
      if (!section || !rgbs[a] || !rgbs[b]) return;
      const mix = [0, 1, 2].map((j) =>
        Math.round(rgbs[a][j] + (rgbs[b][j] - rgbs[a][j]) * f),
      );
      section.style.setProperty("--work-rgb", mix.join(","));
      section.style.setProperty("--work-hex", `rgb(${mix.join(",")})`);
    };

    // The track must be exactly deck height plus one step of scroll per
    // handoff, and it must be HEIGHT, not padding: a sticky child can only
    // roam its parent's content box. CSS holds an estimate; this writes the
    // real number.
    const measure = () => {
      if (!desktop()) {
        track.style.height = "";
        pin.style.top = "";
        return;
      }
      const deck = pin.offsetHeight;
      if (!deck) return;
      // Ceiling for the pin line: where the deck rests in normal flow,
      // measured from the top of the section. Pin any lower than this and
      // sticky yanks the deck DOWN to meet the pin line as the section
      // arrives, which reads as the card dropping before its run starts.
      const rest = section
        ? Math.round(
            track.getBoundingClientRect().top -
              section.getBoundingClientRect().top,
          )
        : Infinity;
      // Pin near the top, not centred: the deck rides in right behind the
      // section heading and sticks just under the nav, so the first hand off
      // starts on the very next scroll with no dead travel and no drop.
      // 136px = 76px of nav clearance plus headroom for the passed cards,
      // whose strips and mid trip arc reach about 47px above the front card.
      pin.style.top = `${Math.max(76, Math.min(136, rest))}px`;
      track.style.height = `${Math.round(deck + (n - 1) * window.innerHeight * STEP)}px`;
    };

    const paintDesktop = () => {
      const r = track.getBoundingClientRect();
      const span = Math.max(r.height - pin.offsetHeight, 1);
      const pinTop = parseFloat(getComputedStyle(pin).top) || 0;
      const scrolled = Math.min(Math.max(pinTop - r.top, 0), span);
      const p = (scrolled / span) * (n - 1);

      // Progress inside the current step, with a dwell: the front card does
      // not move at all for the first HOLD of its step, then eases away on a
      // smootherstep, reluctant to leave and settling softly.
      const step = Math.max(0, Math.min(Math.floor(p), n - 2));
      const u = p - step;
      const t = u <= HOLD ? 0 : Math.min((u - HOLD) / (1 - HOLD), 1);
      const e = t * t * t * (t * (t * 6 - 15) + 10);
      const f = step + e;

      tint(step, Math.min(step + 1, n - 1), e);

      for (let i = 0; i < n; i++) {
        const card = cards[i];
        const s = f - i; // how far past this card the front line has moved
        let y: number;
        let k: number;
        let bright: number;
        let z: number;
        let pass = 0; // mid trip amount, nonzero only for the moving card

        if (s <= 0) {
          // Waiting: stacked behind and BELOW the front card. The CSS origin
          // is the bottom edge, so each strip below stays even as it shrinks.
          const d = -s;
          y = YSTEP * d;
          k = 1 - SCALE * d;
          bright = Math.max(1 - 0.15 * d, 0.5);
          z = 1000 - Math.round(d * 100);
          card.style.transformOrigin = "";
        } else {
          // Passed: lifted behind and ABOVE the front card, wallet style, so
          // its top edge peeks out over the front card as an even strip. The
          // origin moves to the top edge so the strip keeps its height while
          // the card shrinks; the switch happens at s = 0, where the pose is
          // the identity transform, so nothing jumps.
          const a = Math.min(s, 1); // its own trip up, 0 to 1
          const older = Math.min(Math.max(s - 1, 0), n); // handoffs since
          pass = s < 1 ? Math.sin(Math.PI * a) : 0;
          // The trip is an arc: besides the ride to its parked strip, ARC of
          // extra lift that peaks mid trip and settles back to zero, so the
          // card visibly pulls up out of the stack, travels over the deck,
          // and slots into the top strips.
          y = -(UPY * a + UPGAP * older + ARC * pass);
          k = 1 - UPSCALE * a - UPSCALEGAP * older;
          bright = Math.max(1 - 0.4 * a - 0.05 * older, 0.5);
          // Below the front card, above older passed cards. This z falls by
          // 150 over the trip while the arriving card's climbs by 100, so
          // they cross at a = 0.4, under the blur that masks the swap.
          z = 1000 - Math.round(a * 150) - Math.round(older * 50);
          card.style.transformOrigin = "50% 0%";
        }

        card.style.transform = `translate3d(0, ${y.toFixed(1)}px, 0) scale(${k.toFixed(4)})`;
        // Depth cueing is brightness, never opacity. The card on the move
        // dips a touch darker with up to 2px of blur at the middle of its
        // trip, which masks the moment it slips behind the arriving card.
        bright *= 1 - 0.12 * pass;
        card.style.filter =
          pass > 0.02
            ? `brightness(${bright.toFixed(3)}) blur(${(2 * pass).toFixed(2)}px)`
            : bright < 0.999
              ? `brightness(${bright.toFixed(3)})`
              : "";
        // Depth decides what covers what. The z-index has to go on the <li>:
        // each grid item is its own stacking context, so a z-index on the
        // inner div would do nothing.
        items[i].style.zIndex = `${z}`;
        // Only the front card takes clicks.
        card.style.pointerEvents = Math.abs(s) < 0.5 ? "auto" : "none";
      }
    };

    // Phones: the CSS swipe deck does the layout. The centred card is full
    // size, neighbours shrink and dim by brightness, never opacity.
    const paintMobile = () => {
      const mid = window.innerWidth / 2;
      let nearest = 0;
      let best = Infinity;
      for (let i = 0; i < n; i++) {
        const card = cards[i];
        const r = card.getBoundingClientRect();
        const off = Math.min(
          Math.abs(r.left + r.width / 2 - mid) / (r.width || 1),
          1,
        );
        if (off < best) {
          best = off;
          nearest = i;
        }
        card.style.transform = `scale(${(1 - 0.14 * off).toFixed(4)})`;
        card.style.transformOrigin = "";
        card.style.filter =
          off > 0.02 ? `brightness(${(1 - 0.4 * off).toFixed(3)})` : "";
        card.style.pointerEvents = "";
        items[i].style.zIndex = "";
      }
      tint(nearest, nearest, 0);
    };

    let queued = false;
    const paint = () => {
      queued = false;
      if (desktop()) paintDesktop();
      else paintMobile();
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };
    const remeasure = () => {
      measure();
      onScroll();
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    deckEl.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", remeasure);
    window.addEventListener("load", remeasure);
    if ("ResizeObserver" in window) {
      new ResizeObserver(remeasure).observe(pin);
    }
    measure();
    paint();
  })();

  // Progress rail: highlight the dot for the section in view.
  (function () {
    const links = new Map<string, HTMLElement>();
    document
      .querySelectorAll<HTMLElement>(".rail a[data-rail]")
      .forEach((a) => links.set(a.dataset.rail || "", a));
    if (!links.size || !("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          if (!en.isIntersecting) continue;
          links.forEach((a) => a.classList.remove("on"));
          links.get(en.target.id)?.classList.add("on");
        }
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: 0 },
    );
    links.forEach((_, id) => {
      const s = document.getElementById(id);
      if (s) io.observe(s);
    });
  })();
</script>
