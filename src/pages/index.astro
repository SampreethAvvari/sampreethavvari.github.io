---
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../layouts/BaseLayout.astro";
import { info } from "../data/info";
import { disciplines } from "../data/disciplines";
import { teaching } from "../data/teaching";
import Picture from "../components/common/Picture.astro";
import Icon from "../components/common/Icon.astro";
import GlassHero from "../components/hero/GlassHero.astro";
import CareerTimeline from "../components/about_section/CareerTimeline.astro";
import { readingTime } from "../utils/readingTime";

// A cover only renders when its file exists, so a project whose art is still
// being made shows a calm panel instead of a broken image.
// The repo keeps the optimised .avif/.webp siblings, not always the .png.
const hasPublic = (p?: string) =>
  !!p &&
  [p, p.replace(/\.(png|jpe?g)$/i, ".avif"), p.replace(/\.(png|jpe?g)$/i, ".webp")].some((f) =>
    fs.existsSync(path.join(process.cwd(), "public", f)),
  );

const allPosts = await Astro.glob("../pages/posts/*.md");
const latestPosts = allPosts
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime(),
  )
  .slice(0, 4);
const [featuredPost, ...sidePosts] = latestPosts;

// The tabs, in nav order. The hero shows them as the colour legend.
const tabs = [
  { name: "Projects", href: "#projects", tone: "projects" },
  { name: "Work", href: "#work", tone: "work" },
  { name: "Writing", href: "#writing", tone: "writing" },
  { name: "Film", href: "#film", tone: "film" },
  { name: "Teaching", href: "#teaching", tone: "teaching" },
  { name: "Mind", href: "/mind", tone: "mind" },
];

// Numbers that are already told in full in a post.
const proof = [
  { value: "70 hrs", label: "a week handed back to a three person insurance team", href: "/posts/reconciliation" },
  { value: "$98K", label: "vendor quote replaced by a tool that costs under $50 a month", href: "/posts/cbct-scan-validator" },
  { value: "400 hrs", label: "a year handed back to our accountant", href: "/posts/accounting-automation" },
  { value: "1 engineer", label: "from the first interview with the team to the deploy, on every system here", href: "/projects" },
];

// The projects shown on the landing page, newest flagship first.
const lead = {
  title: "Patient Dashboard",
  line:
    "Every system at the practice named a patient differently. Now there is one row per patient, every record one click away, read live from the practice's own scheduling system and never written back.",
  href: "/posts/patient-dashboard",
  img: "/patient-dashboard.png",
  meta: "Hybridge Implants · 2026",
};
const side = [
  {
    title: "Enterprise Search",
    line: "Company search that cites its sources, or says it does not know.",
    href: "/posts/enterprise-search",
    img: "/enterprise-search.png",
  },
  {
    title: "Doc Coach",
    line: "Grades every patient consult against the founder's checklist and coaches the doctor.",
    href: "/posts/clinical-rag",
    img: "/doc-coach.png",
  },
];
const row = [
  {
    title: "Capacity Planner",
    line: "Places doctors and assistants across three offices without burning anyone out.",
    href: "/posts/capacity-planner",
    img: "/capacity-planner.png",
  },
  {
    title: "Scan Validator",
    line: "Catches bad CT scans before they reach the design team.",
    href: "/posts/cbct-scan-validator",
    img: "/cbct-validator.png",
  },
  {
    title: "Reconciliation",
    line: "Reads three daily exports so the insurance team only reads the exceptions.",
    href: "/posts/reconciliation",
    img: "/reconciliation.png",
  },
];

const jobRows = [
  { score: "96", left: "Forward Deployed Engineer", right: "Marrowstone AI" },
  { score: "94", left: "AI Engineer, Applied Models", right: "Osprey Compute" },
  { score: "91", left: "ML Engineer, Risk", right: "Bluewater Ledger" },
  { score: "88", left: "AI Engineer, Insights", right: "Driftwood Metrics" },
];

const disciplineLines: Record<string, string> = {
  aie: "RAG, agents, evals and guardrails. Systems that answer honestly or not at all.",
  fde: "Sitting with the people who have the problem, then shipping what they needed.",
  mle: "PyTorch, vision, RLHF and forecasting. Models trained, shrunk and shipped.",
  sde: "Python and TypeScript. APIs, pipelines and infrastructure that stay up.",
};

const filmCredits = [
  { title: "Among Monsters", year: "2026", role: "Director · Writer · Editor · Music" },
  { title: "Extraordinary Lives", year: "Soon", role: "Director · Writer" },
  { title: "Tiger Man", year: "2022", role: "Director · Writer · Editor" },
  { title: "Strangers", year: "2019", role: "Cinematographer · Music" },
];

const guides = [...teaching]
  .sort((a, b) => b.addedAt.localeCompare(a.addedAt))
  .slice(0, 2);

// Comets per section, in that section's colour.
const comets = (rgb: string, n: number, seed: number) =>
  Array.from({ length: n }, (_, i) => ({
    rgb,
    top: [10, 46, 78, 24, 62][(i + seed) % 5],
    side: (i + seed) % 2 === 0 ? "right" : "left",
    inset: 4 + (((i + seed) * 11) % 22),
    w: 108 + (((i + seed) * 17) % 44),
    rz: [-16, 12, -8, 18, -12][(i + seed) % 5],
  }));
const RGB = {
  projects: "91,141,239",
  work: "245,165,36",
  writing: "52,211,153",
  film: "244,63,94",
  teaching: "34,211,238",
  home: "91,141,239",
};
---

<BaseLayout title="Sampreeth Avvari" preloadImage="/pic.avif">
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section id="home" class="hero relative overflow-hidden" data-tone="home">
    <GlassHero />
    <span class="glow" style="width:620px;height:620px;--gc:#5B8DEF;top:-120px;left:-140px;" aria-hidden="true"></span>
    <span class="glow glow-2" style="width:520px;height:520px;--gc:#22D3EE;bottom:-120px;right:-80px;" aria-hidden="true"></span>
    {comets(RGB.home, 4, 0).map((c) => (
      <span class="space-el" style={`width:${c.w}px;height:${Math.round(c.w * 0.28)}px;top:${c.top}%;${c.side}:${c.inset}%;`} aria-hidden="true"><span class="comet-glow" style={`--sr-rgb:${c.rgb};`}></span><span class="space-comet" style={`--sr-rgb:${c.rgb};--rz:${c.rz}deg;`}></span></span>
    ))}

    <div class="wrap on-top hero-grid">
      <div class="hero-copy">
        <span class="chip chip-live">AI engineer at Hybridge Implants · New York</span>
        <h1 class="t-display hero-title">
          I'm Sampreeth.
          <span class="t-tail">I ship AI and direct films.</span>
        </h1>
        <p class="t-lede hero-lede">
          Whether it's a model or a movie, the job is making the messy thing
          make sense to someone else. Right now that means the systems a dental
          implant practice runs on, every day.
        </p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-primary">
            See the projects <Icon name="arrow-down" size={15} />
          </a>
          <a href="https://hi.switchy.io/zIhU" target="_blank" rel="noopener" class="btn btn-glass">
            Try JobPilot <Icon name="arrow-up-right" size={15} class="arrow-ur" />
          </a>
          <a href="/posts" class="btn btn-ghost">Read the writing</a>
        </div>
        <nav class="hero-legend" aria-label="Sections">
          <span class="t-meta">Every colour is a place on the site</span>
          <div class="hero-legend-chips">
            {tabs.map((t) => (
              <a href={t.href} class="chip chip-dot" data-tone={t.tone}>{t.name}</a>
            ))}
          </div>
        </nav>
      </div>

      <figure class="hero-portrait">
        <Picture
          src={info.picture}
          alt={info.picture_alt}
          width={520}
          height={640}
          class="hero-portrait-img"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="sr-only">{info.name}</figcaption>
      </figure>
    </div>
  </section>

  <!-- ── Proof ────────────────────────────────────────────────────────── -->
  <section class="proof" data-tone="home" aria-label="In numbers">
    <div class="wrap">
      <ul class="proof-grid">
        {proof.map((p) => (
          <li>
            <a href={p.href} class="proof-item">
              <span class="stat-num">{p.value}</span>
              <span class="stat-cap">{p.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Projects ─────────────────────────────────────────────────────── -->
  <section id="projects" class="section overflow-hidden" data-tone="projects">
    <div class="tone-atmos" aria-hidden="true"></div>
    {comets(RGB.projects, 3, 1).map((c) => (
      <span class="space-el" style={`width:${c.w}px;height:${Math.round(c.w * 0.28)}px;top:${c.top}%;${c.side}:${c.inset}%;`} aria-hidden="true"><span class="comet-glow" style={`--sr-rgb:${c.rgb};`}></span><span class="space-comet" style={`--sr-rgb:${c.rgb};--rz:${c.rz}deg;`}></span></span>
    ))}
    <div class="wrap on-top">
      <div class="sec-head" data-reveal>
        <div class="sec-head-main">
          <p class="kicker">Projects</p>
          <h2 class="t-h2">
            Things I've built.
            <span class="t-tail">Most of them run a dental practice every day.</span>
          </h2>
        </div>
        <a href="/projects" class="tlink">All projects <Icon name="arrow-right" size={14} /></a>
      </div>

      <div class="bento">
        <a href={lead.href} class="surface bento-lead" data-reveal>
          <div class="surface-media bento-lead-media">
            {hasPublic(lead.img) ? (
              <Picture src={lead.img} alt={lead.title} width={900} height={560} />
            ) : (
              <div class="media-fallback" aria-hidden="true"><span>{lead.title}</span></div>
            )}
          </div>
          <div class="surface-pad">
            <div class="card-badges">
              <span class="badge badge-live">Live</span>
              <span class="badge badge-tone">New</span>
            </div>
            <h3 class="t-h3 bento-lead-title">{lead.title}</h3>
            <p class="t-body mt-2">{lead.line}</p>
            <p class="t-meta mt-4">{lead.meta}</p>
          </div>
        </a>

        <div class="bento-side">
          {side.map((p) => (
            <a href={p.href} class="surface card-h" data-reveal>
              <div class="card-h-media">
                {hasPublic(p.img) ? (
                  <Picture src={p.img} alt={p.title} width={400} height={300} />
                ) : (
                  <div class="media-fallback" aria-hidden="true"></div>
                )}
              </div>
              <div class="card-h-body">
                <h3 class="t-h4">{p.title}</h3>
                <p class="t-small mt-1.5">{p.line}</p>
              </div>
            </a>
          ))}
        </div>

        {row.map((p) => (
          <a href={p.href} class="surface bento-cell" data-reveal>
            <div class="surface-media bento-cell-media">
              {hasPublic(p.img) ? (
                <Picture src={p.img} alt={p.title} width={600} height={340} />
              ) : (
                <div class="media-fallback" aria-hidden="true"><span>{p.title}</span></div>
              )}
            </div>
            <div class="surface-pad">
              <h3 class="t-h4">{p.title}</h3>
              <p class="t-small mt-1.5">{p.line}</p>
            </div>
          </a>
        ))}

        <div class="surface bento-wide" data-reveal>
          <div class="jp-copy">
            <span class="badge">Open source · live demo</span>
            <h3 class="t-h3 mt-4">Fly JobPilot yourself.</h3>
            <p class="t-body mt-2">
              A robot that hunts for jobs while I sleep. Every hour it finds new
              postings, scores how well each one fits, writes a one page resume
              for the good ones and watches the inbox for replies. The demo runs
              the real product on a made up person, so you can click around
              without signing up.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="https://hi.switchy.io/zIhU" target="_blank" rel="noopener" class="btn btn-glass btn-sm">
                Open the demo <Icon name="arrow-up-right" size={14} class="arrow-ur" />
              </a>
              <a href="/posts/jobpilot-v2" class="btn btn-ghost btn-sm">How I built it</a>
            </div>
          </div>
          <a href="https://hi.switchy.io/zIhU" target="_blank" rel="noopener" class="jp-mock" aria-label="JobPilot demo">
            <div class="jp-mock-bar">
              <span class="jp-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>Today's matches</span>
              <span class="t-meta ml-auto">Fictional data</span>
            </div>
            {jobRows.map((r) => (
              <div class="jp-row">
                <span class="jp-score tabular">{r.score}</span>
                <span class="jp-bar"><span style={`width:${r.score}%`}></span></span>
                <span class="truncate">{r.left}</span>
                <span class="jp-co">{r.right}</span>
              </div>
            ))}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Work ─────────────────────────────────────────────────────────── -->
  <section id="work" class="section overflow-hidden" data-tone="work">
    <div class="tone-atmos" aria-hidden="true"></div>
    {comets(RGB.work, 3, 2).map((c) => (
      <span class="space-el" style={`width:${c.w}px;height:${Math.round(c.w * 0.28)}px;top:${c.top}%;${c.side}:${c.inset}%;`} aria-hidden="true"><span class="comet-glow" style={`--sr-rgb:${c.rgb};`}></span><span class="space-comet" style={`--sr-rgb:${c.rgb};--rz:${c.rz}deg;`}></span></span>
    ))}
    <div class="wrap on-top">
      <div class="sec-head" data-reveal>
        <div class="sec-head-main">
          <p class="kicker">Work</p>
          <h2 class="t-h2">
            One engineer, four kinds of work.
            <span class="t-tail">Same habit in all four: sit next to the person with the problem first.</span>
          </h2>
        </div>
        <a href="/work" class="tlink">How I work <Icon name="arrow-right" size={14} /></a>
      </div>
      <div class="grid4">
        {disciplines.map((d) => (
          <a href={`/work/${d.slug}`} class="surface surface-pad disc-card" data-reveal>
            <div class="flex items-center justify-between gap-3">
              <span class="badge">{d.acronym}</span>
              <span class="t-meta">{d.projects.length} projects</span>
            </div>
            <h3 class="t-h4 mt-5">{d.name}</h3>
            <p class="t-small mt-2">{disciplineLines[d.slug]}</p>
            <span class="tlink mt-auto pt-5">Open <Icon name="arrow-right" size={14} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Writing ──────────────────────────────────────────────────────── -->
  <section id="writing" class="section overflow-hidden" data-tone="writing">
    <div class="tone-atmos" aria-hidden="true"></div>
    {comets(RGB.writing, 3, 3).map((c) => (
      <span class="space-el" style={`width:${c.w}px;height:${Math.round(c.w * 0.28)}px;top:${c.top}%;${c.side}:${c.inset}%;`} aria-hidden="true"><span class="comet-glow" style={`--sr-rgb:${c.rgb};`}></span><span class="space-comet" style={`--sr-rgb:${c.rgb};--rz:${c.rz}deg;`}></span></span>
    ))}
    <div class="wrap on-top">
      <div class="sec-head" data-reveal>
        <div class="sec-head-main">
          <p class="kicker">Writing</p>
          <h2 class="t-h2">
            Notes from the work.
            <span class="t-tail">Real numbers, real screwups, real fixes.</span>
          </h2>
        </div>
        <a href="/posts" class="tlink">All posts <Icon name="arrow-right" size={14} /></a>
      </div>

      <div class="write-grid">
        {featuredPost && (
          <a href={featuredPost.url} class="surface write-lead" data-reveal>
            <div class="surface-media write-lead-media">
              {hasPublic(featuredPost.frontmatter.img_path) ? (
                <Picture
                  src={featuredPost.frontmatter.img_path}
                  alt={featuredPost.frontmatter.img_alt || featuredPost.frontmatter.title}
                  width={900}
                  height={480}
                />
              ) : (
                <div class="media-fallback" aria-hidden="true"><span>Latest</span></div>
              )}
            </div>
            <div class="surface-pad">
              <p class="t-meta">
                <span class="badge badge-tone mr-2">Latest</span>
                {featuredPost.frontmatter.date} · {readingTime(featuredPost.rawContent())} min read
              </p>
              <h3 class="t-h3 write-lead-title">{featuredPost.frontmatter.title}</h3>
              <p class="t-body mt-2 line-clamp-3">{featuredPost.frontmatter.description}</p>
            </div>
          </a>
        )}
        <ul class="write-list">
          {sidePosts.map((post) => (
            <li data-reveal>
              <a href={post.url} class="surface write-item">
                <div class="write-thumb">
                  {hasPublic(post.frontmatter.img_path) ? (
                    <Picture src={post.frontmatter.img_path} alt="" width={240} height={180} />
                  ) : (
                    <div class="media-fallback" aria-hidden="true"></div>
                  )}
                </div>
                <div class="min-w-0">
                  <p class="t-meta">{post.frontmatter.date} · {readingTime(post.rawContent())} min</p>
                  <h3 class="t-h4 mt-1.5 line-clamp-2">{post.frontmatter.title}</h3>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Film ─────────────────────────────────────────────────────────── -->
  <section id="film" class="section overflow-hidden" data-tone="film">
    <div class="tone-atmos" aria-hidden="true"></div>
    {comets(RGB.film, 3, 4).map((c) => (
      <span class="space-el" style={`width:${c.w}px;height:${Math.round(c.w * 0.28)}px;top:${c.top}%;${c.side}:${c.inset}%;`} aria-hidden="true"><span class="comet-glow" style={`--sr-rgb:${c.rgb};`}></span><span class="space-comet" style={`--sr-rgb:${c.rgb};--rz:${c.rz}deg;`}></span></span>
    ))}
    <div class="wrap on-top film-grid">
      <div data-reveal>
        <p class="kicker">Film</p>
        <h2 class="t-h2 mt-5">
          Gray characters and tight spaces.
          <span class="t-tail">The chaos hiding inside ordinary lives.</span>
        </h2>
        <p class="t-lede mt-5">
          I write, direct, edit and score. <span class="text-dk-text font-medium">Among Monsters</span> is
          the independent feature I'm cutting between work weeks.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="https://www.imdb.com/title/tt39700295/" target="_blank" rel="noreferrer" class="btn btn-glass">
            <span class="imdb-wordmark">IMDb</span> Among Monsters <Icon name="arrow-up-right" size={14} class="arrow-ur" />
          </a>
          <a href="/filmmaking" class="tlink ml-2">The full slate <Icon name="arrow-right" size={14} /></a>
        </div>
      </div>
      <ul class="rows" data-reveal>
        {filmCredits.map((c) => (
          <li>
            <a href="/filmmaking" class="row-link">
              <span class="min-w-0">
                <span class="block t-h4">{c.title}</span>
                <span class="block t-meta mt-1">{c.role}</span>
              </span>
              <span class="ml-auto t-meta text-base tabular">{c.year}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Teaching ─────────────────────────────────────────────────────── -->
  <section id="teaching" class="section overflow-hidden" data-tone="teaching">
    <div class="tone-atmos" aria-hidden="true"></div>
    <div class="wrap on-top">
      <div class="sec-head" data-reveal>
        <div class="sec-head-main">
          <p class="kicker">Teaching</p>
          <h2 class="t-h2">
            What I've learned, written down.
            <span class="t-tail">Free guides for engineers who ship AI.</span>
          </h2>
        </div>
        <a href="/teaching" class="tlink">All materials <Icon name="arrow-right" size={14} /></a>
      </div>
      <div class="teach-grid">
        {guides.map((g) => (
          <a href={`/teaching/${g.slug}`} class="surface teach-card" data-reveal>
            <div class="teach-cover">
              {hasPublic(g.cover) ? (
                <Picture src={g.cover} alt={g.title} width={360} height={460} />
              ) : (
                <div class="media-fallback" aria-hidden="true"></div>
              )}
            </div>
            <div class="teach-body">
              <span class="badge">{g.pages ? `PDF · ${g.pages} pages` : "PDF"}</span>
              <h3 class="t-h3 mt-4">{g.title}</h3>
              <p class="t-small mt-2">{g.description}</p>
              <span class="tlink mt-auto pt-5">Read it <Icon name="arrow-right" size={14} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── About ────────────────────────────────────────────────────────── -->
  <section id="about" class="section overflow-hidden" data-tone="home">
    <div class="wrap on-top about-grid">
      <div data-reveal>
        <p class="kicker">About</p>
        <h2 class="t-h2 mt-5">
          An engineer
          <span class="t-tail">who happens to make movies.</span>
        </h2>
        <p class="t-body about-text mt-5">{info.about.description}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/resume" class="btn btn-glass btn-sm">Resume and toolkit</a>
          <a href="/projects" class="btn btn-ghost btn-sm">Every project</a>
        </div>
      </div>
      <div class="surface surface-pad about-timeline" data-reveal>
        <CareerTimeline />
      </div>
    </div>
  </section>

  <!-- ── Contact ──────────────────────────────────────────────────────── -->
  <section id="contact" class="section overflow-hidden text-center" data-tone="home">
    <span class="glow" style="width:640px;height:640px;--gc:#5B8DEF;top:-140px;left:50%;margin-left:-320px;" aria-hidden="true"></span>
    <div class="wrap on-top" data-reveal>
      <p class="kicker">Contact</p>
      <h2 class="t-title mt-6">
        Let's build something.
        <span class="t-tail">Tell me what you're working on.</span>
      </h2>
      <p class="t-lede mx-auto mt-6">
        Hiring for applied AI, or the last mile where software meets the people
        who use it? I'd love to hear about it.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={`mailto:${info.contact.email}`} class="btn btn-primary">
          <Icon name="mail" size={16} /> {info.contact.email}
        </a>
        <a href={info.contact.linkedin} target="_blank" rel="noreferrer" class="btn btn-glass" aria-label="LinkedIn">
          <Icon name="linkedin" size={15} /> LinkedIn
        </a>
        <a href={info.contact.github} target="_blank" rel="noreferrer" class="btn btn-glass" aria-label="GitHub">
          <Icon name="github" size={15} /> GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero { min-height: 100svh; display: flex; align-items: center; padding-block: 120px 72px; }
  .hero-grid {
    display: grid;
