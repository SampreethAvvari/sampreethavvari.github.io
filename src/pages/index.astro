---
import BaseLayout from "../layouts/BaseLayout.astro";
import { info } from "../data/info";
import { disciplines } from "../data/disciplines";
import Contact from "../components/contact_section/Contact";
import Picture from "../components/common/Picture.astro";
import Icon from "../components/common/Icon.astro";
import GlassHero from "../components/hero/GlassHero.astro";
import CareerTimeline from "../components/about_section/CareerTimeline.astro";
import { readingTime } from "../utils/readingTime";

const allPosts = await Astro.glob("../pages/posts/*.md");
const latestPosts = allPosts
  .sort(
    (a, b) =>
      new Date(b.frontmatter.date).getTime() -
      new Date(a.frontmatter.date).getTime(),
  )
  .slice(0, 4);
const [featuredPost, ...sidePosts] = latestPosts;

// The four places my work lives. Each card reads the same way: what it is in
// plain words, a small live-looking panel of the thing itself, and links out.
// Every row in a panel is a link to that project's write-up.
const workCards = [
  {
    variant: "jobpilot",
    accent: "#F5A524",
    rgb: "245,165,36",
    eyebrow: "open source \u00b7 live demo",
    title: ["Fly ", "JobPilot", " yourself."],
    body:
      "A robot that hunts for jobs while I sleep. Every hour it finds new postings, " +
      "scores how well each one fits me, writes a one page resume for the good ones, " +
      "drafts the email, and watches my inbox for replies. The demo is the real " +
      "product running on a made up person, so you can click around without signing up.",
    demo: "https://hi.switchy.io/zIhU",
    rows: [
      { score: "96", tone: "#5bd97a", left: "Forward Deployed Engineer", right: "Marrowstone AI" },
      { score: "94", tone: "#5bd97a", left: "AI Engineer, Applied Models", right: "Osprey Compute" },
      { score: "91", tone: "#5bd97a", left: "ML Engineer, Risk", right: "Bluewater Ledger" },
      { score: "88", tone: "#ffb000", left: "AI Engineer, Insights", right: "Driftwood Metrics" },
    ],
    links: [
      { label: "Explore JobPilot", href: "https://hi.switchy.io/zIhU", external: true, primary: true },
      { label: "How I built it", href: "/posts/jobpilot-v2" },
    ],
  },
  {
    variant: "hybridge",
    accent: "#34D399",
    rgb: "52,211,153",
    eyebrow: "my day job \u00b7 Hybridge Implants",
    title: ["The systems I build ", "at work", "."],
    body:
      "I am the AI engineer at a dental implant company in New York. I built the " +
      "search that answers staff questions out of company documents, the tool that " +
      "scores patient consultations and coaches the team, the model that catches bad " +
      "CT scans before they reach the design queue, and the app the front desk quotes " +
      "prices from. All of them are in daily use, so none of them can be handed out. " +
      "Open any one below to read how it was built.",
    rows: [
      { left: "Ask Hybridge", right: "company wide search", tone: "#34D399", href: "/posts/enterprise-search" },
      { left: "Doc Coach", right: "consultation scoring", tone: "#22D3EE", href: "/posts/clinical-rag" },
      { left: "Scan Validator", right: "CT scan quality", tone: "#A78BFA", href: "/posts/cbct-scan-validator" },
      { left: "Treatment Estimator", right: "front desk quoting", tone: "#F5A524", href: "/posts/treatment-estimator" },
    ],
    links: [
      { label: "See the case studies", href: "/work", primary: true },
      { label: "Start with Enterprise Search", href: "/posts/enterprise-search" },
    ],
  },
  {
    variant: "research",
    accent: "#A78BFA",
    rgb: "167,139,250",
    eyebrow: "NYU \u00b7 machine learning research",
    title: ["Teaching models what a ", "good answer", " looks like."],
    body:
      "At NYU I worked on reward models. That is the part of an AI system that learns " +
      "which of two answers a person would rather read. I trained Llama and BERT sized " +
      "models on the university GPUs and compared training methods against each other. " +
      "The same stretch produced a small image model that won a class contest and a " +
      "fake news detector built on election tweets.",
    rows: [
      { left: "Llama 3.1, RLHF", right: "reward models", tone: "#A78BFA", href: "/posts/llama-rlhf" },
      { left: "ResNet under 5M", right: "small vision model", tone: "#5B8DEF", href: "/posts/resnet-under-5m" },
      { left: "Fake news detector", right: "election tweets", tone: "#F43F5E", href: "/posts/fake-news-sentiment" },
    ],
    links: [
      { label: "Read the research notes", href: "/posts/llama-rlhf", primary: true },
      { label: "All ML work", href: "/work/mle" },
    ],
  },
  {
    variant: "projects",
    accent: "#5B8DEF",
    rgb: "91,141,239",
    eyebrow: "on my own time",
    title: ["Everything ", "else", " I have built."],
    body:
      "Things I made to learn something. An AI filmmaking studio four of us built in a " +
      "single day at a hackathon, a recommender that handles 22 million records, a loan " +
      "scoring service where I built all the boring parts on purpose, and the day I " +
      "caught my own pipeline lying about work it never did.",
    rows: [
      { left: "Magic Hour", right: "AI filmmaking", tone: "#F43F5E", href: "/posts/magic-hour" },
      { left: "Recommender", right: "22M records", tone: "#34D399", href: "/posts/recsys-spark-bigdata" },
      { left: "Loan Radar", right: "the boring parts", tone: "#F5A524", href: "/posts/loan-radar-mlops" },
      { left: "Pipeline confession", right: "silent failures", tone: "#5B8DEF", href: "/posts/pipeline-ghosting" },
    ],
    links: [
      { label: "Browse all projects", href: "/projects", primary: true },
      { label: "The hackathon build", href: "/posts/magic-hour" },
    ],
  },
];

// One-line versions of the four disciplines for the tiles.
const disciplineLines: Record<string, string> = {
  aie: "RAG, agents, evals, guardrails. Systems that answer honestly or not at all.",
  mle: "PyTorch, vision, RLHF. Models trained, shrunk, and shipped to real hardware.",
  fde: "Discovery and enablement, the last mile where software meets people.",
  sde: "Python, TypeScript, Go. APIs, pipelines, and infra that stay up.",
};

const filmCredits = [
  { title: "Among Monsters", year: "2026", role: "Director · Writer · Editor · Music" },
  { title: "Extraordinary Lives", year: "soon", role: "Director · Writer" },
  { title: "Tiger Man", year: "2022", role: "Director · Writer · Editor" },
  { title: "Strangers", year: "2019", role: "Cinematographer · Music" },
];

// Institution logos for the Education/Experience rows. Falls back to a
// gradient monogram for anywhere without a logo file.
const orgFor = (loc: string) => {
  if (/Hybridge/i.test(loc)) return { logo: "/logos/hybridge.webp", label: "Hybridge Implants" };
  if (/Shure/i.test(loc)) return { logo: "/logos/shure.svg", label: "Shure" };
  if (/JNTU|Jawaharlal Nehru|Gokaraju/i.test(loc)) return { logo: "/logos/griet.png", label: "Gokaraju Rangaraju Institute of Engineering and Technology" };
  if (/New York University|NYU/i.test(loc)) return { logo: "/logos/nyu.svg", label: "New York University" };
  return { logo: null, acronym: loc.slice(0, 2).toUpperCase(), label: loc };
};

// Toolkit marquee, replacing the four skill tile walls.
const marqueeItems = [
  { name: "Python", accent: "#5B8DEF" },
  { name: "PyTorch", accent: "#A78BFA" },
  { name: "RAG", accent: "#34D399" },
  { name: "Vertex Gemini", accent: "#34D399" },
  { name: "FastAPI", accent: "#5B8DEF" },
  { name: "BigQuery", accent: "#F5A524" },
  { name: "TypeScript", accent: "#5B8DEF" },
  { name: "Hugging Face", accent: "#A78BFA" },
  { name: "pgvector", accent: "#34D399" },
  { name: "Terraform", accent: "#5B8DEF" },
  { name: "Evals", accent: "#34D399" },
  { name: "React", accent: "#5B8DEF" },
  { name: "RLHF", accent: "#A78BFA" },
  { name: "Docker", accent: "#5B8DEF" },
  { name: "Looker", accent: "#F5A524" },
  { name: "Guardrails", accent: "#34D399" },
  { name: "PostgreSQL", accent: "#5B8DEF" },
  { name: "OpenCV", accent: "#A78BFA" },
];

const sections = [
  { id: "home", label: "Top" },
  { id: "disciplines", label: "Disciplines" },
  { id: "work", label: "Work" },
  { id: "about", label: "About" },
  { id: "writing", label: "Writing" },
  { id: "filmmaking", label: "Film" },
  { id: "contact", label: "Contact" },
];
---

<BaseLayout title="Sampreeth Avvari" preloadImage="/pic.avif">
  <nav class="rail" aria-label="Page sections">
    {sections.map((s) => (
      <a href={`#${s.id}`} data-rail={s.id} aria-label={s.label}></a>
    ))}
  </nav>

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section id="home" class="relative min-h-[100svh] flex items-center overflow-hidden pt-24 pb-16">
    <GlassHero />
    <span class="glow" style="width:630px;height:630px;--gc:#5B8DEF;top:-90px;left:-120px;" aria-hidden="true"></span>
    <span class="glow glow-2" style="width:540px;height:540px;--gc:#22D3EE;bottom:-80px;right:-70px;" aria-hidden="true"></span>
    <span class="space-el" style="width:143px;height:39px;top:14%;left:5%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:91,141,239;"></span><span class="space-comet" style="--sr-rgb:91,141,239;--rz:-16deg;"></span></span>
    <span class="space-el" style="width:117px;height:33px;bottom:18%;right:7%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:34,211,238;"></span><span class="space-comet" style="--sr-rgb:34,211,238;--rz:12deg;"></span></span>
    <span class="space-el" style="width:130px;height:36px;top:34%;right:16%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:91,141,239;"></span><span class="space-comet" style="--sr-rgb:91,141,239;--rz:18deg;"></span></span>
    <span class="space-el" style="width:110px;height:30px;bottom:34%;left:14%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:34,211,238;"></span><span class="space-comet" style="--sr-rgb:34,211,238;--rz:-10deg;"></span></span>
    <span class="space-el" style="width:122px;height:34px;top:56%;right:28%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:91,141,239;"></span><span class="space-comet" style="--sr-rgb:91,141,239;--rz:8deg;"></span></span>
    <span class="space-el" style="width:104px;height:29px;top:22%;left:30%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:34,211,238;"></span><span class="space-comet" style="--sr-rgb:34,211,238;--rz:-20deg;"></span></span>

    <div class="relative z-10 mx-auto w-full max-w-screen-2xl px-6 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <div class="lg:col-span-7" data-arrive>
          <p class="eyebrow text-text/60 dark:text-dk-text/60 mb-5">
            AI Engineer · New York
          </p>
          <h1 class="text-[2.6rem] leading-[1.04] sm:text-6xl lg:text-7xl font-bold tracking-[-0.04em] text-text dark:text-dk-text [text-wrap:balance]">
            I'm <span class="name-shimmer">Sampreeth</span>.<br />
            I ship AI and direct films.
          </h1>
          <p class="mt-6 text-lg lg:text-xl text-text/70 dark:text-dk-text/70 leading-relaxed max-w-xl">
            Whether it's a model or a movie, the job is making the messy thing make sense to someone else.
          </p>
          <div class="mt-7 flex flex-wrap gap-2" aria-label="Disciplines">
            {disciplines.map((d) => (
              <a
                href={`/work/${d.slug}`}
                class="no-lift dpill"
                data-magnetic
                style={`--dx: ${d.accent}; --dx-rgb: ${d.rgb};`}
                aria-label={d.name}
              >
                <i aria-hidden="true"></i>
                <span>{d.acronym}</span>
              </a>
            ))}
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="#work" class="no-lift gbtn" data-magnetic>
              See the work <Icon name="arrow-down" size={15} />
            </a>
            <a
              href="https://hi.switchy.io/zIhU"
              target="_blank"
              rel="noopener"
              class="no-lift gbtn-amber"
              data-magnetic
            >
              JobPilot demo <Icon name="arrow-up-right" size={15} />
            </a>
            <a href="/posts" class="no-lift gbtn-ghost" data-magnetic>
              Read the writing
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 flex justify-center lg:justify-end" data-arrive>
          <figure class="pane pane-glare p-3 w-[min(320px,78vw)]" data-tilt data-tiltmax="5">
            <Picture
              src={info.picture}
              alt={info.picture_alt}
              width={520}
              height={640}
              class="block w-full h-auto aspect-[520/640] object-cover rounded-2xl"
              loading="eager"
              fetchpriority="high"
            />
            <figcaption class="sr-only">{info.name}</figcaption>
          </figure>
        </div>
      </div>
    </div>

    <a class="scroll-cue no-lift" href="#disciplines" aria-label="Scroll to disciplines">
      <Icon name="arrow-down" size={20} />
    </a>
  </section>

  <!-- ── Toolkit marquee ──────────────────────────────────────────────── -->
  <div class="mq" aria-hidden="true">
    <div class="mq-track">
      {[0, 1].map(() =>
        marqueeItems.map((it) => (
          <span style={`--mc: ${it.accent}`}>
            <b>{it.name}</b> ·
          </span>
        )),
      )}
    </div>
  </div>

  <!-- ── Disciplines ──────────────────────────────────────────────────── -->
  <section id="disciplines" class="relative overflow-hidden py-24 lg:py-32">
    <span class="glow" style="width:600px;height:600px;--gc:#A78BFA;top:6%;right:-120px;" aria-hidden="true"></span>
    <span class="glow glow-3" style="width:510px;height:510px;--gc:#F5A524;bottom:-70px;left:-90px;" aria-hidden="true"></span>
    <span class="space-el" style="width:150px;height:39px;top:8%;right:5%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:167,139,250;"></span><span class="space-comet" style="--sr-rgb:167,139,250;--rz:-18deg;"></span></span>
    <span class="space-el" style="width:117px;height:33px;bottom:12%;left:4%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:167,139,250;"></span><span class="space-comet" style="--sr-rgb:167,139,250;--rz:10deg;"></span></span>
    <span class="space-el" style="width:126px;height:35px;top:42%;left:18%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:167,139,250;"></span><span class="space-comet" style="--sr-rgb:167,139,250;--rz:-14deg;"></span></span>
    <span class="space-el" style="width:108px;height:30px;bottom:30%;right:15%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:245,165,36;"></span><span class="space-comet" style="--sr-rgb:245,165,36;--rz:16deg;"></span></span>
    <span class="space-el" style="width:118px;height:33px;top:20%;left:38%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:167,139,250;"></span><span class="space-comet" style="--sr-rgb:167,139,250;--rz:6deg;"></span></span>
    <div class="relative z-[1] mx-auto w-full max-w-screen-2xl px-6 lg:px-12">
      <div class="max-w-3xl" data-arrive>
        <p class="eyebrow text-acc-violet mb-3">01 · What I do</p>
        <h2 class="display-sm text-text dark:text-dk-text mb-4">
          One engineer, <span class="text-acc-violet">four disciplines</span>.
        </h2>
        <p class="text-base lg:text-lg text-text/65 dark:text-dk-text/65 leading-relaxed max-w-2xl">
          The same instinct runs through all four: sit next to the person with the problem, then build the thing they actually needed.
        </p>
      </div>
      <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4" data-arrive>
        {disciplines.map((d) => (
          <a
            href={`/work/${d.slug}`}
            class="no-lift pane pane-glare orbit-glow overflow-hidden p-6 flex flex-col gap-2 group"
            data-tilt
            data-tiltmax="4"
            style={`--oc: ${d.accent};`}
          >
            <span
              class="font-mono text-[0.7rem] font-extrabold tracking-[0.2em]"
              style={`color: ${d.accent};`}
            >
              {d.acronym}
            </span>
            <h3 class="text-lg font-semibold tracking-tight text-text dark:text-dk-text">
              {d.name}
            </h3>
            <p class="relative z-[1] text-sm text-text/60 dark:text-dk-text/60 leading-snug">
              {disciplineLines[d.slug]}
            </p>
            <span class="mt-auto pt-3 text-[0.78rem] font-bold inline-flex items-center gap-1.5" style={`color: ${d.accent};`}>
              {d.projects.length} project{d.projects.length === 1 ? "" : "s"}
              <Icon name="arrow-right" size={13} />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Work ─────────────────────────────────────────────────────────── -->
  <section
    id="work"
    class="relative clip-x py-24 lg:py-32"
    style="--work-rgb:245,165,36; --work-hex:#F5A524;"
  >
    <div class="work-decor" aria-hidden="true">
    <span class="glow" style="width:660px;height:660px;--gc:var(--work-hex);top:-110px;left:28%;" aria-hidden="true"></span>
    <span class="glow glow-2" style="width:510px;height:510px;--gc:var(--work-hex);bottom:-90px;right:-70px;" aria-hidden="true"></span>
    <span class="space-el" style="width:156px;height:39px;top:7%;right:5%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:var(--work-rgb);"></span><span class="space-comet" style="--sr-rgb:var(--work-rgb);--rz:-14deg;"></span></span>
    <span class="space-el" style="width:117px;height:33px;bottom:9%;left:4%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:var(--work-rgb);"></span><span class="space-comet" style="--sr-rgb:var(--work-rgb);--rz:12deg;"></span></span>
    <span class="space-el" style="width:128px;height:36px;top:38%;left:12%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:var(--work-rgb);"></span><span class="space-comet" style="--sr-rgb:var(--work-rgb);--rz:-16deg;"></span></span>
    <span class="space-el" style="width:106px;height:30px;bottom:36%;right:14%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:var(--work-rgb);"></span><span class="space-comet" style="--sr-rgb:var(--work-rgb);--rz:8deg;"></span></span>
    <span class="space-el" style="width:120px;height:33px;top:18%;left:42%;" aria-hidden="true"><span class="comet-glow" style="--sr-rgb:var(--work-rgb);"></span><span class="space-comet" style="--sr-rgb:var(--work-rgb);--rz:-8deg;"></span></span>
    </div>

    <div class="relative z-[1] mx-auto w-full max-w-screen-2xl px-6 lg:px-12">
      <div class="max-w-3xl" data-arrive>
        <p class="eyebrow text-acc-amber mb-3">02 · The work</p>
        <h2 class="display-sm text-text dark:text-dk-text mb-4">
          Where my work <span class="text-acc-amber">lives</span>.
        </h2>
        <p class="text-base lg:text-lg text-text/65 dark:text-dk-text/65 leading-relaxed max-w-2xl">
          Four places. One you can try right now, the systems I build at my day job,
          the research, and everything else I made to learn something.
        </p>
      </div>

      <div class="deck-track mt-8" style={`--cards:${workCards.length};`}>
       {/* No data-arrive here on purpose: initArrive blurs an element by how far
           its centre is from the middle of the screen, and this track is taller
           than three screens, so it would sit permanently blurred. The deck
           animates itself. */}
       <div class="deck-pin">
        <ul class="deck list-none p-0 m-0">
        {workCards.map((c, i) => (
          <li
            class="deck-item"
            data-rgb={c.rgb}
            style={`--i:${i}; z-index:${workCards.length - i};`}
          >
            <div class="deck-card">
            <div class="pane pane-glare p-0 overflow-hidden" data-tilt data-tiltmax="2">
              <div class="grid grid-cols-1 lg:grid-cols-12">
                <div class="lg:col-span-7 p-7 lg:p-9 flex flex-col justify-center">
                  <p class="eyebrow mb-3" style={`color: ${c.accent};`}>{c.eyebrow}</p>
                  <h3 class="text-2xl lg:text-3xl font-bold tracking-tight text-text dark:text-dk-text">
                    {c.title[0]}<span style={`color: ${c.accent};`}>{c.title[1]}</span>{c.title[2]}
                  </h3>
                  <p class="mt-3 text-sm lg:text-base text-text/65 dark:text-dk-text/65 leading-relaxed max-w-xl">
                    {c.body}
                  </p>
                  <div class="mt-6 flex flex-wrap gap-3">
                    {c.links.map((l) => (
                      <a
                        href={l.href}
                        class={`no-lift ${l.primary ? "gbtn" : "gbtn-ghost"}`}
                        data-magnetic
                        {...(l.external ? { target: "_blank", rel: "noopener" } : {})}
                      >
                        {l.label}
                        {l.primary && <Icon name="arrow-right" size={15} />}
                      </a>
                    ))}
                  </div>
                </div>

                <div class="lg:col-span-5 relative">
                  <div
                    class="absolute inset-0"
                    style={`background:
                      radial-gradient(420px 260px at 78% 16%, rgba(${c.rgb},0.22), transparent 66%),
                      radial-gradient(360px 240px at 18% 92%, rgba(${c.rgb},0.12), transparent 70%),
                      #080b0e;`}
                  ></div>

                  <div class="relative h-full p-6 lg:p-7 flex items-center">
                    <div class="ui-mock w-full rounded-xl border border-white/10 bg-[#0b1015]/95 font-mono text-[11px] leading-relaxed shadow-2xl backdrop-blur">
                      {/* title bar, same on every panel */}
                      <div class="flex items-center gap-2 border-b border-white/10 px-3.5 py-2.5">
                        <span class="flex gap-1.5" aria-hidden="true">
                          <span class="h-2 w-2 rounded-full bg-[#ff5f57]"></span>
                          <span class="h-2 w-2 rounded-full bg-[#febc2e]"></span>
                          <span class="h-2 w-2 rounded-full bg-[#28c840]"></span>
                        </span>
                        <span class="ml-1 truncate font-bold tracking-tight text-[#e8e4da]">
                          {c.variant === "jobpilot" && <>JOB<span style="color:#ffb000;">PILOT</span></>}
                          {c.variant === "hybridge" && <>HYBRIDGE <span style={`color:${c.accent};`}>OPS</span></>}
                          {c.variant === "research" && <>TRAINING <span style={`color:${c.accent};`}>RUN</span></>}
                          {c.variant === "projects" && <>SIDE <span style={`color:${c.accent};`}>BUILDS</span></>}
                        </span>
                        <span
