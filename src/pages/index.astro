  .hero-proof span { font-size: 0.75rem; line-height: 1.4; color: var(--ink-faint); transition: color 150ms var(--ease-glass); }
  /* On a phone the proof line is the first evidence a reader sees; one size
     up so the labels read without zooming. */
  @media (max-width: 719px) { .hero-proof span { font-size: 0.8125rem; } }
  .hero-proof a:hover span { color: var(--ink-soft); }
  .hero-proof a:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.25); border-radius: 6px; }
  .hero-actions { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-art { display: flex; justify-content: center; }
  @media (min-width: 1024px) { .hero-art { justify-content: flex-end; } }

  /* Projects row, the way a streaming row works: it starts on the page
     margin and runs off the right edge of the screen, scrolls sideways with
     a trackpad, a swipe or the arrows, and snaps card by card. */
  .proj { position: relative; padding-block: clamp(72px, 9vw, 120px); --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1); }
  .proj-viewport { position: relative; }
  .proj-track {
    --row-start: max(var(--gutter), calc((100% - var(--max)) / 2));
    list-style: none;
    margin: 0;
    display: flex;
    gap: 16px;
    padding: 14px var(--gutter) 28px var(--row-start);
    scroll-padding-inline: var(--row-start);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .proj-track::-webkit-scrollbar { display: none; }
  .proj-item { flex: none; width: min(82vw, 360px); scroll-snap-align: start; }
