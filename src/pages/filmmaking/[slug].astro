---
// One page per film: the poster or a title card full width, the title and
// where the film stands, my credits in large type, the story where the site
// has one, the stills, the cast and crew where we have them, and the films
// either side of it. Facts come from src/data/films.ts and nowhere else.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SmartImage from "../../components/common/SmartImage.astro";
import Icon from "../../components/common/Icon.astro";
import {
  films,
  filmPath,
  filmStills,
  neighbours,
  yearLabel,
  statusLabel,
  rolesLine,
  rolesProse,
  filmDescription,
  type Film,
} from "../../data/films";
import { filmNode } from "../../utils/seo";

export function getStaticPaths() {
  return films.map((film) => ({ params: { slug: film.slug }, props: { film } }));
}

const { film } = Astro.props as { film: Film };
const stills = filmStills(film);
const { prev, next } = neighbours(film.slug);
const path = filmPath(film.slug);
const description = filmDescription(film, stills.length);
const pageTitle = `${film.title}${film.year ? ` (${film.year})` : ""} · SA: Filmmaking`;
// The image search engines see: the poster, else a frame from the film.
const schemaImage = film.poster?.image ?? (stills[0] ? stills[0].src.replace(/\.avif$/i, ".webp") : undefined);
const heroStill = film.slug === "swechcha" ? stills[4] ?? stills[0] : undefined;

// The same nebula and eclipse placement the reel gives this film's card.
const SEEDS = [
  [24, 40, 76, 58],
  [70, 34, 26, 66],
  [36, 64, 78, 30],
  [78, 56, 22, 38],
  [50, 28, 30, 70],
  [26, 60, 70, 36],
  [62, 66, 34, 30],
  [40, 32, 74, 64],
  [72, 44, 24, 56],
];
const seedFor = (f: Film) => SEEDS[films.indexOf(f) % SEEDS.length];
const [nx, ny, sx, sy] = seedFor(film);

const statusText =
  film.status === "dated" ? yearLabel(film) : [film.year, film.statusNote ?? statusLabel(film)].filter(Boolean).join(" · ");

const facts = [
  { label: "Year", value: yearLabel(film) },
  ...(film.status !== "dated" ? [{ label: "Status", value: film.statusNote ?? statusLabel(film) }] : []),
  ...(film.genre ? [{ label: "Genre", value: film.genre }] : []),
  ...(film.shot ? [{ label: "Shot", value: `${film.shot.place}, ${film.shot.when}` }] : []),
  ...(stills.length ? [{ label: "Stills", value: `${stills.length} frames` }] : []),
];

// My other films in each of the jobs I did on this one.
const alsoAs = film.roles
  .map((role) => ({ role, others: films.filter((f) => f !== film && f.roles.includes(role)) }))
  .filter((g) => g.others.length);

const links = [
  film.links?.imdb && { title: "IMDb", line: `${film.title} on IMDb.`, href: film.links.imdb, icon: "imdb" },
  film.links?.screenplay && { title: "Screenplay", line: "Read the script as a PDF.", href: film.links.screenplay, icon: "file" },
  film.links?.playlist && { title: "Playlist", line: "The film's playlist on YouTube.", href: film.links.playlist, icon: "youtube" },
].filter(Boolean) as Array<{ title: string; line: string; href: string; icon: string }>;

const instagramUrl = (handle?: string) => (handle ? `https://instagram.com/${handle.replace(/^@/, "")}` : "");
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .filter(Boolean)
    .slice(0, 2)
    .join("")
    .toUpperCase();

const base = Astro.site!.toString();
---

<BaseLayout
  title={pageTitle}
  description={description}
  footerVariant={film.links?.imdb ? "filmmaking" : "default"}
  ogImage="/og/film.jpg"
  preloadImage={film.poster ? film.poster.image.replace(/\.webp$/, ".avif") : heroStill?.src}
  schema={[filmNode(base, film.slug, { description, image: schemaImage })]}
  crumbs={[
    { name: "Home", path: "/" },
    { name: "Filmmaking", path: "/filmmaking" },
    { name: film.title, path },
  ]}
>
  <div class="fp">
    {film.poster ? (
      <section class="fp-poster-hero" aria-label={`${film.title} poster`}>
        <div class="fp-space" aria-hidden="true">
          <span class="fp-nebula fp-nebula-a"></span>
          <span class="fp-nebula fp-nebula-b"></span>
          <span class="fp-beam"></span>
          <canvas class="fp-dust" data-fp-dust></canvas>
        </div>
        <div class="fp-poster-stage">
          <span class="fp-sun" aria-hidden="true"><span class="fp-corona"></span></span>
          <div class="fp-screen">
            <SmartImage src={film.poster.src} alt={film.poster.alt} class="fp-screen-img" loading="eager" fetchpriority="high" />
          </div>
        </div>
        <div class="wrap fp-head">
          <a href="/filmmaking" class="fp-back"><Icon name="arrow-left" size={14} /> All films</a>
          <p class="kicker fp-kicker">Film · {statusText}</p>
          <h1 class="fp-h1">{film.title}</h1>
          <p class="fp-head-roles">{rolesLine(film)}</p>
        </div>
      </section>
    ) : (
      <section class="fp-card-hero" style={`--nx:${nx}%;--ny:${ny}%;--sx:${sx}%;--sy:${sy}%;`} aria-labelledby="fp-title">
        <div class="fp-bar fp-bar-top" aria-hidden="true"></div>
        <div class:list={["fp-field", heroStill && "fp-field-still"]}>
          {heroStill ? (
            <SmartImage src={heroStill.src} alt={heroStill.alt} class="fp-field-img" loading="eager" fetchpriority="high" />
          ) : (
            <span class="fp-card-sun" aria-hidden="true"><span class="fp-corona"></span></span>
          )}
          <span class="fp-field-shade" aria-hidden="true"></span>
          <canvas class="fp-dust" data-fp-dust aria-hidden="true"></canvas>
          <div class="wrap fp-field-back">
            <a href="/filmmaking" class="fp-back"><Icon name="arrow-left" size={14} /> All films</a>
          </div>
          <div class="fp-field-inner">
            <p class="fp-over">
              {film.status === "upcoming" && <span class="badge badge-tone">Upcoming</span>}
              <span>{statusText}</span>
            </p>
            <h1 id="fp-title" class="fp-card-title">{film.title}</h1>
          </div>
        </div>
        <div class="fp-bar fp-bar-bottom">
          <span class="fp-bar-roles">{rolesLine(film)}</span>
        </div>
      </section>
    )}

    <!-- Credits and facts -->
    <section class="section fp-credits-sec" aria-labelledby="credits-title">
      <span class="fp-haze fp-haze-left" aria-hidden="true"></span>
      <div class="wrap on-top">
        <div class="fp-credits">
          <div class="fp-credit-block" data-reveal>
            <h2 id="credits-title" class="fp-label">My credits</h2>
            <ul class="fp-roles">
              {film.roles.map((r) => <li>{r}</li>)}
            </ul>
            <p class="t-meta fp-credited">Credited as Sampreeth Sharma</p>
          </div>
          <dl class="fp-facts" data-reveal>
            {facts.map((f) => (
              <div class="fp-fact">
                <dt class="t-meta">{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        {(film.logline || film.work) && (
          <div class="fp-story" data-reveal>
            {film.logline && (
              <div>
                <p class="fp-label">The story</p>
                <p class="fp-logline">{film.logline}</p>
              </div>
            )}
            {film.work && (
              <div>
                <p class="fp-label">My work on it</p>
                <p class="t-body fp-work">{film.work}</p>
              </div>
            )}
          </div>
        )}

        {links.length > 0 && (
          <ul class="fp-links" data-reveal>
            {links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noreferrer" class="surface fp-link">
                  <span class="fp-link-icon" aria-hidden="true">
                    {l.icon === "imdb" && <span class="imdb-wordmark">IMDb</span>}
                    {l.icon === "youtube" && (
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                      </svg>
                    )}
                    {l.icon === "file" && (
                      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                        <path d="M14 2v4a2 2 0 0 0 2 2h4M16 13H8M16 17H8M10 9H8" />
                      </svg>
                    )}
                  </span>
                  <span class="min-w-0">
                    <span class="block t-h4">{l.title}</span>
                    <span class="block t-small mt-1">{l.line}</span>
                  </span>
                  <span class="fp-link-arrow" aria-hidden="true"><Icon name="arrow-up-right" size={16} /></span>
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>

    <!-- Stills -->
    {stills.length > 0 && (
      <section id="stills" class="section fp-stills-sec" aria-labelledby="stills-title">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <div class="sec-head-main">
              <h2 id="stills-title" class="t-h2">
                Frames.
                <span class="t-tail">{stills.length} stills from {film.title}.</span>
              </h2>
            </div>
          </div>
          <ul class="fp-stills" data-reveal>
            {stills.map((item, i) => (
              <li>
                <button
                  type="button"
                  class:list={["fp-still", film.stills?.letterboxed && "fp-still-boxed"]}
                  data-still
                  data-group={film.slug}
                  data-index={i}
                  data-full={item.src}
                  data-caption={film.title}
                  aria-label={`View still ${i + 1} of ${stills.length} from ${film.title}`}
                >
                  <SmartImage src={item.src} alt={item.alt} class="fp-still-img" loading="lazy" />
                </button>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <!-- Cast and crew -->
    {film.credits && (
      <section id="cast" class="section fp-cast-sec" aria-labelledby="cast-title">
        <span class="fp-haze fp-haze-right" aria-hidden="true"></span>
        <div class="wrap on-top">
          <div class="sec-head" data-reveal>
            <div class="sec-head-main">
              <h2 id="cast-title" class="t-h2">
                The people who made the scene work.
                <span class="t-tail">Cast and crew of {film.title}.</span>
              </h2>
            </div>
          </div>
          {film.credits.map((group, gi) => (
            <div class:list={["fp-crew-group", gi > 0 && "fp-gap"]}>
              <div class="fp-group-head" data-reveal>
                <h3 class="t-h4">{group.label}</h3>
                <span class="t-meta">{group.people.length}</span>
              </div>
              <ul class="people" data-reveal>
                {group.people.map((person) => {
                  const Tag = person.instagram ? "a" : "div";
                  const linkProps = person.instagram
                    ? {
                        href: instagramUrl(person.instagram),
                        target: "_blank",
                        rel: "noreferrer",
                        "aria-label": `${person.name} on Instagram`,
                      }
                    : {};
                  return (
                    <li>
                      <Tag class="surface person" {...linkProps}>
                        <div class="person-media">
                          {person.photo ? (
                            <SmartImage
                              src={person.photo}
                              alt={`${person.name} portrait`}
                              class="person-img"
                              style={person.imageStyle}
                              loading="lazy"
                            />
                          ) : (
                            <div class="person-ph" aria-hidden="true">
                              <span>{initials(person.name)}</span>
                            </div>
                          )}
                        </div>
                        <div class="person-body">
                          <div class="min-w-0">
                            <p class="person-name">{person.name}</p>
                            <p class="t-meta person-role">{person.role || "Cast"}</p>
                          </div>
                          {person.instagram && (
                            <span class="person-ig" aria-hidden="true">
                              <Icon name="instagram" size={14} />
                            </span>
                          )}
                        </div>
                      </Tag>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- The same jobs on other films -->
    {alsoAs.length > 0 && (
      <section class="section fp-also-sec" aria-labelledby="also-title">
        <div class="wrap">
          <div class="sec-head" data-reveal>
            <div class="sec-head-main">
              <h2 id="also-title" class="t-h2">
                The same jobs, other films.
                <span class="t-tail">Where else I was the {rolesProse(film)}.</span>
              </h2>
            </div>
          </div>
          <div class="fp-also" data-reveal>
            {alsoAs.map((g) => (
              <div class="fp-also-row">
                <p class="fp-also-role">{g.role}</p>
                <ul class="fp-also-films">
                  {g.others.map((f) => (
                    <li>
                      <a href={filmPath(f.slug)} class="chip fp-chip">
                        {f.title} <span class="t-meta">{yearLabel(f)}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Either side on the slate -->
    <nav class="section fp-next-sec" aria-label="More films">
      <div class="wrap">
        <div class="fp-pn">
          {[
            { f: prev, dir: "Previous film" },
            { f: next, dir: "Next film" },
          ].map(({ f, dir }) => {
            const [a, b, c, d] = seedFor(f);
            return (
              <a href={filmPath(f.slug)} class:list={["fp-pn-card", dir === "Next film" && "fp-pn-next"]}>
                <div class="fp-pn-frame">
                  {f.poster ? (
                    <SmartImage src={f.poster.src} alt="" class="fp-pn-img" loading="lazy" />
                  ) : (
                    <div class="fp-pn-tc" style={`--nx:${a}%;--ny:${b}%;--sx:${c}%;--sy:${d}%;`} aria-hidden="true">
                      <span class="fp-pn-sun"></span>
                      <span class="fp-pn-title">{f.title}</span>
                    </div>
                  )}
                </div>
                <div class="fp-pn-meta">
                  <span class="t-meta fp-pn-dir">
                    {dir === "Previous film" && <Icon name="arrow-left" size={13} />}
                    {dir}
                    {dir === "Next film" && <Icon name="arrow-right" size={13} />}
                  </span>
                  <span class="fp-pn-name">{f.title}</span>
                  <span class="t-meta">{yearLabel(f)} · {rolesLine(f)}</span>
                </div>
              </a>
            );
          })}
        </div>
        <div class="fp-all">
          <a href="/filmmaking#slate" class="btn btn-tone">All nine films</a>
        </div>
      </div>
    </nav>
  </div>

  {stills.length > 0 && (
    <div id="flb" class="lb" hidden role="dialog" aria-modal="true" aria-label="Still viewer">
      <div class="lb-backdrop" data-lb-close></div>
      <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Close viewer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
      <figure class="lb-stage">
        <img id="flb-img" class="lb-img" alt="" />
        <figcaption class="lb-cap"><span id="flb-cap" class="t-small"></span></figcaption>
      </figure>
      <div class="lb-bar">
        <button type="button" class="lb-btn" data-lb-prev aria-label="Previous still">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <span id="flb-count" class="t-meta lb-count" aria-live="polite"></span>
        <button type="button" class="lb-btn" data-lb-next aria-label="Next still">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </button>
      </div>
    </div>
  )}
</BaseLayout>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Star dust in the hero: one small 2D canvas that sleeps off screen, in
  // background tabs and for people who asked for less motion.
  const dust = document.querySelector<HTMLCanvasElement>("[data-fp-dust]");
  const ctx = dust?.getContext("2d");
  if (dust && ctx) {
    const phone = window.matchMedia("(max-width: 767px)").matches;
    const dprCap = phone ? 1.5 : 2;
    type Mote = { x: number; y: number; r: number; a: number; tw: number; ts: number; vx: number; vy: number; red: boolean };
    const spawn = (anywhere: boolean): Mote => ({
      x: Math.random(),
      y: anywhere ? Math.random() : 1.02,
      r: Math.random() ** 2.2 * 1.5 + 0.35,
      a: 0.25 + Math.random() * 0.7,
      tw: Math.random() * Math.PI * 2,
      ts: 0.5 + Math.random() * 1.4,
      vx: (Math.random() - 0.5) * 0.006,
      vy: -(0.003 + Math.random() * 0.01),
      red: Math.random() < 0.4,
    });
    const motes = Array.from({ length: phone ? 60 : 130 }, () => spawn(true));
    let w = 0;
    let h = 0;
    const resize = () => {
      const rect = dust.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, dprCap);
      w = rect.width;
      h = rect.height;
      dust.width = Math.max(1, Math.round(w * dpr));
      dust.height = Math.max(1, Math.round(h * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const draw = (t: number, dt: number) => {
      ctx.clearRect(0, 0, w, h);
      for (const m of motes) {
        m.x += m.vx * dt;
        m.y += m.vy * dt;
        if (m.y < -0.02 || m.x < -0.02 || m.x > 1.02) Object.assign(m, spawn(false), { x: Math.random() });
        const fade = Math.max(0, Math.min(1, (1 - m.y) / 0.25, m.y / 0.08));
        const twinkle = 0.55 + 0.45 * Math.sin(t * m.ts + m.tw);
        ctx.globalAlpha = m.a * twinkle * fade;
        ctx.fillStyle = m.red ? "#ff5d78" : "#ffe6ea";
        ctx.beginPath();
        ctx.arc(m.x * w, m.y * h, m.r, 0, Math.PI * 2);
        ctx.fill();
        if (m.r > 1.3) {
          ctx.globalAlpha *= 0.18;
          ctx.beginPath();
          ctx.arc(m.x * w, m.y * h, m.r * 3.2, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    };
    let running = false;
    let onScreen = true;
    let last = 0;
    let raf = 0;
    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000 || 0);
      last = now;
      draw(now / 1000, dt);
      raf = requestAnimationFrame(frame);
    };
    const sync = () => {
      const want = !reduce && onScreen && !document.hidden;
      if (want && !running) {
        running = true;
        last = performance.now();
        raf = requestAnimationFrame(frame);
      } else if (!want && running) {
        running = false;
        cancelAnimationFrame(raf);
      }
    };
    resize();
    draw(0, 0);
    new ResizeObserver(() => {
      resize();
      if (!running) draw(performance.now() / 1000, 0);
    }).observe(dust);
    new IntersectionObserver((entries) => {
      onScreen = entries[0]?.isIntersecting ?? true;
      sync();
    }).observe(dust);
    document.addEventListener("visibilitychange", sync);
    sync();
  }

  // The still viewer: click to open, arrows or swipe to move, Escape or the
  // backdrop to close. Focus stays inside and goes back to the still.
  const lb = document.getElementById("flb");
  const img = document.getElementById("flb-img") as HTMLImageElement | null;
  const cap = document.getElementById("flb-cap");
  const count = document.getElementById("flb-count");
  if (lb && img && cap && count) {
    type Item = { src: string; caption: string; alt: string };
    let items: Item[] = [];
    let cursor = 0;
    let opener: HTMLElement | null = null;
    const collect = (group: string): Item[] =>
      Array.from(document.querySelectorAll<HTMLElement>(`[data-still][data-group="${group}"]`)).map((el) => ({
        src: el.dataset.full || "",
        caption: el.dataset.caption || "",
        alt: el.querySelector("img")?.getAttribute("alt") || "",
      }));
    const preload = (i: number) => {
      const it = items[i];
      if (it) new Image().src = it.src;
    };
    const render = () => {
      const it = items[cursor];
      if (!it) return;
      img.classList.remove("is-in");
      img.onload = () => img.classList.add("is-in");
      img.src = it.src;
      img.alt = it.alt;
      cap.textContent = it.caption;
      count.textContent = `${cursor + 1} / ${items.length}`;
      preload(cursor + 1);
      preload(cursor - 1);
    };
    const open = (el: HTMLElement) => {
      opener = el;
      items = collect(el.dataset.group || "");
      cursor = Math.min(Math.max(Number(el.dataset.index || 0), 0), items.length - 1);
      lb.hidden = false;
      requestAnimationFrame(() => lb.classList.add("is-open"));
      document.documentElement.classList.add("lb-lock");
      render();
      lb.querySelector<HTMLElement>(".lb-close")?.focus();
    };
    const close = () => {
      if (lb.hidden) return;
      lb.classList.remove("is-open");
      document.documentElement.classList.remove("lb-lock");
      window.setTimeout(() => {
        lb.hidden = true;
      }, 220);
      opener?.focus();
    };
    const step = (delta: number) => {
      if (!items.length) return;
      cursor = (cursor + delta + items.length) % items.length;
      render();
    };
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const still = target.closest<HTMLElement>("[data-still]");
      if (still) {
        open(still);
        return;
      }
      if (target.closest("[data-lb-close]")) close();
      if (target.closest("[data-lb-prev]")) step(-1);
      if (target.closest("[data-lb-next]")) step(1);
    });
    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
      if (e.key === "Tab") {
        const stops = Array.from(lb.querySelectorAll<HTMLElement>("button"));
        const at = stops.indexOf(document.activeElement as HTMLElement);
        e.preventDefault();
        stops[(at + (e.shiftKey ? -1 : 1) + stops.length) % stops.length]?.focus();
      }
    });
    let touchX: number | null = null;
    lb.addEventListener("touchstart", (e) => (touchX = e.touches[0]?.clientX ?? null), { passive: true });
    lb.addEventListener(
      "touchend",
      (e) => {
        if (touchX === null) return;
        const dx = (e.changedTouches[0]?.clientX ?? touchX) - touchX;
        if (Math.abs(dx) > 48) step(dx < 0 ? 1 : -1);
        touchX = null;
      },
      { passive: true },
    );
  }
</script>

