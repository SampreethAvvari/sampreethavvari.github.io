---
// /work/<slug>, one page per discipline, opening as the inside of its docking
// bay. The story, what I bring, every project and the writing are real HTML
// laid out as cards in that space; the camera walks the hall as the page
// scrolls. The page wears the Work tab's colour; the discipline is named, not
// coloured. See src/scripts/work-world/.
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Picture from "../../components/common/Picture.astro";
import Icon from "../../components/common/Icon.astro";
import NextStep from "../../components/common/NextStep.astro";
import WorldStage from "../../components/work-world/WorldStage.astro";
import { RESUME, bayStopCount, groupCards } from "../../components/work-world/world-data";
import { disciplines } from "../../data/disciplines";
import { readingTime } from "../../utils/readingTime";

export function getStaticPaths() {
  return disciplines.map((d) => ({ params: { slug: d.slug }, props: { d } }));
}

const { d } = Astro.props;
const idx = disciplines.findIndex((x) => x.slug === d.slug);
const prev = disciplines[(idx + disciplines.length - 1) % disciplines.length];
const next = disciplines[(idx + 1) % disciplines.length];
const pad = (n: number) => String(n).padStart(2, "0");

// A cover only renders when its file (or its .avif/.webp sibling) exists, so
// a project whose art is still being made shows a calm panel instead.
const hasPublic = (p?: string) =>
  !!p &&
  [p, p.replace(/\.(png|jpe?g)$/i, ".avif"), p.replace(/\.(png|jpe?g)$/i, ".webp")].some((f) =>
    fs.existsSync(path.join(process.cwd(), "public", f)),
  );

const isLive = (s: string) => s === "In production" || s === "Live" || s === "Running program";

// The tagline's first sentence finishes the headline; the rest of it opens
// "What I bring". A tagline that is one sentence splits at its colon.
function splitTagline(t: string): [string, string] {
  const dot = t.indexOf(". ");
  if (dot > 0) return [t.slice(0, dot + 1), t.slice(dot + 2)];
  const colon = t.indexOf(": ");
  if (colon > 0) {
    const rest = t.slice(colon + 2);
    return [t.slice(0, colon) + ".", rest.charAt(0).toUpperCase() + rest.slice(1)];
  }
  return [t, ""];
}
const [tail, bringTail] = splitTagline(d.tagline);

// Date and reading time for each article, read from the post itself.
const posts = await Astro.glob("../posts/*.md");
const postByUrl = new Map(posts.map((p) => [p.url, p]));
const monthYear = (iso?: string) =>
  iso
    ? new Date(`${iso}T00:00:00Z`).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" })
    : "";
const articles = d.articles.map((a) => {
  const post = postByUrl.get(a.href);
  const meta = post ? [monthYear(post.frontmatter.date), `${readingTime(post.rawContent())} min read`].filter(Boolean).join(" · ") : "";
  return { ...a, meta };
});

const groups = groupCards(d.projects);
const stops = bayStopCount(d);
const shelfRows = articles.length <= 3 ? [articles.length] : articles.length === 4 ? [2, 2] : articles.length === 5 ? [3, 2] : articles.length === 6 ? [3, 3] : [4, 3];
const shelfWidth = (i: number) => {
  let seen = 0;
  for (const r of shelfRows) {
    if (i < seen + r) return 12 / r;
    seen += r;
  }
  return 4;
};

// Each screen frames the bay differently, so the words and cards move too.
const LAYS = ["lay-left", "lay-fan", "lay-right"];
const SIDES = ["at-bl", "at-bc", "at-br"];
const SHADES = ["b", "b", "b"];
const shopCount = 3;
const resume = RESUME[d.slug];
---

<BaseLayout title={`${d.name} · Sampreeth Avvari`} description={d.summary}>
  <WorldStage page="bay" slug={d.slug} stops={stops} label={`Inside the ${d.name} bay`} span={1.6}>
    <!-- Arrive -->
    <section class="ww-panel at-bl" data-stop="0" data-id="arrive" data-shade="bl" data-depth="40">
      <div class="ww-box" style="max-width:min(860px,80vw)">
        <p class="ww-eye"><b>Bay {pad(idx + 1)}</b><i></i><span>{d.projects.length} projects · {d.articles.length} articles</span></p>
        <h1 class="ww-h1" style="font-size:clamp(2.4rem,6vw,5.75rem)">{d.name}.</h1>
        <p class="ww-line">{tail}</p>
        <p class="ww-meta">{d.summary}</p>
        <p class="ww-cue"><i></i>Scroll to walk the bay</p>
      </div>
    </section>

    <!-- How I work -->
    <section class="ww-panel at-r" data-stop="1" data-id="how" data-shade="" data-depth="30" id="how">
      <div class="ww-box" style="max-width:440px">
        <p class="ww-eye"><b>How I work</b></p>
        <ul class="ww-points">
          {d.points.map((pt, k) => (
            <li data-note={k} data-id={`point-${k}`}><strong>{pt.lead}</strong> <span>{pt.text}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- What I bring -->
    <section class="ww-panel at-tl" data-stop="2" data-id="bring" data-shade="tl" data-depth="26" id="bring">
      <div class="ww-box" style="max-width:640px">
        <p class="ww-eye"><b>What I bring</b></p>
        {bringTail && <p class="ww-line">{bringTail}</p>}
        <ul class="ww-plates">
          {d.strengths.map((s, k) => (
            <li data-note={k} data-id={`strength-${k}`}><strong>{s.title}</strong><span>{s.body}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- The projects, a few to a screen -->
    {groups.map((g, gi) => (
      <section class={`ww-panel ${SIDES[gi % shopCount]}`} data-stop={3 + gi} data-id={`work-${gi + 1}`} data-shade={SHADES[gi % shopCount]} data-depth="28">
        <div class={`ww-deck n${g.length} ${g.length === 2 ? "lay-pair" : LAYS[gi % LAYS.length]}`} data-ww-scroll>
          {g.map((p, k) => (
            <article class="ww-card" data-note={gi * 3 + k} data-id={`card-${gi * 3 + k}`}>
              <span class="ww-card-art" aria-hidden="true">
                {hasPublic(p.img) ? <Picture src={p.img ?? ""} alt="" width={640} height={360} /> : <span class="ww-card-fallback">{p.name}</span>}
              </span>
              <div class="ww-card-body">
                <span class:list={["ww-badge", { "is-live": isLive(p.status) }]}>{p.status}</span>
                <h3>{p.href ? <a href={p.href}>{p.name}</a> : p.name}</h3>
                <p>{p.oneLiner}</p>
                {p.highlights && (
                  <ul>
                    {p.highlights.slice(0, 3).map((h) => <li>{h}</li>)}
                  </ul>
                )}
                {p.demo && (
                  <div class="ww-card-links"><a href={p.demo}>Live demo</a></div>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <!-- The writing -->
    <section class="ww-panel at-bc" data-stop={3 + groups.length} data-id="writing" data-shade="b" data-depth="26" id="writing" style="text-align:left">
      <div style="display:grid;gap:14px;justify-items:start;width:min(1120px,100%)">
        <p class="ww-eye"><b>The writing</b><i></i><a href="/posts" style="color:inherit;text-decoration:none;pointer-events:auto">All posts</a></p>
        <div class="ww-shelf" data-ww-scroll>
          {articles.map((a, k) => (
            <a href={a.href} style={`--w:${shelfWidth(k)};pointer-events:auto`} data-note={k} data-id={`article-${k}`}>
              <span class="ww-shelf-art" aria-hidden="true">
                {hasPublic(a.img) ? <Picture src={a.img ?? ""} alt="" width={160} height={108} /> : <span class="ww-card-fallback"></span>}
              </span>
              <span><b>{a.title}</b>{a.meta && <small>{a.meta}</small>}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- The way out -->
    <section class="ww-panel at-c" data-stop={stops - 1} data-id="exit" data-shade="all" data-depth="20" id="exit">
      <div class="ww-box" style="justify-items:center;text-align:center;max-width:640px">
        <p class="ww-eye"><b>End of the bay</b></p>
        <h2 class="ww-h2">Next doors.</h2>
        <nav class="ww-doors" aria-label="Other bays">
          <a href={`/work/${prev.slug}`} class="ww-door" data-note={0} data-id={`door-${prev.slug}`}>
            <small>Previous bay</small><b>{prev.name}</b>
          </a>
          <a href={`/work/${next.slug}`} class="ww-door is-next" data-note={1} data-id={`door-${next.slug}`}>
            <small>Next bay</small><b>{next.name}</b>
          </a>
        </nav>
        <div class="ww-actions">
          <a class="jb" href="/work"><span>Back to the station</span><i class="jb-arrow"><Icon name="arrow-right" size={13} /></i></a>
          <a class="jb is-ghost" href={resume} target="_blank" rel="noopener noreferrer"><span>Resume for this work</span><i class="jb-arrow"><Icon name="arrow-up-right" size={13} /></i></a>
        </div>
      </div>
    </section>

    <nav slot="hud" class="ww-rail" aria-label="In this bay">
      <ol>
        <li><a href="/work" data-out>Station</a></li>
        <li class="is-gap" aria-hidden="true"></li>
        <li><a href="#how" data-ww-go="1">How I work</a></li>
        <li><a href="#bring" data-ww-go="2">What I bring</a></li>
        {groups.map((_, gi) => <li><a href={`#work-${gi + 1}`} data-ww-go={3 + gi}>Projects {gi + 1}</a></li>)}
        <li><a href="#writing" data-ww-go={3 + groups.length}>Writing</a></li>
        <li><a href="#exit" data-ww-go={stops - 1}>Next doors</a></li>
      </ol>
    </nav>
  </WorldStage>

  <NextStep next={{ href: "/architecture", label: "See the drawings" }} />
</BaseLayout>
