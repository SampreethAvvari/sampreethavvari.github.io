---
// /work: a ring station with one docking bay per kind of work, then the career
// as a comet's path through time. One pinned stage, twelve stops; all the words
// and links are real HTML in the panels below. See src/scripts/work-world/.
import BaseLayout from "../../layouts/BaseLayout.astro";
import NextStep from "../../components/common/NextStep.astro";
import Icon from "../../components/common/Icon.astro";
import WorldStage from "../../components/work-world/WorldStage.astro";
import { BAYS, TRAIL, bayStopCount, disciplines, leadProjects } from "../../components/work-world/world-data";

const pad = (n: number) => String(n).padStart(2, "0");

// Where the words sit on each screen, and the dark they sit on.
const BAY_AT = [
  { at: "at-bl", shade: "bl", depth: 90 },
  { at: "at-tl", shade: "tl", depth: 240 },
  { at: "at-br", shade: "br", depth: 60 },
  { at: "at-tr", shade: "tr", depth: 110 },
];
const TRAIL_AT = [
  { at: "at-tl", shade: "tl", depth: 300 },
  { at: "at-bc", shade: "b", depth: 300, glass: true },
  { at: "at-tr", shade: "tr", depth: 340 },
  { at: "at-r", shade: "", depth: 240 },
  { at: "at-bl", shade: "bl", depth: 300 },
  { at: "at-bl", shade: "bl", depth: 420 },
];
const stopsTotal = 1 + BAYS.length + 1 + TRAIL.length;
---

<BaseLayout title="Work · Sampreeth Avvari">
  <WorldStage page="index" stops={stopsTotal} label="A ring station with four docking bays, then the career as a comet's path">
    <!-- 0 The first screen -->
    <section class="ww-panel at-bl" data-stop="0" data-id="station" data-shade="bl" data-depth="150" id="station">
      <div class="ww-box" style="max-width:min(880px,78vw)">
        <p class="ww-eye"><b>Work</b><i></i><span>One station, four bays</span></p>
        <h1 class="ww-h1">One engineer, <span class="is-dim">four kinds of work.</span></h1>
        <p class="ww-line">Most of it comes from Hybridge, a dental implant company where I've been the only engineer in the building.</p>
        <p class="ww-cue"><i></i>Scroll or drag to turn the station</p>
      </div>
    </section>

    <!-- 1 to 4 The bays -->
    {BAYS.map((b, i) => {
      const d = disciplines.find((x) => x.slug === b.slug)!;
      const a = BAY_AT[i];
      return (
        <section class={`ww-panel ww-bay ${a.at}`} data-stop={i + 1} data-id={b.slug} data-bay={b.slug} data-interior={bayStopCount(d)} data-shade={a.shade} data-depth={a.depth} id={b.slug}>
          <div class="ww-box">
            <p class="ww-eye"><b>Bay {pad(i + 1)}</b><i></i><span>{d.projects.length} projects · {d.articles.length} articles</span></p>
            <h2 class="ww-h2"><a href={`/work/${b.slug}`} data-ww-enter={b.slug}>{d.name}</a></h2>
            <p class="ww-line">{b.form}</p>
            <div class="ww-reveal">
              <ul class="ww-stats">
                {b.stats.map((s, k) => (
                  <li style={`--i:${k}`} data-note={k} data-id={`${b.slug}-stat-${k}`}><b>{s.value}</b><span>{s.label}</span></li>
                ))}
              </ul>
              <ul class="ww-work">
                {leadProjects(d, b.lead).map((p, k) => (
                  <li><a class="ww-chip" href={p.href ?? `/work/${b.slug}`} data-note={k} data-id={`${b.slug}-work-${k}`}>{p.name.split(":")[0]}</a></li>
                ))}
              </ul>
              <div class="ww-actions">
                <a class="jb is-solid" href={`/work/${b.slug}`} data-ww-enter={b.slug}><span>Enter the bay</span><i class="jb-arrow"><Icon name="arrow-right" size={13} /></i></a>
              </div>
            </div>
          </div>
        </section>
      );
    })}

    <!-- 5 The turn: from the bays to the trail -->
    <section class="ww-panel at-bl" data-stop="5" data-id="trail" data-shade="bl" data-depth="500" id="trail">
      <div class="ww-box">
        <p class="ww-eye"><b>The trail</b><i></i><span>Six chapters on one path</span></p>
        <h2 class="ww-h1">2017 <span class="is-dim">to now.</span></h2>
        <p class="ww-line">Distance is time. Keep scrolling and it runs back to the start.</p>
      </div>
    </section>

    <!-- 6 to 11 The stops -->
    {TRAIL.map((t, i) => {
      const a = TRAIL_AT[i];
      const last = i === TRAIL.length - 1;
      return (
        <section class={`ww-panel ww-stop ${a.at}`} data-stop={6 + i} data-id={t.id} data-body={t.body} data-shade={a.shade} data-depth={a.depth} id={t.id}>
          <div class:list={["ww-box", { "is-glass": a.glass }]}>
            <p class="ww-eye"><b>{t.date}</b></p>
            <h2 class="ww-h2">{t.title}</h2>
            <p class="ww-line">{t.org} · {t.place}</p>
            <ul class="ww-facts">
              {t.facts.map((f, k) => <li><span class="ww-chip" data-note={k} data-id={`${t.id}-fact-${k}`}>{f}</span></li>)}
            </ul>
            <div class="ww-more">
              <p>{t.blurb}</p>
              {t.links.length > 0 && (
                <ul class="ww-work">
                  {t.links.map((l) => <li><a class="ww-chip" href={l.href}>{l.label}</a></li>)}
                </ul>
              )}
            </div>
            <button type="button" class="ww-toggle" data-ww-toggle aria-expanded="false">More</button>
            {last && (
              <div class="ww-actions">
                <a class="jb is-solid" href="/resume"><span>Resume</span><i class="jb-arrow"><Icon name="arrow-up-right" size={13} /></i></a>
                <a class="jb is-ghost" href="/gallery"><span>Screenshots</span><i class="jb-arrow"><Icon name="arrow-right" size={13} /></i></a>
              </div>
            )}
          </div>
        </section>
      );
    })}

    <nav slot="hud" class="ww-rail" aria-label="Stops">
      <ol>
        <li><a href="#station" data-ww-go="0" aria-current="step">Station</a></li>
        {BAYS.map((b, i) => <li><a href={`#${b.slug}`} data-ww-go={i + 1}>{disciplines.find((x) => x.slug === b.slug)!.name}</a></li>)}
        <li class="is-gap" aria-hidden="true"></li>
        <li><a href="#trail" data-ww-go="5">The trail</a></li>
        {TRAIL.map((t, i) => <li><a href={`#${t.id}`} data-ww-go={6 + i}>{t.year} · {t.org}</a></li>)}
      </ol>
    </nav>
    <p slot="hud" class="ww-read" aria-hidden="true"><span data-ww-year>2017</span></p>
  </WorldStage>

  <NextStep next={{ href: "/projects", label: "See every project" }} />
</BaseLayout>
