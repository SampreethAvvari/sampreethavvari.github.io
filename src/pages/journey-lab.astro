---
// Bare test page for the journey engine. Not linked anywhere; delete before merge.
const chapters = [
  { id: "launch", color: "#5B8DEF" },
  { id: "proof", color: "#22D3EE" },
  { id: "projects", color: "#5B8DEF" },
  { id: "disciplines", color: "#F5A524" },
  { id: "writing", color: "#34D399" },
  { id: "film", color: "#F43F5E" },
  { id: "mind", color: "#A78BFA" },
  { id: "contact", color: "#F5A524" },
  { id: "connect", color: "#5B8DEF" },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Journey lab</title>
    <style>
      html, body { margin: 0; background: #020309; color: #fff; font-family: system-ui, sans-serif; }
      #journey { position: fixed; inset: 0; width: 100vw; height: 100lvh; display: block; }
      main { height: 1000vh; }
      #copy { position: fixed; max-width: 34vw; z-index: 2; pointer-events: none; transition: opacity .3s; }
      #copy h2 { font-size: clamp(28px, 4.4vw, 60px); margin: 0; font-weight: 600; letter-spacing: -0.02em; text-shadow: 0 2px 24px rgba(0,0,0,.6); }
      #copy p { margin: 10px 0 0; opacity: .7; font-size: 15px; line-height: 1.5; }
      #ring { position: fixed; border: 1px dashed rgba(255,255,255,.35); border-radius: 50%; pointer-events: none; z-index: 2; }
      #hud { position: fixed; top: 8px; right: 8px; font: 12px ui-monospace, monospace; background: rgba(0,0,0,.45); padding: 4px 8px; border-radius: 6px; z-index: 3; }
      body.clean #hud, body.clean #ring { visibility: hidden; }
      body.notext #copy { visibility: hidden; }
      @media (max-width: 700px) { #copy { max-width: none; left: 24px !important; right: 24px !important; top: auto !important; bottom: 9vh !important; } }
    </style>
  </head>
  <body>
    <canvas id="journey"></canvas>
    <div id="copy"><h2></h2><p>Placeholder copy so the framing can be judged: a line or two of text sits where the page will put the words.</p></div>
    <div id="ring"></div>
    <div id="hud">loading</div>
    <main></main>
    <script define:vars={{ chapters }} is:inline>
      window.__chapters = chapters;
    </script>
    <script>
      import type { Journey, JourneyChapter, ShipScreen } from "../scripts/journey/engine";

      const w = window as unknown as {
        __chapters: JourneyChapter[];
        __journey?: Journey;
        __frames: number;
        __setP?: (p: number) => void;
        __glide?: (to: number, ms?: number) => void;
        __pointer?: (nx: number, ny: number) => void;
        __ship?: ShipScreen;
        __p?: number;
      };
      w.__frames = 0;
      const params = new URLSearchParams(location.search);
      const quality = params.get("q") === "low" ? "low" : "high";
      const fixedP = params.has("p") ? parseFloat(params.get("p") || "0") : null;
      const reduced = params.get("rm") === "1" || matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (params.get("clean") === "1") document.body.classList.add("clean");
      if (params.get("text") === "0") document.body.classList.add("notext");
      const canvas = document.getElementById("journey") as HTMLCanvasElement;
      const hud = document.getElementById("hud")!;
      const copy = document.getElementById("copy")!;
      const ring = document.getElementById("ring")!;

      (async () => {
        const engine = await import("../scripts/journey/engine");
        canvas.addEventListener("journeyready", () => ((window as unknown as { __ready: number }).__ready = performance.now()));
        const max = w.__chapters.length;
        let current = fixedP ?? 0;
        const j = await engine.mountJourney(canvas, {
          chapters: w.__chapters,
          quality,
          reducedMotion: reduced,
          onShip: (s) => {
            w.__ship = { ...s };
            const h = innerHeight;
            ring.style.left = `${s.x * innerWidth - s.r * h}px`;
            ring.style.top = `${s.y * h - s.r * h}px`;
            ring.style.width = ring.style.height = `${s.r * 2 * h}px`;
          },
        });
        w.__journey = j;
        const place = (p: number) => {
          const world = Math.max(0, Math.min(max - 1, Math.floor(p + 0.2)));
          const f = engine.CHAPTER_FRAMING[world];
          copy.querySelector("h2")!.textContent = w.__chapters[world].id;
          copy.style.left = f.side === "left" ? "6vw" : "auto";
          copy.style.right = f.side === "right" ? "6vw" : "auto";
          copy.style.top = f.v === "top" ? "12vh" : "auto";
          copy.style.bottom = f.v === "bottom" ? "12vh" : "auto";
          const jump = engine.jumpState(p);
          copy.style.opacity = jump ? String(Math.abs(jump.amount - 0.5) * 2) : "1";
        };
        const set = (p: number) => {
          current = p;
          w.__p = p;
          j.setScroll(p, 0);
          place(p);
        };
        addEventListener(
          "scroll",
          () => {
            if (fixedP === null) set(Math.min(max, Math.max(0, scrollY / innerHeight)));
          },
          { passive: true },
        );
        addEventListener("pointermove", (e) => j.setPointer((e.clientX / innerWidth) * 2 - 1, (e.clientY / innerHeight) * 2 - 1), { passive: true });
        document.addEventListener("visibilitychange", () => j.setPaused(document.hidden));
        w.__setP = set;
        w.__pointer = (nx, ny) => j.setPointer(nx, ny);
        // The page's step: a 1400 ms ease in and out between rest points.
        w.__glide = (to: number, ms = 1400) => {
          const from = current;
          const t0 = performance.now();
          const tick = () => {
            const t = Math.min(1, (performance.now() - t0) / ms);
            const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
            set(from + (to - from) * e);
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        set(fixedP ?? Math.min(max, scrollY / innerHeight));

        let frames = 0;
        let t0 = performance.now();
        const tick = () => {
          frames++;
          w.__frames++;
          const now = performance.now();
          if (now - t0 > 1000) {
            hud.textContent = `${quality} ${Math.round((frames * 1000) / (now - t0))} fps p=${current.toFixed(2)}`;
            frames = 0;
            t0 = now;
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      })();
    </script>
  </body>
</html>
