---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MaterialActions from "../../components/teaching/MaterialActions.tsx";
import TeachingBranding from "../../components/teaching/TeachingBranding.astro";
import { teaching, streamMeta, typeMeta } from "../../data/teaching";
import Picture from "../../components/common/Picture.astro";
import Icon from "../../components/common/Icon.astro";
import { info } from "../../data/info";

export function getStaticPaths() {
  return teaching.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props;
const stream = streamMeta[m.stream];
const tm = typeMeta[m.type];

// Small facts under the title: the discipline in words, the size, the date.
const size =
  m.type === "pdf" && m.pages
    ? `${m.pages} pages`
    : m.type === "video" && m.durationMin
      ? `${m.durationMin} min`
      : "";
const added = new Date(`${m.addedAt}T00:00:00Z`).toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const facts = [stream.label, size, `Added ${added}`].filter(Boolean).join(" · ");

// "What to expect" reads as paragraphs when the copy has blank lines.
const expect = m.whatToExpect
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

// Normalize a video URL to an embeddable form for the inline player.
function embedUrl(url: string): string {
  const yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([\w-]+)/);
  if (yt) return `https://www.youtube.com/embed/${yt[1]}`;
  const vm = url.match(/vimeo\.com\/(\d+)/);
  if (vm) return `https://player.vimeo.com/video/${vm[1]}`;
  return url;
}
---

<BaseLayout title={`SA: ${m.title}`} description={m.description}>
  <article class="tm-page">
    <section class="page-top tm-top relative overflow-hidden">
      <div class="tone-atmos" aria-hidden="true"></div>
      <div class="wrap on-top">
        <div class="tm-head">
          <div class="tm-main">
            <a href="/teaching" class="tm-back">
              <Icon name="arrow-right" size={14} class="tm-back-arrow" /> All teaching
            </a>
            <p class="kicker tm-kicker">Teaching</p>
            <h1 class="t-title tm-title">{m.title}</h1>
            <p class="t-lede tm-lede">{m.description}</p>
            <div class="tm-facts">
              <span class="badge">{tm.label}</span>
              <span class="badge" title={stream.label}>{stream.acronym}</span>
              <span class="t-meta">{facts}</span>
            </div>
            <MaterialActions client:load slug={m.slug} file={m.file} title={m.title} />
          </div>

          <figure class="tm-cover">
            <Picture
              src={m.cover}
              alt={m.title}
              width={1344}
              height={768}
              class="tm-cover-img"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        </div>
      </div>
    </section>

    <section class="tm-detail">
      <div class="wrap">
        <div class="tm-grid">
          <div class="tm-expect">
            <h2 class="t-h3">What to expect</h2>
            {expect.map((p) => <p class="t-body tm-expect-p">{p}</p>)}
          </div>

          <aside class="surface surface-pad tm-connect" aria-label="About the author">
            <div class="tm-connect-id">
              <div class="tm-connect-ava">
                <Picture src={info.picture} alt={info.picture_alt} width={96} height={96} loading="lazy" />
              </div>
              <div class="min-w-0">
                <p class="t-h4">{info.name}</p>
                <p class="t-meta">{info.role} · {info.location}</p>
              </div>
            </div>
            <p class="t-small tm-connect-note">Questions, or ideas for what I should cover next? Reach out.</p>
            <div class="tm-connect-links">
              <a class="btn btn-glass btn-sm" href={info.contact.linkedin} target="_blank" rel="noreferrer">
                <Icon name="linkedin" size={14} /> Connect on LinkedIn
              </a>
              <a class="btn btn-glass btn-sm" href={`mailto:${info.contact.email}`}>
                <Icon name="mail" size={15} /> Email me
              </a>
              <a class="btn btn-glass btn-sm" href={info.contact.github} target="_blank" rel="noreferrer">
                <Icon name="github" size={14} /> GitHub
              </a>
            </div>
          </aside>
        </div>

        {m.type === "pdf" && m.file && (
          <div class="tm-viewer">
            <div class="tm-viewer-head">
              <h2 class="t-h3">Read it here</h2>
              <a href={m.file} target="_blank" rel="noopener" class="tlink">
                Open in a new tab <Icon name="arrow-up-right" size={14} />
              </a>
            </div>
            <div class="tm-frame">
              <iframe
                src={`${m.file}#toolbar=0&navpanes=0&view=FitH`}
                title={m.title}
                class="tm-viewer-pdf"
                loading="lazy"
              />
            </div>
          </div>
        )}
        {m.type === "video" && m.videoUrl && (
          <div class="tm-viewer">
            <div class="tm-viewer-head">
              <h2 class="t-h3">Watch it here</h2>
            </div>
            <div class="tm-frame tm-viewer-video">
              <iframe
                src={embedUrl(m.videoUrl)}
                title={m.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
          </div>
        )}
        {m.type === "blog" && m.body && (
          <div class="tm-viewer tm-viewer-blog" set:html={m.body} />
        )}
      </div>
    </section>

    <TeachingBranding />
  </article>
</BaseLayout>

<style>
  /* Page top: copy on the left, the cover in a frame on the right. */
  .tm-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .tm-head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 64px; }
  }
  .tm-back {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 28px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 150ms var(--ease-glass);
  }
  .tm-back:hover { color: var(--ink); transform: none; }
  .tm-back :global(.tm-back-arrow) { transform: rotate(180deg); transition: transform 250ms var(--ease-glass); }
  .tm-back:hover :global(.tm-back-arrow) { transform: rotate(180deg) translateX(3px); }
  .tm-kicker { display: flex; }
  .tm-title { margin-top: 22px; }
  .tm-lede { margin-top: 22px; }
  .tm-facts {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .tm-facts .t-meta { margin-left: 4px; }

  .tm-cover {
    margin: 0;
    padding: 10px;
    border-radius: 28px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      0 40px 80px -40px rgba(0, 0, 0, 1),
      0 0 80px -30px rgba(var(--tone-rgb), 0.35);
  }
  .tm-cover :global(.tm-cover-img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 20px;
    background: #07080b;
  }

  /* Actions (React island) */
  .tm-main :global(.tm-actions) { margin-top: 32px; display: grid; gap: 14px; justify-items: start; }
  .tm-main :global(.tm-actions-btns) { display: flex; flex-wrap: wrap; gap: 12px; }
  .tm-main :global(.tm-stats) { margin: 0; }

  /* What to expect, with the author beside it. */
  .tm-detail { position: relative; z-index: 1; padding-top: clamp(56px, 7vw, 88px); }
  .tm-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .tm-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: 64px; }
  }
  .tm-expect { max-width: 42rem; }
  .tm-expect-p { margin-top: 14px; font-size: 1.0625rem; line-height: 1.7; }
  .tm-connect-id { display: flex; align-items: center; gap: 14px; }
  .tm-connect-ava {
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    overflow: hidden;
    flex: none;
    border: 1px solid var(--line-strong);
  }
  /* The portrait is a wide street shot: frame the face. */
  .tm-connect-ava :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 64% 50%; transform: translate(-28.6%, 35.7%) scale(2.1); display: block; }
  .tm-connect-note { margin-top: 16px; }
  .tm-connect-links { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 8px; }

  /* The reader */
  .tm-viewer { margin-top: clamp(56px, 7vw, 88px); }
  .tm-viewer-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 20px;
  }
  .tm-frame {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface-solid);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 30px 60px -42px rgba(0, 0, 0, 0.95);
  }
  .tm-viewer-pdf { display: block; width: 100%; height: 82vh; min-height: 30rem; border: 0; background: #0b0c10; }
  .tm-viewer-video { position: relative; aspect-ratio: 16 / 9; }
  .tm-viewer-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .tm-viewer-blog { max-width: 42rem; font-size: 1.0625rem; line-height: 1.7; color: var(--ink-soft); }
  .tm-viewer-blog :global(h2), .tm-viewer-blog :global(h3) { color: var(--ink); font-weight: 600; letter-spacing: -0.02em; margin: 1.8em 0 0.6em; }
  .tm-viewer-blog :global(p) { margin: 0 0 1em; color: var(--ink-soft); }
  .tm-viewer-blog :global(a) { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--ink-ghost); }

  /* The review gate, portalled to <body>. Glass, because it is a modal. */
  :global(.tm-modal) {
    position: fixed;
    inset: 0;
    z-index: 95;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  :global(.tm-modal-backdrop) {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  :global(.tm-modal-card) {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 30rem;
    padding: 28px 24px 24px;
    border-radius: 24px;
    color: var(--ink);
    animation: glass-in 260ms var(--ease-glass);
  }
  :global(.tm-modal-x) {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    border: 0;
    color: var(--ink-soft);
    background: var(--wash-strong);
    cursor: pointer;
    transition: color 150ms var(--ease-glass), background-color 150ms var(--ease-glass);
  }
  :global(.tm-modal-x svg) { width: 15px; height: 15px; }
  :global(.tm-modal-x:hover) { color: var(--ink); background: rgba(255, 255, 255, 0.14); }
  :global(.tm-modal-title) { margin-top: 8px; padding-right: 32px; }
  :global(.tm-modal-sub) { margin-top: 8px; }
  :global(.tm-stars) { display: flex; gap: 4px; margin: 20px 0 16px; }
  :global(.tm-star) {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: transparent;
    color: var(--ink-ghost);
    cursor: pointer;
    transition: color 150ms var(--ease-glass), background-color 150ms var(--ease-glass);
  }
  :global(.tm-star svg) { width: 24px; height: 24px; fill: currentColor; }
  :global(.tm-star:hover) { background: var(--wash); }
  :global(.tm-star.is-on) { color: var(--ink); }
  :global(.tm-star:focus-visible) { outline: none; box-shadow: 0 0 0 3px rgba(var(--tone-rgb), 0.45); }
  :global(.tm-textarea) {
    display: block;
    width: 100%;
    min-height: 6rem;
    resize: vertical;
    margin-bottom: 16px;
    padding: 12px 14px;
    border-radius: 14px;
    font: inherit;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink);
    background: var(--wash);
    border: 1px solid var(--line-strong);
  }
  :global(.tm-textarea::placeholder) { color: var(--ink-faint); }
  :global(.tm-textarea:focus) { outline: none; border-color: rgba(255, 255, 255, 0.3); box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.06); }
  :global(.tm-submit) { width: 100%; }
  :global(.tm-submit:disabled) { opacity: 0.4; cursor: not-allowed; transform: none; box-shadow: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(.tm-modal-card) { animation: none; }
  }
</style>
