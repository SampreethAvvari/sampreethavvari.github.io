---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MaterialActions from "../../components/teaching/MaterialActions.tsx";
import TeachingBranding from "../../components/teaching/TeachingBranding.astro";
import { teaching, streamMeta, typeMeta } from "../../data/teaching";
import books from "../../data/teaching-pages.json";
import Picture from "../../components/common/Picture.astro";
import Icon from "../../components/common/Icon.astro";
import { info } from "../../data/info";
import fs from "node:fs";
import path from "node:path";
// Only these pages download these stylesheets.
import "../../styles/teaching.css";
import "../../styles/teaching-material.css";
import "../../styles/solid-glass.css";

export function getStaticPaths() {
  return teaching.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props;
const stream = streamMeta[m.stream];
const tm = typeMeta[m.type];

// Small facts under the title: the discipline in words, the size, the date.
const size =
  m.type === "pdf" && m.pages
    ? `${m.pages} pages`
    : m.type === "video" && m.durationMin
      ? `${m.durationMin} min`
      : "";
const added = new Date(`${m.addedAt}T00:00:00Z`).toLocaleDateString("en-US", {
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const facts = [stream.label, size, `Added ${added}`].filter(Boolean).join(" · ");

// "What to expect" reads as paragraphs when the copy has blank lines.
const expect = m.whatToExpect
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

// Normalize a video URL to an embeddable form for the inline player.
function embedUrl(url: string): string {
  const yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([\w-]+)/);
  if (yt) return `https://www.youtube.com/embed/${yt[1]}`;
  const vm = url.match(/vimeo\.com\/(\d+)/);
  if (vm) return `https://player.vimeo.com/video/${vm[1]}`;
  return url;
}

// The cover is the largest paint. No preload: the browser finds it soon enough, it
// cannot paint before the styles arrive anyway, and on a slow connection it would
// only hold the styles up.
const artSizes = "(min-width: 1024px) 96vw, 175vw";
const artBase = m.cover.replace(/\.(png|jpe?g|webp|avif)$/i, "");
const longTitle = m.title.length > 20;

// The stack at the reader's place: real pages, made by scripts/make-teaching-pages.mjs.
const book = (books as Record<string, { pages: number; w: number; h: number; odd: Record<string, number[]> }>)[m.slug];
const leafPages = [1, 3, 9].map((n) => `/teaching/pages/${m.slug}-${n}.webp`);
const leaves = leafPages.filter((p) => fs.existsSync(path.join(process.cwd(), "public", p)));
---

<BaseLayout
  title={`SA: ${m.title}`}
  description={m.description}
>
  <article class="tm-page" data-teaching>
    <header class="ts-hero tm-hero" data-ts-hero data-ts-section="opening" data-rgb="52,211,153" data-seed={(m.slug.length % 13) / 13}>
      <div class="ts-stage">
        <figure class="ts-art tm-art" data-art={artBase}>
          <Picture
            src={m.cover}
            alt={m.title}
            width={1344}
            height={768}
            loading="eager"
            fetchpriority="high"
            sizes={artSizes}
          />
        </figure>
        <canvas class="ts-gl" aria-hidden="true"></canvas>
        <div class="ts-scrim" aria-hidden="true"></div>
        <div class="wrap ts-copy">
          <a href="/teaching" class="tm-back">
            <Icon name="arrow-right" size={14} class="tm-back-arrow" /> All teaching
          </a>
          <div class="tm-main">
            <p class="kicker tm-kicker">Teaching</p>
            <h1 class:list={["tm-title", longTitle && "is-long"]}>{m.title}</h1>
            <p class="t-lede tm-lede">{m.description}</p>
            <div class="tm-facts">
              <span class="badge">{tm.label}</span>
              <span class="badge" title={stream.label}>{stream.acronym}</span>
              <span class="t-meta">{facts}</span>
            </div>
            <MaterialActions client:load slug={m.slug} file={m.file} title={m.title} />
            {m.type === "pdf" && m.file && (
              <a href="#read" class="tlink tm-jump" data-read-jump>
                Read it here
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14m0 0 6-6m-6 6-6-6"></path></svg>
              </a>
            )}
          </div>
        </div>
        <div class="ts-cue" aria-hidden="true"><i></i></div>
      </div>
    </header>

    <section class="tm-flap" data-ts-section="expect">
      <div class="wrap">
        <div class="tm-expect" data-depth>
          <h2 class="t-h3 tm-expect-h">What to expect</h2>
          {expect.map((p) => <p class="tm-expect-p" data-words>{p}</p>)}
        </div>

        <aside class="tm-colophon" aria-label="About" data-depth>
          <div class="tm-connect-id">
            <div class="tm-planet">
              <div class="tm-connect-ava">
                <Picture src={info.picture} alt={info.picture_alt} width={96} height={96} loading="lazy" />
              </div>
              <span class="tm-moon" aria-hidden="true"><i></i></span>
            </div>
            <div class="min-w-0">
              <p class="t-h4">{info.name}</p>
              <p class="t-meta">{info.role} · {info.location}</p>
            </div>
          </div>
          <p class="t-small tm-connect-note">Questions, or ideas for what I should cover next? Reach out.</p>
          <div class="tm-connect-links">
            <a class="btn btn-glass btn-sm" href={info.contact.linkedin} target="_blank" rel="noreferrer">
              <Icon name="linkedin" size={14} /> Connect on LinkedIn
            </a>
            <a class="btn btn-glass btn-sm" href={`mailto:${info.contact.email}`}>
              <Icon name="mail" size={15} /> Email me
            </a>
            <a class="btn btn-glass btn-sm" href={info.contact.github} target="_blank" rel="noreferrer">
              <Icon name="github" size={14} /> GitHub
            </a>
          </div>
        </aside>
      </div>
    </section>

    {m.type === "pdf" && m.file && (
      <section
        class="tr"
        id="read"
        data-reader
        data-ts-section="read"
        data-file={m.file}
        data-slug={m.slug}
        data-title={m.title}
        data-dims={book ? JSON.stringify(book) : undefined}
      >
        <div class="wrap tr-rest">
          <div class="tr-head">
            <h2 class="tr-title">
              <a href={m.file} target="_blank" rel="noopener" class="tr-open">
                Read it here
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m0 0-6-6m6 6-6 6"></path></svg>
              </a>
            </h2>
            <a href={m.file} target="_blank" rel="noopener" class="tlink tr-tab">
              Open in a new tab <Icon name="arrow-up-right" size={14} />
            </a>
          </div>
          <div class="tr-deck" data-depth>
            <a href={m.file} target="_blank" rel="noopener" class="tr-stack" aria-label={`Read ${m.title} here`}>
              <span class="tr-leaf tr-leaf-blank" style="--i:4" aria-hidden="true"></span>
              <span class="tr-leaf tr-leaf-blank" style="--i:3" aria-hidden="true"></span>
              {[2, 1, 0].map((i) => (
                <span class:list={["tr-leaf", i === 0 && "tr-leaf-top"]} style={`--i:${i}`}>
                  {leaves[i] && (i === 0 ? (
                    <Picture src={leaves[i]} alt="" width={800} height={1131} loading="lazy" decoding="async" />
                  ) : (
                    <img data-later={leaves[i]} alt="" width="800" height="1131" decoding="async" />
                  ))}
                </span>
              ))}
              <span class="tr-press" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7c-2-1.6-4.6-2-8-2v13c3.400 0 6 .4 8 2 2-1.600 4.600-2 8-2V5c-3.400 0-6 .4-8 2Zm0 0v13"></path></svg>
              </span>
            </a>
          </div>
        </div>
        <noscript>
          <div class="tr-fallback wrap">
            <iframe src={`${m.file}#toolbar=0&navpanes=0&view=FitH`} title={m.title} loading="lazy"></iframe>
          </div>
        </noscript>
      </section>
    )}

    {m.type === "video" && m.videoUrl && (
      <section class="tm-other" data-ts-section="watch">
        <div class="wrap">
          <div class="tm-viewer" data-depth>
            <div class="tm-viewer-head">
              <h2 class="t-h3">Watch it here</h2>
            </div>
            <div class="tm-frame tm-viewer-video">
              <iframe
                src={embedUrl(m.videoUrl)}
                title={m.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            </div>
          </div>
        </div>
      </section>
    )}
    {m.type === "blog" && m.body && (
      <section class="tm-other" data-ts-section="read">
        <div class="wrap">
          <div class="tm-viewer tm-viewer-blog" set:html={m.body} />
        </div>
      </section>
    )}

    <TeachingBranding />
  </article>

  <script>
    import "../../scripts/teaching/index";
  </script>
</BaseLayout>
