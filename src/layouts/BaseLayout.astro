---
import { ViewTransitions } from "astro:transitions";
import Nav from "../components/navbar/Nav";
import TopButton from "../components/TopButton";
import ChatWidget from "../components/chatbot/ChatWidget";
import FooterBar from "../components/footer/FooterBar";
import SpaceField from "../components/hero/SpaceField.astro";
import WarpLoader from "../components/hero/WarpLoader.astro";
import ScrollOrbit from "../components/ScrollOrbit.astro";
import { info } from "../data/info";
import { personNode, websiteNode, breadcrumbNode, graph, type Crumb } from "../utils/seo";
import "../styles/landing.css";

const {
  title,
  description = "Sampreeth Avvari, forward deployed engineer in New York. The only engineer at a three office dental implant practice, running about 45 services, each drawn with its parts, failure paths and monthly cost.",
  footerVariant = "default",
  // Optional LCP image to preload (an AVIF path). Pages pass their above-the-fold
  // hero/cover so the browser fetches it before it discovers the <img> in markup.
  // When the <img> has a srcset the preload needs the same one, or a phone
  // fetches the wide file here and then the right one for the <img> as well.
  preloadImage,
  preloadSrcset,
  preloadSizes,
  // The page's tab. Its colour marks the kicker, links and background wash.
  tone: toneProp,
  // Search and sharing: this page's share image (a path under public), its
  // Open Graph type, extra structured data nodes, breadcrumbs, and dates.
  ogImage: ogImageProp,
  ogType = "website",
  schema = [],
  crumbs,
  published,
  modified,
  // A page that drives the background wash itself (initAmbient in its own
  // onPage setup) passes this; every other page gets its tab's colour.
  ownSky = false,
}: {
  title: string;
  description?: string;
  footerVariant?: string;
  preloadImage?: string;
  preloadSrcset?: string;
  preloadSizes?: string;
  tone?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  schema?: unknown[];
  crumbs?: Crumb[];
  published?: string;
  modified?: string;
  ownSky?: boolean;
} = Astro.props;

// Canonical URL for the current page (no query strings), absolute via astro.config `site`.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
// Absolute URL for social-share / structured-data image.
const ogImage = new URL(ogImageProp ?? "/og/home.jpg", Astro.site).toString();

// Structured data: one graph per page. The person and the website on every
// page (shared ids, so search and AI engines join them into one entity), then
// whatever the page adds (an article, a system, a list) and its breadcrumbs.
const base = Astro.site!.toString();
const jsonLd = graph([
  personNode(base, {
    image: info.picture,
    email: info.contact.email,
    description: "Forward deployed engineer in New York. The only engineer at a three office dental implant practice, building and running its software, and a filmmaker.",
  }),
  websiteNode(base, "Sampreeth Avvari: forward deployed engineer. Systems, architecture drawings with real costs, writing and films."),
  ...(crumbs?.length ? [breadcrumbNode(base, crumbs)] : []),
  ...schema,
]);
import { searchItems } from "../data/searchItems";

import "../styles/global.css";
import "../styles/system.css";

// One colour per tab. Derived from the first path segment unless a page
// passes its own.
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const seg = pathname.split("/").filter(Boolean)[0] || "";
const TONE_FOR: Record<string, string> = {
  projects: "projects",
  demos: "projects",
  architecture: "architecture",
  work: "work",
  posts: "writing",
  filmmaking: "film",
  gallery: "film",
  teaching: "writing",
  mind: "mind",
  resume: "resume",
};
const tone = toneProp || TONE_FOR[seg] || "home";
const TONE_RGB: Record<string, string> = {
  projects: "91,141,239",
  work: "245,165,36",
  writing: "52,211,153",
  film: "244,63,94",
  architecture: "34,211,238",
  teaching: "52,211,153",
  mind: "167,139,250",
  resume: "206,212,222",
  home: "91,141,239",
};
const toneRgb = TONE_RGB[tone];
// Every tab's colour by its first path segment, so the loader can blend
// toward the next page before it arrives. "" is home.
const toneMap: Record<string, string> = { "": TONE_RGB.home };
for (const [seg, t] of Object.entries(TONE_FOR)) toneMap[seg] = TONE_RGB[t];
// The loader's comets: home blends every tab, so it gets all their colours.
// Blue and green lead, the same pair the sky starts on.
const warpPalette =
  tone === "home" ? [...new Set([toneRgb, TONE_RGB.writing, ...Object.values(TONE_RGB)])] : [toneRgb];

// Comets in the tab's colour on every page. Home and the writing index place
// their own per section, /mind wants a still sky, and the Projects, Work and
// Resume worlds are opaque, so comets would only run unseen under them.
const hasOwnComets =
  pathname === "/" || pathname === "/posts" || pathname === "/mind" || seg === "projects" || seg === "work" || seg === "resume";
const pageComets = hasOwnComets
  ? []
  : Array.from({ length: 8 }, (_, i) => ({
      color: toneRgb,
      top: [5, 17, 30, 43, 56, 69, 81, 91][i],
      side: i % 2 === 0 ? "right" : "left",
      inset: 4 + ((i * 9) % 26),
      w: 104 + ((i * 13) % 40),
      rz: [-16, 12, -8, 18, -20, 6, 14, -12][i],
    }));
---

<!doctype html>
<html lang="en" translate="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="keywords" content="Sampreeth Avvari, Sampreeth Sharma, forward deployed engineer, AI engineer, software engineer, machine learning engineer, system architecture, healthcare AI, portfolio, New York, filmmaker" />
    <meta name="author" content="Sampreeth Avvari" />
    <meta http-equiv="Content-Language" content="en" />
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#000000" />
    <!-- Inter, the variable build with the optical size axis, the only face
         on the site. Served from this site (the same files Google Fonts
         serves) and preloaded, so text paints in Inter without waiting on
         another host. Until it lands, Arial sized to Inter's metrics holds
         the lines where Inter will put them, so nothing reflows. -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face { font-family: "Inter"; font-style: normal; font-weight: 100 900; font-display: swap; src: url(/fonts/inter-latin-ext.woff2) format("woff2"); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
      @font-face { font-family: "Inter"; font-style: normal; font-weight: 100 900; font-display: swap; src: url(/fonts/inter-latin.woff2) format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: "Inter Fallback"; src: local("Arial"); size-adjust: 107.12%; ascent-override: 90.44%; descent-override: 22.52%; line-gap-override: 0%; }
      /* Dark from the very first frame, before any stylesheet has arrived. */
      html { background: #000; color-scheme: dark; }
      body { margin: 0; }
    </style>
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          imagesrcset={preloadSrcset}
          imagesizes={preloadSizes}
          type="image/avif"
          fetchpriority="high"
        />
      )
    }
    <!-- The S glass mark is the tab icon; the SA mark sits in the nav. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Sampreeth Avvari RSS"
      href={`${Astro.site}rss.xml`}
    />
    <meta name="generator" content={Astro.generator} />
    <!-- Open Graph / social share -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Sampreeth Avvari" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published} />}
    {(modified ?? published) && <meta property="article:modified_time" content={modified ?? published} />}
    {ogType === "article" && <meta property="article:author" content="Sampreeth Avvari" />}
    <!-- Structured data: the person, the site and this page, one graph -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
    <!-- No icon font: every icon is an inline SVG. -->
    <title>{title}</title>
    <!-- Pages change without a reload, so the document, the sound, the sky
         and the chrome marked transition:persist last the whole visit. The
         loader covers each move (WarpLoader); page scripts start and stop
         through src/scripts/lifecycle.ts. Browsers without the View
         Transition API get the same swap with a plain fade. -->
    <ViewTransitions fallback="animate" />
    <style is:global>
      /* Reduced motion: page changes swap in place, with no animation. */
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-group(*),
        ::view-transition-old(*),
        ::view-transition-new(*) {
          animation: none !important;
        }
      }
      /* Focus lands on the new page's content after a move; the content
         itself shows no ring. */
      main[tabindex="-1"]:focus {
        outline: none;
      }
    </style>
    <script is:inline>
      // Cloudflare Web Analytics: privacy-first, cookieless, no consent
      // banner needed. Just basic traffic stats. Replaces GA4.
      // Get the token: dash.cloudflare.com → Web Analytics → Add a site
      // (manual) → copy the value of "token" and paste it below.
      (function () {
        var CF_BEACON_TOKEN = "643bcd2b05614ef2b29da4c4f0409d04";
        var host = location.hostname;
        if (host === "localhost" || host === "127.0.0.1") return; // dev runs don't count
        if (!CF_BEACON_TOKEN || CF_BEACON_TOKEN.indexOf("__") === 0) return; // token not set yet
        var s = document.createElement("script");
        s.defer = true;
        s.src = "https://static.cloudflareinsights.com/beacon.min.js";
        s.setAttribute("data-cf-beacon", JSON.stringify({ token: CF_BEACON_TOKEN }));
        document.head.appendChild(s);
      })();
    </script>
    <script is:inline>
      // When a page's script does not come. A chunk that cannot load is not a
      // crash; the 3D simply stays away and the painted sky holds. If the page's
      // own script fails, or has not run after a long wait, the pinned stages
      // would show their first screen and nothing else, so they go back to plain
      // readable pages, the same ones browsers without WebGL get.
      (function () {
        if (window.__pageWatch) return;
        window.__pageWatch = true;
        var WAIT = 12000;
        var timer = 0;
        var root = document.documentElement;
        function flat() {
          clearTimeout(timer);
          root.classList.add("no-stage");
          var pw = document.querySelector("[data-pw]");
          var rw = document.querySelector("[data-rw]");
          var ww = document.querySelector("[data-ww]");
          var wall = document.querySelector("[data-wall]");
          if (pw) pw.classList.remove("is-live");
          if (rw) rw.classList.remove("is-live");
          if (ww) ww.classList.add("is-flat");
          if (wall) {
            wall.setAttribute("data-mode", "list");
            root.classList.remove("wall-on");
          }
        }
        function watch() {
          clearTimeout(timer);
          root.classList.remove("no-stage");
          timer = setTimeout(flat, WAIT);
        }
        function arrived() {
          clearTimeout(timer);
        }
        window.addEventListener("error", function (e) {
          var el = e.target;
          if (el && el.tagName === "SCRIPT" && el.type === "module") flat();
        }, true);
        window.addEventListener("unhandledrejection", function (e) {
          var why = String((e.reason && e.reason.message) || e.reason || "");
          if (/dynamically imported module|importing a module script failed|unable to preload/i.test(why)) e.preventDefault();
        });
        watch();
        document.addEventListener("DOMContentLoaded", arrived, { once: true });
        document.addEventListener("astro:after-swap", watch);
        document.addEventListener("astro:page-load", arrived);
      })();
    </script>
    <script is:inline>
      // The stylesheets are in the body, under the loader (scripts/late-css.mjs).
      // The router only knows stylesheets in the head, so once a page has parsed
      // they move there, and each arriving page's move there too before the swap,
      // with the new ones loaded first. A stylesheet that hangs holds a move back
      // for a few seconds at most.
      (function () {
        if (window.__lateCss) return;
        window.__lateCss = true;
        var LATE = "body [data-late]";
        // A page with a 3D world names its code in a meta tag (scripts/late-css.mjs).
        // It starts down the wire now, at low priority so everything the page needs
        // to read goes first, wherever it will be used. The browser keeps it, and the
        // world does not wait for the page to finish laying out.
        function worldCode(page) {
          var names = page.querySelector('meta[name="world-code"]');
          var net = navigator.connection;
          if (!names || (net && (net.saveData || /2g/.test(net.effectiveType))) || !("WebGL2RenderingContext" in window)) return;
          if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
          names.content.split(" ").forEach(function (href) {
            fetch(href, { priority: "low" }).then(function (res) { return res.text(); }).catch(function () {});
          });
        }
        var parsed = new MutationObserver(function () {
          if (!document.body) return;
          parsed.disconnect();
          worldCode(document);
        });
        parsed.observe(document.documentElement, { childList: true });
        function settle() {
          document.querySelectorAll(LATE).forEach(function (el) {
            var copy = el.cloneNode(true);
            if (el.tagName === "LINK") {
              copy.onload = copy.onerror = function () { el.remove(); };
            } else {
              el.remove();
            }
            document.head.appendChild(copy);
          });
        }
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", settle, { once: true });
        else settle();
        document.addEventListener("astro:before-preparation", function (e) {
          var load = e.loader;
          e.loader = function () {
            return Promise.resolve(load()).then(function () {
              var next = e.newDocument;
              if (!next || next === document) return;
              worldCode(next);
              var waits = [];
              next.querySelectorAll(LATE).forEach(function (el) {
                next.head.appendChild(el);
                if (el.tagName !== "LINK") return;
                var href = el.getAttribute("href");
                if (document.querySelector('link[rel="stylesheet"][href="' + href + '"]')) return;
                waits.push(new Promise(function (done) {
                  var early = document.createElement("link");
                  early.rel = "preload";
                  early.as = "style";
                  early.href = href;
                  early.onload = early.onerror = done;
                  document.head.appendChild(early);
                }));
              });
              if (waits.length) return Promise.race([Promise.all(waits), new Promise(function (done) { setTimeout(done, 5000); })]);
            });
          };
        }, true);
      })();
    </script>
    <script is:inline>
      // The site is dark only. Set the class inline in head to avoid FOUC.
      // Runs once a visit (the same text on every page, so the router does
      // not run it again); lifecycle.ts carries the class across page swaps.
      document.documentElement.classList.add("dark");
    </script>
    <script>
      import { onPage } from "../scripts/lifecycle";
      import { mountPrefetch } from "../scripts/prefetch";

      mountPrefetch();

      // A link to a file (a PDF, an image) goes straight to the browser
      // instead of being fetched by the router first and then again.
      document.addEventListener("astro:before-preparation", (e) => {
        const to = (e as Event & { to: URL }).to;
        if (/\.(pdf|png|jpe?g|webp|avif|gif|svg|xml|txt|zip|json|mp4|webm)$/i.test(to.pathname)) e.preventDefault();
      });

      // Blocks marked data-reveal ease in as they scroll into view. One
      // observer per page shown, plus a watch for blocks that islands add.
      onPage("reveal", (signal) => {
        const seen = new Set<HTMLElement>();
        const io =
          "IntersectionObserver" in window
            ? new IntersectionObserver(
                (entries) => {
                  entries.forEach((entry) => {
                    entry.target.classList.toggle("reveal-visible", entry.isIntersecting);
                  });
                },
                // threshold 0 (not 0.2) so sections taller than ~5x the viewport
                // still reveal, at 0.2 a very tall section (e.g. AIE's 6 project
                // cards on mobile) could never reach 20% visibility and stayed hidden.
                { threshold: 0, rootMargin: "0px 0px -10% 0px" },
              )
            : null;
        const scan = () => {
          document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
            if (seen.has(el)) return;
            seen.add(el);
            el.dataset.revealObserved = "true";
            if (io) io.observe(el);
            else el.classList.add("reveal-visible");
          });
        };
        scan();
        // Coalesce mutation bursts (island hydration, chat messages) into
        // one rescan instead of one per DOM change.
        let pending = 0;
        const mo = new MutationObserver(() => {
          if (pending) return;
          pending = window.setTimeout(() => {
            pending = 0;
            if (!signal.aborted) scan();
          }, 120);
        });
        mo.observe(document.body, { childList: true, subtree: true });
        return () => {
          mo.disconnect();
          io?.disconnect();
          clearTimeout(pending);
          // A block that persists onto the next page is watched again there.
          seen.forEach((el) => delete el.dataset.revealObserved);
        };
      });
    </script>
  </head>
  <body
    class="relative bg-dk-primary text-dk-text w-full overflow-x-clip"
    data-tone={tone}
    data-sky={toneRgb}
    data-own-sky={ownSky ? "true" : undefined}
  >
    <!-- First in the body so it covers the very first paint. -->
    <WarpLoader palette={warpPalette} toneMap={toneMap} />
    <!-- The build moves the page's stylesheets here (scripts/late-css.mjs), so the
         loader above paints without waiting for them. Whatever comes after still
         waits, the scripts included, exactly as if they were in the head. -->
    <template data-css-here></template>
    <!-- Shared space backdrop on every page: starfield, ambient colour
         flow, and film grain. All behind the content (z -1, grain overlay). -->
    <SpaceField />
    <div class="ambient" data-ambient aria-hidden="true" transition:persist="ambient"></div>
    <div class="grain" aria-hidden="true" transition:persist="grain"></div>
    {pageComets.length > 0 && (
      <div class="page-comets" aria-hidden="true" style="position:absolute; inset:0; overflow:hidden; z-index:0; pointer-events:none;">
        {pageComets.map((c) => (
          <span
            class="space-el"
            style={`width:${c.w}px;height:${Math.round(c.w * 0.28)}px;top:${c.top}%;${c.side}:${c.inset}%;`}
          >
            <span class="comet-glow" style={`--sr-rgb:${c.color};`}></span>
            <span class="space-comet" style={`--sr-rgb:${c.color};--rz:${c.rz}deg;`}></span>
          </span>
        ))}
      </div>
    )}
    <script>
      // Run once a visit: the score, the pointer effects and the glass. They
      // keep going across page changes (module scripts run once, and their
      // layers move into each new page).
      import { onPage } from "../scripts/lifecycle";
      import { initAmbient, initComets } from "../scripts/spatial";
      import { initLiquidGlass } from "../scripts/liquid-glass";
      import { tweenToneFromWarp } from "../scripts/toneTween";
      import { mountSound } from "../scripts/sound/engine";
      import { mountClickBurst } from "../scripts/fx/click-burst";
      mountClickBurst();
      import { mountSpaceLens } from "../scripts/fx/space-lens";
      mountSpaceLens();
      import { mountCursor } from "../scripts/fx/cursor";
      mountCursor();
      // The site's score: off until the visitor turns it on.
      mountSound();
      // Real refracting glass on the navigation layer (Chromium only).
      initLiquidGlass(".nav-glass, .btn-glass, .social, .to-top, .proj-arrow, .chat-launcher");

      // Every page shown: default ambient colour flow and the page's comets.
      // A page with its own section stops passes ownSky (data-own-sky on
      // <body>) and calls initAmbient itself. The comet engine is
      // idempotent per element, so page level calls coexist with this.
      onPage("layout", (signal) => {
        if (!document.body.dataset.ownSky) {
          const rgb = document.body.dataset.sky || "91,141,239";
          initAmbient(
            [
              [rgb, rgb],
              [rgb, rgb],
            ],
            undefined,
            signal,
          );
        }
        initComets(".space-el", signal);
      });
      // Finish the colour blend the loader started when the link was
      // followed. Last, so it starts from what the page's own ambient set.
      onPage("tone", (signal) => tweenToneFromWarp(signal), 10);

      // After a move, focus goes to the new page's content when it was not
      // kept on a persisted control (a nav tab keeps it). The router
      // announces the new title for screen readers.
      let moved = false;
      document.addEventListener("astro:after-swap", () => {
        moved = true;
      });
      onPage("focus", () => {
        if (!moved) return;
        const active = document.activeElement;
        if (active && active !== document.body && active !== document.documentElement) return;
        const main = document.querySelector<HTMLElement>("main");
        if (!main) return;
        if (!main.hasAttribute("tabindex")) main.setAttribute("tabindex", "-1");
        main.focus({ preventScroll: true });
      }, 20);
    </script>
    <!-- The chrome persists across page changes: the nav keeps its state
         and the sound toggle, an open chat stays open, the scroll gauge and
         back to top carry on. Nav reads the new path after each swap. -->
    <Nav client:soon transition:persist="nav" searchItems={searchItems} cv={info.cv} />
    <ScrollOrbit />
    <main class="w-full">
      <slot />
    </main>
    <FooterBar variant={footerVariant} />
    <!-- In the HTML from the first paint, so the launcher arrives with the page;
         it wakes up once the browser has a moment. -->
    <ChatWidget client:soon transition:persist="chat" />
    <TopButton client:soon transition:persist="to-top" />
    <script is:inline>
      // The last tag of the page: lay it out now (WarpLoader).
      document.documentElement.classList.remove("parsing");
    </script>
  </body>
</html>
