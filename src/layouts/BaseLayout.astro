---
import Nav from "../components/navbar/Nav";
import TopButton from "../components/TopButton";
import ChatWidget from "../components/chatbot/ChatWidget";
import FooterBar from "../components/footer/FooterBar";
import SpaceField from "../components/hero/SpaceField.astro";
import WarpLoader from "../components/hero/WarpLoader.astro";
import ScrollOrbit from "../components/ScrollOrbit.astro";
import { info } from "../data/info";
import { personNode, websiteNode, breadcrumbNode, graph, type Crumb } from "../utils/seo";
import "../styles/landing.css";

const {
  title,
  description = "Sampreeth Avvari, forward deployed engineer in New York. The only engineer at a three office dental implant practice, running about 45 services, each drawn with its parts, failure paths and monthly cost.",
  footerVariant = "default",
  // Optional LCP image to preload (an AVIF path). Pages pass their above-the-fold
  // hero/cover so the browser fetches it before it discovers the <img> in markup.
  preloadImage,
  // The page's tab. Its colour marks the kicker, links and background wash.
  tone: toneProp,
  // Search and sharing: this page's share image (a path under public), its
  // Open Graph type, extra structured data nodes, breadcrumbs, and dates.
  ogImage: ogImageProp,
  ogType = "website",
  schema = [],
  crumbs,
  published,
  modified,
}: {
  title: string;
  description?: string;
  footerVariant?: string;
  preloadImage?: string;
  tone?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  schema?: unknown[];
  crumbs?: Crumb[];
  published?: string;
  modified?: string;
} = Astro.props;

// Canonical URL for the current page (no query strings), absolute via astro.config `site`.
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
// Absolute URL for social-share / structured-data image.
const ogImage = new URL(ogImageProp ?? "/og/home.jpg", Astro.site).toString();

// Structured data: one graph per page. The person and the website on every
// page (shared ids, so search and AI engines join them into one entity), then
// whatever the page adds (an article, a system, a list) and its breadcrumbs.
const base = Astro.site!.toString();
const jsonLd = graph([
  personNode(base, {
    image: info.picture,
    email: info.contact.email,
    description: "Forward deployed engineer in New York. The only engineer at a three office dental implant practice, building and running its software, and a filmmaker.",
  }),
  websiteNode(base, "Sampreeth Avvari: forward deployed engineer. Systems, architecture drawings with real costs, writing and films."),
  ...(crumbs?.length ? [breadcrumbNode(base, crumbs)] : []),
  ...schema,
]);
import { searchItems } from "../data/searchItems";

import "../styles/global.css";
import "../styles/system.css";

// One colour per tab. Derived from the first path segment unless a page
// passes its own.
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const seg = pathname.split("/").filter(Boolean)[0] || "";
const TONE_FOR: Record<string, string> = {
  projects: "projects",
  demos: "projects",
  architecture: "architecture",
  work: "work",
  posts: "writing",
  filmmaking: "film",
  gallery: "film",
  teaching: "writing",
  mind: "mind",
};
const tone = toneProp || TONE_FOR[seg] || "home";
const TONE_RGB: Record<string, string> = {
  projects: "91,141,239",
  work: "245,165,36",
  writing: "52,211,153",
  film: "244,63,94",
  architecture: "34,211,238",
  teaching: "52,211,153",
  mind: "167,139,250",
  home: "91,141,239",
};
const toneRgb = TONE_RGB[tone];
// Every tab's colour by its first path segment, so the loader can blend
// toward the next page before it arrives. "" is home.
const toneMap: Record<string, string> = { "": TONE_RGB.home };
for (const [seg, t] of Object.entries(TONE_FOR)) toneMap[seg] = TONE_RGB[t];
// The loader's comets: home blends every tab, so it gets all their colours.
// Blue and green lead, the same pair the sky starts on.
const warpPalette =
  tone === "home" ? [...new Set([toneRgb, TONE_RGB.writing, ...Object.values(TONE_RGB)])] : [toneRgb];

// Comets in the tab's colour on every page. Home and the writing index place
// their own per section, and /mind wants a still sky.
const hasOwnComets = pathname === "/" || pathname === "/posts" || pathname === "/mind";
const pageComets = hasOwnComets
  ? []
  : Array.from({ length: 8 }, (_, i) => ({
      color: toneRgb,
      top: [5, 17, 30, 43, 56, 69, 81, 91][i],
      side: i % 2 === 0 ? "right" : "left",
      inset: 4 + ((i * 9) % 26),
      w: 104 + ((i * 13) % 40),
      rz: [-16, 12, -8, 18, -20, 6, 14, -12][i],
    }));
---

<!doctype html>
<html lang="en" translate="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="keywords" content="Sampreeth Avvari, Sampreeth Sharma, forward deployed engineer, AI engineer, software engineer, machine learning engineer, system architecture, healthcare AI, portfolio, New York, filmmaker" />
    <meta name="author" content="Sampreeth Avvari" />
    <meta http-equiv="Content-Language" content="en" />
    <meta name="google" content="notranslate" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#000000" />
    <!-- Inter, the variable build with the optical size axis, the only face
         on the site. Served from this site (the same files Google Fonts
         serves) and preloaded, so text paints in Inter without waiting on
         another host. Until it lands, Arial sized to Inter's metrics holds
         the lines where Inter will put them, so nothing reflows. -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline>
      @font-face { font-family: "Inter"; font-style: normal; font-weight: 100 900; font-display: swap; src: url(/fonts/inter-latin-ext.woff2) format("woff2"); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
      @font-face { font-family: "Inter"; font-style: normal; font-weight: 100 900; font-display: swap; src: url(/fonts/inter-latin.woff2) format("woff2"); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
      @font-face { font-family: "Inter Fallback"; src: local("Arial"); size-adjust: 107.12%; ascent-override: 90.44%; descent-override: 22.52%; line-gap-override: 0%; }
    </style>
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          type="image/avif"
          fetchpriority="high"
        />
      )
    }
    <!-- The S glass mark is the tab icon; the SA mark sits in the nav. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Sampreeth Avvari RSS"
      href={`${Astro.site}rss.xml`}
    />
    <meta name="generator" content={Astro.generator} />
    <!-- Open Graph / social share -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Sampreeth Avvari" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {published && <meta property="article:published_time" content={published} />}
    {(modified ?? published) && <meta property="article:modified_time" content={modified ?? published} />}
    {ogType === "article" && <meta property="article:author" content="Sampreeth Avvari" />}
    <!-- Structured data: the person, the site and this page, one graph -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- No icon font: every icon is an inline SVG. -->
    <title>{title}</title>
    <script is:inline>
      // Cloudflare Web Analytics: privacy-first, cookieless, no consent
      // banner needed. Just basic traffic stats. Replaces GA4.
      // Get the token: dash.cloudflare.com → Web Analytics → Add a site
      // (manual) → copy the value of "token" and paste it below.
      (function () {
        var CF_BEACON_TOKEN = "643bcd2b05614ef2b29da4c4f0409d04";
        var host = location.hostname;
        if (host === "localhost" || host === "127.0.0.1") return; // dev runs don't count
        if (!CF_BEACON_TOKEN || CF_BEACON_TOKEN.indexOf("__") === 0) return; // token not set yet
        var s = document.createElement("script");
        s.defer = true;
        s.src = "https://static.cloudflareinsights.com/beacon.min.js";
        s.setAttribute("data-cf-beacon", JSON.stringify({ token: CF_BEACON_TOKEN }));
        document.head.appendChild(s);
      })();
    </script>
    <script is:inline>
      // The site is dark only. Set the class inline in head to avoid FOUC.
      document.documentElement.classList.add("dark");
    </script>
    <script>
      const setupReveal = () => {
        const elements = document.querySelectorAll("[data-reveal]");
        if (!elements.length) return;

        if (!("IntersectionObserver" in window)) {
          elements.forEach((el) => el.classList.add("reveal-visible"));
          return;
        }

        if (!window.__revealObserver) {
          window.__revealObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("reveal-visible");
                } else {
                  entry.target.classList.remove("reveal-visible");
                }
              });
            },
            // threshold 0 (not 0.2) so sections taller than ~5x the viewport
            // still reveal, at 0.2 a very tall section (e.g. AIE's 6 project
            // cards on mobile) could never reach 20% visibility and stayed hidden.
            { threshold: 0, rootMargin: "0px 0px -10% 0px" }
          );
        }

        elements.forEach((el) => {
          if (el.dataset.revealObserved) return;
          el.dataset.revealObserved = "true";
          window.__revealObserver.observe(el);
        });
      };

      const boot = () => {
        setupReveal();
        if ("MutationObserver" in window) {
          // Coalesce mutation bursts (island hydration, chat messages) into
          // one rescan instead of one per DOM change.
          let pending = false;
          const observer = new MutationObserver(() => {
            if (pending) return;
            pending = true;
            setTimeout(() => {
              pending = false;
              setupReveal();
            }, 120);
          });
          observer.observe(document.body, { childList: true, subtree: true });
        }
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot);
      } else {
        boot();
      }
    </script>
  </head>
  <body
    class="relative bg-dk-primary text-dk-text w-full overflow-x-clip"
    data-tone={tone}
    data-sky={toneRgb}
    data-own-sky={pathname === "/" ? "true" : undefined}
  >
    <!-- First in the body so it covers the very first paint. -->
    <WarpLoader palette={warpPalette} toneMap={toneMap} />
    <!-- Shared space backdrop on every page: starfield, ambient colour
         flow, and film grain. All behind the content (z -1, grain overlay). -->
    <SpaceField />
    <div class="ambient" data-ambient aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    {pageComets.length > 0 && (
      <div class="page-comets" aria-hidden="true" style="position:absolute; inset:0; overflow:hidden; z-index:0; pointer-events:none;">
        {pageComets.map((c) => (
          <span
            class="space-el"
            style={`width:${c.w}px;height:${Math.round(c.w * 0.28)}px;top:${c.top}%;${c.side}:${c.inset}%;`}
          >
            <span class="comet-glow" style={`--sr-rgb:${c.color};`}></span>
            <span class="space-comet" style={`--sr-rgb:${c.color};--rz:${c.rz}deg;`}></span>
          </span>
        ))}
      </div>
    )}
    <script>
      // Default ambient colour flow; pages with their own section stops
      // (landing, writing) call initAmbient again and win. The comet engine
      // is idempotent per element, so page-level calls coexist with this.
      import { initAmbient, initComets } from "../scripts/spatial";
      import { initLiquidGlass } from "../scripts/liquid-glass";
      import { tweenToneFromWarp } from "../scripts/toneTween";
      // Real refracting glass on the navigation layer (Chromium only).
      initLiquidGlass(".nav-glass, .btn-glass, .social, .to-top, .proj-arrow, .chat-launcher");
      // Every page's sky takes its tab's colour. The landing page blends its
      // own, section by section, so it is left alone here.
      if (!document.body.dataset.ownSky) {
        const rgb = document.body.dataset.sky || "91,141,239";
        initAmbient([
          [rgb, rgb],
          [rgb, rgb],
        ]);
      }
      initComets(".space-el");
      // Finish the colour blend the loader started on the page before.
      tweenToneFromWarp();
    </script>
    <Nav client:visible searchItems={searchItems} cv={info.cv} />
    <ScrollOrbit />
    <main class="w-full">
      <slot />
    </main>
    <FooterBar variant={footerVariant} />
    <ChatWidget client:only />
    <TopButton client:only />
  </body>
</html>
