---
import BaseLayout from "./BaseLayout.astro";
import Picture from "../components/common/Picture.astro";
import Icon from "../components/common/Icon.astro";
import ArchCard from "../components/architecture/ArchCard.astro";
import { architectureBySlug } from "../data/architecture";
import Contact from "../components/contact_section/Contact";
import { info } from "../data/info";
import { readingTime } from "../utils/readingTime";
import { articleNode } from "../utils/seo";
import {
  disciplinesFor,
  slugOf,
  formatPostDate,
  hasPublic,
} from "../utils/postTopics";
import Constellation from "../components/post-fx/Constellation.astro";
import EndSky from "../components/post-fx/EndSky.astro";
import fs from "node:fs";
import path from "node:path";
// Article styles live in their own sheet so only post pages download them.
import "../styles/post-article.css";
import "../components/post-fx/post-fx.css";
import "../styles/solid-glass.css";
import "../components/post-fx/figures.css";

const { frontmatter, headings = [] } = Astro.props;
const { title, date, description, img_path, img_alt, tag, stats, demo, architecture, facts } = frontmatter;

const allPosts = await Astro.glob("../pages/posts/*.md");
const slug = slugOf(Astro.url.pathname);
const self = allPosts.find((p) => slugOf(p.url) === slug);
const minutes = self ? readingTime(self.rawContent()) : null;

const hasCover = hasPublic(img_path);

// Search and AI engines: this post as an article, with its key facts as the
// abstract, linked to the system it describes, and its own share image.
const DISC = { aie: "AI engineering", fde: "Forward deployed engineering", mle: "Machine learning engineering", sde: "Software engineering" } as const;
const keyFacts: Array<{ label: string; value: string }> = Array.isArray(facts) ? facts : [];
const words = self ? self.rawContent().split(/\s+/).filter(Boolean).length : undefined;
const siteBase = Astro.site!.toString();
const archFor = architecture ? architectureBySlug[architecture] : undefined;
const postPath = `/posts/${slug}`;
const ogPath = `/og/post-${slug}.jpg`;
const postSchema = [
  articleNode(siteBase, postPath, {
    type: architecture ? "TechArticle" : "BlogPosting",
    title,
    description,
    date,
    image: ogPath,
    keywords: [...(disciplinesFor[slug] || []).map((d: keyof typeof DISC) => DISC[d]), ...(tag ? [tag] : [])],
    facts: keyFacts,
    wordCount: words,
    about: archFor
      ? { name: archFor.name, url: new URL(`/architecture/${archFor.slug}`, siteBase).toString(), description: archFor.lede }
      : undefined,
  }),
];
const postCrumbs = [
  { name: "Home", path: "/" },
  { name: "Writing", path: "/posts" },
  { name: title, path: postPath },
];
// The drawing behind this post, if it has one, for the step at the end.
const archForPost = architecture ? architectureBySlug[architecture] : undefined;
// Preload the cover (the LCP element on a post page) as AVIF.
const coverPreload = fs.existsSync(path.join(process.cwd(), "public", `writing/${slug}-1280.avif`))
  ? `/writing/${slug}-1280.avif`
  : hasCover
    ? img_path.replace(/\.(png|jpe?g)$/i, ".avif")
    : undefined;

// Long titles step down a size so they settle in three lines or fewer.
const titleClass = title && title.length > 64 ? "post-title post-title-long" : "post-title";

// The side contents, from the post's own h2s. Astro has already given each
// one its id, so this needs no script and never shifts the page.
const toc = (headings as Array<{ depth: number; slug: string; text: string }>).filter(
  (h) => h.depth === 2,
);

// The opening: the post's own colour for the light around its art, and the
// large art for the six case studies that have it.
const TONE_RGB: Record<string, string> = {
  blue: "91,141,239",
  emerald: "52,211,153",
  violet: "167,139,250",
  amber: "245,165,36",
  cyan: "34,211,238",
  film: "244,63,94",
};
const artRgb = TONE_RGB[frontmatter.tone] || "52,211,153";
const artBase = fs.existsSync(path.join(process.cwd(), "public", `writing/${slug}-2560.avif`)) ? `/writing/${slug}` : undefined;

// What the small cards on this post's links show, for the links it really has.
const raw = self ? self.rawContent() : "";
const firstSentence = (d: string) => (d.match(/^.*?[.!?](?=\s|$)/) || [d])[0];
const thumbOf = (img?: string) => {
  if (!img || !hasPublic(img)) return undefined;
  const name = img.replace(/^.*\//, "").replace(/\.(png|jpe?g|webp|avif)$/i, "");
  return fs.existsSync(path.join(process.cwd(), "public", `writing/thumbs/${name}.avif`)) ? `/writing/thumbs/${name}` : img;
};
const linkCards: Record<string, { t: string; d: string; img?: string; k: string }> = {};
for (const m of raw.matchAll(/(?:\]\(|href=")(\/(?:posts|architecture)\/[a-z0-9-]+)/g)) {
  const href = m[1];
  if (linkCards[href]) continue;
  const [, kind, target] = href.split("/");
  if (kind === "posts") {
    const p = allPosts.find((x) => slugOf(x.url) === target);
    if (!p) continue;
    linkCards[href] = {
      t: p.frontmatter.title,
      d: firstSentence(p.frontmatter.description || ""),
      img: thumbOf(p.frontmatter.img_path),
      k: "Post",
    };
  } else {
    const a = architectureBySlug[target];
    if (!a) continue;
    linkCards[href] = {
      t: a.name,
      d: firstSentence(a.lede || ""),
      img: hasPublic(`/arch/${a.slug}.png`) ? `/arch/${a.slug}.png` : undefined,
      k: "Drawing",
    };
  }
}
const fxData = JSON.stringify({ links: linkCards }).replace(/</g, "\\u003c");
---

<BaseLayout
  title={title}
  description={description}
  preloadImage={coverPreload}
  ogImage={ogPath}
  ogType="article"
  schema={postSchema}
  crumbs={postCrumbs}
  published={date}
>
  <div class="post-progress" id="post-progress" aria-hidden="true"></div>
  <!-- While reading, the sky goes quiet behind the words. -->
  <div class="pfx-veil" id="pfx-veil" aria-hidden="true"></div>

  <article class="post" style={`--art:${artRgb};`}>
    <header
      class="post-head pfx-open"
      id="pfx-open"
      data-slug={slug}
      data-rgb={artRgb}
      data-art={artBase}
    >
      <!-- The settled layout below is the real one. With a script the art and
           the title start out in space and scroll into these places. -->
      <div class="pfx-stage" id="pfx-stage">
        <canvas class="pfx-gl" aria-hidden="true"></canvas>
        <div class="pfx-scrim" aria-hidden="true"></div>
        <div class="wrap pfx-settled on-top">
          <a href="/posts" class="tlink post-back">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m0 0 6 6m-6-6 6-6"></path></svg>
            All posts
          </a>

          {
            hasCover && (
              <figure class="post-cover-frame pfx-art" data-zoom={artBase || "1"}>
                {artBase ? (
                  <picture>
                    <source srcset={`${artBase}-1280.avif`} type="image/avif" />
                    <source srcset={`${artBase}-1280.webp`} type="image/webp" />
                    <img src={`${artBase}-1280.webp`} alt={img_alt || title} width="1280" height="720" loading="eager" fetchpriority="high" decoding="async" />
                  </picture>
                ) : (
                  <Picture
                    src={img_path}
                    alt={img_alt || title}
                    width={1200}
                    height={675}
                    loading="eager"
                    fetchpriority="high"
                  />
                )}
              </figure>
            )
          }

          <div class="post-head-inner pfx-copy">
            <p class="t-meta post-meta">
              {date && <time datetime={date}>{formatPostDate(date)}</time>}
              {minutes && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>{minutes} min read</span>
                </>
              )}
              {tag && <span class="badge post-badge">{tag}</span>}
            </p>

            <h1 class={titleClass}>{title}</h1>

            {description && <p class="t-lede post-lede">{description}</p>}

            {
              demo && (
                <div class="post-actions">
                  <a href={demo} class="btn btn-glass">
                    Try the live demo <Icon name="arrow-right" size={15} class="arrow-r" />
                  </a>
                </div>
              )
            }
          </div>
        </div>
        <div class="pfx-cue" aria-hidden="true"><i></i></div>
      </div>
    </header>

    {
      architecture && (
        <div class="wrap">
          <ArchCard slug={architecture} />
        </div>
      )
    }

    {
      Array.isArray(stats) && stats.length > 0 && (
        <div class="wrap">
          <ul class="post-stats" aria-label="In numbers">
            {stats.map((s: { value: string; label: string }) => (
              <li class="surface post-stat">
                <p class="stat-num">{s.value}</p>
                <p class="stat-cap">{s.label}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      keyFacts.length > 0 && (
        <div class="wrap">
          <section class="surface post-facts" aria-labelledby="post-facts-title">
            <h2 class="post-facts-title" id="post-facts-title">Key facts</h2>
            <dl class="post-facts-list">
              {keyFacts.map((f) => (
                <div class="post-fact">
                  <dt>{f.label}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        </div>
      )
    }

    <div class="wrap post-main">
      <div class={toc.length >= 2 ? "post-grid has-toc" : "post-grid"}>
        <div class="post-prose" id="post-prose-body">
          <slot />
        </div>
        {
          toc.length >= 2 && (
            <aside class="post-toc-wrap">
              <Constellation headings={toc} />
            </aside>
          )
        }
      </div>

      <footer class="post-sign">
        <Picture
          src={info.picture}
          alt={info.picture_alt}
          class="post-sign-pic"
          width={56}
          height={56}
        />
        <div class="min-w-0">
          <p class="t-h4">{info.name}</p>
          <p class="t-meta post-sign-role">{info.role} · {info.location}</p>
          <Contact contact={info.contact} className="t-body post-sign-line" />
          <!-- The one next step: the drawing when the post has one, then a
               quiet way to get in touch. -->
          <div class="post-next">
            {archForPost ? (
              <>
                <a href={`/architecture/${archForPost.slug}`} class="btn btn-primary btn-sm">
                  Open the drawing <Icon name="arrow-right" size={14} class="arrow-r" />
                </a>
                <a href="/#ch-connect" class="tlink">Get in touch <Icon name="arrow-right" size={14} /></a>
              </>
            ) : (
              <a href="/#ch-connect" class="btn btn-primary btn-sm">
                Get in touch <Icon name="arrow-right" size={14} class="arrow-r" />
              </a>
            )}
          </div>
        </div>
      </footer>
    </div>
  </article>

  <EndSky posts={allPosts} slug={slug} tag={tag} />

  <script type="application/json" id="pfx-data" set:html={fxData}></script>

  <script>
    import "../scripts/post-fx/index";
  </script>
</BaseLayout>
