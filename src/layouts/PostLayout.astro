---
import BaseLayout from "./BaseLayout.astro";
import Picture from "../components/common/Picture.astro";
import Icon from "../components/common/Icon.astro";
import Contact from "../components/contact_section/Contact";
import { info } from "../data/info";
import { readingTime } from "../utils/readingTime";
import {
  disciplinesFor,
  slugOf,
  formatPostDate,
  hasPublic,
} from "../utils/postTopics";
// Article styles live in their own sheet so only post pages download them.
import "../styles/post-article.css";

const { frontmatter, headings = [] } = Astro.props;
const { title, date, description, img_path, img_alt, tag, stats, demo } = frontmatter;

const allPosts = await Astro.glob("../pages/posts/*.md");
const slug = slugOf(Astro.url.pathname);
const self = allPosts.find((p) => slugOf(p.url) === slug);
const minutes = self ? readingTime(self.rawContent()) : null;

const hasCover = hasPublic(img_path);
// Preload the cover (the LCP element on a post page) as AVIF.
const coverPreload = hasCover ? img_path.replace(/\.(png|jpe?g)$/i, ".avif") : undefined;

// Long titles step down a size so they settle in three lines or fewer.
const titleClass = title && title.length > 64 ? "post-title post-title-long" : "post-title";

// The side contents, from the post's own h2s. Astro has already given each
// one its id, so this needs no script and never shifts the page.
const toc = (headings as Array<{ depth: number; slug: string; text: string }>).filter(
  (h) => h.depth === 2,
);

// More writing: posts about the same kind of work first, then the newest.
const newestFirst = (a: any, b: any) =>
  new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime();
const mine = disciplinesFor[slug] || [];
const others = allPosts.filter((p) => slugOf(p.url) !== slug).sort(newestFirst);
const related = others.filter((p) =>
  (disciplinesFor[slugOf(p.url)] || []).some((d) => mine.includes(d)),
);
const more = [...related, ...others.filter((p) => !related.includes(p))].slice(0, 3);
---

<BaseLayout title={title} description={description} preloadImage={coverPreload}>
  <div class="post-progress" id="post-progress" aria-hidden="true"></div>

  <article class="post">
    <header class="post-head page-top">
      <div class="tone-atmos" aria-hidden="true"></div>
      <div class="wrap on-top">
        <div class="post-head-inner">
          <a href="/posts" class="tlink post-back">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5m0 0 6 6m-6-6 6-6"></path></svg>
            All posts
          </a>

          <p class="t-meta post-meta">
            {date && <time datetime={date}>{formatPostDate(date)}</time>}
            {minutes && (
              <>
                <span aria-hidden="true">·</span>
                <span>{minutes} min read</span>
              </>
            )}
            {tag && <span class="badge post-badge">{tag}</span>}
          </p>

          <h1 class={titleClass}>{title}</h1>

          {description && <p class="t-lede post-lede">{description}</p>}

          {
            demo && (
              <div class="post-actions">
                <a href={demo} target="_blank" rel="noreferrer" class="btn btn-glass">
                  Try the live demo <Icon name="arrow-up-right" size={15} class="arrow-ur" />
                </a>
              </div>
            )
          }
        </div>
      </div>
    </header>

    {
      hasCover && (
        <div class="wrap">
          <figure class="post-cover-frame">
            <Picture
              src={img_path}
              alt={img_alt || title}
              width={1200}
              height={600}
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        </div>
      )
    }

    {
      Array.isArray(stats) && stats.length > 0 && (
        <div class="wrap">
          <ul class="post-stats" aria-label="In numbers">
            {stats.map((s: { value: string; label: string }) => (
              <li class="surface post-stat">
                <p class="stat-num">{s.value}</p>
                <p class="stat-cap">{s.label}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="wrap post-main">
      <div class={toc.length >= 2 ? "post-grid has-toc" : "post-grid"}>
        <div class="post-prose" id="post-prose-body">
          <slot />
        </div>
        {
          toc.length >= 2 && (
            <aside class="post-toc-wrap">
              <nav class="post-toc" id="post-toc" aria-label="On this page">
                <p class="t-meta post-toc-label">On this page</p>
                <ol>
                  {toc.map((h) => (
                    <li>
                      <a href={`#${h.slug}`} data-target={h.slug}>{h.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>
          )
        }
      </div>

      <footer class="post-sign">
        <Picture
          src={info.picture}
          alt={info.picture_alt}
          class="post-sign-pic"
          width={56}
          height={56}
        />
        <div class="min-w-0">
          <p class="t-h4">{info.name}</p>
          <p class="t-meta post-sign-role">{info.role} · {info.location}</p>
          <Contact contact={info.contact} className="t-body post-sign-line" />
        </div>
      </footer>
    </div>
  </article>

  {
    more.length > 0 && (
      <section class="section-tight post-more" aria-labelledby="more-writing">
        <div class="wrap">
          <div class="post-more-head">
            <h2 id="more-writing" class="post-more-title">More writing</h2>
            <a href="/posts" class="tlink">
              All posts <Icon name="arrow-right" size={14} />
            </a>
          </div>
          <div class="post-more-grid">
            {more.map((p) => (
              <a href={p.url} class="surface post-more-card">
                <div class="surface-media post-more-media">
                  {hasPublic(p.frontmatter.img_path) ? (
                    <Picture
                      src={p.frontmatter.img_path}
                      alt={p.frontmatter.img_alt || p.frontmatter.title}
                      width={600}
                      height={338}
                    />
                  ) : (
                    <div class="post-media-fallback" aria-hidden="true" />
                  )}
                </div>
                <div class="post-more-body">
                  <p class="t-meta">
                    {formatPostDate(p.frontmatter.date)} · {readingTime(p.rawContent())} min read
                  </p>
                  <h3 class="post-more-card-title">{p.frontmatter.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <script is:inline>
    (function () {
      // Reading progress, in the writing colour.
      var bar = document.getElementById("post-progress");
      if (bar) {
        var raf = 0;
        var update = function () {
          raf = 0;
          var doc = document.documentElement;
          var height = doc.scrollHeight - doc.clientHeight;
          var pct = height > 0 ? Math.min(1, Math.max(0, doc.scrollTop / height)) : 0;
          bar.style.transform = "scaleX(" + pct + ")";
        };
        var queue = function () { if (!raf) raf = requestAnimationFrame(update); };
        window.addEventListener("scroll", queue, { passive: true });
        window.addEventListener("resize", queue);
        update();
      }

      var body = document.getElementById("post-prose-body");
      if (!body) return;

      // Wide tables scroll inside their own frame, never the page.
      body.querySelectorAll("table").forEach(function (t) {
        if (t.parentElement && t.parentElement.classList.contains("post-table")) return;
        var wrap = document.createElement("div");
        wrap.className = "post-table";
        wrap.setAttribute("tabindex", "0");
        wrap.setAttribute("role", "region");
        wrap.setAttribute("aria-label", "Table");
        t.parentNode.insertBefore(wrap, t);
        wrap.appendChild(t);
        // Columns that hold sentences get more room on a phone.
        var longest = [];
        Array.prototype.forEach.call(t.rows, function (row) {
          Array.prototype.forEach.call(row.cells, function (cell, i) {
            longest[i] = Math.max(longest[i] || 0, (cell.textContent || "").trim().length);
          });
        });
        Array.prototype.forEach.call(t.rows, function (row) {
          Array.prototype.forEach.call(row.cells, function (cell, i) {
            if (longest[i] > 32) cell.classList.add("is-wide");
          });
        });
      });

      // Mark the section being read in the side contents: the last heading
      // that has passed a line 30% down the window.
      var toc = document.getElementById("post-toc");
      if (!toc) return;
      var links = {};
      var heads = [];
      toc.querySelectorAll("a[data-target]").forEach(function (a) {
        var id = a.getAttribute("data-target");
        var h = document.getElementById(id);
        if (!h) return;
        links[id] = a;
        heads.push(h);
      });
      var active = null;
      var spyRaf = 0;
      var spy = function () {
        spyRaf = 0;
        var line = window.innerHeight * 0.3;
        var current = null;
        for (var i = 0; i < heads.length; i++) {
          if (heads[i].getBoundingClientRect().top <= line) current = heads[i].id;
          else break;
        }
        if (current === active) return;
        active = current;
        Object.keys(links).forEach(function (k) {
          links[k].classList.toggle("is-active", k === current);
          if (k === current) links[k].setAttribute("aria-current", "true");
          else links[k].removeAttribute("aria-current");
        });
      };
      var queueSpy = function () { if (!spyRaf) spyRaf = requestAnimationFrame(spy); };
      window.addEventListener("scroll", queueSpy, { passive: true });
      window.addEventListener("resize", queueSpy);
      spy();
    })();
  </script>
</BaseLayout>
