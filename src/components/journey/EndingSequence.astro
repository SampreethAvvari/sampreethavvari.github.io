---
// The closing film: the landed ship, the walk through the desert forest, the
// kneel, and the hand that touches the small plant. Frames live in
// public/story/ending and are drawn by scripts/journey/ending.ts.
//
// Two ways to place it:
//   drive="host"   only the canvas. The host mounts the player with
//                  mountEnding() and calls setProgress(0..1) itself.
//   drive="scroll" a tall section with a pinned canvas. The film follows the
//                  page scroll through the section on its own. Anything in
//                  the slot sits on top of the film; the section carries
//                  --ending-p (0..1), data-beat (0..3) and data-words
//                  ("1" once the hand has touched the plant) for it.
interface Props {
  manifest?: string;
  drive?: "host" | "scroll";
  /** Screens of scroll for the whole film when drive="scroll". */
  screens?: number;
  /** Progress from which the closing words may show. */
  wordsAt?: number;
  class?: string;
}
const { manifest = "/story/ending/manifest.json", drive = "scroll", screens = 3, wordsAt = 0.8, class: cls } = Astro.props;
---

{drive === "host" ? (
  <canvas class:list={["ending-canvas", "is-host", cls]} data-ending-canvas data-manifest={manifest} aria-hidden="true"></canvas>
) : (
  <section
    class:list={["ending-seq", cls]}
    data-ending-seq
    data-manifest={manifest}
    data-words-at={wordsAt}
    data-beat="0"
    data-words="0"
    style={`--screens:${screens};--ending-p:0;`}
  >
    <div class="ending-stage">
      <canvas class="ending-canvas" aria-hidden="true"></canvas>
      <div class="ending-over"><slot /></div>
    </div>
  </section>
)}

<style>
  .ending-seq { position: relative; height: calc((var(--screens) + 1) * 100svh); }
  .ending-stage { position: sticky; top: 0; height: 100svh; overflow: hidden; background: #030305; isolation: isolate; }
  .ending-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }
  .ending-over { position: absolute; inset: 0; z-index: 1; }
</style>

<script>
  import { mountEnding, type Ending } from "../../scripts/journey/ending";

  const phoneQuery = "(max-width: 767px), (pointer: coarse)";
  const mounted: { player: Ending; off: () => void }[] = [];

  function boot() {
    document.querySelectorAll<HTMLElement>("[data-ending-seq]").forEach((sec) => {
      if (sec.dataset.mounted) return;
      sec.dataset.mounted = "1";
      const canvas = sec.querySelector<HTMLCanvasElement>(".ending-canvas");
      if (!canvas) return;
      const wordsAt = Number(sec.dataset.wordsAt || 0.8);
      const player = mountEnding(canvas, {
        manifestUrl: sec.dataset.manifest || "/story/ending/manifest.json",
        phone: matchMedia(phoneQuery).matches,
      });

      let ticking = false;
      const update = () => {
        ticking = false;
        const r = sec.getBoundingClientRect();
        const run = Math.max(1, sec.offsetHeight - innerHeight);
        const p = Math.min(1, Math.max(0, -r.top / run));
        const near = r.bottom > -innerHeight && r.top < innerHeight * 2;
        player.setPaused(!near);
        player.setProgress(p);
        sec.style.setProperty("--ending-p", p.toFixed(4));
        sec.dataset.words = p >= wordsAt ? "1" : "0";
      };
      const onScroll = () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      };
      const onBeat = (e: Event) => {
        const d = (e as CustomEvent<{ beat: number }>).detail;
        if (d && typeof d.beat === "number") sec.dataset.beat = String(d.beat);
      };
      addEventListener("scroll", onScroll, { passive: true });
      addEventListener("resize", onScroll);
      addEventListener("journey:ending", onBeat);
      update();
      mounted.push({
        player,
        off: () => {
          removeEventListener("scroll", onScroll);
          removeEventListener("resize", onScroll);
          removeEventListener("journey:ending", onBeat);
          delete sec.dataset.mounted;
        },
      });
    });
  }

  boot();
  document.addEventListener("astro:page-load", boot);
  document.addEventListener("astro:before-swap", () => {
    while (mounted.length) {
      const m = mounted.pop()!;
      m.off();
      m.player.destroy();
    }
  });
</script>
