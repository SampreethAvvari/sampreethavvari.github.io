    color: rgba(255, 255, 255, 0.82);
  }
  .jc-live { width: 7px; height: 7px; border-radius: 50%; background: #34d399; box-shadow: 0 0 10px #34d399; }
  .jc-kicker { margin: 0; display: flex; align-items: center; gap: 12px; font-size: 0.8125rem; color: rgba(255, 255, 255, 0.6); }
  .jc-kicker span:first-child { color: rgb(var(--cc)); font-variant-numeric: tabular-nums; }
  .jc-kicker i { width: 56px; height: 1px; background: linear-gradient(90deg, rgb(var(--cc)), rgba(var(--cc), 0.1)); }
  .jc-title {
    margin: 0;
    font-size: clamp(2.5rem, 6.2vw, 5.6rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .jc-hero { font-weight: 600; }
  .jc-line { display: block; }
  .jc-tail, .jc-dim { color: rgba(255, 255, 255, 0.46); }
  .jw { display: inline-block; white-space: pre; opacity: 0; transform: translateY(0.45em) rotate(2deg); filter: blur(8px); transition: opacity 0.6s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease; }
  .jc.is-active .jw { opacity: 1; transform: none; filter: none; transition-delay: calc(0.18s + var(--w) * 0.07s); }
  .jc-lede { margin: 0; max-width: 34rem; font-size: clamp(1rem, 1.3vw, 1.125rem); line-height: 1.6; color: rgba(255, 255, 255, 0.72); }
  .jc-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .jc-meta { margin: 2px 0 0; font-size: 0.75rem; letter-spacing: 0.01em; color: rgba(255, 255, 255, 0.42); }
  .jc-guides { margin: 0; font-size: 0.875rem; color: rgba(255, 255, 255, 0.55); }
  .jc-guides a { color: rgba(255, 255, 255, 0.85); text-decoration: none; border-bottom: 1px solid rgba(var(--cc), 0.5); }
  .jc-guides a:hover { color: rgb(var(--cc)); }
  .jc-faq { max-width: 640px; font-size: 0.875rem; color: rgba(255, 255, 255, 0.7); }
  .jc-faq summary { width: fit-content; cursor: pointer; list-style: none; color: rgba(255, 255, 255, 0.6); border-bottom: 1px dashed rgba(255, 255, 255, 0.3); padding-bottom: 2px; }
  .jc-faq summary::-webkit-details-marker { display: none; }
  .jc-faq summary:hover { color: #fff; }
  .jc-faq dl { margin: 12px 0 0; max-height: 34vh; overflow: auto; padding-right: 8px; display: grid; gap: 10px; }
  .jc-faq dt { color: #fff; font-weight: 600; }
  .jc-faq dd { margin: 2px 0 0; line-height: 1.55; color: rgba(255, 255, 255, 0.62); }
  /* the site's left scroll gauge would sit on the words; the flight has its own rail */
  :global(html.in-journey .orbit) { opacity: 0 !important; pointer-events: none; transition: opacity 0.4s ease; }
  /* the flight has its own way back to the start (Begin again) */
  :global(html.in-journey .to-top) { opacity: 0 !important; pointer-events: none !important; }

  /* items inside a chapter come in after the headline */
  .jc-stats li, .jc-cards li, .jart.is-poster { opacity: 0; transform: translateY(14px) scale(0.98); transition: opacity 0.6s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  .jc.is-active .jc-stats li, .jc.is-active .jc-cards li, .jc.is-active .jart.is-poster { opacity: 1; transform: none; transition-delay: calc(0.2s + var(--w) * 0.08s); }

  /* buttons made for the flight: a thin lit pill in the chapter's colour */
  .jb {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 8px 0 18px;
    border-radius: 9999px;
    border: 1px solid rgba(var(--cc), 0.42);
    background: linear-gradient(180deg, rgba(var(--cc), 0.16), rgba(var(--cc), 0.03));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    text-decoration: none;
