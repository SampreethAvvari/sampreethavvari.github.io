  @media (prefers-reduced-motion: reduce) {
    .jc, .jc.is-active, .jw, .jc .jw, .jc-stats li, .jc-cards li, .jart.is-poster, .jart { transition: opacity 0.3s ease !important; transform: none !important; filter: none !important; }
    .journey-cue i { animation: none; }
  }
</style>

<script>
  type Chapter = { id: string; color: string; scene: string | null };
  type Journey = { setScroll(p: number, v: number): void; setPointer(x: number, y: number): void; setPaused(p: boolean): void; destroy(): void };
  type Ending = { setScene(id: string): void; setProgress(p: number): void; setPaused(b: boolean): void; destroy(): void; duration?(id: string): number; ready?(id: string): boolean };
  type Framing = { side: "left" | "right"; v: "top" | "bottom" };
  // The engine module may also export CHAPTER_FRAMING (where the words sit per
  // chapter) and landed(progress) (how settled the ship is in the last world).

  // Runs on first load and again after each in-page navigation back to the
  // home page; everything it adds is removed when the page is swapped away.
  function mount() {
    const root = document.querySelector<HTMLElement>("[data-journey]");
    if (!root || root.dataset.mounted) return;
    root.dataset.mounted = "1";
    const visit = new AbortController();
    const sig = { signal: visit.signal };

    const chapters: Chapter[] = JSON.parse(root.dataset.chapters || "[]");
    const N = chapters.length;
    const LAST = N - 1;
    const SPAN = Number(root.dataset.span || 1.7); // screens per world
    const ENDING = Number(root.dataset.ending || 3); // screens for the closing film
    const REST = Number(root.dataset.rest || 0.3); // where a world rests within its span
    const GLIDE = 1400; // every move between worlds takes exactly this long
    const panes = Array.from(root.querySelectorAll<HTMLElement>("[data-jc]"));
    const now = root.querySelector<HTMLElement>("[data-j-now]");
    const fill = root.querySelector<HTMLElement>("[data-j-fill]");
    const label = root.querySelector<HTMLElement>("[data-j-label]");
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>(".journey-index [data-j-go]"));
    const names = links.map((a) => a.querySelector(".ji-name")?.textContent || "");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const low = matchMedia("(max-width: 767px), (pointer: coarse)").matches || ((navigator as any).deviceMemory ?? 8) < 4;
    const hexRgb = (h: string) => { const n = parseInt(h.slice(1), 16); return `${(n >> 16) & 255},${(n >> 8) & 255},${n & 255}`; };
    const pad = (n: number) => String(n).padStart(2, "0");

    let progress = 0, ending = 0, lastP = 0, lastT = performance.now(), velocity = 0, active = -1, ticking = false;
    let journey: Journey | null = null;
    let player: Ending | null = null;
    let landed: ((p: number) => number) | null = null;
    // the filmed chapters' state (declared before anything can call show)
    const firstScene = chapters.findIndex((c) => c.scene);
    let sceneRaf = 0, sceneNow: string | null = null;
    const sceneLength = (id: string) => (player?.duration?.(id) ?? 8);
    let framing: Framing[] = [];

    // ---- geometry: the flight is LAST * SPAN screens, the closing film ENDING screens after it
    const flightPx = () => LAST * SPAN * innerHeight;
    const measure = () => {
      const y = Math.max(0, -root.getBoundingClientRect().top);
      return { p: Math.min(LAST, (y / Math.max(1, flightPx())) * LAST), e: 0 };
    };
    // A free world scrolls from arriveAt to travelEnd under the reader's own hand;
    // past its end the jump to the next world runs by itself. The landing and the
    // filmed worlds are one step each (their arrive and end are the same point).
    const TRAVEL_END = 0.55, ARRIVE = 0.04;
    const stepFrom = (() => { const k = chapters.findIndex((c) => c.id === "film"); return k < 0 ? N : k; })();
    const isStep = (i: number) => i >= stepFrom;
    const arriveAt = (i: number) => (i <= 0 ? 0 : i >= LAST ? LAST : isStep(i) ? i + REST : i + ARRIVE);
    const travelEnd = (i: number) => (i >= LAST ? LAST : isStep(i) ? i + REST : i + TRAVEL_END);
    const topFor = (p: number) => root.offsetTop + (p / LAST) * flightPx();
    const EPS = 0.006;
    // the world whose stretch holds p, or -1 between worlds
    const worldAt = (p: number) => {
      for (let i = 0; i <= LAST; i++) if (p >= arriveAt(i) - EPS && p <= travelEnd(i) + EPS) return i;
      return -1;
    };
    // the world just behind a point between worlds
    const behind = (p: number) => { let k = 0; for (let i = 0; i <= LAST; i++) if (travelEnd(i) <= p) k = i; return k; };

    // ---- the words of a world, and where they sit
    const place = (i: number) => {
      const f = framing[i];
      root.dataset.copySide = f?.side ?? "left";
      root.dataset.copyV = f?.v ?? "bottom";
    };
    const countUp = (el: HTMLElement) => {
      const text = el.dataset.count || "";
      const m = text.match(/^([\d,.]+)(.*)$/);
      if (!m || reduced) { el.textContent = text; return; }
      const target = Number(m[1].replace(/,/g, ""));
      const comma = m[1].includes(",");
      const t0 = performance.now(), dur = 1100;
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / dur);
        const v = Math.round(target * (1 - Math.pow(1 - k, 3)));
        el.textContent = (comma ? v.toLocaleString("en-US") : String(v)) + m[2];
        if (k < 1 && !visit.signal.aborted) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    let wordsLater = 0;
    const show = (i: number) => {
      if (i === active) return;
      active = i;
      clearTimeout(wordsLater);
      const scene = i >= 0 ? chapters[i].scene : null;
      playScene(scene);
      // on the planet the words wait for the moment in the film (only when a film is playing)
      const filmOn = !!scene && root.classList.contains("show-film");
      panes.forEach((p, k) => p.classList.toggle("is-active", k === i && !filmOn));
      if (scene && filmOn) wordsLater = window.setTimeout(() => { if (active === i) panes[i].classList.add("is-active"); }, Math.min(2600, sceneLength(scene) * 450));
      if (i < 0) return;
      place(i);
      links.forEach((a, k) => (k === i ? a.setAttribute("aria-current", "step") : a.removeAttribute("aria-current")));
      if (now) now.textContent = pad(i + 1);
      if (label) label.textContent = `${pad(i + 1)} ${names[i] || ""}`;
      root.style.setProperty("--jc", hexRgb(chapters[i].color));
      panes[i].querySelectorAll<HTMLElement>("[data-count]").forEach((el) => countUp(el));
      // the score follows the flight, and speaks the words as they arrive
      window.dispatchEvent(new CustomEvent("journey:chapter", { detail: { index: i, id: chapters[i].id, count: N } }));
      const said = Array.from(panes[i].querySelectorAll<HTMLElement>(".jw")).map((w) => (w.textContent || "").trim()).filter(Boolean);
      const items = panes[i].querySelectorAll(".jc-stats li, .jc-cards li").length;
      window.dispatchEvent(new CustomEvent("journey:words", { detail: { index: i, id: chapters[i].id, words: said, items, wordStagger: 0.07, itemStagger: 0.08, delay: 0.18 } }));
    };

    // ---- moving: free inside a world, a jump of fixed tempo between worlds
    let gliding = false, quietUntil = 0, lastInput = 0, lastDir = 1, gapLater = 0, fling = 0;
    const coarse = matchMedia("(pointer: coarse)").matches;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const stopFling = () => { if (fling) cancelAnimationFrame(fling); fling = 0; };
    const glide = (top: number, dur = GLIDE) => {
      const from = scrollY, to = Math.round(top);
      if (Math.abs(to - from) < 2) return;
      if (reduced) { scrollTo({ top: to, behavior: "instant" as ScrollBehavior }); quietUntil = performance.now() + 200; return; }
      gliding = true;
      root.classList.add("is-jumping");
      const t0 = performance.now();
      const frame = (t: number) => {
        if (visit.signal.aborted) return;
        const k = Math.min(1, (t - t0) / dur);
        scrollTo({ top: from + (to - from) * ease(k), behavior: "instant" as ScrollBehavior });
        if (k < 1) requestAnimationFrame(frame);
        else { gliding = false; root.classList.remove("is-jumping"); quietUntil = performance.now() + 180; onScroll(); }
      };
      requestAnimationFrame(frame);
    };
    // the world the reader is in (or the one just behind them between worlds)
    const here = () => (active >= 0 ? active : behind(progress));
    const stepHere = () => isStep(here());
    // go to world j, landing at `at` (its start by default, its end when coming back)
    const go = (j: number, at?: number) => {
      j = Math.max(0, Math.min(LAST, j));
      const target = at ?? arriveAt(j);
      const i = here();
      stopFling();
      if (Math.abs(progress - target) < 0.004) { show(j); return false; }
      show(-1); // the words leave for the jump
      if (i !== j) window.dispatchEvent(new CustomEvent("journey:jump", { detail: { from: i, to: j, direction: j > i ? 1 : -1, duration: reduced ? 0 : GLIDE } }));
      glide(topFor(target), i !== j ? GLIDE : 520);
      return true;
    };
    const step = (dir: number) => {
      const i = here();
      const j = Math.max(0, Math.min(LAST, i + dir));
      if (j !== i) go(j, dir < 0 ? travelEnd(j) : arriveAt(j));
    };
    // between two worlds: keep going the way the reader was going
    const resolveGap = () => {
      clearTimeout(gapLater);
      const fresh = performance.now() - lastInput < 450;
      const act = () => {
        if (gliding) return;
        const p = measure().p;
        if (worldAt(p) >= 0) return;
        const k = behind(p);
        let dir = fresh ? lastDir : 0;
        if (!dir) dir = p - travelEnd(k) < arriveAt(k + 1) - p ? -1 : 1;
        if (dir > 0) go(k + 1, arriveAt(k + 1));
        else go(k, travelEnd(k));
      };
      if (fresh) act();
      else gapLater = window.setTimeout(act, 220); // a scrollbar drag or a restore: wait for it to stop
    };

    // wheel: the page scrolls itself inside a free world; the landing and the films take one notch each
    let wheelAcc = 0, lastWheel = 0;
    addEventListener("wheel", (e) => {
      if (e.ctrlKey) return; // pinch zoom stays the browser's
      const t = performance.now();
      if (gliding || t < quietUntil) { e.preventDefault(); quietUntil = Math.max(quietUntil, t + 140); return; } // trackpad momentum
      const dy = e.deltaMode === 1 ? e.deltaY * 32 : e.deltaY;
      if (!stepHere()) { if (dy) { lastInput = t; lastDir = dy > 0 ? 1 : -1; } return; }
      e.preventDefault();
      if (t - lastWheel > 220) wheelAcc = 0;
      lastWheel = t;
      wheelAcc += dy;
      if (Math.abs(wheelAcc) > 24) { step(wheelAcc > 0 ? 1 : -1); wheelAcc = 0; }
    }, { passive: false, ...sig });

    // touch: the finger moves the world directly and a fling slows like the page would,
    // so a jump never fights the phone's own momentum
    let touchY = 0, touchX = 0, touchT = 0, touchFree = false, touchV = 0, touchLastY = 0, touchLastT = 0;
    let scroller: HTMLElement | null = null, decided = false;
    addEventListener("touchstart", (e) => {
      stopFling();
      touchY = touchLastY = e.touches[0].clientY; touchX = e.touches[0].clientX; touchT = touchLastT = performance.now(); touchV = 0;
      // a touch inside an answer list or a card row may belong to that scroller: the first move decides
      scroller = (e.target as Element | null)?.closest?.<HTMLElement>(".jc-faq dl, .jc-cards") ?? null;
      decided = !scroller; touchFree = false;
    }, { passive: true, ...sig });
    addEventListener("touchmove", (e) => {
      if (!decided && scroller) {
        decided = true;
        const dx = e.touches[0].clientX - touchX, dy = touchY - e.touches[0].clientY;
        const sideways = Math.abs(dx) > Math.abs(dy);
        if (scroller.matches(".jc-cards")) touchFree = sideways && scroller.scrollWidth > scroller.clientWidth + 1;
        else touchFree = !sideways && (dy > 0 ? scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 1 : scroller.scrollTop > 0);
      }
      if (touchFree) return;
      if (e.cancelable) e.preventDefault();
      if (gliding || stepHere()) return;
      const y = e.touches[0].clientY, t = performance.now();
      const dy = touchLastY - y;
      touchV = touchV * 0.3 + (dy / Math.max(1, t - touchLastT)) * 0.7;
      touchLastY = y; touchLastT = t;
      if (dy) { lastInput = t; lastDir = dy > 0 ? 1 : -1; }
      scrollBy({ top: dy, behavior: "instant" as ScrollBehavior });
    }, { passive: false, ...sig });
    addEventListener("touchend", (e) => {
      if (touchFree || gliding) return;
      const t = performance.now();
      if (stepHere()) {
        const dy = touchY - (e.changedTouches[0]?.clientY ?? touchY);
        if (Math.abs(dy) > 36 && t - touchT < 900) step(dy > 0 ? 1 : -1);
        return;
      }
      let v = t - touchLastT > 90 ? 0 : touchV; // px per ms
      if (Math.abs(v) < 0.05) return;
      let prev = t;
      const run = (now: number) => {
        if (gliding || visit.signal.aborted) { fling = 0; return; }
        const dt = Math.min(32, now - prev); prev = now;
        v *= Math.pow(0.95, dt / 16);
        if (Math.abs(v) < 0.02) { fling = 0; return; }
        lastInput = now; lastDir = v > 0 ? 1 : -1;
        scrollBy({ top: v * dt, behavior: "instant" as ScrollBehavior });
        fling = requestAnimationFrame(run);
      };
      fling = requestAnimationFrame(run);
    }, { passive: true, ...sig });

    // keys: arrows scroll a free world, page keys and space move a whole world
    addEventListener("keydown", (e) => {
      const tgt = e.target as HTMLElement | null;
      if (tgt?.closest?.("input, textarea, select, [contenteditable=true]") || e.metaKey || e.ctrlKey || e.altKey) return;
      const down = e.key === "ArrowDown" || e.key === "PageDown" || (e.key === " " && !e.shiftKey);
      const up = e.key === "ArrowUp" || e.key === "PageUp" || (e.key === " " && e.shiftKey);
      if (!down && !up) return;
      if (gliding) { e.preventDefault(); return; }
      if (stepHere() || !e.key.startsWith("Arrow")) { e.preventDefault(); step(down ? 1 : -1); return; }
      lastInput = performance.now(); lastDir = down ? 1 : -1;
    }, sig);

    // ---- every frame of scroll
    const update = () => {
      ticking = false;
      const t = performance.now();
      const m = measure();
      progress = m.p; ending = m.e;
      const dt = Math.max(16, t - lastT) / 1000;
      velocity = velocity * 0.6 + ((progress - lastP) / dt) * 0.4;
      lastP = progress; lastT = t;
      if (!gliding) { const w = worldAt(progress); if (w >= 0) show(w); else resolveGap(); }
      const f = progress / LAST;
      if (fill) fill.style.transform = `scaleY(${f})`;
      if (label) label.style.top = `${f * 100}%`;
      root.classList.toggle("is-moving", progress > 0.04);
      document.documentElement.classList.toggle("in-journey", root.getBoundingClientRect().bottom > innerHeight * 0.5);
      journey?.setScroll(progress, velocity);
      if (progress > firstScene - 1.6) bootEnding();
      window.dispatchEvent(new CustomEvent("journey:progress", { detail: { progress, velocity, count: N } }));
    };
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
    addEventListener("scroll", onScroll, { passive: true, ...sig });
    addEventListener("resize", onScroll, { passive: true, ...sig });
    update();

    // index links and "Begin again" glide to their world
    root.querySelectorAll<HTMLAnchorElement>("[data-j-go]").forEach((a) => {
      a.addEventListener("click", (e) => { e.preventDefault(); if (!gliding) go(Number(a.dataset.jGo)); }, sig);
    });
    // keyboard focus landing in a hidden world brings that world up
    panes.forEach((p, k) => p.addEventListener("focusin", () => {
      if (k === active) return;
      scrollTo({ top: topFor(arriveAt(k)), behavior: "auto" });
    }, sig));

    // cards lean toward the pointer and catch a glare
    root.querySelectorAll<HTMLElement>(".jart").forEach((card) => {
      card.addEventListener("pointermove", (e) => {
        if (e.pointerType !== "mouse") return;
        const b = card.getBoundingClientRect();
        const x = (e.clientX - b.left) / b.width, y = (e.clientY - b.top) / b.height;
        card.style.setProperty("--rx", `${((x - 0.5) * 10).toFixed(2)}deg`);
        card.style.setProperty("--ry", `${((0.5 - y) * 8).toFixed(2)}deg`);
        card.style.setProperty("--gx", `${(x * 100).toFixed(1)}%`);
        card.style.setProperty("--gy", `${(y * 100).toFixed(1)}%`);
      }, sig);
      card.addEventListener("pointerleave", () => { card.style.setProperty("--rx", "0deg"); card.style.setProperty("--ry", "0deg"); }, sig);
    });

    // the pointer steers the ship
    addEventListener("pointermove", (e) => {
      journey?.setPointer((e.clientX / innerWidth) * 2 - 1, (e.clientY / innerHeight) * 2 - 1);
    }, { passive: true, ...sig });

    // ---- the 3D flight: after first paint, only where WebGL works, paused off screen
    const canvas = root.querySelector<HTMLCanvasElement>(".journey-canvas");
    const engines = import.meta.glob("../../scripts/journey/engine.ts");
    const loadEngine = Object.values(engines)[0] as undefined | (() => Promise<any>);
    const hasGL = (() => { try { return !!document.createElement("canvas").getContext("webgl2"); } catch { return false; } })();
    if (canvas && loadEngine && hasGL) {
      const boot = () => loadEngine().then((m) => {
        if (visit.signal.aborted) return; // left the page while it loaded
        // the ship reports where it is on screen; the words step aside if it drifts into them
        let shipT = 0;
        const onShip = (sh: { x: number; y: number; r: number }) => {
          const t = performance.now();
          if (t - shipT < 120 || low) return;
          shipT = t;
          const pane = panes[active];
          if (!pane) return;
          const b = pane.getBoundingClientRect();
          const cx = sh.x * innerWidth, cy = sh.y * innerHeight, rr = sh.r * innerHeight;
          const nx = Math.max(b.left, Math.min(cx, b.right)), ny = Math.max(b.top, Math.min(cy, b.bottom));
          const overlap = rr - Math.hypot(cx - nx, cy - ny);
          const dx = overlap > 0 ? (cx > (b.left + b.right) / 2 ? -1 : 1) * Math.min(56, overlap) : 0;
          pane.style.setProperty("--nx", `${dx.toFixed(0)}px`);
        };
        journey = m.mountJourney(canvas, { chapters, quality: low ? "low" : "high", reducedMotion: reduced, onShip }) as Journey;
        if (typeof m.landed === "function") landed = m.landed;
        const plan = m.CHAPTER_FRAMING as Framing[] | undefined;
        if (Array.isArray(plan) && plan.length) {
          framing = plan;
          panes.forEach((p, k) => { p.dataset.side = plan[k]?.side ?? "left"; p.dataset.v = plan[k]?.v ?? "bottom"; });
          if (active >= 0) place(active);
        }
        journey.setScroll(progress, 0);
        root.classList.add("is-3d");
        const io = new IntersectionObserver(([e]) => journey?.setPaused(!e.isIntersecting));
        io.observe(root);
        visit.signal.addEventListener("abort", () => io.disconnect());
        document.addEventListener("visibilitychange", () => journey?.setPaused(document.hidden), sig);
      }).catch(() => { /* the painted sky stays */ });
      if ("requestIdleCallback" in window) (window as any).requestIdleCallback(boot, { timeout: 1500 });
      else setTimeout(boot, 600);
    }

    // ---- the filmed chapters on the planet
    function playScene(id: string | null) {
      cancelAnimationFrame(sceneRaf);
      sceneNow = id;
      // only a player that knows scenes and has this one loaded may cover the flight
      const ready = !!(id && player && typeof player.setScene === "function" && (player.ready ? player.ready(id) : false));
      root.classList.toggle("show-film", ready);
      journey?.setPaused(false);
      if (!id || !player || !ready) { player?.setPaused(true); return; }
      player.setPaused(false);
      player.setScene(id);
      player.setProgress(0);
      const dur = sceneLength(id) * 1000, t0 = performance.now();
      const tick = (t: number) => {
        if (sceneNow !== id || visit.signal.aborted) return;
        const k = Math.min(1, (t - t0) / dur);
        player?.setProgress(k);
        if (k > 0.25) journey?.setPaused(true); // the film covers the flight
        if (k < 1) sceneRaf = requestAnimationFrame(tick);
      };
      sceneRaf = requestAnimationFrame(tick);
    }

    // ---- the filmed scenes' player: loads when the planet comes near
    const endCanvas = root.querySelector<HTMLCanvasElement>(".journey-ending");
    const endings = import.meta.glob("../../scripts/journey/ending.ts");
    const loadEnding = Object.values(endings)[0] as undefined | (() => Promise<any>);
    let endingAsked = false;
    function bootEnding() {
      if (endingAsked || !endCanvas || !loadEnding) return;
      endingAsked = true;
      loadEnding().then((m) => {
        if (visit.signal.aborted) return;
        player = m.mountEnding(endCanvas, { manifestUrl: "/story/manifest.json", phone: low }) as Ending;
        root.classList.add("has-ending");
        // if a filmed chapter is already showing, start it now
        if (active >= 0 && chapters[active].scene) { const i = active; active = -1; show(i); }
      }).catch(() => { /* no film yet: the landing shot holds */ });
    }

    // ---- leaving the page: stop the scene, the film and every listener added above
    document.addEventListener("astro:before-swap", () => {
      visit.abort();
      clearTimeout(idle);
      clearTimeout(wordsLater);
      cancelAnimationFrame(sceneRaf);
      journey?.destroy();
      player?.destroy();
      journey = null;
      player = null;
      delete root.dataset.mounted;
      document.documentElement.classList.remove("in-journey");
    }, { once: true });
  }
  mount();
  document.addEventListener("astro:page-load", mount);
</script>
