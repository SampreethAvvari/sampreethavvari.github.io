---
// The landing page as a flight. One stage stays pinned while the page
// scrolls; each screen of scroll is a chapter. The 3D scene (a ship flying
// through space, scripts/journey/engine.ts) loads after first paint and
// follows the scroll; until then, and wherever WebGL is missing, a painted
// sky in the chapter's colour stands in. All copy is real HTML, so it reads
// and indexes without the scene.
import Icon from "../common/Icon.astro";

interface Stat { value: string; label: string; href: string }
interface Art { avif?: string; webp?: string; alt: string }
interface Proj { title: string; line: string; href: string; art?: Art }
interface Disc { slug: string; short: string; name: string; line: string; art?: Art }
interface PostLink { title: string; url: string; date?: string; art?: Art }
interface QA { q: string; a: string }
interface Props {
  proof: Stat[];
  projects: Proj[];
  projectCount: number;
  disciplines: Disc[];
  posts: PostLink[];
  postCount: number;
  guides: { title: string; url: string }[];
  faq: QA[];
  poster?: Art;
  email: string;
  linkedin: string;
  github: string;
}
const { proof, projects, projectCount, disciplines, posts, postCount, guides, faq, poster, email, linkedin, github } = Astro.props;

const chapters = [
  { id: "launch", name: "Launch", color: "#5B8DEF", rgb: "91,141,239" },
  { id: "proof", name: "In numbers", color: "#22D3EE", rgb: "34,211,238" },
  { id: "projects", name: "The work", color: "#5B8DEF", rgb: "91,141,239" },
  { id: "disciplines", name: "Four ways in", color: "#F5A524", rgb: "245,165,36" },
  { id: "writing", name: "Writing", color: "#34D399", rgb: "52,211,153" },
  { id: "film", name: "Film", color: "#F43F5E", rgb: "244,63,94" },
  { id: "mind", name: "The Mind", color: "#A78BFA", rgb: "167,139,250" },
  { id: "contact", name: "What's next", color: "#F5A524", rgb: "245,165,36" },
];
const N = chapters.length;
const pad = (n: number) => String(n).padStart(2, "0");
const words = (s: string) => s.split(" ");
const year = new Date().getFullYear();
// Scroll per chapter, in screens: most of it is spent inside the world, the
// last part is the jump to the next one.
const SPAN = 1.7;
// Where each chapter rests when the scroll settles (fraction of its span).
const REST = 0.3;
---

<section
  id="home"
  class="journey"
  data-journey
  data-chapters={JSON.stringify(chapters.map(({ id, color }) => ({ id, color })))}
  data-rest={REST}
  style={`--n:${N};--span:${SPAN};--jc:${chapters[0].rgb};`}
  aria-label="Sampreeth Avvari, in eight chapters"
>
  <div class="journey-stage">
    <div class="journey-sky" aria-hidden="true"></div>
    <canvas class="journey-canvas" aria-hidden="true"></canvas>
    <div class="journey-grain" aria-hidden="true"></div>
    <div class="journey-shade" aria-hidden="true"></div>

    <!-- where you are -->
    <p class="journey-count" aria-hidden="true"><b data-j-now>01</b><i>/</i><span>{pad(N)}</span></p>
    <nav class="journey-index" aria-label="Chapters">
      <ol>
        {chapters.map((c, i) => (
          <li>
            <a href={`#ch-${c.id}`} data-j-go={i} style={`--cc:${c.rgb}`} aria-current={i === 0 ? "step" : undefined}>
              <span class="ji-num">{pad(i + 1)}</span><span class="ji-name">{c.name}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="journey-rail" aria-hidden="true">
      <span class="jr-track"><span class="jr-fill" data-j-fill></span></span>
      {chapters.map((_, i) => <span class="jr-tick" style={`--t:${i / (N - 1)}`}></span>)}
      <span class="jr-label" data-j-label>{pad(1)} {chapters[0].name}</span>
    </div>
    <p class="journey-cue" aria-hidden="true"><span>Scroll</span><i></i></p>

    <!-- the chapters' words -->
    <div class="journey-copy">
      <article class="jc is-active" data-jc="0" style={`--cc:${chapters[0].rgb}`}>
        <p class="jc-chip"><span class="jc-live"></span>Forward deployed engineer · New York</p>
        <h1 class="jc-title jc-hero">
          <span class="jc-line">{words("I'm Sampreeth.").map((w, k) => <span class="jw" style={`--w:${k}`}>{w} </span>)}</span>
          <span class="jc-line jc-tail">{words("I ship in the room.").map((w, k) => <span class="jw" style={`--w:${k + 2}`}>{w} </span>)}</span>
        </h1>
        <p class="jc-lede">The only engineer at a three office dental implant practice. I find the problem next to the people who have it, build the fix, and run it in production. I also make films.</p>
        <div class="jc-actions">
          <a href="/projects" class="jb is-solid"><span>See the projects</span><i class="jb-arrow"><Icon name="arrow-right" size={13} /></i></a>
          <a href="/mind" class="jb is-mind"><Icon name="brain" size={14} /><span>Explore the Mind</span></a>
          <a href="#ch-contact" class="jb is-ghost" data-j-go="7"><span>Contact</span><i class="jb-arrow"><Icon name="mail" size={13} /></i></a>
        </div>
        <p class="jc-meta">M.S. Computer Engineering, NYU Tandon, 2025 · B.Tech Computer Science, JNTU · Scroll to fly through the work</p>
      </article>

      <article class="jc" data-jc="1" style={`--cc:${chapters[1].rgb}`}>
        <p class="jc-kicker"><span>02</span><i></i><span>Chapter</span></p>
        <h2 class="jc-title"><span class="jc-line">{words("What the work changed").map((w, k) => <span class="jw" style={`--w:${k}`}>{w} </span>)}</span></h2>
        <p class="jc-lede">Counted, not guessed. Each number opens the record it comes from.</p>
        <ul class="jc-stats">
          {proof.map((s, k) => (
            <li style={`--w:${k + 3}`}>
              <a href={s.href}><b data-count={s.value}>{s.value}</b><span>{s.label}</span></a>
            </li>
          ))}
        </ul>
      </article>

      <article class="jc" data-jc="2" style={`--cc:${chapters[2].rgb}`}>
        <p class="jc-kicker"><span>03</span><i></i><span>Chapter</span></p>
        <h2 class="jc-title"><span class="jc-line">{words("Software a practice runs on").map((w, k) => <span class="jw" style={`--w:${k}`}>{w} </span>)}</span></h2>
        <p class="jc-lede">What the front desk, finance, marketing and clinical teams open every day. {projectCount} projects, each with its own case study and architecture drawing.</p>
        <ul class="jc-cards">
          {projects.map((p, k) => (
            <li style={`--w:${k + 3}`}>
              <a class="jart" href={p.href}>
                {p.art && <picture>{p.art.avif && <source srcset={p.art.avif} type="image/avif" />}<img src={p.art.webp} alt="" loading="lazy" decoding="async" /></picture>}
                <span class="jart-glare" aria-hidden="true"></span>
                <span class="jart-text"><b>{p.title}</b><span>{p.line}</span></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="jc-actions"><a href="/projects" class="jb"><span>All {projectCount} projects</span><i class="jb-arrow"><Icon name="arrow-right" size={13} /></i></a><a href="/architecture" class="jb is-ghost"><span>The drawings</span><i class="jb-arrow"><Icon name="arrow-right" size={13} /></i></a></div>
      </article>

      <article class="jc" data-jc="3" style={`--cc:${chapters[3].rgb}`}>
        <p class="jc-kicker"><span>04</span><i></i><span>Chapter</span></p>
        <h2 class="jc-title"><span class="jc-line">{words("Four ways in").map((w, k) => <span class="jw" style={`--w:${k}`}>{w} </span>)}</span></h2>
        <p class="jc-lede">The same work, read four ways. Pick the one closest to the role you have in mind.</p>
        <ul class="jc-cards is-quad">
          {disciplines.map((d, k) => (
            <li style={`--w:${k + 3}`}>
              <a class="jart" href={`/work/${d.slug}`}>
                {d.art && <picture>{d.art.avif && <source srcset={d.art.avif} type="image/avif" />}<img src={d.art.webp} alt="" loading="lazy" decoding="async" /></picture>}
                <span class="jart-glare" aria-hidden="true"></span>
                <span class="jart-text"><i class="jq-short">{d.short}</i><b>{d.name}</b><span>{d.line}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </article>

      <article class="jc" data-jc="4" style={`--cc:${chapters[4].rgb}`}>
        <p class="jc-kicker"><span>05</span><i></i><span>Chapter</span></p>
        <h2 class="jc-title"><span class="jc-line">{words("Written down as it happened").map((w, k) => <span class="jw" style={`--w:${k}`}>{w} </span>)}</span></h2>
        <p class="jc-lede">{postCount} case studies: the problem, what I built, what changed. The latest:</p>
        <ul class="jc-cards is-three">
          {posts.map((p, k) => (
            <li style={`--w:${k + 3}`}>
              <a class="jart" href={p.url}>
                {p.art && <picture>{p.art.avif && <source srcset={p.art.avif} type="image/avif" />}<img src={p.art.webp} alt="" loading="lazy" decoding="async" /></picture>}
                <span class="jart-glare" aria-hidden="true"></span>
                <span class="jart-text"><b>{p.title}</b>{p.date && <span>{p.date}</span>}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="jc-guides">Free guides · {guides.map((g, k) => <>{k > 0 && " · "}<a href={g.url}>{g.title}</a></>)}</p>
        <div class="jc-actions"><a href="/posts" class="jb"><span>All writing</span><i class="jb-arrow"><Icon name="arrow-right" size={13} /></i></a></div>
      </article>

      <article class="jc" data-jc="5" style={`--cc:${chapters[5].rgb}`}>
        <p class="jc-kicker"><span>06</span><i></i><span>Chapter</span></p>
        <h2 class="jc-title"><span class="jc-line">{words("Among Monsters").map((w, k) => <span class="jw" style={`--w:${k}`}>{w} </span>)}</span></h2>
        <p class="jc-lede">My feature, an independent crime drama shot in New York, written and directed as Sampreeth Sharma. Eight more films on the slate, behind the camera and in the edit.</p>
        {poster && (
          <a class="jart is-poster" href="/filmmaking/among-monsters" style="--w:3">
            <picture>{poster.avif && <source srcset={poster.avif} type="image/avif" />}<img src={poster.webp} alt={poster.alt} loading="lazy" decoding="async" /></picture>
            <span class="jart-glare" aria-hidden="true"></span>
          </a>
        )}
        <div class="jc-actions">
          <a href="/filmmaking/among-monsters" class="jb is-solid"><span>Among Monsters</span><i class="jb-arrow"><Icon name="film" size={13} /></i></a>
          <a href="/filmmaking" class="jb is-ghost"><span>All nine films</span><i class="jb-arrow"><Icon name="arrow-right" size={13} /></i></a>
        </div>
      </article>

      <article class="jc" data-jc="6" style={`--cc:${chapters[6].rgb}`}>
        <p class="jc-kicker"><span>07</span><i></i><span>Chapter</span></p>
        <h2 class="jc-title"><span class="jc-line">{words("Everything I've built, as a star map").map((w, k) => <span class="jw" style={`--w:${k}`}>{w} </span>)}</span></h2>
        <p class="jc-lede">Projects, case studies and the tools behind them, joined the way they really connect. Fly through it.</p>
        <div class="jc-actions"><a href="/mind" class="jb is-mind"><Icon name="brain" size={14} /><span>Enter the Mind</span><i class="jb-arrow"><Icon name="arrow-right" size={13} /></i></a></div>
      </article>

      <article class="jc jc-end" data-jc="7" style={`--cc:${chapters[7].rgb}`}>
        <p class="jc-kicker"><span>08</span><i></i><span>Open to new work · {year}</span></p>
        <h2 class="jc-title"><span class="jc-line">{words("Let's build").map((w, k) => <span class="jw" style={`--w:${k}`}>{w} </span>)}<span class="jc-dim">{words("what's next.").map((w, k) => <span class="jw" style={`--w:${k + 2}`}>{w} </span>)}</span></span></h2>
        <div class="jc-reach">
          <a class="jc-mail" href={`mailto:${email}`}>{email} <Icon name="arrow-right" size={16} /></a>
          <p class="jc-links">
            <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="arrow-up-right" size={12} /></a>
            <a href={github} target="_blank" rel="noopener noreferrer">GitHub <Icon name="arrow-up-right" size={12} /></a>
            <a href="/resume">Resume <Icon name="arrow-up-right" size={12} /></a>
            <a href="#ch-launch" data-j-go="0">Begin again <Icon name="arrow-up-right" size={12} /></a>
          </p>
          <details class="jc-faq">
            <summary>Quick answers</summary>
            <dl>
              {faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
            </dl>
          </details>
        </div>
      </article>
    </div>
  </div>

  <!-- one anchor per chapter, a screen apart, for links and the index -->
  {chapters.map((c, i) => <span class="journey-anchor" id={`ch-${c.id}`} style={`top:calc(${i * SPAN + (i ? REST * SPAN : 0)} * 100svh)`}></span>)}
</section>


<style>
  /* every chapter gets SPAN screens; the last one ends where the page ends */
  .journey { position: relative; height: calc(((var(--n) - 1) * var(--span) + 1) * 100svh); }
  .journey-anchor { position: absolute; left: 0; width: 1px; height: 1px; pointer-events: none; }
  .journey-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: #020306;
  }
  /* The painted sky: what shows before the 3D scene arrives, or without WebGL. */
  .journey-sky {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(42% 38% at 68% 46%, rgba(var(--jc), 0.32), transparent 70%),
      radial-gradient(30% 26% at 22% 30%, rgba(var(--jc), 0.12), transparent 70%),
      radial-gradient(60% 40% at 50% 110%, rgba(var(--jc), 0.18), transparent 70%),
      #020306;
    transition: background 1.2s ease;
  }
  .journey-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 1.2s ease; }
  .journey.is-3d .journey-canvas { opacity: 1; }
  .journey.is-3d .journey-sky { opacity: 0.35; }
  /* fine grain and a dark floor so the words always read */
  .journey-grain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.09;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
  .journey-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top, rgba(2, 3, 6, 0.86) 0%, rgba(2, 3, 6, 0.4) 34%, transparent 58%),
      linear-gradient(to right, rgba(2, 3, 6, 0.55) 0%, transparent 46%);
    transition: opacity 0.8s ease;
  }
  /* the readable dark follows the words to whichever side they are on */
  .journey-shade::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
    background:
      linear-gradient(to top, rgba(2, 3, 6, 0.86) 0%, rgba(2, 3, 6, 0.4) 34%, transparent 58%),
      linear-gradient(to left, rgba(2, 3, 6, 0.6) 0%, transparent 46%);
  }
  .journey[data-copy-side="right"] .journey-shade { background: none; }
  .journey[data-copy-side="right"] .journey-shade::after { opacity: 1; }
  .journey[data-copy-v="top"] .journey-shade { background: linear-gradient(to bottom, rgba(2, 3, 6, 0.78) 0%, rgba(2, 3, 6, 0.3) 36%, transparent 60%), linear-gradient(to right, rgba(2, 3, 6, 0.5) 0%, transparent 46%); }

  /* the counter, top centre under the nav */
  .journey-count {
    position: absolute;
    top: 96px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    display: flex;
    gap: 8px;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.5);
    z-index: 3;
  }
  .journey-count b { color: #fff; font-weight: 600; }
  .journey-count i { font-style: normal; opacity: 0.4; }

  /* the chapter index, top right */
  .journey-index { position: absolute; top: 92px; right: max(24px, var(--gutter, 24px)); z-index: 3; }
  .journey-index ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; justify-items: end; }
  .journey-index a {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 3px 0;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.42);
    text-decoration: none;
    transition: color 300ms ease;
  }
  .journey-index .ji-num { font-size: 0.625rem; font-variant-numeric: tabular-nums; color: rgba(var(--cc), 0.6); }
  .journey-index a:hover, .journey-index a[aria-current] { color: #fff; }
  .journey-index a[aria-current] .ji-num { color: rgb(var(--cc)); }

  /* the rail on the right edge: a line that fills, a tick per chapter */
  .journey-rail { position: absolute; right: max(24px, var(--gutter, 24px)); top: 372px; bottom: 120px; width: 1px; z-index: 3; }
  .jr-track { position: absolute; inset: 0; background: rgba(255, 255, 255, 0.14); }
  .jr-fill { position: absolute; left: 0; right: 0; top: 0; height: 100%; transform-origin: top; transform: scaleY(0); background: rgb(var(--jc)); box-shadow: 0 0 10px rgba(var(--jc), 0.8); transition: background 0.8s ease; }
  .jr-tick { position: absolute; right: -4px; width: 9px; height: 1px; top: calc(var(--t) * 100%); background: rgba(255, 255, 255, 0.3); }
  .jr-label {
    position: absolute;
    right: 16px;
    top: 0;
    transform: translateY(-50%);
    white-space: nowrap;
    font-size: 0.6875rem;
    color: rgba(255, 255, 255, 0.7);
    transition: top 0.25s linear;
  }

  .journey-cue {
    position: absolute;
    left: 50%;
    bottom: 26px;
    transform: translateX(-50%);
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 8px;
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    z-index: 3;
    transition: opacity 0.5s ease;
  }
  .journey-cue i { width: 1px; height: 34px; background: linear-gradient(rgba(255, 255, 255, 0.7), transparent); animation: j-cue 1.8s ease-in-out infinite; transform-origin: top; }
  .journey.is-moving .journey-cue { opacity: 0; }
  @keyframes j-cue { 0% { transform: scaleY(0); opacity: 1; } 60% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }

  /* the words: each chapter sits bottom left and arrives word by word */
  .journey-copy { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .jc {
    position: absolute;
    left: max(24px, var(--gutter, 24px));
    bottom: clamp(36px, 8vh, 84px);
    width: min(720px, calc(100% - 48px));
    display: grid;
    gap: 18px;
    color: #fff;
    opacity: 0;
    visibility: hidden;
    transform: translateY(18px);
    filter: blur(6px);
    transition: opacity 0.6s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease, visibility 0s linear 0.8s;
  }
  /* where the words sit follows the shot: the side the ship leaves free */
  .jc { translate: var(--nx, 0px) var(--ny, 0px); transition-property: opacity, transform, filter, visibility, left, right, top, bottom, translate; }
  .jc[data-side="right"] { left: auto; right: max(72px, calc(var(--gutter, 24px) + 48px)); }
  .jc[data-v="top"] { bottom: auto; top: 150px; }
  .jc.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    filter: none;
    pointer-events: auto;
    transition: opacity 0.7s ease 0.12s, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.12s, filter 0.7s ease 0.12s, visibility 0s;
  }
  .jc-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    margin: 0;
    padding: 6px 12px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(0, 0, 0, 0.35);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.82);
  }
  .jc-live { width: 7px; height: 7px; border-radius: 50%; background: #34d399; box-shadow: 0 0 10px #34d399; }
  .jc-kicker { margin: 0; display: flex; align-items: center; gap: 12px; font-size: 0.8125rem; color: rgba(255, 255, 255, 0.6); }
  .jc-kicker span:first-child { color: rgb(var(--cc)); font-variant-numeric: tabular-nums; }
  .jc-kicker i { width: 56px; height: 1px; background: linear-gradient(90deg, rgb(var(--cc)), rgba(var(--cc), 0.1)); }
  .jc-title {
    margin: 0;
    font-size: clamp(2.5rem, 6.2vw, 5.6rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }
  .jc-hero { font-weight: 600; }
  .jc-line { display: block; }
  .jc-tail, .jc-dim { color: rgba(255, 255, 255, 0.46); }
  .jw { display: inline-block; white-space: pre; opacity: 0; transform: translateY(0.45em) rotate(2deg); filter: blur(8px); transition: opacity 0.6s ease, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease; }
  .jc.is-active .jw { opacity: 1; transform: none; filter: none; transition-delay: calc(0.18s + var(--w) * 0.07s); }
  .jc-lede { margin: 0; max-width: 34rem; font-size: clamp(1rem, 1.3vw, 1.125rem); line-height: 1.6; color: rgba(255, 255, 255, 0.72); }
  .jc-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .jc-meta { margin: 2px 0 0; font-size: 0.75rem; letter-spacing: 0.01em; color: rgba(255, 255, 255, 0.42); }
  .jc-guides { margin: 0; font-size: 0.875rem; color: rgba(255, 255, 255, 0.55); }
  .jc-guides a { color: rgba(255, 255, 255, 0.85); text-decoration: none; border-bottom: 1px solid rgba(var(--cc), 0.5); }
  .jc-guides a:hover { color: rgb(var(--cc)); }
  .jc-faq { max-width: 640px; font-size: 0.875rem; color: rgba(255, 255, 255, 0.7); }
  .jc-faq summary { width: fit-content; cursor: pointer; list-style: none; color: rgba(255, 255, 255, 0.6); border-bottom: 1px dashed rgba(255, 255, 255, 0.3); padding-bottom: 2px; }
  .jc-faq summary::-webkit-details-marker { display: none; }
  .jc-faq summary:hover { color: #fff; }
  .jc-faq dl { margin: 12px 0 0; max-height: 34vh; overflow: auto; padding-right: 8px; display: grid; gap: 10px; }
  .jc-faq dt { color: #fff; font-weight: 600; }
  .jc-faq dd { margin: 2px 0 0; line-height: 1.55; color: rgba(255, 255, 255, 0.62); }
  /* the site's left scroll gauge would sit on the words; the flight has its own rail */
  :global(html.in-journey .orbit) { opacity: 0 !important; pointer-events: none; transition: opacity 0.4s ease; }

  /* items inside a chapter come in after the headline */
  .jc-stats li, .jc-cards li, .jart.is-poster { opacity: 0; transform: translateY(14px) scale(0.98); transition: opacity 0.6s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  .jc.is-active .jc-stats li, .jc.is-active .jc-cards li, .jc.is-active .jart.is-poster { opacity: 1; transform: none; transition-delay: calc(0.2s + var(--w) * 0.08s); }

  /* buttons made for the flight: a thin lit pill in the chapter's colour */
  .jb {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 8px 0 18px;
    border-radius: 9999px;
    border: 1px solid rgba(var(--cc), 0.42);
    background: linear-gradient(180deg, rgba(var(--cc), 0.16), rgba(var(--cc), 0.03));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .jb::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.22) 48%, transparent 66%);
    transform: translateX(-120%);
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .jb:hover { border-color: rgba(var(--cc), 0.85); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 0 26px -6px rgba(var(--cc), 0.8); }
  .jb:hover::before { transform: translateX(120%); }
  .jb:active { transform: scale(0.97); }
  .jb:focus-visible { outline: 1.5px solid rgb(var(--cc)); outline-offset: 3px; }
  .jb-arrow { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: rgba(255, 255, 255, 0.1); font-style: normal; transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.3s ease; }
  .jb:hover .jb-arrow { transform: translateX(3px); background: rgba(var(--cc), 0.35); }
  .jb.is-solid { color: #04060b; border-color: transparent; background: linear-gradient(180deg, #fff, rgba(var(--cc), 0.95)); box-shadow: 0 8px 26px -10px rgba(var(--cc), 0.9); }
  .jb.is-solid .jb-arrow { background: rgba(4, 6, 11, 0.12); }
  .jb.is-mind { --cc: 167, 139, 250; padding-left: 14px; }
  .jb.is-ghost { border-color: rgba(255, 255, 255, 0.14); background: rgba(255, 255, 255, 0.03); }
  .jb.is-ghost:hover { border-color: rgba(255, 255, 255, 0.4); }

  /* art you can open: the card leans toward the pointer and catches light */
  .jc-cards { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; max-width: 760px; perspective: 900px; }
  .jc-cards.is-three { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 680px; }
  .jart {
    position: relative;
    display: block;
    aspect-ratio: 16 / 11;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #05070d;
    color: #fff;
    text-decoration: none;
    transform: rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .jart picture, .jart img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .jart img { transform: scale(1.06); transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease; filter: saturate(0.9) brightness(0.8); }
  .jart:hover img { transform: scale(1.12); filter: saturate(1.1) brightness(1); }
  .jart::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(2, 3, 8, 0.92) 0%, rgba(2, 3, 8, 0.25) 55%, transparent 80%); }
  .jart:hover { border-color: rgba(var(--cc), 0.75); box-shadow: 0 16px 40px -18px rgba(var(--cc), 0.85); }
  .jart-glare { position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: 0; background: radial-gradient(240px circle at var(--gx, 50%) var(--gy, 50%), rgba(255, 255, 255, 0.22), transparent 60%); transition: opacity 0.3s ease; }
  .jart:hover .jart-glare { opacity: 1; }
  .jart-text { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; display: grid; gap: 2px; padding: 10px 12px; }
  .jart-text b { font-size: 0.8125rem; font-weight: 600; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .jart-text span { font-size: 0.6875rem; line-height: 1.35; color: rgba(255, 255, 255, 0.62); max-height: 0; opacity: 0; overflow: hidden; transition: max-height 0.4s ease, opacity 0.3s ease; }
  .jart:hover .jart-text span, .jart:focus-visible .jart-text span { max-height: 4.2em; opacity: 1; }
  .jc-cards.is-three .jart-text span { max-height: none; opacity: 1; }
  .jq-short { font-style: normal; font-size: 0.625rem; font-weight: 700; letter-spacing: 0.12em; color: rgb(var(--cc)); }
  .jart.is-poster { width: min(440px, 100%); aspect-ratio: 16 / 9; }
  .jart.is-poster::after { background: linear-gradient(to top, rgba(2, 3, 8, 0.4), transparent 50%); }
  .jart:focus-visible { outline: 1.5px solid rgb(var(--cc)); outline-offset: 3px; }

  /* the jump: the words leave, the counter flickers */
  .journey.is-jumping .journey-count b { animation: j-flicker 0.24s steps(2) infinite; }
  @keyframes j-flicker { 50% { opacity: 0.3; transform: translateX(1px); } }
  .jc-stats { list-style: none; margin: 6px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 32px; max-width: 640px; }
  .jc-stats a { display: grid; gap: 6px; color: inherit; text-decoration: none; }
  .jc-stats b { font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; }
  .jc-stats span { font-size: 0.875rem; line-height: 1.45; color: rgba(255, 255, 255, 0.62); max-width: 16rem; }
  .jc-stats a:hover b { color: rgb(var(--cc)); }
  .jc-reach { display: grid; gap: 14px; margin-top: 6px; }
  .jc-mail { display: inline-flex; align-items: center; gap: 10px; width: fit-content; font-size: clamp(1.1rem, 2vw, 1.5rem); color: #fff; text-decoration: none; border-bottom: 1px solid rgba(var(--cc), 0.6); padding-bottom: 6px; }
  .jc-mail:hover { color: rgb(var(--cc)); }
  .jc-links { margin: 0; display: flex; flex-wrap: wrap; gap: 18px; font-size: 0.875rem; }
  .jc-links a { display: inline-flex; align-items: center; gap: 4px; color: rgba(255, 255, 255, 0.7); text-decoration: none; }
  .jc-links a:hover { color: #fff; }

  @media (max-width: 1023px) {
    .journey-index { display: none; }
    .journey-rail { top: 160px; bottom: 120px; right: 14px; }
    .jr-label { display: none; }
  }
  @media (max-width: 640px) {
    /* phones: the ship holds the upper half, the words always sit below */
    .jc[data-side="right"] { right: auto; left: 16px; }
    .jc[data-v="top"] { top: auto; bottom: 28px; }
    .jc { translate: none; }
    .journey-count { top: 84px; }
    .jc { left: 16px; width: calc(100% - 44px); bottom: 28px; gap: 14px; }
    .jc-title { font-size: clamp(2.2rem, 10.5vw, 3rem); }
    .jc-stats { gap: 14px 18px; }
    .jc-stats b { font-size: 1.9rem; }
    .jc-cards, .jc-cards.is-three { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 8px; margin-right: -16px; padding-right: 16px; scrollbar-width: none; perspective: none; }
    .jc-cards li { flex: 0 0 62%; scroll-snap-align: start; }
    .jart { transform: none; }
    .jart-text span { display: none; }
    .jart.is-poster { width: 100%; }
    .jc-actions .jb { flex: 1 1 auto; justify-content: center; }
    .journey-cue { bottom: auto; top: 112px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .jc, .jc.is-active, .jw, .jc .jw, .jc-stats li, .jc-cards li, .jart.is-poster, .jart { transition: opacity 0.3s ease !important; transform: none !important; filter: none !important; }
    .journey-cue i { animation: none; }
  }
</style>

<script>
  type Chapter = { id: string; color: string };
  type Journey = { setScroll(p: number, v: number): void; setPointer(x: number, y: number): void; setPaused(p: boolean): void; destroy(): void };
  // The engine module may also export CHAPTER_FRAMING (where the words should sit per chapter).

  // Runs on first load and again after each in-page navigation back to the
  // home page; everything it adds is removed when the page is swapped away.
  function mount() {
  const root = document.querySelector<HTMLElement>("[data-journey]");
  if (!root || root.dataset.mounted) return;
  root.dataset.mounted = "1";
  const visit = new AbortController();
  const sig = { signal: visit.signal };
    const chapters: Chapter[] = JSON.parse(root.dataset.chapters || "[]");
    const N = chapters.length;
    const panes = Array.from(root.querySelectorAll<HTMLElement>("[data-jc]"));
    const now = root.querySelector<HTMLElement>("[data-j-now]");
    const fill = root.querySelector<HTMLElement>("[data-j-fill]");
    const label = root.querySelector<HTMLElement>("[data-j-label]");
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>(".journey-index [data-j-go]"));
    const names = links.map((a) => a.querySelector(".ji-name")?.textContent || "");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const low = matchMedia("(max-width: 767px), (pointer: coarse)").matches || ((navigator as any).deviceMemory ?? 8) < 4;
    const hexRgb = (h: string) => { const n = parseInt(h.slice(1), 16); return `${(n >> 16) & 255},${(n >> 8) & 255},${n & 255}`; };
    const pad = (n: number) => String(n).padStart(2, "0");

    let progress = 0, lastP = 0, lastT = performance.now(), velocity = 0, active = -1, ticking = false;
    let journey: Journey | null = null;

    const REST = Number(root.dataset.rest || 0.3);
    const JUMP = 0.8; // the last fifth of each chapter is the jump to the next
    const span = () => Math.max(1, root.offsetHeight - innerHeight);
    const measure = () => {
      const r = root.getBoundingClientRect();
      return Math.min(1, Math.max(0, -r.top / span())) * (N - 1);
    };
    const topFor = (p: number) => root.offsetTop + (p / (N - 1)) * span();
    const restOf = (i: number) => (i <= 0 ? 0 : i >= N - 1 ? N - 1 : i + REST);
    // Where each chapter's words sit, from the engine's camera plan.
    let framing: { side: "left" | "right"; v: "top" | "bottom" }[] = [];
    const place = (i: number) => {
      const f = framing[i];
      root.dataset.copySide = f?.side ?? "left";
      root.dataset.copyV = f?.v ?? "bottom";
    };
    const show = (i: number) => {
      if (i === active) return;
      active = i;
      place(i);
      panes.forEach((p, k) => p.classList.toggle("is-active", k === i));
      links.forEach((a, k) => (k === i ? a.setAttribute("aria-current", "step") : a.removeAttribute("aria-current")));
      if (now) now.textContent = pad(i + 1);
      if (label) label.textContent = `${pad(i + 1)} ${names[i] || ""}`;
      root.style.setProperty("--jc", hexRgb(chapters[i].color));
      // the numbers count up as their chapter arrives
      panes[i].querySelectorAll<HTMLElement>("[data-count]").forEach((el) => countUp(el));
      // the score follows the flight (scripts/sound listens), and speaks the words as they arrive
      window.dispatchEvent(new CustomEvent("journey:chapter", { detail: { index: i, id: chapters[i].id, count: N } }));
      const pane = panes[i];
      const said = Array.from(pane.querySelectorAll<HTMLElement>(".jw")).map((w) => (w.textContent || "").trim()).filter(Boolean);
      const items = pane.querySelectorAll(".jc-stats li, .jc-cards li").length;
      window.dispatchEvent(new CustomEvent("journey:words", { detail: { index: i, id: chapters[i].id, words: said, items, wordStagger: 0.07, itemStagger: 0.08, delay: 0.18 } }));
    };
    const update = () => {
      ticking = false;
      const t = performance.now();
      progress = measure();
      const dt = Math.max(16, t - lastT) / 1000;
      velocity = velocity * 0.6 + ((progress - lastP) / dt) * 0.4;
      lastP = progress; lastT = t;
      // inside a world its words show; in the jump between worlds they leave
      const i = Math.min(N - 1, Math.floor(progress + 1e-6));
      const frac = progress - i;
      const jumping = i < N - 1 && frac > JUMP;
      if (jumping !== root.classList.contains("is-jumping")) {
        root.classList.toggle("is-jumping", jumping);
        if (jumping) {
          const dir = velocity >= 0 ? 1 : -1;
          window.dispatchEvent(new CustomEvent("journey:jump", { detail: { from: dir > 0 ? i : i + 1, to: dir > 0 ? i + 1 : i, direction: dir } }));
          panes.forEach((p) => p.classList.remove("is-active"));
          active = -1;
        }
      }
      if (!jumping) show(i);
      const f = progress / (N - 1);
      if (fill) fill.style.transform = `scaleY(${f})`;
      if (label) label.style.top = `${f * 100}%`;
      root.classList.toggle("is-moving", progress > 0.04);
      document.documentElement.classList.toggle("in-journey", root.getBoundingClientRect().bottom > innerHeight * 0.5);
      journey?.setScroll(progress, velocity);
      window.dispatchEvent(new CustomEvent("journey:progress", { detail: { progress, velocity, count: N } }));
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } settle(); };

    // Magnetic stops: when the scroll settles near a world's reading spot it
    // eases onto it, and it never stops halfway through a jump.
    let idle = 0, gliding = false, held = false;
    const glide = (p: number) => {
      gliding = true;
      scrollTo({ top: topFor(p), behavior: reduced ? "auto" : "smooth" });
      window.setTimeout(() => { gliding = false; }, 900);
    };
    const settle = () => {
      clearTimeout(idle);
      if (gliding || held) return;
      idle = window.setTimeout(() => {
        if (held) return;
        const p = measure();
        const i = Math.min(N - 1, Math.floor(p + 1e-6));
        const frac = p - i;
        if (i < N - 1 && frac > JUMP) { glide(velocity < 0 ? restOf(i) : restOf(i + 1)); return; }
        const r = restOf(i);
        if (Math.abs(p - r) < 0.16 && Math.abs(p - r) > 0.004) glide(r);
      }, 170);
    };
    addEventListener("pointerdown", () => { held = true; }, sig);
    addEventListener("pointerup", () => { held = false; settle(); }, sig);
    addEventListener("touchstart", () => { held = true; }, { passive: true, ...sig });
    addEventListener("touchend", () => { held = false; settle(); }, { passive: true, ...sig });

    // a number that counts up from zero, keeping its words ("70 hrs", "1,161")
    const countUp = (el: HTMLElement) => {
      const text = el.dataset.count || "";
      const m = text.match(/^([\d,.]+)(.*)$/);
      if (!m || reduced) { el.textContent = text; return; }
      const target = Number(m[1].replace(/,/g, ""));
      const comma = m[1].includes(",");
      const t0 = performance.now(), dur = 1100;
      const tick = (t: number) => {
        const k = Math.min(1, (t - t0) / dur);
        const v = Math.round(target * (1 - Math.pow(1 - k, 3)));
        el.textContent = (comma ? v.toLocaleString("en-US") : String(v)) + m[2];
        if (k < 1 && !visit.signal.aborted) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    // cards lean toward the pointer and catch a glare
    root.querySelectorAll<HTMLElement>(".jart").forEach((card) => {
      card.addEventListener("pointermove", (e) => {
        if (e.pointerType !== "mouse") return;
        const b = card.getBoundingClientRect();
        const x = (e.clientX - b.left) / b.width, y = (e.clientY - b.top) / b.height;
        card.style.setProperty("--rx", `${((x - 0.5) * 10).toFixed(2)}deg`);
        card.style.setProperty("--ry", `${((0.5 - y) * 8).toFixed(2)}deg`);
        card.style.setProperty("--gx", `${(x * 100).toFixed(1)}%`);
        card.style.setProperty("--gy", `${(y * 100).toFixed(1)}%`);
      }, sig);
      card.addEventListener("pointerleave", () => { card.style.setProperty("--rx", "0deg"); card.style.setProperty("--ry", "0deg"); }, sig);
    });
    addEventListener("scroll", onScroll, { passive: true, ...sig });
    addEventListener("resize", onScroll, { passive: true, ...sig });
    update();

    // index links and "Begin again" jump to their chapter
    root.querySelectorAll<HTMLAnchorElement>("[data-j-go]").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        glide(restOf(Number(a.dataset.jGo)));
      });
    });
    // keyboard focus landing in a hidden chapter brings that chapter up
    panes.forEach((p, k) => p.addEventListener("focusin", () => {
      if (k === active) return;
      scrollTo({ top: topFor(restOf(k)), behavior: "auto" });
    }));

    // the pointer steers the ship
    addEventListener("pointermove", (e) => {
      journey?.setPointer((e.clientX / innerWidth) * 2 - 1, (e.clientY / innerHeight) * 2 - 1);
    }, { passive: true, ...sig });

    // the 3D scene: after first paint, only where WebGL works, paused off screen
    const canvas = root.querySelector<HTMLCanvasElement>(".journey-canvas");
    const engines = import.meta.glob("../../scripts/journey/engine.ts");
    const loadEngine = Object.values(engines)[0] as undefined | (() => Promise<{ mountJourney: (c: HTMLCanvasElement, o: unknown) => Journey }>);
    const hasGL = (() => { try { return !!document.createElement("canvas").getContext("webgl2"); } catch { return false; } })();
    if (canvas && loadEngine && hasGL) {
      const boot = () => loadEngine().then((m) => {
        if (visit.signal.aborted) return; // left the page while it loaded
        // the ship reports where it is on screen; the words step aside if it drifts into them
        let shipT = 0;
        const onShip = (sh: { x: number; y: number; r: number }) => {
          const t = performance.now();
          if (t - shipT < 120 || low) return;
          shipT = t;
          const pane = panes[active];
          if (!pane) return;
          const b = pane.getBoundingClientRect();
          const cx = sh.x * innerWidth, cy = sh.y * innerHeight, rr = sh.r * innerHeight;
          const nx = Math.max(b.left, Math.min(cx, b.right)), ny = Math.max(b.top, Math.min(cy, b.bottom));
          const overlap = rr - Math.hypot(cx - nx, cy - ny);
          let dx = 0;
          if (overlap > 0) dx = (cx > (b.left + b.right) / 2 ? -1 : 1) * Math.min(56, overlap);
          pane.style.setProperty("--nx", `${dx.toFixed(0)}px`);
        };
        journey = m.mountJourney(canvas, { chapters, quality: low ? "low" : "high", reducedMotion: reduced, onShip } as any);
        const plan = (m as any).CHAPTER_FRAMING as typeof framing | undefined;
        if (Array.isArray(plan) && plan.length) {
          framing = plan;
          panes.forEach((p, k) => {
            p.dataset.side = plan[k]?.side ?? "left";
            p.dataset.v = plan[k]?.v ?? "bottom";
          });
          place(active);
        }
        journey.setScroll(progress, 0);
        root.classList.add("is-3d");
        const io = new IntersectionObserver(([e]) => journey?.setPaused(!e.isIntersecting));
        io.observe(root);
        visit.signal.addEventListener("abort", () => io.disconnect());
        document.addEventListener("visibilitychange", () => journey?.setPaused(document.hidden), sig);
      }).catch(() => { /* the painted sky stays */ });
      if ("requestIdleCallback" in window) (window as any).requestIdleCallback(boot, { timeout: 1500 });
      else setTimeout(boot, 600);
    }

  // leaving the page: stop the scene and every listener added above
  document.addEventListener("astro:before-swap", () => {
    visit.abort();
    journey?.destroy();
    journey = null;
    delete root.dataset.mounted;
    document.documentElement.classList.remove("in-journey");
  }, { once: true });
  }
  mount();
  document.addEventListener("astro:page-load", mount);
</script>