    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .jb:hover { border-color: rgba(var(--cc), 0.85); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 0 26px -6px rgba(var(--cc), 0.8); }
  .jb:hover::before { transform: translateX(120%); }
  .jb:active { transform: scale(0.97); }
  .jb:focus-visible { outline: 1.5px solid rgb(var(--cc)); outline-offset: 3px; }
  .jb-arrow { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: rgba(255, 255, 255, 0.1); font-style: normal; transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.3s ease; }
  .jb:hover .jb-arrow { transform: translateX(3px); background: rgba(var(--cc), 0.35); }
  .jb.is-solid { color: #04060b; border-color: transparent; background: linear-gradient(180deg, #fff, rgba(var(--cc), 0.95)); box-shadow: 0 8px 26px -10px rgba(var(--cc), 0.9); }
  .jb.is-solid .jb-arrow { background: rgba(4, 6, 11, 0.12); }
  .jb.is-mind { --cc: 167, 139, 250; padding-left: 14px; }
  .jb.is-ghost { border-color: rgba(255, 255, 255, 0.14); background: rgba(255, 255, 255, 0.03); }
  .jb.is-ghost:hover { border-color: rgba(255, 255, 255, 0.4); }

  /* art you can open: the card leans toward the pointer and catches light */
  .jc-cards { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; max-width: 760px; perspective: 900px; }
  .jc-cards.is-three { grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 680px; }
  .jart {
    position: relative;
    display: block;
    aspect-ratio: 16 / 11;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #05070d;
    color: #fff;
    text-decoration: none;
    transform: rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .jart picture, .jart img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .jart img { transform: scale(1.06); transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease; filter: saturate(0.9) brightness(0.8); }
  .jart:hover img { transform: scale(1.12); filter: saturate(1.1) brightness(1); }
  .jart::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(2, 3, 8, 0.92) 0%, rgba(2, 3, 8, 0.25) 55%, transparent 80%); }
  .jart:hover { border-color: rgba(var(--cc), 0.75); box-shadow: 0 16px 40px -18px rgba(var(--cc), 0.85); }
  .jart-glare { position: absolute; inset: 0; z-index: 2; pointer-events: none; opacity: 0; background: radial-gradient(240px circle at var(--gx, 50%) var(--gy, 50%), rgba(255, 255, 255, 0.22), transparent 60%); transition: opacity 0.3s ease; }
  .jart:hover .jart-glare { opacity: 1; }
  .jart-text { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; display: grid; gap: 2px; padding: 10px 12px; }
  .jart-text b { font-size: 0.8125rem; font-weight: 600; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .jart-text span { font-size: 0.6875rem; line-height: 1.35; color: rgba(255, 255, 255, 0.62); max-height: 0; opacity: 0; overflow: hidden; transition: max-height 0.4s ease, opacity 0.3s ease; }
  .jart:hover .jart-text span, .jart:focus-visible .jart-text span { max-height: 4.2em; opacity: 1; }
  .jc-cards.is-three .jart-text span { max-height: none; opacity: 1; }
  .jq-short { font-style: normal; font-size: 0.625rem; font-weight: 700; letter-spacing: 0.12em; color: rgb(var(--cc)); }
  .jart.is-poster { width: min(440px, 100%); aspect-ratio: 16 / 9; }
  .jart.is-poster::after { background: linear-gradient(to top, rgba(2, 3, 8, 0.4), transparent 50%); }
  .jart:focus-visible { outline: 1.5px solid rgb(var(--cc)); outline-offset: 3px; }

  /* the jump: the words leave, the counter flickers */
  .journey.is-jumping .journey-count b { animation: j-flicker 0.24s steps(2) infinite; }
  @keyframes j-flicker { 50% { opacity: 0.3; transform: translateX(1px); } }
  .jc-stats { list-style: none; margin: 6px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 32px; max-width: 640px; }
  .jc-stats a { display: grid; gap: 6px; color: inherit; text-decoration: none; }
  .jc-stats b { font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 500; letter-spacing: -0.04em; line-height: 1; }
  .jc-stats span { font-size: 0.875rem; line-height: 1.45; color: rgba(255, 255, 255, 0.62); max-width: 16rem; }
  .jc-stats a:hover b { color: rgb(var(--cc)); }
  .jc-reach { display: grid; gap: 14px; margin-top: 6px; }
  .jc-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; margin-top: 10px; padding-top: 14px; border-top: 1px solid rgba(255, 255, 255, 0.1); font-size: 0.8125rem; }
  .jc-foot a { display: inline-flex; align-items: center; gap: 6px; color: rgba(255, 255, 255, 0.62); text-decoration: none; }
  .jc-foot a::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: rgb(var(--fc)); box-shadow: 0 0 8px rgba(var(--fc), 0.8); }
  .jc-foot a:hover { color: #fff; }
  .jc-copy { flex-basis: 100%; font-size: 0.6875rem; color: rgba(255, 255, 255, 0.36); }
  .jc-mail { display: inline-flex; align-items: center; gap: 10px; width: fit-content; font-size: clamp(1.1rem, 2vw, 1.5rem); color: #fff; text-decoration: none; border-bottom: 1px solid rgba(var(--cc), 0.6); padding-bottom: 6px; }
  .jc-mail:hover { color: rgb(var(--cc)); }
  .jc-links { margin: 0; display: flex; flex-wrap: wrap; gap: 18px; font-size: 0.875rem; }
  .jc-links a { display: inline-flex; align-items: center; gap: 4px; color: rgba(255, 255, 255, 0.7); text-decoration: none; }
  .jc-links a:hover { color: #fff; }

  @media (max-width: 1023px) {
    .journey-index { display: none; }
    .journey-rail { top: 160px; bottom: 120px; right: 14px; }
    .jr-label { display: none; }
  }
  @media (max-width: 640px) {
    /* phones: the ship holds the upper half, the words always sit below */
    .jc[data-side="right"] { right: auto; left: 16px; }
    .jc[data-v="top"] { top: auto; bottom: 28px; }
    .jc { translate: none; }
    .journey-count { top: 84px; }
    .jc { left: 16px; width: calc(100% - 44px); bottom: 28px; gap: 14px; }
    .jc-title { font-size: clamp(2.2rem, 10.5vw, 3rem); }
    .jc-stats { gap: 14px 18px; }
    .jc-stats b { font-size: 1.9rem; }
    .jc-cards, .jc-cards.is-three { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 8px; margin-right: -16px; padding-right: 16px; scrollbar-width: none; perspective: none; }
    .jc-cards li { flex: 0 0 62%; scroll-snap-align: start; }
