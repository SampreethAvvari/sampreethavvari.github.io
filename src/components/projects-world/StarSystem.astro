---
// The Projects tab as one live star system. One stage stays pinned while the
// page scrolls and a 3D scene (src/scripts/projects-world) flies the camera
// through it, and it stays pinned behind the cards that come after the flight
// (the slot), so there is no edge between them. All the words and links are
// real HTML here: without WebGL, or before the scene loads, the same articles
// read as plain cards.
import Icon from "../common/Icon.astro";

export interface PartView { key: string; value: string; label: string }
export interface WorldView {
  id: string;
  anchor: string;
  name: string[];
  title: string;
  accent: string;
  line: string;
  kicker: string;
  hero?: { value: string; label: string };
  shown: number;
  parts: PartView[];
  post: string | null;
  demo: string | null;
  link: string | null;
}
export interface BodyView { id: string; title: string; value: string; label: string; href: string; line: string; status: string }
export interface StarView { title: string; value: string; label: string; href: string }

interface Props {
  worlds: WorldView[];
  bodies: BodyView[];
  star: StarView;
  total: number;
  live: number;
}
const { worlds, bodies, star, total, live } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
// Screens of scroll for each stage; path.ts holds the same list for the camera.
const SPANS = [2.1, ...worlds.map(() => 3.6), 8.5];
const sum = SPANS.reduce((a, b) => a + b, 0);
const stageTop = (i: number) => SPANS.slice(0, i).reduce((a, b) => a + b, 0);
---

<div
  id="worlds"
  class="pw"
  data-pw
  data-spans={JSON.stringify(SPANS)}
  data-worlds={JSON.stringify(worlds.map((w) => ({ id: w.id, title: w.title, accent: w.accent, post: w.post, shown: w.shown, parts: w.parts })))}
  data-bodies={JSON.stringify(bodies.map((b) => ({ id: b.id, href: b.href, title: b.title, value: b.value, label: b.label })))}
  data-star={JSON.stringify(star)}
  style={`--pw-total:${sum};`}
>
  <script is:inline>
    (function () {
      var el = document.querySelector("[data-pw]");
      if (!el) return;
      // Asked once a visit: making a context to ask stops the page for a moment.
      try {
        if (sessionStorage.getItem("gl2") === "1") {
          el.classList.add("is-live");
          return;
        }
      } catch (e) {}
      try {
        var c = document.createElement("canvas");
        var g = c.getContext("webgl2");
        if (g) {
          el.classList.add("is-live");
          var x = g.getExtension("WEBGL_lose_context");
          if (x) x.loseContext();
          try { sessionStorage.setItem("gl2", "1"); } catch (e) {}
        }
      } catch (e) {}
    })();
  </script>

  <section class="pw-stage" data-pw-stage aria-label="Projects, as a star system">
    <div class="pw-sky" aria-hidden="true"></div>
    <canvas class="pw-canvas" aria-hidden="true"></canvas>
    <div class="pw-shade" aria-hidden="true"></div>
    <svg class="pw-lines" aria-hidden="true"></svg>

    <div class="pw-ui">
      <!-- the first screen -->
      <header class="pw-hero" data-pw-hero>
        <p class="pw-kick"><span class="pw-kick-dot"></span>Projects · {total} of them, {live} live in production</p>
        <h1 class="pw-h1">Things I've built.</h1>
        <p class="pw-tail">Most of them run at a dental practice.</p>
              </header>

      <!-- one real link per world. On the first screen each is pinned to its
           world; later they become a small index on the right edge. -->
      <nav class="pw-pins" aria-label="Worlds in this system" data-pw-pins>
        <ol>
          {worlds.map((w, i) => (
            <li>
              <a class="pw-pin" href={`#${w.anchor}`} data-pin={i} data-go={i + 1}>
                <span class="pw-pin-in"><i class="pw-pin-dot"></i><b>{pad(i + 1)}</b><span class="pw-pin-name">{w.name.join(" ")}</span></span>
              </a>
            </li>
          ))}
          <li>
            <a class="pw-pin pw-pin-star" href={star.href} data-pin-star>
              <span class="pw-pin-in"><i class="pw-pin-dot"></i><span class="pw-pin-name">{star.title}</span><em>{star.value}</em></span>
            </a>
          </li>
        </ol>
      </nav>

      <!-- the worlds -->
      {worlds.map((w, i) => (
        <article class={`pw-w pw-${w.id}`} data-pane={i + 1} data-w={w.id} style={`--a:${w.accent};`}>
          <div class="pw-a">
            <p class="pw-kick pw-a-kick"><b>{pad(i + 1)}</b><i></i>{w.kicker}</p>
            {w.hero && <p class="pw-hero-num"><b>{w.hero.value}</b><span>{w.hero.label}</span></p>}
            <h2 class="pw-title">
              {w.post ? (
                <a href={w.post} data-open>{w.name.map((n, k) => <><span>{n}</span>{k < w.name.length - 1 ? " " : ""}</>)}</a>
              ) : (
                w.name.map((n) => <span>{n}</span>)
              )}
            </h2>
            <p class="pw-line">{w.line}</p>
            <div class="pw-acts">
              {w.post && (
                <a href={w.post} class="jb is-solid">
                  <span>Read the write up</span><i class="jb-arrow"><Icon name="arrow-right" size={13} /></i>
                </a>
              )}
              {w.demo && (
                <a href={w.demo} class="jb">
                  <span>Live demo</span><i class="jb-arrow"><Icon name="arrow-right" size={13} /></i>
                </a>
              )}
              {w.link && (
                <a href={w.link} class="jb is-ghost" target="_blank" rel="noopener">
                  <span>GitHub</span><i class="jb-arrow"><Icon name="arrow-up-right" size={13} /></i>
                </a>
              )}
            </div>
          </div>
          <ul class="pw-b" aria-label={`${w.name.join(" ")} in numbers`}>
            {w.parts.map((p, k) => (
              <li class={k < w.shown ? "pw-c" : "pw-c is-extra"} data-part={k}>
                <button type="button" data-part-btn={k}>
                  <b>{p.value}</b>
                  <span>{p.label}</span>
                </button>
              </li>
            ))}
          </ul>
        </article>
      ))}

      <!-- the belt -->
      <div class="pw-beltcopy" data-pane={worlds.length + 1}>
        <p class="pw-kick"><b>{bodies.length}</b><i></i>More, in the belt</p>
        <p class="pw-belttitle">The rest of the system.</p>
        <p class="pw-line">Each one shaped by what it does. Click to open.</p>
        <a class="jb is-ghost pw-beltskip" href="#all"><span>Every project in cards</span><i class="jb-arrow"><Icon name="arrow-right" size={13} /></i></a>
      </div>
      <nav class="pw-bodies" aria-label="More projects, in the belt" data-pw-bodies>
        <ol>
          {bodies.map((b, i) => (
            <li>
              <a class="pw-body" href={b.href} data-body={i}>
                <span class="pw-body-name">{b.title}</span>
                <span class="pw-body-more"><b>{b.value}</b> {b.label}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <!-- where you are -->
      <p class="pw-count" aria-hidden="true" data-pw-count><b>00</b><i>/</i><span>{pad(worlds.length)}</span></p>
      <a class="pw-top" href="#worlds" data-go="0"><span>The whole system</span></a>
      <a class="pw-skip" href="#all"><span>Skip to all {total} projects</span></a>
      <p class="pw-hint" data-pw-hint><span>Scroll to fly</span><i>·</i><span class="pw-hint-d">Drag to turn the system</span><i class="pw-hint-d">·</i><span class="pw-hint-mouse">Click a world to go there</span><span class="pw-hint-touch">Tap a world to go there</span></p>
      <div class="pw-tip" data-pw-tip aria-hidden="true"><b></b><span></span></div>
    </div>
  </section>

  <!-- the scroll of the flight, with one anchor per stage for links and the index -->
  <div class="pw-flight" data-pw-flight>
    {worlds.map((w, i) => <span class="pw-anchor" id={w.anchor} style={`top:calc(${stageTop(i + 1) + 3.6 * 0.3} * 100svh)`}></span>)}
  </div>

  <!-- the cards, over the same stage -->
  <slot />
</div>

<noscript><style>.pw { height: auto !important; } .pw-stage { position: static !important; height: auto !important; }</style></noscript>

<style is:global>
  /* The site's left gauge and top button would sit on the scene. */
  html.pw-live .orbit { opacity: 0 !important; pointer-events: none; transition: opacity 0.4s ease; }
  html.in-pw:not([data-pw-cards]) .to-top { opacity: 0 !important; pointer-events: none !important; }
  /* on a phone the chat button would sit on the numbers; it is back on the first screen and at the cards */
  @media (max-width: 899px) { html.in-pw[data-pw-touring] .chat-launcher { opacity: 0 !important; pointer-events: none !important; } }
</style>

<style>
  .pw { --rx: max(104px, calc(var(--gutter) + 64px)); --lx: max(32px, var(--gutter)); }
  /* ---- without the scene: plain cards in the page's flow ---- */
  .pw { position: relative; background: #020306; }
  .pw-stage { position: relative; }
  .pw-sky, .pw-canvas, .pw-shade, .pw-lines, .pw-pins, .pw-bodies, .pw-count, .pw-top, .pw-tip, .pw-skip, .pw-flight { display: none; }
  .pw-ui { display: grid; gap: 16px; padding: clamp(124px, 13vw, 168px) var(--gutter) 48px; max-width: calc(var(--max, 1200px) + 2 * var(--gutter)); margin-inline: auto; }
  .pw-w, .pw-beltcopy { display: grid; gap: 16px; padding: 24px; border: 1px solid var(--line); border-radius: 18px; background: rgba(255, 255, 255, 0.03); }
  .pw-hero { padding-bottom: 24px; }

  /* type, used by both versions */
  .pw-h1 { margin: 16px 0 0; font-size: clamp(3rem, 8vw, 7rem); font-weight: 300; letter-spacing: -0.05em; line-height: 0.96; color: #fff; }
  .pw-tail { margin: 12px 0 0; font-size: clamp(1.05rem, 1.7vw, 1.5rem); font-weight: 300; letter-spacing: -0.015em; line-height: 1.25; color: rgba(255, 255, 255, 0.72); }
  .pw-kick { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 0.8125rem; font-variant-numeric: tabular-nums; color: rgba(255, 255, 255, 0.7); }
  .pw-kick b { font-weight: 500; color: #5b8def; }
  .pw-kick i { width: 40px; height: 1px; background: linear-gradient(90deg, #5b8def, rgba(91, 141, 239, 0.1)); }
  .pw-kick-dot { width: 7px; height: 7px; border-radius: 50%; background: #5b8def; box-shadow: 0 0 12px #5b8def; }
  .pw-hint { flex-wrap: wrap; align-items: center; gap: 8px; font-size: 0.75rem; letter-spacing: 0.01em; color: rgba(255, 255, 255, 0.55); }
  .pw-hint i { font-style: normal; opacity: 0.6; }
  .pw-title { margin: 0; font-weight: 300; font-size: clamp(2.6rem, 6.6vw, 7rem); letter-spacing: -0.052em; line-height: 0.96; color: #fff; }
  .pw-title span { display: block; }
  .pw-title a { color: inherit; text-decoration: none; }
  .pw-line { margin: 0; max-width: 28rem; font-size: clamp(0.9375rem, 1.1vw, 1.0625rem); line-height: 1.5; color: rgba(255, 255, 255, 0.74); }
  .pw-hero-num { margin: 0; display: grid; gap: 4px; }
  .pw-hero-num b { font-size: clamp(3.4rem, 10vw, 11rem); font-weight: 200; letter-spacing: -0.06em; line-height: 0.9; color: #fff; font-variant-numeric: tabular-nums; }
  .pw-hero-num span { font-size: 0.875rem; color: rgba(255, 255, 255, 0.68); }
  .pw-a { display: grid; gap: 16px; justify-items: start; }
  .pw-acts { display: flex; flex-wrap: wrap; gap: 8px; }
  .pw-b { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px 24px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
  .pw-c button { all: unset; display: grid; gap: 4px; cursor: default; }
  .pw-c b { text-wrap: balance; font-size: clamp(1.5rem, 2.4vw, 2.5rem); font-weight: 300; letter-spacing: -0.035em; line-height: 1.04; color: #fff; font-variant-numeric: tabular-nums; }
  .pw-c span { font-size: 0.8125rem; line-height: 1.4; color: rgba(255, 255, 255, 0.66); }
  .pw-c button:focus-visible { outline: 1.5px solid #5b8def; outline-offset: 4px; border-radius: 4px; }
  .pw-belttitle { margin: 0; font-size: clamp(2.2rem, 5vw, 4.6rem); font-weight: 300; letter-spacing: -0.045em; line-height: 1; color: #fff; }

  /* the flight's button, the same one the home page uses */
  .jb {
    --cc: 91, 141, 239;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 8px 0 18px;
    border-radius: 9999px;
    border: 1px solid rgba(var(--cc), 0.42);
    background: linear-gradient(180deg, rgba(var(--cc), 0.16), rgba(var(--cc), 0.03));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .jb::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.22) 48%, transparent 66%); transform: translateX(-120%); transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .jb:hover { border-color: rgba(var(--cc), 0.85); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 0 26px -6px rgba(var(--cc), 0.8); }
  .jb:hover::before { transform: translateX(120%); }
  .jb:active { transform: scale(0.97); }
  .jb:focus-visible { outline: 1.5px solid rgb(var(--cc)); outline-offset: 3px; }
  .jb-arrow { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: rgba(255, 255, 255, 0.1); font-style: normal; transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.3s ease; }
  .jb:hover .jb-arrow { transform: translateX(3px); background: rgba(var(--cc), 0.35); }
  .jb.is-solid { color: #04060b; border-color: transparent; background: linear-gradient(180deg, #fff, rgba(var(--cc), 0.95)); box-shadow: 0 8px 26px -10px rgba(var(--cc), 0.9); }
  .jb.is-solid .jb-arrow { background: rgba(4, 6, 11, 0.12); }
  .jb.is-ghost { border-color: rgba(255, 255, 255, 0.16); background: rgba(255, 255, 255, 0.03); }
  .jb.is-ghost:hover { border-color: rgba(255, 255, 255, 0.4); }

  /* ---- the live stage ---- */
  /* The stage is the first thing in the box and the flight's scroll starts level with it. */
  .pw.is-live .pw-flight { display: block; height: calc((var(--pw-total) + 1) * 100svh); margin-top: -100lvh; }
  .pw-anchor { position: absolute; left: 0; width: 1px; height: 1px; pointer-events: none; }
  .pw.is-live .pw-stage { position: sticky; top: 0; height: 100lvh; overflow: hidden; isolation: isolate; background: #020306; touch-action: pan-y; }
  .pw.is-live .pw-sky { display: block; position: absolute; inset: 0; background: radial-gradient(38% 34% at 58% 44%, rgba(91, 141, 239, 0.3), transparent 72%), radial-gradient(70% 50% at 50% 110%, rgba(91, 141, 239, 0.12), transparent 70%), #020306; transition: opacity 1.4s ease; }
  .pw.is-live .pw-canvas { display: block; position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.2s ease; }
  .pw[data-3d] .pw-canvas { opacity: 1; }
  .pw[data-3d] .pw-sky { opacity: 0; }
  .pw.is-live .pw-shade { display: block; position: absolute; inset: 0; pointer-events: none; opacity: var(--shade, 0); transition: opacity 0.6s ease; background: linear-gradient(to top, rgba(2, 3, 6, 0.55), transparent 44%); }
  .pw.is-live .pw-lines { display: block; position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 2; }

  .pw.is-live .pw-ui { display: block; position: absolute; left: 0; right: 0; top: 0; height: 100svh; padding: 0; max-width: none; margin: 0; z-index: 3; pointer-events: none; transition: opacity 0.35s ease; }
  /* Past the flight the stage is only the space behind the cards: its words, pins and lines
     are out of sight, out of the tab order and out of the compositor. All of this hangs on
     attributes and not classes: a changed class makes the browser work out the style of
     everything inside, here the whole page, and that is a long task on a phone. */
  .pw.is-live[data-cards] .pw-ui { opacity: 0; }
  .pw.is-live[data-cards] .pw-lines, .pw.is-live[data-cards] .pw-shade { display: none; }
  .pw.is-live[data-past] .pw-ui { content-visibility: hidden; }
  @supports not (content-visibility: hidden) { .pw.is-live[data-past] .pw-ui { visibility: hidden; } }
  .pw.is-live .pw-ui a, .pw.is-live .pw-ui button { pointer-events: auto; }

  .pw.is-live .pw-hero { position: absolute; left: max(32px, var(--gutter)); top: clamp(88px, 12vh, 112px); padding: 0; max-width: 34rem; transition: opacity 0.6s ease, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  .pw.is-live .pw-hero.is-gone { opacity: 0; transform: translateY(16px); }
  .pw.is-live .pw-h1 { transition: opacity 0.7s ease; }
  .pw.is-live[data-type-on] .pw-h1 { opacity: 0; }
  .pw[data-3d][data-has-type] .pw-h1 { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; margin: 0; }
  .pw[data-3d][data-has-type] .pw-tail { margin-top: 10px; max-width: 22rem; }

  /* panes hide without leaving the tab order: focus brings their world up */
  .pw.is-live .pw-w, .pw.is-live .pw-beltcopy { display: block; position: absolute; inset: 0; padding: 0; border: 0; border-radius: 0; background: none; pointer-events: none; }
  .pw.is-live .pw-a, .pw.is-live .pw-b { position: absolute; opacity: 0; transition: opacity 0.42s ease, transform 0.75s cubic-bezier(0.16, 1, 0.3, 1); will-change: opacity, transform; }
  .pw.is-live .pw-a { transform: translateY(14px); }
  .pw.is-live .pw-a a, .pw.is-live .pw-b button { pointer-events: none; }
  .pw.is-live .pw-w[data-beat="a"] .pw-a { opacity: 1; transform: none; }
  .pw.is-live .pw-w[data-beat="a"] .pw-a a { pointer-events: auto; }
  .pw.is-live .pw-b { inset: 0; display: block; }
  .pw.is-live .pw-w[data-beat="b"] .pw-b { opacity: 1; }
  .pw.is-live .pw-w[data-beat="b"] .pw-b button { pointer-events: auto; }
  .pw.is-live .pw-a:focus-within { opacity: 1; }
  /* a title link holds only its words, so the world behind it can still be dragged */
  .pw.is-live .pw-w[data-beat="a"] .pw-title a { pointer-events: none; }
  .pw.is-live .pw-w[data-beat="a"] .pw-title a span { pointer-events: auto; }
  .pw.is-live .pw-c { position: absolute; width: min(250px, 24vw); }
  .pw.is-live .pw-c:not(.is-extra) { padding: 12px 14px 13px; border-radius: 14px; border: 1px solid rgba(255, 255, 255, 0.09); background: rgba(5, 8, 16, 0.74); transition: border-color 0.25s ease, background-color 0.25s ease; }
  .pw.is-live .pw-c.is-hot { border-color: rgba(91, 141, 239, 0.8) !important; background: rgba(9, 15, 30, 0.82) !important; }
  .pw.is-live .pw-c button { cursor: pointer; }
  .pw.is-live .pw-c b { font-size: clamp(1.55rem, 2.6vw, 2.75rem); transition: color 0.25s ease; }
  .pw.is-live .pw-c span { transition: color 0.25s ease; }
  .pw.is-live .pw-c.is-hot b { color: #9ec1ff; }
  .pw.is-live .pw-c.is-hot span { color: #fff; }
  .pw.is-live .pw-c.is-extra { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .pw.is-live .pw-c.is-extra:focus-within { width: auto; height: auto; clip-path: none; overflow: visible; left: 50%; bottom: 8%; }
  .pw.is-live .pw-line { text-shadow: 0 1px 14px rgba(0, 0, 0, 0.8); }
  .pw.is-live .pw-title, .pw.is-live .pw-hero-num { translate: calc(var(--px, 0) * -9px) calc(var(--py, 0) * -6px); }
  .pw.is-live .pw-kick { translate: calc(var(--px, 0) * -4px) calc(var(--py, 0) * -3px); }
  .pw.is-live .pw-title { text-shadow: 0 2px 30px rgba(2, 3, 6, 0.35); }

  /* pins and the index */
  .pw.is-live .pw-pins { display: block; position: absolute; inset: 0; pointer-events: none; }
  .pw-pins ol { list-style: none; margin: 0; padding: 0; }
  .pw-pin { position: absolute; left: 0; top: 0; display: block; color: #fff; text-decoration: none; will-change: transform, opacity; opacity: 0; }
  .pw-pin-in { display: inline-flex; align-items: center; gap: 8px; min-height: 28px; white-space: nowrap; transform: translateX(calc(var(--flip, 0) * -100%)); }
  .pw-pin-dot { order: 0; width: 7px; height: 7px; border-radius: 50%; background: #fff; box-shadow: 0 0 10px rgba(156, 196, 255, 0.95); transition: transform 0.2s ease, background-color 0.2s ease; flex: none; }
  .pw-pin b { font-size: 0.6875rem; font-weight: 500; color: #8fb2f5; font-variant-numeric: tabular-nums; }
  .pw-pin-name { font-size: 0.8125rem; font-weight: 400; letter-spacing: -0.003em; color: rgba(255, 255, 255, 0.88); text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9); transition: color 0.2s ease; }
  .pw-pin em { font-style: normal; font-size: 0.75rem; color: rgba(255, 255, 255, 0.58); }
  .pw-pin:hover .pw-pin-dot, .pw-pin.is-hot .pw-pin-dot, .pw-pin:focus-visible .pw-pin-dot { transform: scale(1.6); background: #5b8def; }
  .pw-pin:hover .pw-pin-name, .pw-pin.is-hot .pw-pin-name { color: #fff; }
  .pw-pin:focus-visible { outline: 1.5px solid #5b8def; outline-offset: 3px; border-radius: 6px; }
  .pw-pin.is-flip .pw-pin-in { flex-direction: row-reverse; }
  /* on the right edge: dots, with the name only where you are or where you point */
  .pw-pin.is-rail .pw-pin-name, .pw-pin.is-rail b { opacity: 0; transition: opacity 0.25s ease; }
  .pw-pin.is-rail { opacity: 1; }
  .pw-pin.is-rail:hover .pw-pin-name, .pw-pin.is-rail:hover b, .pw-pin.is-rail:focus-visible .pw-pin-name, .pw-pin.is-rail:focus-visible b { opacity: 1; }
