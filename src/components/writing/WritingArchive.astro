---
// Everything after the six case studies, as a star map: every post is a
// small glowing card, and posts that share a tag gather into one
// constellation, its line drawn in the order they were written. Search,
// tag, year and kind of work filters move the cards to their new places;
// hover or focus brings a card forward with its art in depth; a click
// flies into it. Drag to move around, the buttons or ctrl and scroll to
// zoom. "List view" shows the same posts as a plain grid, which is also
// what renders before the script runs, on phones by default, and with
// reduced motion.
import Icon from "../common/Icon.astro";
import Picture from "../common/Picture.astro";
import type { ArchivePost } from "./types";
import type { TeachingMaterial } from "../../data/teaching";
import { hasPublic } from "../../utils/postTopics";

interface Props {
  posts: ArchivePost[];
  guides: TeachingMaterial[];
}
const { posts, guides } = Astro.props;

const kinds = [
  { key: "all", label: "All", title: "Every kind of work" },
  { key: "aie", label: "AIE", title: "AI engineering" },
  { key: "mle", label: "MLE", title: "Machine learning engineering" },
  { key: "fde", label: "FDE", title: "Working on site with the people who use it" },
  { key: "sde", label: "SDE", title: "Software engineering" },
];
const years = [...new Set(posts.map((p) => p.year))].sort((a, b) => b.localeCompare(a));
const tagCounts = new Map<string, number>();
for (const p of posts) tagCounts.set(p.tag, (tagCounts.get(p.tag) || 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

// Reading time as a ring: a full ring is ten minutes or more.
const ringOf = (m: number) => Math.min(1, m / 10).toFixed(3);
const RING = 2 * Math.PI * 9;

const WRITING_RGB = "52,211,153";
const comets = [
  { w: 130, top: "4%", pos: "left:3%", rz: 12 },
  { w: 112, top: "36%", pos: "right:2%", rz: -12 },
  { w: 106, top: "80%", pos: "right:28%", rz: -16 },
];
---

<section class="ax" id="every-post" aria-labelledby="ax-title" data-view="list">
  <div class="ax-horizon" aria-hidden="true"><span class="ax-planet"></span><span class="ax-haze"></span></div>
  {comets.map((c) => (
    <span class="space-el" style={`width:${c.w}px;height:${Math.round(c.w * 0.27)}px;top:${c.top};${c.pos};`} aria-hidden="true"><span class="comet-glow" style={`--sr-rgb:${WRITING_RGB};`}></span><span class="space-comet" style={`--sr-rgb:${WRITING_RGB};--rz:${c.rz}deg;`}></span></span>
  ))}

  <div class="wrap on-top ax-head">
    <p class="kicker">Every post</p>
    <h2 class="t-h2 ax-h2" id="ax-title">
      A map of everything I wrote.
      <span class="t-tail">Posts that share a tag form one constellation.</span>
    </h2>
  </div>

  <!-- Controls: one dock for both views. -->
  <div class="wrap on-top ax-dock-wrap">
    <div class="ax-dock" role="group" aria-label="Find posts">
      <label class="lg ax-search">
        <Icon name="search" size={15} />
        <span class="sr-only">Search posts</span>
        <input id="ax-q" type="search" placeholder="Search titles and summaries" autocomplete="off" spellcheck="false" />
      </label>
      <div class="lg ax-bar" role="group" aria-label="Kind of work">
        {kinds.map((f) => (
          <button type="button" class={`chip ax-kind ${f.key === "all" ? "is-on" : ""}`} data-kind={f.key} aria-pressed={f.key === "all" ? "true" : "false"} title={f.title}>{f.label}</button>
        ))}
      </div>
      <div class="lg ax-bar" role="group" aria-label="Year">
        <button type="button" class="chip ax-year is-on" data-year="all" aria-pressed="true">Any year</button>
        {years.map((y) => (
          <button type="button" class="chip ax-year" data-year={y} aria-pressed="false">{y}</button>
        ))}
      </div>
      <div class="lg ax-bar" role="group" aria-label="Order">
        <button type="button" class="chip ax-sort is-on" data-sort="date" aria-pressed="true">Newest</button>
        <button type="button" class="chip ax-sort" data-sort="impact" aria-pressed="false" title="Larger on the map, first in the list">Impact</button>
      </div>
      <div class="lg ax-bar ax-views" role="group" aria-label="View">
        <button type="button" class="chip ax-view" data-view="map" aria-pressed="false">Map</button>
        <button type="button" class="chip ax-view is-on" data-view="list" aria-pressed="true">List view</button>
      </div>
    </div>
    <div class="ax-tags" role="group" aria-label="Tag">
      <button type="button" class="ax-tag is-on" data-tag="all" aria-pressed="true">All tags <span>{posts.length}</span></button>
      {tags.map(([t, c]) => (
        <button type="button" class="ax-tag" data-tag={t} aria-pressed="false">{t} <span>{c}</span></button>
      ))}
    </div>
    <p class="ax-status">
      <span class="t-meta" id="ax-count" aria-live="polite">{posts.length} posts</span>
      <span id="ax-impact-note" class="t-meta ax-note" hidden>Ranked by how much the project behind each one moved the company.</span>
    </p>
  </div>

  <!-- The map. Cards are real links in date order; the script places them. -->
  <div class="ax-map" id="ax-map" role="region" aria-label="Map of every post, grouped by tag" tabindex="-1">
    <div class="ax-glows" aria-hidden="true">
      {tags.map(([t]) => <span class="ax-glow" data-tag={t}></span>)}
    </div>
    <svg class="ax-lines" aria-hidden="true">
      <defs>
        <linearGradient id="ax-line-g" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color={`rgb(${WRITING_RGB})`} stop-opacity="0.15" />
          <stop offset="0.5" stop-color={`rgb(${WRITING_RGB})`} stop-opacity="0.55" />
          <stop offset="1" stop-color={`rgb(${WRITING_RGB})`} stop-opacity="0.15" />
        </linearGradient>
      </defs>
      {tags.map(([t]) => <path class="ax-line" data-tag={t} d="" />)}
    </svg>
    <div class="ax-names">
      {tags.map(([t, c]) => (
        <button type="button" class="ax-name" data-tag={t} aria-label={`Zoom in on ${t}, ${c} posts`}>
          <span class="ax-name-dot" aria-hidden="true"></span>{t}<span class="ax-name-n">{c}</span>
        </button>
      ))}
    </div>
    <ul class="ax-stars" role="list" aria-label="Every post">
      {posts.map((p) => (
        <li
          class="ax-star"
          data-slug={p.slug}
          data-tag={p.tag}
          data-year={p.year}
          data-dx={p.dx.join(" ")}
          data-date={p.time}
          data-impact={p.impact}
          data-featured={p.featured ? "1" : undefined}
          data-q={`${p.title} ${p.description} ${p.tag}`.toLowerCase()}
        >
          <a class="ax-node" href={p.url}>
            <span class="ax-node-dot" aria-hidden="true"></span>
            <span class="ax-node-art" aria-hidden="true">
              {p.thumb ? (
                <picture>
                  <source srcset={`${p.thumb}.avif`} type="image/avif" />
                  <img class="ax-node-img" src={`${p.thumb}.webp`} alt="" width="560" height="315" loading="lazy" decoding="async" />
                </picture>
              ) : (
                <span class="ax-node-fallback">{p.fallback}</span>
              )}
              <span class="ax-node-glint"></span>
              {p.featured && <span class="ax-node-badge">Case study</span>}
            </span>
            <span class="ax-node-body">
              <span class="ax-node-title">{p.title}</span>
              <span class="ax-node-meta">
                <svg class="ax-ring" viewBox="0 0 24 24" aria-hidden="true" style={`--p:${ringOf(p.minutes)};`}>
                  <circle cx="12" cy="12" r="9" class="ax-ring-bg" />
                  <circle cx="12" cy="12" r="9" class="ax-ring-fg" stroke-dasharray={`${(Number(ringOf(p.minutes)) * RING).toFixed(2)} ${RING.toFixed(2)}`} />
                </svg>
                <span>{p.minutes} min · {p.date}</span>
              </span>
              <span class="ax-node-desc">{p.description}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <div class="ax-zoom" role="group" aria-label="Zoom the map">
      <button type="button" class="lg ax-zbtn" data-zoom="in" aria-label="Zoom in">+</button>
      <button type="button" class="lg ax-zbtn" data-zoom="out" aria-label="Zoom out">&minus;</button>
      <button type="button" class="lg ax-zbtn ax-zfit" data-zoom="fit" aria-label="Show the whole map">Fit</button>
    </div>
    <button type="button" class="lg ax-back" hidden>Back to the whole map</button>
    <p class="ax-hint" aria-hidden="true">Click a constellation's name to zoom in · ctrl and scroll to zoom</p>
  </div>

  <!-- List view: the same posts as a grid. -->
  <div class="wrap on-top ax-listwrap">
    <ul id="ax-grid" class="ax-grid" role="list" aria-label="All posts">
      {posts.map((p) => (
        <li
          class="ax-slot"
          data-slug={p.slug}
          data-tag={p.tag}
          data-year={p.year}
          data-date={p.time}
          data-impact={p.impact}
          data-dx={p.dx.join(" ")}
          data-featured={p.featured ? "1" : undefined}
          data-q={`${p.title} ${p.description} ${p.tag}`.toLowerCase()}
          hidden={p.featured ? true : undefined}
        >
          <a href={p.url} class="ax-card">
            <span class="ax-light" aria-hidden="true"></span>
            <div class="ax-media">
              {p.img ? (
                <Picture src={p.img} alt={p.alt} width={640} height={360} />
              ) : (
                <div class="ax-fallback" aria-hidden="true">
                  <span>{p.fallback}</span>
                </div>
              )}
            </div>
            <div class="ax-body">
              <p class="ax-meta">
                <svg class="ax-ring" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" class="ax-ring-bg" />
                  <circle cx="12" cy="12" r="9" class="ax-ring-fg" stroke-dasharray={`${(Number(ringOf(p.minutes)) * RING).toFixed(2)} ${RING.toFixed(2)}`} />
                </svg>
                {p.date} · {p.minutes} min read
              </p>
              <h3 class="ax-title">{p.title}</h3>
              <p class="ax-desc">{p.description}</p>
              <span class="ax-go" aria-hidden="true">Read <Icon name="arrow-right" size={13} /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <p id="ax-empty" class="wrap on-top t-body ax-empty" hidden>No posts match. Try another tag, year or search.</p>

  <!-- Teaching: guides I wrote, kept beside the posts -->
  <div id="teaching" class="wrap on-top ax-teach" aria-labelledby="ax-teach-title" role="region">
    <div class="sec-head">
      <div class="sec-head-main">
        <p class="kicker">Teaching</p>
        <h2 class="t-h2" id="ax-teach-title">
          Guides I wrote.
          <span class="t-tail">Free PDFs for engineers who ship AI.</span>
        </h2>
      </div>
      <a href="/teaching" class="tlink">All materials <Icon name="arrow-right" size={14} /></a>
    </div>
    <div class="ax-teach-grid">
      {guides.map((g) => (
        <a href={`/teaching/${g.slug}`} class="ax-guide">
          <span class="ax-light" aria-hidden="true"></span>
          <div class="ax-guide-cover">
            {hasPublic(g.cover) ? (
              <Picture src={g.cover} alt={g.title} width={360} height={460} />
            ) : (
              <div class="ax-fallback" aria-hidden="true"></div>
            )}
          </div>
          <div class="ax-guide-body">
            <span class="badge">{g.pages ? `PDF · ${g.pages} pages` : "PDF"}</span>
            <h3 class="t-h3 ax-guide-title">{g.title}</h3>
            <p class="t-small ax-guide-desc">{g.description}</p>
            <span class="tlink ax-guide-go">Read it <Icon name="arrow-right" size={14} /></span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ax {
    position: relative;
    z-index: 1;
    padding-top: clamp(120px, 16vw, 220px);
    overflow-x: clip;
  }

  /* The horizon: the rim of a dark planet catching the writing colour,
     right where the case studies end. */
  .ax-horizon {
    position: absolute;
    left: 50%;
    top: 0;
    width: 100%;
    height: clamp(420px, 52vw, 760px);
    transform: translateX(-50%);
    pointer-events: none;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
  }
  .ax-planet {
    position: absolute;
    left: 50%;
    top: clamp(70px, 9vw, 130px);
    width: max(220vw, 2400px);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, #010204 97%, rgba(1, 2, 4, 0) 100%);
    box-shadow:
      0 0 0 1px rgba(var(--c-writing-rgb), 0.55),
      0 -2px 18px rgba(var(--c-writing-rgb), 0.6),
      0 -20px 90px rgba(var(--c-writing-rgb), 0.28),
      0 -60px 220px rgba(var(--c-writing-rgb), 0.16),
      inset 0 18px 60px -30px rgba(var(--c-writing-rgb), 0.5);
  }
  .ax-haze {
    position: absolute;
    left: 50%;
    top: 0;
    width: min(1400px, 120vw);
    height: clamp(200px, 24vw, 340px);
    transform: translateX(-50%);
    background: radial-gradient(50% 60% at 50% 70%, rgba(var(--c-writing-rgb), 0.16), rgba(var(--c-writing-rgb), 0) 70%);
  }

  .ax-head { position: relative; }
  .ax-h2 { margin-top: 18px; max-width: 20ch; }

  /* ---------------- Controls ---------------- */
  .ax-dock-wrap { position: relative; z-index: 5; margin-top: clamp(28px, 3.5vw, 40px); }
  .ax-dock { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .ax-search {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px;
    border-radius: 9999px;
    color: var(--ink-faint);
    flex: 1 1 220px;
    max-width: 300px;
  }
  .ax-search input {
    flex: 1;
    min-width: 0;
    height: 100%;
    background: transparent;
    border: 0;
    outline: none;
    color: var(--ink);
    font: inherit;
    font-size: 0.875rem;
  }
  .ax-search input::placeholder { color: rgba(245, 245, 247, 0.4); }
  .ax-search:focus-within { box-shadow: 0 0 0 3px rgba(var(--c-writing-rgb), 0.4); }
  .ax-bar { display: inline-flex; align-items: center; gap: 4px; padding: 5px; border-radius: 9999px; }
  .ax-bar .chip { cursor: pointer; background: transparent; border-color: transparent; }
  .ax-bar .chip:not(.is-on):hover { background: var(--wash-strong); border-color: transparent; }
  .ax-bar .chip.is-on { color: #000; background: var(--ink); border-color: var(--ink); }
  .ax-bar .chip:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--c-writing-rgb), 0.5); }
  .ax-tags { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px; }
  .ax-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding: 0 12px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    color: var(--ink-soft);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 150ms var(--ease-glass), border-color 150ms var(--ease-glass), background-color 150ms var(--ease-glass), box-shadow 250ms var(--ease-glass);
  }
  .ax-tag span { color: rgba(245, 245, 247, 0.4); font-variant-numeric: tabular-nums; }
  .ax-tag:hover { color: var(--ink); border-color: rgba(255, 255, 255, 0.2); }
  .ax-tag.is-on {
    color: var(--ink);
    border-color: rgba(var(--c-writing-rgb), 0.6);
    background: rgba(var(--c-writing-rgb), 0.12);
    box-shadow: 0 0 18px -6px rgba(var(--c-writing-rgb), 0.7);
  }
  .ax-tag.is-on span { color: rgba(var(--c-writing-rgb), 0.9); }
  .ax-tag:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--c-writing-rgb), 0.5); }
  .ax-status { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px 16px; }

  /* ---------------- The map ---------------- */
  .ax-map { display: none; }
  .ax[data-view="map"] .ax-map {
    display: block;
    position: relative;
    z-index: 2;
    height: 100vh;
    height: 100svh;
    min-height: 640px;
    margin-top: 18px;
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    outline: none;
    background: radial-gradient(42% 38% at 50% 55%, rgba(var(--c-writing-rgb), 0.07), rgba(var(--c-writing-rgb), 0) 100%);
  }
  .ax[data-view="map"] .ax-map.is-dragging { cursor: grabbing; }
  .ax[data-view="map"] .ax-listwrap { display: none; }

  .ax-glows, .ax-lines, .ax-names, .ax-stars { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .ax-lines { width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .ax-line {
    fill: none;
    stroke: url(#ax-line-g);
    stroke: rgba(var(--c-writing-rgb), 0.5);
    stroke-width: 1;
    stroke-dasharray: none;
    stroke-linecap: round;
    transition: opacity 500ms var(--ease-glass);
    filter: drop-shadow(0 0 4px rgba(var(--c-writing-rgb), 0.7));
  }
  .ax-line.is-off { opacity: 0; }
  .ax-glows { pointer-events: none; }
  .ax-glow {
    position: absolute;
    left: 0;
    top: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(var(--c-writing-rgb), 0.22), rgba(var(--c-writing-rgb), 0.08) 45%, rgba(var(--c-writing-rgb), 0) 100%);
    transition: opacity 600ms var(--ease-glass);
    will-change: transform;
  }
  .ax-glow.is-off { opacity: 0; }
  .ax-names { pointer-events: none; z-index: 3; }
  .ax-stars { z-index: 2; }
  .ax-name {
    position: absolute;
    left: 0;
    top: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 26px;
    padding: 0 10px 0 8px;
    border-radius: 9999px;
    border: 1px solid rgba(var(--c-writing-rgb), 0.28);
    background: rgba(3, 8, 7, 0.72);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    cursor: pointer;
    pointer-events: auto;
    transition: opacity 400ms var(--ease-glass), border-color 200ms var(--ease-glass), box-shadow 300ms var(--ease-glass);
    will-change: transform;
  }
  .ax-name:hover, .ax-name.is-on { border-color: rgba(var(--c-writing-rgb), 0.8); box-shadow: 0 0 22px -6px rgba(var(--c-writing-rgb), 0.9); }
  .ax-name:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--c-writing-rgb), 0.55); }
  .ax-name.is-off { opacity: 0; pointer-events: none; }
  .ax-name-dot { width: 6px; height: 6px; border-radius: 50%; background: rgb(var(--c-writing-rgb)); box-shadow: 0 0 10px rgba(var(--c-writing-rgb), 0.9); }
  .ax-name-n { color: rgba(var(--c-writing-rgb), 0.9); font-variant-numeric: tabular-nums; }

  .ax-star {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
    opacity: 0;
    transition: opacity 500ms var(--ease-glass);
    will-change: transform;
  }
  .ax-map.is-live .ax-star { opacity: 1; }
  .ax-map.is-live .ax-star.is-out { opacity: 0; visibility: hidden; transition: opacity 400ms var(--ease-glass), visibility 0s linear 400ms; }
  .ax-star.is-open { z-index: 20; }

  .ax-node {
    --px: 0;
    --py: 0;
    display: flex;
    flex-direction: column;
    width: 104px;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02) 50%), #06080b;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 0 26px -8px rgba(var(--c-writing-rgb), 0.55),
      0 18px 40px -20px rgba(0, 0, 0, 0.9);
    transform: perspective(700px) rotateX(calc(var(--py) * -9deg)) rotateY(calc(var(--px) * 11deg));
    transition: width 420ms var(--ease-glass), box-shadow 300ms var(--ease-glass), border-color 300ms var(--ease-glass), transform 200ms linear;
  }
  .ax-star[data-featured] .ax-node { border-color: rgba(var(--c-writing-rgb), 0.5); }
  .ax-star.is-open .ax-node {
    width: 300px;
    border-color: rgba(var(--c-writing-rgb), 0.75);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.6),
      0 0 60px -10px rgba(var(--c-writing-rgb), 0.8),
      0 40px 80px -30px rgba(0, 0, 0, 1);
  }
  .ax-node:focus-visible { outline: none; }
  .ax-node-art {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #05070a;
  }
  .ax-node-img {
    position: absolute;
    inset: -8%;
    width: 116%;
    height: 116%;
    object-fit: cover;
    display: block;
    transform: translate3d(calc(var(--px) * -10px), calc(var(--py) * -7px), 0);
    transition: transform 200ms linear, filter 400ms var(--ease-glass);
    filter: saturate(0.9) brightness(0.9);
  }
  .ax-star.is-open .ax-node-img { filter: saturate(1.1) brightness(1.05); }
  /* The second layer: a glint that moves the other way. */
  .ax-node-glint {
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 80% at calc(50% + var(--px) * 40%) calc(40% + var(--py) * 40%), rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 60%);
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 300ms var(--ease-glass);
  }
  .ax-star.is-open .ax-node-glint { opacity: 1; }
  .ax-node-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
