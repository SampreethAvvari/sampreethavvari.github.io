---
// "Connect with me" block shown at the end of every teaching material.
import Picture from "../common/Picture.astro";
import Icon from "../common/Icon.astro";
import { info } from "../../data/info";
const { email, linkedin, github } = info.contact;
---

<section class="tb-brand-sec">
  <div class="wrap">
    <div class="surface tb-brand">
      <div class="tone-atmos tb-brand-wash" aria-hidden="true"></div>
      <div class="on-top tb-brand-grid">
        <div class="tb-brand-id">
          <div class="tb-brand-ava">
            <Picture
              src={info.picture}
              alt={info.picture_alt}
              width={120}
              height={120}
              loading="lazy"
            />
          </div>
          <div class="min-w-0">
            <p class="t-meta">Made by</p>
            <p class="t-h3 tb-brand-name">{info.name}</p>
            <p class="t-small">{info.role} · {info.location}</p>
          </div>
        </div>

        <div class="tb-brand-copy">
          <p class="t-body tb-brand-note">
            If this helped, the best thanks is telling me what to write next. Or just
            say hi.
          </p>
          <div class="tb-brand-links">
            <a class="btn btn-glass btn-sm" href={linkedin} target="_blank" rel="noreferrer">
              <Icon name="linkedin" size={14} /> Connect on LinkedIn
            </a>
            <a class="btn btn-glass btn-sm tb-brand-mail" href={`mailto:${email}`}>
              <Icon name="mail" size={15} /> <span>{email}</span>
            </a>
            <a class="btn btn-glass btn-sm" href={github} target="_blank" rel="noreferrer" aria-label="GitHub">
              <Icon name="github" size={14} /> GitHub
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tb-brand-sec {
    position: relative;
    z-index: 1;
    padding-top: clamp(56px, 7vw, 88px);
    padding-bottom: clamp(56px, 7vw, 96px);
  }
  .tb-brand {
    overflow: hidden;
    padding: 24px;
  }
  @media (min-width: 640px) { .tb-brand { padding: 32px; } }
  .tb-brand-wash { opacity: 0.8; }
  .tb-brand-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .tb-brand-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; }
  }
  .tb-brand-id {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .tb-brand-ava {
    width: 64px;
    height: 64px;
    border-radius: 9999px;
    overflow: hidden;
    flex: none;
    border: 1px solid var(--line-strong);
  }
  /* The portrait is a wide street shot: frame the face. */
  .tb-brand-ava :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 64% 50%;
    transform: translate(-28.6%, 35.7%) scale(2.1);
    display: block;
  }
  .tb-brand-name { margin: 2px 0 2px; }
  .tb-brand-note { max-width: 46ch; font-size: 1rem; }
  .tb-brand-links {
    margin-top: 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  /* Long address: let it shrink on a narrow phone instead of pushing sideways. */
  .tb-brand-mail { max-width: 100%; }
  .tb-brand-mail span { overflow: hidden; text-overflow: ellipsis; }
</style>
