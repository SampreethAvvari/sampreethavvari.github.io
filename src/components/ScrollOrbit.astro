---
// How far down the page you are, drawn as a flight path on the left edge: a
// ringed planet at the top, a star at the bottom, a dotted track between, and
// a comet that rides it as you scroll. Its tail streams behind it and grows
// with your speed, so it points the way you came. Clicking the track flies
// there. Desktop only, and only on pages long enough to need it.
const ticks = Array.from({ length: 11 }, (_, i) => i);
---

<div class="orbit" data-orbit aria-hidden="true">
  <svg class="orbit-planet" viewBox="0 0 24 24" fill="none">
    <circle cx="12" cy="12" r="4.2" />
    <ellipse cx="12" cy="12" rx="10" ry="3.2" transform="rotate(-20 12 12)" />
  </svg>
  <div class="orbit-track" data-orbit-track>
    {ticks.map((t) => <span class:list={["orbit-tick", { "is-major": t % 5 === 0 }]} style={`top:${t * 10}%`}></span>)}
    <span class="orbit-trail" data-orbit-trail></span>
    <span class="orbit-head" data-orbit-head>
      <span class="orbit-tail" data-orbit-tail></span>
      <span class="orbit-dot"></span>
      <span class="orbit-read" data-orbit-read>0</span>
    </span>
  </div>
  <svg class="orbit-star" viewBox="0 0 24 24" fill="currentColor">
    <path d="M12 2.5c.5 4.6 2.4 6.9 7 9.5-4.6 2.6-6.5 4.9-7 9.5-.5-4.6-2.4-6.9-7-9.5 4.6-2.6 6.5-4.9 7-9.5Z" />
  </svg>
</div>

<style>
  .orbit {
    position: fixed;
    left: clamp(14px, 1.8vw, 30px);
    top: 50%;
    z-index: 40;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transform: translateY(-50%);
    color: var(--ink-faint);
    opacity: 0;
    transition: opacity 500ms var(--ease-glass);
  }
  @media (min-width: 1180px) and (pointer: fine) {
    .orbit { display: flex; }
  }
  .orbit.is-ready { opacity: 1; }
  .orbit-planet { width: 18px; height: 18px; stroke: rgba(var(--tone-rgb), 0.85); stroke-width: 1.3; filter: drop-shadow(0 0 6px rgba(var(--tone-rgb), 0.5)); }
  .orbit-star { width: 11px; height: 11px; color: var(--ink-ghost); }
  .orbit.is-end .orbit-star { color: var(--tone); filter: drop-shadow(0 0 6px rgba(var(--tone-rgb), 0.9)); }

  .orbit-track {
    position: relative;
    width: 22px;
    height: min(34vh, 280px);
    cursor: pointer;
    pointer-events: auto;
  }
  .orbit-track::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--line-strong) 12%, var(--line-strong) 88%, transparent);
  }
  .orbit-tick {
    position: absolute;
    left: 50%;
    width: 2px;
    height: 2px;
    margin: -1px 0 0 -1px;
    border-radius: 50%;
    background: var(--ink-ghost);
    transition: background-color 200ms;
  }
  .orbit-tick.is-major { width: 6px; height: 1px; margin: 0 0 0 -3px; border-radius: 0; background: var(--ink-faint); }
  .orbit-track:hover .orbit-tick { background: var(--ink-faint); }

  /* Where you have been glows in the page's colour. */
  .orbit-trail {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1px;
    height: 0;
    transform: translateX(-0.5px);
    background: linear-gradient(180deg, rgba(var(--tone-rgb), 0.05), rgba(var(--tone-rgb), 0.85));
    box-shadow: 0 0 6px rgba(var(--tone-rgb), 0.6);
  }
  .orbit-head { position: absolute; left: 50%; top: 0; width: 0; height: 0; }
  .orbit-dot {
    position: absolute;
    left: -4.5px;
    top: -4.5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 2px rgba(var(--tone-rgb), 0.35), 0 0 12px rgba(var(--tone-rgb), 0.95), 0 0 26px rgba(var(--tone-rgb), 0.55);
  }
  /* The tail streams behind the comet, longer the faster you go. */
  .orbit-tail {
    position: absolute;
    left: -1px;
    width: 2px;
    height: 0;
    border-radius: 2px;
    opacity: 0;
    transition: opacity 300ms;
  }
  .orbit-tail.is-down { bottom: 0; background: linear-gradient(0deg, rgba(var(--tone-rgb), 0.95), transparent); }
  .orbit-tail.is-up { top: 0; background: linear-gradient(180deg, rgba(var(--tone-rgb), 0.95), transparent); }
  .orbit-read {
    position: absolute;
    left: 14px;
    top: -8px;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 16px;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    opacity: 0.55;
    transition: opacity 300ms, color 300ms;
  }
  .orbit-read::after { content: "%"; margin-left: 1px; font-weight: 500; opacity: 0.7; }
  .orbit.is-moving .orbit-read, .orbit-track:hover .orbit-read { opacity: 1; color: var(--ink); }
  @media (prefers-reduced-motion: reduce) {
    .orbit-tail { display: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-orbit]");
  const track = root?.querySelector<HTMLElement>("[data-orbit-track]");
  const head = root?.querySelector<HTMLElement>("[data-orbit-head]");
  const trail = root?.querySelector<HTMLElement>("[data-orbit-trail]");
  const tail = root?.querySelector<HTMLElement>("[data-orbit-tail]");
  const read = root?.querySelector<HTMLElement>("[data-orbit-read]");
  if (root && track && head && trail && tail && read) {
    let last = window.scrollY;
    let speed = 0;
    let shown = -1;
    let idle = 0;
    let raf = 0;
    // The gauge only shows on wide screens with a mouse (the CSS above). On
    // phones it is display: none, so there is nothing to draw.
    const shows = window.matchMedia("(min-width: 1180px) and (pointer: fine)");
    const frame = () => {
      raf = 0;
      if (!shows.matches) {
        // Hidden: keep the scroll position current so the tail does not
        // jump when the window grows wide enough to show the gauge.
        last = window.scrollY;
        speed = 0;
        return;
      }
      const max = document.documentElement.scrollHeight - window.innerHeight;
      // Short pages do not need a gauge.
      root.classList.toggle("is-ready", max > window.innerHeight * 0.6);
      const y = window.scrollY;
      const p = max > 0 ? Math.min(1, Math.max(0, y / max)) : 0;
      const h = track.clientHeight;
      head.style.transform = `translateY(${(p * h).toFixed(1)}px)`;
      trail.style.height = `${(p * h).toFixed(1)}px`;
      // Speed in track pixels a frame, eased so the tail settles smoothly.
      const v = max > 0 ? ((y - last) / max) * h : 0;
      speed = speed * 0.82 + v * 0.18;
      last = y;
      const len = Math.min(56, Math.abs(speed) * 9);
      tail.style.height = `${len.toFixed(1)}px`;
      tail.style.opacity = len > 2 ? "1" : "0";
      tail.classList.toggle("is-down", speed > 0);
      tail.classList.toggle("is-up", speed < 0);
      const pct = Math.round(p * 100);
      if (pct !== shown) {
        read.textContent = String(pct);
        shown = pct;
      }
      root.classList.toggle("is-end", pct >= 99);
      if (Math.abs(v) > 0.05) idle = performance.now();
      const moving = performance.now() - idle < 900;
      root.classList.toggle("is-moving", moving);
      // Keep drawing while anything still changes: the page moving, the tail
      // easing out, the read-out fading. Once all of it has settled the gauge
      // rests until the next scroll, resize or change in page height.
      if (v !== 0 || len >= 0.05 || moving) wake();
    };
    const wake = () => {
      if (!raf) raf = requestAnimationFrame(frame);
    };
    window.addEventListener("scroll", wake, { passive: true });
    window.addEventListener("resize", wake, { passive: true });
    shows.addEventListener?.("change", wake);
    if ("ResizeObserver" in window) {
      const ro = new ResizeObserver(wake);
      ro.observe(document.documentElement);
      ro.observe(document.body);
    }
    wake();
    track.addEventListener("click", (ev) => {
      const r = track.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (ev.clientY - r.top) / r.height));
      const max = document.documentElement.scrollHeight - window.innerHeight;
      window.scrollTo({ top: p * max, behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    });
  }
</script>
