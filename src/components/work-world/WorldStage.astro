---
// The pinned stage both Work pages share: one canvas, kept alive across the
// move between /work and /work/<slug>, and the words as real HTML on top. All
// the copy and every link is in the document, so it reads and indexes without
// the 3D. With no WebGL, or under reduced motion, the panels fall back to a
// plain page in normal flow (class is-flat).
interface Props {
  page: "index" | "bay";
  slug?: string;
  stops: number;
  label: string;
  /** Screens of scroll per stop. */
  span?: number;
}
const { page, slug, stops, label, span = 1.9 } = Astro.props;
---

<section class="ww" data-ww data-page={page} data-slug={slug} data-stops={stops} data-span={span} style={`--stops:${stops};--span:${span};`} aria-label={label}>
  <div class="ww-stage" data-ww-stage>
    <div class="ww-sky" aria-hidden="true"></div>
    <canvas class="ww-canvas" aria-hidden="true" transition:persist="work-world"></canvas>
    <div class="ww-panels" data-ww-layer>
      <slot />
    </div>
    <slot name="hud" />
  </div>
</section>
<noscript>
  <style>
    .ww { height: auto !important; }
    .ww-stage { position: static !important; height: auto !important; overflow: visible !important; }
    .ww-panels { position: static !important; height: auto !important; }
    .ww-foot { position: static !important; }
    .ww-panel { position: relative !important; opacity: 1 !important; pointer-events: auto !important; inset: auto !important; min-height: 0 !important; }
    .ww-reveal, .ww-more { max-height: none !important; opacity: 1 !important; overflow: visible !important; }
    .ww-canvas, .ww-rail, .ww-read, .ww-cue { display: none !important; }
  </style>
</noscript>

<style is:global>
  /* Reuses the flight's lit pill button. */
  .ww, .ww-panels { --cc: 245, 165, 36; }
  .ww {
    position: relative;
    height: calc((var(--stops) - 1) * var(--span) * 100vh + 100vh);
    height: calc((var(--stops) - 1) * var(--span) * 100svh + 100lvh);
    background: #030201;
  }
  .ww-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100lvh;
    overflow: hidden;
    overflow: clip;
    isolation: isolate;
    background: #030201;
    touch-action: pan-y;
    color: #fff;
  }
  .ww-sky {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(38% 34% at 62% 30%, rgba(245, 165, 36, 0.38), transparent 72%),
      radial-gradient(70% 60% at 62% 30%, rgba(180, 90, 20, 0.22), transparent 74%),
      radial-gradient(60% 40% at 20% 110%, rgba(120, 60, 16, 0.2), transparent 70%),
      #030201;
  }
  .ww-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 1s ease; }
  .ww.is-3d .ww-canvas { opacity: 1; }

  .ww-stage.is-dragging { user-select: none; -webkit-user-select: none; }
  .ww-panels { position: absolute; left: 0; right: 0; top: 0; height: 100vh; height: 100svh; z-index: 2; pointer-events: none; overflow: hidden; overflow: clip; transform-style: preserve-3d; perspective-origin: 50% 50%; }
  .ww-panel {
    position: absolute;
    inset: 0;
    padding: 96px max(32px, var(--gutter, 32px)) 44px;
    display: grid;
    opacity: 0;
    transform-origin: 50% 50%;
    pointer-events: none;
    backface-visibility: hidden;
  }
  .ww-panel[data-stop="0"] { opacity: 1; }
  .ww-panel.is-active a, .ww-panel.is-active button, .ww-panel.is-active .ww-box, .ww-panel.is-active .ww-card, .ww-panel.is-active [data-ww-scroll] { pointer-events: auto; }
  .ww-box { max-width: 620px; display: grid; gap: 14px; align-content: start; width: 100%; }
  /* Words over hull get solid glass: no blur over a live canvas. */
  .ww-bay .ww-box, .ww-box.is-glass {
    width: min(560px, 100%);
    padding: 20px 22px;
    border-radius: 20px;
    background: linear-gradient(180deg, rgba(14, 11, 8, 0.86), rgba(9, 7, 5, 0.92));
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 30px 70px -30px rgba(0, 0, 0, 0.95);
  }
  .ww-bay .ww-h2, .ww-box.is-glass .ww-h2 { font-size: clamp(1.9rem, 3.3vw, 3.1rem); }
  .ww-bay.is-open .ww-box { border-color: rgba(245, 165, 36, 0.34); }

  /* Where a panel's words sit. Every screen picks its own. */
  .at-bl { justify-items: start; align-items: end; }
  .at-br { justify-items: end; align-items: end; }
  .at-tl { justify-items: start; align-items: start; }
  .at-tr { justify-items: end; align-items: start; }
  .at-l { justify-items: start; align-items: center; }
  .at-r { justify-items: end; align-items: center; }
  .at-bc { justify-items: center; align-items: end; text-align: center; }
  .at-c { justify-items: center; align-items: center; text-align: center; }

  /* Type */
  .ww-eye { margin: 0; text-shadow: 0 1px 10px rgba(0, 0, 0, 0.7); display: flex; align-items: center; gap: 12px; font-size: 0.8125rem; color: rgba(255, 255, 255, 0.66); }
  .ww-eye b { font-weight: 500; color: #f5a524; font-variant-numeric: tabular-nums; }
  .ww-eye i { width: 44px; height: 1px; background: linear-gradient(90deg, #f5a524, rgba(245, 165, 36, 0.08)); }
  .at-br .ww-eye, .at-r .ww-eye, .at-tr .ww-eye { justify-content: flex-end; }
  .at-br .ww-h2, .at-r .ww-h2, .at-tr .ww-h2, .at-br .ww-h1, .at-r .ww-h1, .at-tr .ww-h1 { text-align: right; }
  .at-br .ww-meta, .at-r .ww-meta, .at-tr .ww-meta { text-align: right; justify-self: end; }
  .at-bc .ww-eye, .at-c .ww-eye { justify-content: center; }
  .ww-h1, .ww-h2 { text-shadow: 0 2px 26px rgba(0, 0, 0, 0.55); }
  .ww-h1 {
    margin: 0;
    font-size: clamp(2.75rem, 7.4vw, 7.25rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 0.96;
    text-wrap: balance;
  }
  .ww-h1 .is-dim { display: block; color: rgba(255, 255, 255, 0.62); }
  .ww-h2 {
    margin: 0;
    font-size: clamp(2.1rem, 4.6vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.042em;
    line-height: 1;
    text-wrap: balance;
  }
  .ww-h2 a { color: inherit; text-decoration: none; }
  .ww-h2 a:hover { color: #f5a524; }
  .ww-line { margin: 0; max-width: 34rem; font-size: clamp(1rem, 1.25vw, 1.125rem); line-height: 1.5; color: rgba(255, 255, 255, 0.8); text-shadow: 0 1px 14px rgba(0, 0, 0, 0.7); }
  .at-br .ww-line, .at-r .ww-line, .at-tr .ww-line { text-align: right; justify-self: end; }
  .ww-meta { margin: 0; max-width: 40rem; font-size: 0.875rem; line-height: 1.5; color: rgba(255, 255, 255, 0.7); text-shadow: 0 1px 12px rgba(0, 0, 0, 0.85); }

  /* Numbers that arrive when the doors open */
  .ww-reveal { display: grid; gap: 18px; max-height: 0; opacity: 0; overflow: hidden; transition: max-height 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease; }
  .ww-panel.is-open .ww-reveal { max-height: 420px; opacity: 1; }
  .ww-bay .ww-box .ww-eye, .ww-box.is-glass .ww-eye { justify-content: flex-start; }
  .ww-bay .ww-box .ww-h2, .ww-bay .ww-box .ww-line, .ww-box.is-glass .ww-h2, .ww-box.is-glass .ww-line { text-align: left; justify-self: start; }
  .ww-bay .ww-box .ww-work, .ww-bay .ww-box .ww-actions, .ww-box.is-glass .ww-facts, .ww-box.is-glass .ww-actions { justify-content: flex-start; }
  .ww-box.is-glass .ww-toggle { justify-self: start; }
  /* The exit screen: its words centre on their plate. */
  .ww-box.is-exit { justify-items: center; text-align: center; }
  .ww-box.is-exit .ww-eye, .ww-box.is-exit .ww-actions { justify-content: center; }
  .ww-box.is-exit .ww-h2 { text-align: center; justify-self: center; }
  @media (max-height: 720px) {
    .ww-points li { padding: 6px 0; }
    .ww-points strong { font-size: 0.875rem; }
    .ww-points span { font-size: 0.75rem; }
    .ww-plates li { padding: 12px 14px; }
    .ww-panel { padding-top: 80px; padding-bottom: 28px; }
    .ww-card-art { aspect-ratio: 21 / 9; }
  }
  .ww-box.is-glass[data-ww-scroll] { max-height: calc(100svh - 110px); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; }
  .ww-box.is-glass[data-ww-scroll]::-webkit-scrollbar { display: none; }
  .has-foot .ww-box[data-ww-scroll] { max-height: calc(100svh - 96px - 84px); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none; }
  .has-foot .ww-box[data-ww-scroll]::-webkit-scrollbar { display: none; }
  @media (max-width: 760px) { .has-foot .ww-box[data-ww-scroll] { max-height: calc(100svh - 84px - 136px); } }
  /* Clear of the chat button in the corner. */
  .at-br, .at-bc { padding-bottom: 96px; }
  @media (min-width: 761px) { .at-br, .at-r { padding-right: 96px; } }
  .ww-stats { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, auto)); justify-content: space-between; gap: 18px; }
  .ww-stats li { display: grid; gap: 4px; align-content: start; opacity: 0; transform: translateY(10px); transition: opacity 0.5s ease, transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(var(--i) * 0.07s); }
  .ww-panel.is-open .ww-stats li { opacity: 1; transform: none; }
  .ww-stats b { font-size: clamp(1.25rem, 2vw, 1.875rem); font-weight: 500; letter-spacing: -0.035em; line-height: 1; color: #f5a524; white-space: nowrap; }
  .ww-stats span { font-size: 0.75rem; line-height: 1.35; color: rgba(255, 255, 255, 0.62); }
  .ww-work { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .at-br .ww-work, .at-r .ww-work, .at-tr .ww-work { justify-content: flex-end; }
  .ww-chip { display: inline-flex; align-items: center; height: 28px; padding: 0 11px; border-radius: 9999px; border: 1px solid rgba(255, 255, 255, 0.14); background: rgba(10, 8, 6, 0.55); font-size: 0.75rem; color: rgba(255, 255, 255, 0.82); text-decoration: none; white-space: nowrap; transition: border-color 0.2s ease, color 0.2s ease; }
  a.ww-chip:hover { border-color: rgba(245, 165, 36, 0.7); color: #fff; }
  .ww-facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .at-br .ww-facts, .at-r .ww-facts, .at-tr .ww-facts { justify-content: flex-end; }
  .at-bc .ww-facts, .at-c .ww-facts { justify-content: center; }
  .ww-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .at-br .ww-actions, .at-r .ww-actions, .at-tr .ww-actions { justify-content: flex-end; }
  .at-bc .ww-actions, .at-c .ww-actions { justify-content: center; }
  .ww-cue { display: inline-flex; align-items: center; gap: 10px; font-size: 0.75rem; letter-spacing: 0.02em; color: rgba(255, 255, 255, 0.56); }
  .ww-cue i { position: relative; width: 44px; height: 1px; background: rgba(255, 255, 255, 0.2); overflow: hidden; }
  .ww-cue i::after { content: ""; position: absolute; inset: 0; background: #f5a524; transform: translateX(-100%); animation: ww-cue 2.2s cubic-bezier(0.6, 0, 0.3, 1) infinite; }
  @keyframes ww-cue { 60%, 100% { transform: translateX(100%); } }

  /* "More" on a stop of the trail */
  .ww-more { display: grid; gap: 12px; max-height: 0; opacity: 0; overflow: hidden; transition: max-height 0.5s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease; }
  .ww-panel.is-open .ww-more { max-height: 280px; opacity: 1; }
  .ww-more p { margin: 0; max-width: 30rem; font-size: 0.9375rem; line-height: 1.5; color: rgba(255, 255, 255, 0.72); }
  .ww-toggle { justify-self: start; display: inline-flex; align-items: center; gap: 8px; padding: 0; border: 0; background: none; color: rgba(255, 255, 255, 0.7); font: inherit; font-size: 0.8125rem; cursor: pointer; }
  .ww-toggle:hover { color: #f5a524; }
  .ww-toggle::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: #f5a524; box-shadow: 0 0 10px rgba(245, 165, 36, 0.9); }
  .at-br .ww-toggle, .at-r .ww-toggle, .at-tr .ww-toggle { justify-self: end; }
  .at-bc .ww-toggle, .at-c .ww-toggle { justify-self: center; }

  /* The small line that replaces the footer, on the last screen only. */
  .ww-panel.has-foot { padding-bottom: 84px; }
  .ww-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 22px;
    padding: 34px max(32px, var(--gutter, 32px)) 12px;
    background: linear-gradient(to top, rgba(3, 2, 1, 0.88) 0%, rgba(3, 2, 1, 0.66) 46%, transparent 100%);
    font-size: 0.75rem;
    text-align: left;
  }
  .ww-foot-tabs, .ww-foot-out { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; }
  .ww-foot a { display: inline-flex; align-items: center; gap: 6px; color: rgba(255, 255, 255, 0.72); text-decoration: none; line-height: 1.5; }
  .ww-foot a:hover { color: #fff; }
  .ww-foot a:focus-visible { outline: 1.5px solid #f5a524; outline-offset: 2px; }
  .ww-foot-tabs a::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: rgb(var(--fc)); box-shadow: 0 0 8px rgba(var(--fc), 0.8); }
  .ww-foot-copy { font-size: 0.6875rem; color: rgba(255, 255, 255, 0.5); }
  .ww.is-flat .ww-foot { position: static; padding: 24px 0 0; background: none; grid-column: 1 / -1; width: 100%; }

  /* Rail and readout */
  .ww-rail { position: absolute; right: max(18px, calc(var(--gutter, 24px) - 16px)); top: 50%; transform: translateY(-50%); z-index: 3; }
  .ww-rail ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; justify-items: end; }
  .ww-rail a { position: relative; display: flex; align-items: center; justify-content: flex-end; gap: 10px; height: 18px; color: transparent; font-size: 0.6875rem; text-decoration: none; white-space: nowrap; transition: color 0.25s ease; }
  .ww-rail a::after { content: ""; width: 12px; height: 1px; background: rgba(255, 255, 255, 0.34); transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s ease; }
  .ww-rail a[aria-current]::after { width: 24px; background: #f5a524; box-shadow: 0 0 8px rgba(245, 165, 36, 0.9); }
  .ww-rail:hover a, .ww-rail a:focus-visible { color: rgba(255, 255, 255, 0.72); }
  .ww-rail a:hover { color: #fff; }
  .ww-rail a:hover::after { background: #f5a524; }
  .ww-rail a:focus-visible { outline: 1.5px solid #f5a524; outline-offset: 2px; }
  .ww-rail li.is-gap { height: 12px; }
  /* The year, huge, only while travelling. */
  .ww-read { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%); margin: 0; z-index: 1; pointer-events: none; text-align: center; font-size: clamp(5rem, 15vw, 15rem); font-weight: 500; letter-spacing: -0.06em; font-variant-numeric: tabular-nums; color: rgba(255, 255, 255, 0.16); opacity: 0; transition: opacity 0.35s ease; }
  .ww-read small { display: block; text-align: right; font-size: 0.6875rem; letter-spacing: 0.02em; font-weight: 400; color: rgba(255, 255, 255, 0.52); }
  .ww.is-trail.is-moving .ww-read { opacity: 1; }

  /* The lit pill, the same shape as the home flight's */
  .jb {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 40px;
    padding: 0 8px 0 18px;
    border-radius: 9999px;
    border: 1px solid rgba(var(--cc), 0.42);
    background: linear-gradient(180deg, rgba(var(--cc), 0.16), rgba(var(--cc), 0.03));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    text-decoration: none;
    overflow: hidden;
    white-space: nowrap;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .jb::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.22) 48%, transparent 66%); transform: translateX(-120%); transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .jb:hover { border-color: rgba(var(--cc), 0.85); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), 0 0 26px -6px rgba(var(--cc), 0.8); }
  .jb:hover::before { transform: translateX(120%); }
  .jb:active { transform: scale(0.97); }
  .jb:focus-visible { outline: 1.5px solid rgb(var(--cc)); outline-offset: 3px; }
  .jb-arrow { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: rgba(255, 255, 255, 0.1); font-style: normal; transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.3s ease; }
  .jb:hover .jb-arrow { transform: translateX(3px); background: rgba(var(--cc), 0.35); }
  .jb.is-solid { color: #120b02; border-color: transparent; background: linear-gradient(180deg, #fff, rgba(var(--cc), 0.95)); box-shadow: 0 8px 26px -10px rgba(var(--cc), 0.9); }
  .jb.is-solid .jb-arrow { background: rgba(4, 6, 11, 0.12); }
  .jb.is-ghost { border-color: rgba(255, 255, 255, 0.14); background: rgba(255, 255, 255, 0.03); }
  .jb.is-ghost:hover { border-color: rgba(255, 255, 255, 0.4); }

  /* Cards in the bays. Solid glass: no blur over a live canvas. */
  .ww-card {
    position: relative;
    text-align: left;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-radius: 18px;
    overflow: hidden;
    background: rgba(13, 10, 7, 0.86);
    border: 1px solid rgba(255, 255, 255, 0.11);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.09), 0 30px 60px -30px rgba(0, 0, 0, 0.9);
    transform: translateZ(var(--tz, 0px)) rotateY(var(--ry, 0deg)) rotateX(var(--rx, 0deg));
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .ww-card:hover { border-color: rgba(245, 165, 36, 0.6); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), 0 30px 70px -26px rgba(245, 165, 36, 0.32); }
  .ww-card-art { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: #0a0705; }
  /* The art goes warm grey, so colour keeps meaning the tab. */
  .ww-card-art img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) sepia(0.32) contrast(1.08) brightness(1.05); transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease; }
  .ww-card:hover .ww-card-art img { transform: scale(1.05); filter: grayscale(1) sepia(0.62) contrast(1.12) brightness(1.25); }
  .ww-card-fallback { position: absolute; inset: 0; display: grid; place-items: center; padding: 12px; font-size: 0.875rem; color: rgba(255, 255, 255, 0.5); background: radial-gradient(70% 90% at 20% 0%, rgba(245, 165, 36, 0.22), transparent 70%), #0a0705; }
  .ww-card-body { display: grid; gap: 8px; padding: 14px 16px 16px; align-content: start; }
  .ww-card h3 { margin: 0; font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.018em; line-height: 1.2; color: #fff; }
  .ww-card h3 a { color: inherit; text-decoration: none; }
  .ww-card h3 a::after { content: ""; position: absolute; inset: 0; }
  .ww-card p { margin: 0; font-size: 0.8125rem; line-height: 1.45; color: rgba(255, 255, 255, 0.68); }
  .ww-card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; max-height: 0; overflow: hidden; opacity: 0; transition: max-height 0.45s ease, opacity 0.3s ease; }
  .ww-card:hover ul, .ww-card:focus-within ul { max-height: 240px; opacity: 1; }
  .ww-card li { position: relative; padding-left: 12px; font-size: 0.75rem; line-height: 1.4; color: rgba(255, 255, 255, 0.62); }
  .ww-card li::before { content: ""; position: absolute; left: 1px; top: 0.55em; width: 4px; height: 4px; border-radius: 50%; background: #f5a524; }
  .ww-badge { justify-self: start; display: inline-flex; align-items: center; height: 22px; padding: 0 9px; border-radius: 9999px; font-size: 0.6875rem; color: rgba(255, 255, 255, 0.72); border: 1px solid rgba(255, 255, 255, 0.14); background: rgba(255, 255, 255, 0.03); }
  .ww-badge.is-live { color: #f5a524; border-color: rgba(245, 165, 36, 0.4); background: rgba(245, 165, 36, 0.08); }
  .ww-card-links { position: relative; z-index: 2; display: flex; gap: 14px; }
  .ww-card-links a { font-size: 0.75rem; color: #f5a524; text-decoration: none; }
  .ww-card-links a:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* Cards in a screen, arranged differently from one screen to the next */
  .ww-deck { display: grid; gap: 16px; pointer-events: none; transform-style: preserve-3d; perspective: 1400px; }
  .ww-deck.n3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ww-deck.n2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .ww-deck.n4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .lay-fan { width: min(1180px, 100%); }
  .lay-fan.n3 > :nth-child(1) { --ry: 13deg; --tz: -20px; margin-top: 26px; }
  .lay-fan.n3 > :nth-child(2) { --ry: 0deg; --tz: 20px; }
