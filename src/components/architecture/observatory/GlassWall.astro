---
// The architecture tab as an endless wall of glass cards, one per system,
// on a gently curved surface. Drag, scroll or use the arrow keys to move
// it; a card opens its drawing. The wall is a WebGL layer; under it sits
// the plain list of every system as real links, which the List view shows
// and screen readers and search engines always read.
import Picture from "../../common/Picture.astro";
import { architectures } from "../../../data/architecture";
import { inPageOrder, toCard } from "./model";

const order = inPageOrder();
const cards = order.map(toCard);

const totalParts = architectures.reduce((n, a) => n + Object.keys(a.parts).length, 0);
const totalFails = architectures.reduce((n, a) => n + a.breaks.length, 0);

// Filters: the four kinds of work, then the shared services.
const FILTERS: Array<{ id: string; label: string; test: (c: (typeof cards)[number]) => boolean }> = [
  { id: "all", label: "All", test: () => true },
  { id: "aie", label: "AI Engineering", test: (c) => c.disciplines.includes("aie") },
  { id: "fde", label: "Forward Deployed", test: (c) => c.disciplines.includes("fde") },
  { id: "mle", label: "Machine Learning", test: (c) => c.disciplines.includes("mle") },
  { id: "sde", label: "Software", test: (c) => c.disciplines.includes("sde") },
  { id: "service", label: "Shared services", test: (c) => c.kind === "service" },
];
const counts = Object.fromEntries(FILTERS.map((f) => [f.id, cards.filter(f.test).length]));
const ACRONYM: Record<string, string> = { aie: "AIE", fde: "FDE", mle: "MLE", sde: "SDE" };

const data = JSON.stringify(cards).replace(/</g, "\\u003c");
---

<section class="gw" data-wall data-mode="wall" aria-labelledby="gw-title">
  <script is:inline>
    // The page does not scroll under the wall. Set before the first layout, so a
    // phone never starts it zoomed out around the list and then jumps.
    (function () {
      var list = false;
      try { list = sessionStorage.getItem("arch-view") === "list"; } catch (e) {}
      if (!list && "WebGL2RenderingContext" in window) document.documentElement.classList.add("wall-on");
    })();
  </script>
  <div
    class="gw-stage"
    data-wall-stage
    tabindex="0"
    role="group"
    aria-roledescription="wall of cards"
    aria-label="Every system as a card. Drag, scroll or use the arrow keys to move the wall. Enter opens the card in the middle."
  >
    <canvas class="gw-canvas" data-wall-canvas aria-hidden="true"></canvas>
    <div class="gw-vignette" aria-hidden="true"></div>
    <div class="gw-flash" data-wall-flash aria-hidden="true"></div>
    <p class="gw-hint" data-wall-hint aria-hidden="true">
      <span class="gw-hint-icon"></span><span data-wall-hint-text>Drag or scroll to explore</span>
    </p>
  </div>
  <p class="sr-only" aria-live="polite" data-wall-live></p>

  <header class="gw-head">
    <p class="kicker">Architecture</p>
    <h1 class="gw-title" id="gw-title">Every system, drawn.</h1>
    <ul class="gw-stats" aria-label="Across every drawing">
      <li><b>{architectures.length}</b> drawings</li>
      <li><b>{totalParts}</b> parts drawn</li>
      <li><b>{totalFails}</b> failure paths</li>
    </ul>
    <p class="gw-cost">$132 from October 1 to 28, 2026, for the six projects the billing export measured.</p>
  </header>

  <nav class="gw-bar" aria-label="Filter the systems">
    <div class="gw-bar-in">
      <div class="gw-chips" role="group" aria-label="Show">
        {FILTERS.map((f, i) => (
          <button type="button" class:list={["gw-chip", { "is-on": i === 0 }]} data-filter={f.id} aria-pressed={i === 0 ? "true" : "false"} disabled={counts[f.id] === 0}>
            {f.label}
            <span class="gw-n">{counts[f.id]}</span>
          </button>
        ))}
      </div>
      <span class="gw-sep" aria-hidden="true"></span>
      <button type="button" class="gw-chip gw-mode" data-wall-mode aria-pressed="false" aria-controls="gw-list">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="ic-list"><path d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"></path></svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="ic-wall"><rect x="3" y="4" width="8" height="7" rx="2"></rect><rect x="13" y="4" width="8" height="7" rx="2"></rect><rect x="3" y="13" width="8" height="7" rx="2"></rect><rect x="13" y="13" width="8" height="7" rx="2"></rect></svg>
        <span data-wall-mode-label>List view</span>
      </button>
    </div>
  </nav>

  <!-- The list: every system as a real link, in the wall's order. -->
  <div class="gw-list wrap" id="gw-list" data-wall-list>
    <h2 class="sr-only">Every system</h2>
    <ul class="gl-grid">
      {order.map((a, i) => {
        const c = cards[i];
        return (
          <li class="gl-item" data-slug={c.slug} data-disciplines={c.disciplines.join(" ")} data-kind={c.kind}>
            <a href={`/architecture/${c.slug}`} class="gl-card">
              <span class="gl-art">
                <Picture src={`/arch/${c.slug}.png`} alt="" width={1200} height={686} sizes="(min-width: 1024px) 470px, (min-width: 768px) 350px, 92vw" />
              </span>
              <span class="gl-body">
                <span class="gl-top">
                  <span class="gl-project">{c.project}</span>
                  <span class:list={["gl-status", { "is-sleep": !c.running }]}><i aria-hidden="true"></i>{c.status}</span>
                </span>
                <span class="gl-name">{c.name}</span>
                <span class="gl-line">{c.headline} <span>{c.tail}</span></span>
                <span class="gl-facts">
                  <span><b>{c.parts}</b> parts, {c.mine} mine</span>
                  <span><b>{c.fails}</b> failure paths</span>
                  {c.cost && <span><b>{a.cost!.total}</b> {a.cost!.period}</span>}
                  <span class="gl-disc">{c.disciplines.map((d) => <span class="badge">{ACRONYM[d]}</span>)}</span>
                </span>
                <span class="gl-open">Open the drawing</span>
              </span>
            </a>
            <a href={a.post} class="gl-story tlink">Read the story<span class="sr-only"> of {c.name}</span></a>
          </li>
        );
      })}
    </ul>
    <p class="gl-empty t-lede" data-wall-empty hidden>Nothing drawn for that kind of work yet.</p>
    <slot />
  </div>
</section>

<script type="application/json" id="wall-data" set:html={data} />

<script>
  import { onPage } from "../../../scripts/lifecycle";
  import { mountWall } from "../../../scripts/observatory/wall";
  onPage("glass-wall", (signal) => mountWall(signal));
</script>

<style>
  .gw {
    --gw-rgb: var(--c-architecture-rgb);
    position: relative;
  }

  /* ------------------------------------------------------------ the wall */
  .gw-stage {
    position: fixed;
    inset: 0;
    z-index: 45;
    background: #020306;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
    outline: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .gw-stage.is-dragging { cursor: grabbing; }
  .gw-stage.is-over { cursor: pointer; }
  .gw-stage:focus-visible::after {
    content: "";
    position: absolute;
    inset: 10px;
    border-radius: 26px;
    box-shadow: inset 0 0 0 2px rgba(var(--gw-rgb), 0.6);
    pointer-events: none;
  }
  .gw-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .gw-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(125% 100% at 50% 50%, transparent 50%, rgba(0, 0, 0, 0.45) 76%, rgba(0, 0, 0, 0.9) 100%);
  }
  .gw-flash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(60% 60% at 50% 50%, rgba(255, 255, 255, 0.9), rgba(var(--gw-rgb), 0.35) 60%, transparent 100%);
  }
  .gw-flash.is-on { animation: gw-flash 520ms var(--ease-glass) forwards; }
  @keyframes gw-flash { 0% { opacity: 0; } 55% { opacity: 0.85; } 100% { opacity: 1; background: #000; } }

  .gw-hint {
    position: absolute;
    left: 50%;
    bottom: 104px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 10px 18px;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    white-space: nowrap;
    color: var(--ink);
    background: rgba(8, 10, 16, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 20px 40px -20px #000;
    transform: translateX(-50%);
    pointer-events: none;
    transition: opacity 600ms var(--ease-glass), transform 600ms var(--ease-glass);
  }
  .gw-hint.is-gone { opacity: 0; transform: translate(-50%, 8px); }
  .gw-hint-icon { position: relative; width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid currentColor; }
  .gw-hint-icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 4px;
    margin: -2px 0 0 -2px;
    border-radius: 50%;
    background: currentColor;
    animation: gw-hint 1.8s var(--ease-glass) infinite;
  }
  @keyframes gw-hint { 0% { transform: translateX(-5px); } 50% { transform: translateX(5px); } 100% { transform: translateX(-5px); } }

  /* ------------------------------------------------------------- chrome */
  .gw-head {
    position: fixed;
    top: 96px;
    left: clamp(16px, 3vw, 44px);
    z-index: 46;
    max-width: 360px;
    padding: 18px 20px 16px;
    border-radius: 22px;
    background: linear-gradient(180deg, rgba(14, 17, 24, 0.96), rgba(5, 7, 11, 0.96));
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 30px 60px -30px #000;
    pointer-events: auto;
  }
  .gw-head p { margin: 0; }
  .gw-title { margin: 12px 0 0; font-size: clamp(1.6rem, 2.4vw, 2.1rem); font-weight: 600; letter-spacing: -0.035em; line-height: 1.05; color: var(--ink); }
  .gw-stats { display: flex; flex-wrap: wrap; gap: 4px 14px; margin: 12px 0 0; padding: 0; list-style: none; font-size: 0.8125rem; color: var(--ink-faint); }
  .gw-stats b { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
  .gw-cost { margin-top: 6px !important; font-size: 0.75rem; line-height: 1.45; color: var(--ink-faint); }

  .gw-bar {
    position: fixed;
    left: 50%;
    bottom: clamp(14px, 2.4vh, 26px);
    z-index: 46;
    max-width: calc(100vw - 24px);
    transform: translateX(-50%);
  }
  .gw-bar-in {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 5px;
    border-radius: 9999px;
    background: linear-gradient(180deg, rgba(40, 44, 54, 0.82), rgba(14, 16, 22, 0.9));
    border: 1px solid rgba(255, 255, 255, 0.16);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16), inset 0 -1px 0 rgba(0, 0, 0, 0.5), 0 24px 50px -20px #000;
  }
  .gw-chips { display: flex; gap: 2px; }
  .gw-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    padding: 0 14px;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    color: var(--ink-soft);
    font: inherit;
    font-size: 0.84375rem;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color 200ms var(--ease-glass), color 200ms var(--ease-glass);
  }
  .gw-chip:hover { color: var(--ink); background: rgba(255, 255, 255, 0.07); }
  .gw-chip.is-on { color: var(--ink); background: rgba(255, 255, 255, 0.14); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14); }
  .gw-chip:disabled { opacity: 0.4; cursor: default; }
  .gw-chip:focus-visible { outline: none; box-shadow: 0 0 0 2px rgba(var(--gw-rgb), 0.7); }
  .gw-n { font-size: 0.71875rem; font-variant-numeric: tabular-nums; color: var(--ink-faint); }
  .gw-sep { width: 1px; height: 20px; margin: 0 4px; background: rgba(255, 255, 255, 0.14); flex: none; }
  .gw-mode svg { width: 16px; height: 16px; }
  .gw-mode .ic-wall { display: none; }
  .gw[data-mode="list"] .gw-mode .ic-wall { display: block; }
  .gw[data-mode="list"] .gw-mode .ic-list { display: none; }

  /* ------------------------------------------------------------- the list */
  /* In wall mode the list stays in the page for screen readers and search,
     visually hidden. Focus landing in it switches to the list view. */
  .gw[data-mode="wall"] .gw-list {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .gw[data-mode="list"] .gw-stage { display: none; }
  .gw[data-mode="list"] .gw-head { position: relative; top: auto; left: auto; max-width: none; margin: 0 auto; padding: 0; background: none; border: 0; box-shadow: none; }
  .gw[data-mode="list"] { padding-top: clamp(118px, 12vw, 150px); padding-bottom: 120px; }
  .gw[data-mode="list"] .gw-head { width: 100%; max-width: calc(var(--max) + 2 * var(--gutter)); padding-inline: var(--gutter); }
  .gw[data-mode="list"] .gw-title { font-size: clamp(2.4rem, 5.2vw, 4.25rem); }
  .gl-grid { display: grid; grid-template-columns: 1fr; gap: 14px; margin: 34px 0 0; padding: 0; list-style: none; }
  @media (min-width: 700px) { .gl-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1080px) { .gl-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .gl-item { position: relative; display: flex; flex-direction: column; min-width: 0; }
  .gl-item[hidden] { display: none; }
  /* The list is out of sight behind the wall until someone asks for it, so its cards wait
     to be laid out until they are near the screen. Screen readers still have all of them. */
  .gl-item { content-visibility: auto; contain-intrinsic-size: auto 443px; }
  @media (min-width: 720px) { .gl-item { contain-intrinsic-size: auto 460px; } }
  .gl-card {
    display: flex;
    flex-direction: column;
    flex: 1;
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012) 40%), var(--surface-solid);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 30px 60px -40px #000;
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    transition: transform 300ms var(--ease-glass), border-color 200ms var(--ease-glass), box-shadow 300ms var(--ease-glass);
  }
  .gl-card:hover { transform: translateY(-3px); border-color: rgba(var(--gw-rgb), 0.5); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), 0 40px 70px -40px #000, 0 0 50px -22px rgba(var(--gw-rgb), 0.6); }
  .gl-card:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(var(--gw-rgb), 0.6); }
  .gl-art { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: #05070c; border-bottom: 1px solid var(--line); }
  .gl-art :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .gl-body { display: flex; flex-direction: column; gap: 9px; flex: 1; padding: 18px 20px 20px; }
  .gl-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; font-size: 0.75rem; }
  .gl-project { color: var(--c-architecture); font-weight: 500; }
  .gl-status { display: inline-flex; align-items: center; gap: 6px; color: var(--ink-faint); text-align: right; }
  .gl-status i { width: 6px; height: 6px; border-radius: 50%; flex: none; background: var(--live); box-shadow: 0 0 8px rgba(34, 197, 94, 0.8); }
  .gl-status.is-sleep i { background: #b9c7d8; box-shadow: none; opacity: 0.7; }
  .gl-name { font-size: 1.3125rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; }
  .gl-line { font-size: 0.9375rem; line-height: 1.4; color: var(--ink); text-wrap: balance; }
  .gl-line span { color: var(--ink-faint); }
  .gl-facts { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 2px; }
  .gl-facts > span:not(.gl-disc) { height: 24px; padding: 0 10px; border-radius: 9999px; border: 1px solid var(--line-strong); font-size: 0.71875rem; line-height: 22px; color: var(--ink-faint); white-space: nowrap; }
  .gl-facts b { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
  .gl-disc { display: flex; gap: 5px; margin-left: auto; }
  .gl-open { margin-top: auto; padding-top: 6px; font-size: 0.875rem; line-height: 1.5; font-weight: 500; color: var(--c-architecture); }
  .gl-story { position: absolute; right: 20px; bottom: 20px; font-size: 0.875rem; line-height: 1.5; }
  .gl-empty { padding-block: 10vh; text-align: center; margin-inline: auto; }

  /* ------------------------------------------------------------- phones */
  @media (max-width: 767px) {
    .gw-head { top: 82px; left: 12px; right: 12px; max-width: none; padding: 10px 14px 11px; border-radius: 16px; }
    .gw-head .kicker { display: none; }
    .gw-title { margin-top: 0; font-size: 1.1875rem; }
    .gw-stats { margin-top: 4px; gap: 2px 10px; font-size: 0.6875rem; }
    .gw-cost { font-size: 0.625rem; margin-top: 2px !important; }
    .gw-bar { left: 12px; right: 12px; max-width: none; transform: none; }
    .gw-bar-in { overflow-x: auto; scrollbar-width: none; }
    .gw-bar-in::-webkit-scrollbar { display: none; }
    .gw-chip { height: 34px; padding: 0 12px; font-size: 0.8125rem; flex: none; }
    .gw-hint { bottom: 86px; font-size: 0.8125rem; }
    .gw[data-mode="list"] .gw-head { padding-inline: var(--gutter); }
  }
  @media (prefers-reduced-motion: reduce) {
    .gw-hint-icon::after { animation: none; }
    .gw-flash.is-on { animation: none; }
    .gl-card { transition: none; }
  }
</style>

<style is:global>
  /* While the wall is on screen the page itself does not scroll, and the
     scroll gauge has nothing to measure. */
  html.wall-on, html.wall-on body { overflow: hidden; overscroll-behavior: none; }
  html.wall-on .orbit { display: none !important; }
</style>
