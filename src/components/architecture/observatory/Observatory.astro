---
// The architecture tab as an observatory. Every system is a world in one
// galaxy: its real parts orbit it, and when you reach it on the scroll they
// dock into the real drawing, with light running along its real links.
//
// The 3D is a layer over a proper page: an ordered list of every system as
// text and links, in the same order the flight visits them. Without WebGL,
// or with reduced motion, the list is the page.
import Picture from "../../common/Picture.astro";
import { architectures } from "../../../data/architecture";
import { disciplines } from "../../../data/disciplines";
import { inPageOrder, isRunning, runNoun, runsPerDay, scheduleText, toWorld, usd } from "./model";

const order = inPageOrder();
const worlds = order.map(toWorld);

const totalParts = architectures.reduce((n, a) => n + Object.keys(a.parts).length, 0);
const totalFails = architectures.reduce((n, a) => n + a.breaks.length, 0);
const measured = architectures.filter((a) => a.cost);
const monthly = measured.reduce((n, a) => n + a.cost!.parts.reduce((s, p) => s + p.usd, 0), 0);
const counts = Object.fromEntries(
  disciplines.map((d) => [d.slug, architectures.filter((a) => a.disciplines.includes(d.slug)).length]),
);
const kindCounts = {
  system: architectures.filter((a) => a.kind === "system").length,
  service: architectures.filter((a) => a.kind === "service").length,
};
const ACRONYM = { aie: "AIE", fde: "FDE", mle: "MLE", sde: "SDE" } as const;

// The cost dial reads on a log scale from one cent to a thousand dollars,
// so 2 cents and $132 both land somewhere you can see.
const LOG_MIN = -2;
const LOG_MAX = 3;
const dialAngle = (v: number) => {
  const t = (Math.log10(Math.max(v, 0.01)) - LOG_MIN) / (LOG_MAX - LOG_MIN);
  return Math.PI * (1 - Math.min(1, Math.max(0, t)));
};
const dialPoint = (ang: number, r: number) => [60 + Math.cos(ang) * r, 62 - Math.sin(ang) * r];
const dialTicks = [0.01, 0.1, 1, 10, 100, 1000].map((v) => ({
  v,
  label: v < 1 ? `${Math.round(v * 100)}¢` : v >= 1000 ? "$1k" : `$${v}`,
  a: dialAngle(v),
}));
const arcPath = (from: number, to: number, r: number) => {
  const [x1, y1] = dialPoint(from, r);
  const [x2, y2] = dialPoint(to, r);
  return `M ${x1.toFixed(2)} ${y1.toFixed(2)} A ${r} ${r} 0 0 1 ${x2.toFixed(2)} ${y2.toFixed(2)}`;
};

// The day: every system that runs on a clock, with how often its path runs
// on a weekday. Two drawings show the same scheduler job, so the total
// counts each job once.
const clocks = order
  .filter((a) => a.live.mode !== "event")
  .map((a) => {
    const n = runsPerDay(a, 1) ?? 0;
    return { a, n, noun: runNoun(a, n), when: scheduleText(a) };
  });
const jobs = new Map<string, number>();
for (const c of clocks) jobs.set(c.a.live.source || c.a.slug, c.n);
const dayTotal = [...jobs.values()].reduce((s, n) => s + n, 0);
const sharedWith = (slug: string) => {
  const me = clocks.find((c) => c.a.slug === slug)!;
  return clocks.find((c) => c.a.slug !== slug && c.a.live.source && c.a.live.source === me.a.live.source && clocks.indexOf(c) < clocks.indexOf(me));
};
const eventCount = order.length - clocks.length;
// Where each clock's runs fall across 24 hours, as marks on a strip.
const dayMarks = (a: (typeof order)[number]) => {
  const l = a.live;
  if (l.mode === "daily") {
    const [h, m] = (l.at || "0:0").split(":").map(Number);
    return { band: null as null | [number, number], ticks: [(h * 60 + m) / 1440] };
  }
  const span = l.window ? [l.window[0] / 24, l.window[1] / 24] : [0, 1];
  return { band: span as [number, number], ticks: [] as number[] };
};

const data = JSON.stringify(worlds).replace(/</g, "\\u003c");
---

<section class="obs" data-obs data-tone="architecture" aria-label="Every system, as an observatory">
  <!-- The sky: the 3D scene, its labels and the eyepiece. It is a picture of
       the list below, so screen readers skip it. -->
  <div class="obs-sky" aria-hidden="true">
    <div class="obs-poster"></div>
    <canvas class="obs-canvas" data-obs-canvas></canvas>
    <div class="obs-labels" data-obs-labels></div>
    <div class="obs-eye" data-obs-eye>
      <span class="eye-lens"><img data-eye-img alt="" decoding="async" /><i class="eye-reticle"></i></span>
      <span class="eye-text"><b data-eye-name></b><span data-eye-meta></span></span>
    </div>
    <div class="obs-tip" data-obs-tip>
      <p class="tip-kind" data-tip-kind></p>
      <p class="tip-name" data-tip-name></p>
      <p class="tip-sub" data-tip-sub></p>
      <p class="tip-fails" data-tip-fails></p>
    </div>
    <p class="obs-wake" data-obs-wake></p>
  </div>

  <header class="obs-hero wrap">
    <p class="kicker">Architecture</p>
    <h1 class="t-title obs-title">
      Every system, drawn.
      <span class="t-tail">Scroll to fly through them.</span>
    </h1>

    <ul class="obs-totals" aria-label="Across every drawing">
      <li><b data-count-to={architectures.length}>{architectures.length}</b><span>drawings</span></li>
      <li><b data-count-to={totalParts}>{totalParts}</b><span>parts drawn</span></li>
      <li><b data-count-to={totalFails}>{totalFails}</b><span>failure paths written down</span></li>
      <li><b data-count-to={Math.round(monthly)} data-count-prefix="$">${Math.round(monthly)}</b><span>a month, the {measured.length} measured so far</span></li>
    </ul>

    <div class="obs-filters">
      <div class="obs-chips" role="group" aria-label="Filter by kind of work">
        <button type="button" class="chip is-on" data-filter="all" aria-pressed="true">All <span class="ix-n">{architectures.length}</span></button>
        {disciplines.map((d) => (
          <button type="button" class="chip" data-filter={d.slug} aria-pressed="false" disabled={counts[d.slug] === 0}>
            {d.name} <span class="ix-n">{counts[d.slug]}</span>
          </button>
        ))}
      </div>
      <div class="obs-chips" role="group" aria-label="Filter by what it is">
        <button type="button" class="chip is-on" data-kind="all" aria-pressed="true">Systems and services</button>
        <button type="button" class="chip" data-kind="system" aria-pressed="false">Whole systems <span class="ix-n">{kindCounts.system}</span></button>
        <button type="button" class="chip" data-kind="service" aria-pressed="false">Shared services <span class="ix-n">{kindCounts.service}</span></button>
      </div>
    </div>

    <ul class="obs-key" aria-label="How to read the sky">
      <li><i class="k-mine"></i>Bright cyan parts are mine</li>
      <li><i class="k-flow"></i>Light moving is data on a real path</li>
      <li><i class="k-fail"></i>Red marks a part with a written failure</li>
      <li><i class="k-sleep"></i>Pale worlds are previews, paused or retired</li>
    </ul>

    <p class="obs-cue" data-obs-cue><span aria-hidden="true"></span>Scroll to fly in, or pick a world</p>
  </header>

  <ol class="obs-list" data-obs-list aria-label="Every system, in flight order">
    {order.map((a, i) => {
      const parts = Object.values(a.parts);
      const mine = parts.filter((p) => p.owner === "mine").length;
      const flagged = parts.filter((p) => !!p.fails).length;
      const running = isRunning(a);
      const sum = a.cost ? a.cost.parts.reduce((s, p) => s + p.usd, 0) : 0;
      const needle = a.cost ? dialAngle(sum) : Math.PI;
      const [nx, ny] = dialPoint(needle, 40);
      const costParts = a.cost ? [...a.cost.parts].sort((x, y) => y.usd - x.usd) : [];
      return (
        <li
          class="obs-stop"
          id={`w-${a.slug}`}
          data-stop={i}
          data-slug={a.slug}
          data-name={a.name}
          data-disciplines={a.disciplines.join(" ")}
          data-kind={a.kind}
        >
          <article class="obs-panel" aria-labelledby={`wn-${a.slug}`}>
            <span class="op-art">
              <Picture src={`/arch/${a.slug}.png`} alt="" width={1200} height={686} />
              <span class="op-scan" aria-hidden="true"></span>
            </span>
            <div class="op-body">
              <p class="op-top">
                <span class="op-index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="op-project">{a.project}</span>
                <span class="op-kind">{a.kind === "service" ? "Shared service" : "System"}</span>
                <span class:list={["op-status", { "is-sleep": !running }]}><i aria-hidden="true"></i>{a.statusNote ?? (running ? "In production" : "Preview")}</span>
              </p>
              <h2 class="op-name" id={`wn-${a.slug}`}>{a.name}</h2>
              <p class="op-head">{a.headline} <span>{a.tail}</span></p>

              <ul class="op-facts">
                <li><b>{parts.length}</b> parts, {mine} mine</li>
                <li><b>{a.breaks.length}</b> failure paths</li>
                <li class="op-disc">{a.disciplines.map((d) => <span class="badge">{ACRONYM[d]}</span>)}</li>
              </ul>

              <div
                class="op-live"
                data-live
                data-mode={a.live.mode}
                data-every={a.live.everySeconds ?? (a.live.mode === "event" ? 14 : 60)}
                data-window={a.live.window?.join(",") ?? ""}
                data-at={a.live.at ?? ""}
                data-days={a.live.days?.join(",") ?? ""}
                title={a.live.source ? `Replays ${a.live.source}. A clock in your browser, it never calls the real system.` : "A clock in your browser, it never calls the real system."}
              >
                <svg viewBox="0 0 20 20" class="ol-ring" aria-hidden="true">
                  <circle cx="10" cy="10" r="8" class="ol-track" />
                  <circle cx="10" cy="10" r="8" class="ol-fill" data-live-ring />
                </svg>
                <span class="ol-text">
                  <span class="ol-label">{a.live.label}</span>
                  <span class="ol-when" data-live-when>{a.live.mode === "event" ? `Wakes when ${a.live.source || "something happens"}` : scheduleText(a)}</span>
                </span>
                <button type="button" class="ol-btn" data-live-fire aria-label={`Replay: ${a.live.label}, ${a.name}`}>Replay</button>
              </div>

              <div class="op-breaks" data-breaks>
                <p class="op-label">When it breaks <span>{flagged} {flagged === 1 ? "part has" : "parts have"} a written failure</span></p>
                <ul>
                  {a.breaks.map((b, k) => (
                    <li>
                      <button type="button" class="ob-q" aria-expanded="false" aria-controls={`wb-${a.slug}-${k}`} data-break>
                        <i aria-hidden="true"></i>{b.title}
                      </button>
                      <p class="ob-a" id={`wb-${a.slug}-${k}`} hidden>{b.body}</p>
                    </li>
                  ))}
                </ul>
              </div>

              <div class:list={["op-cost", { "is-none": !a.cost }]}>
                <svg class="oc-dial" viewBox="0 0 120 70" role="img" aria-label={a.cost ? `${a.cost.total} ${a.cost.period}, on a scale from one cent to a thousand dollars a month` : "Cost not measured yet"}>
                  <path d={arcPath(Math.PI, 0, 46)} class="oc-track" />
                  {a.cost && <path d={arcPath(Math.PI, needle, 46)} class="oc-fill" />}
                  {dialTicks.map((t) => {
                    const [x1, y1] = dialPoint(t.a, 50);
                    const [x2, y2] = dialPoint(t.a, 54);
                    const [lx, ly] = dialPoint(t.a, 62);
                    return (
                      <g class="oc-tick">
                        <line x1={x1} y1={y1} x2={x2} y2={y2} />
                        <text x={lx} y={ly + 2.5} text-anchor="middle">{t.label}</text>
                      </g>
                    );
                  })}
                  {a.cost && <line x1="60" y1="62" x2={nx} y2={ny} class="oc-needle" />}
                  <circle cx="60" cy="62" r="2.6" class="oc-hub" />
                </svg>
                <div class="oc-read">
                  {a.cost ? (
                    <>
                      <p class="oc-total"><b>{a.cost.total}</b> {a.cost.period}</p>
                      <ul class="oc-parts">
                        {costParts.slice(0, 3).map((p) => <li><b>{usd(p.usd)}</b> {p.label}</li>)}
                        {costParts.length > 3 && <li class="oc-more">and {costParts.length - 3} more on the drawing</li>}
                      </ul>
                    </>
                  ) : (
                    <>
                      <p class="oc-total"><b>Not measured</b> yet</p>
                      <p class="oc-none">No billing export for this one so far.</p>
                    </>
                  )}
                </div>
              </div>

              <div class="op-links">
                <a href={`/architecture/${a.slug}`} class="btn btn-primary btn-sm">
                  Open the drawing
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-r" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"></path></svg>
                </a>
                <a href={a.post} class="tlink">Read the story</a>
              </div>
            </div>
          </article>
        </li>
      );
    })}
  </ol>
  <p class="obs-empty wrap t-lede" data-obs-empty hidden>Nothing drawn for that kind of work yet.</p>

  <section class="obs-day wrap" data-obs-day aria-labelledby="obs-day-title">
    <p class="kicker">One day</p>
    <h2 class="t-h2" id="obs-day-title">
      Every clock in the sky, on a weekday.
      <span class="t-tail">{order.length - eventCount} drawings run on a schedule. Play the day and watch them fire.</span>
    </h2>
    <div class="od-head">
      <p class="od-total"><b data-day-total>{dayTotal.toLocaleString("en-US")}</b> runs from {jobs.size} scheduler jobs</p>
      <button type="button" class="btn btn-tone btn-sm" data-day-play>Play the day</button>
    </div>
    <ul class="od-grid">
      {clocks.map((c) => {
        const marks = dayMarks(c.a);
        const shared = sharedWith(c.a.slug);
        return (
          <li class="od-card" data-day-card={c.a.slug} data-runs={c.n}>
            <a href={`/architecture/${c.a.slug}`} class="od-name">{c.a.name}</a>
            <p class="od-when">{c.when}</p>
            <p class="od-n"><b data-day-n>{c.n.toLocaleString("en-US")}</b> {c.noun}</p>
            <span class="od-strip" aria-hidden="true">
              {marks.band && <i class="od-band" style={`left:${marks.band[0] * 100}%;right:${(1 - marks.band[1]) * 100}%`}></i>}
              {marks.ticks.map((t) => <i class="od-tick" style={`left:${t * 100}%`}></i>)}
              <i class="od-head-line" data-day-head></i>
            </span>
            <span class="od-hours" aria-hidden="true"><span>12 AM</span><span>6 AM</span><span>12 PM</span><span>6 PM</span><span>12 AM</span></span>
            {shared && <p class="od-shared">The same scheduler job as {shared.a.name}</p>}
          </li>
        );
      })}
    </ul>
    <p class="od-events">The other {eventCount} wake when something happens, a form sent or a call ended, so they have no clock to replay.</p>
  </section>

  <div class="obs-hud" data-obs-hud aria-label="Clock">
    <svg viewBox="0 0 36 36" class="hud-dial" aria-hidden="true">
      <circle cx="18" cy="18" r="15" class="hud-track" />
      <circle cx="18" cy="18" r="15" class="hud-fill" data-hud-ring />
    </svg>
    <span class="hud-text">
      <span class="hud-where" data-hud-where>New York</span>
      <b data-hud-clock>--:--</b>
    </span>
    <button type="button" class="hud-btn" data-hud-play aria-label="Play a day of scheduled runs">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"></path></svg>
      <span data-hud-play-label>Play a day</span>
    </button>
  </div>

  <nav class="obs-rail" data-obs-rail aria-hidden="true">
    <ol>
      {order.map((a, i) => (
        <li data-rail={a.slug} class:list={{ "is-gap": i > 0 && order[i - 1].project !== a.project }}>
          <a href={`#w-${a.slug}`} tabindex="-1"><span>{a.name}</span></a>
        </li>
      ))}
    </ol>
  </nav>
</section>

<script type="application/json" id="obs-data" set:html={data} />

<script>
  import { onPage } from "../../../scripts/lifecycle";
  import { mountObservatory } from "../../../scripts/observatory/page";
  onPage("observatory", (signal) => mountObservatory(signal));
</script>

<style>
  .obs {
    --obs-rgb: var(--c-architecture-rgb);
    --obs: var(--c-architecture);
    --fail: #ff4d5e;
    --fail-rgb: 255, 77, 94;
    position: relative;
    isolation: isolate;
  }

  /* ------------------------------------------------------------- the sky */
  .obs-sky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100lvh;
    margin-bottom: -100vh;
    margin-bottom: -100lvh;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .obs-poster {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 66% 46%, rgba(var(--obs-rgb), 0.16), transparent 70%),
      radial-gradient(40% 36% at 74% 56%, rgba(120, 90, 255, 0.1), transparent 70%),
      radial-gradient(90% 70% at 50% 50%, rgba(10, 18, 34, 0.6), transparent 80%);
    transition: opacity 1.2s var(--ease-glass);
  }
  .obs-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    opacity: 0;
    transition: opacity 1.1s var(--ease-glass);
  }
  .obs.is-3d .obs-canvas { opacity: 1; }
  .obs.is-3d .obs-poster { opacity: 0; }
  .obs-labels { position: absolute; inset: 0; }

  /* Part labels drawn over the docked drawing. */
  .obs-labels :global(.pl) {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    max-width: 150px;
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.005em;
    text-align: center;
    color: var(--ink);
    text-shadow: 0 0 6px #000, 0 0 2px #000;
    white-space: nowrap;
    opacity: 0;
    will-change: transform, opacity;
  }
  .obs-labels :global(.pl small) { font-size: 0.59375rem; font-weight: 500; color: var(--ink-faint); }
  .obs-labels :global(.pl.is-mine small) { color: rgba(var(--obs-rgb), 0.9); }
  .obs-labels :global(.pl.is-fail) { color: #ffd3d8; }

  /* The eyepiece: a look at a world's picture when the pointer finds it. */
  .obs-eye {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    opacity: 0;
    transform: translate3d(-999px, 0, 0);
    transition: opacity 220ms var(--ease-glass);
  }
  .obs-eye.is-on { opacity: 1; }
  .eye-lens {
    position: relative;
    width: 132px;
    height: 132px;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid rgba(var(--obs-rgb), 0.7);
    box-shadow: 0 0 0 5px rgba(0, 0, 0, 0.55), 0 0 0 6px rgba(var(--obs-rgb), 0.25), 0 0 40px -6px rgba(var(--obs-rgb), 0.7);
    background: #05070c;
  }
  .eye-lens img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.5); }
  .eye-reticle {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(var(--obs-rgb), 0.5), rgba(var(--obs-rgb), 0.5)) center / 1px 22% no-repeat,
      linear-gradient(90deg, rgba(var(--obs-rgb), 0.5), rgba(var(--obs-rgb), 0.5)) center / 22% 1px no-repeat,
      radial-gradient(circle, transparent 58%, rgba(0, 0, 0, 0.55) 72%);
  }
  .eye-text { display: flex; flex-direction: column; gap: 4px; max-width: 200px; }
  .eye-text b { font-size: 1rem; font-weight: 600; letter-spacing: -0.02em; text-shadow: 0 0 10px #000; }
  .eye-text span { font-size: 0.75rem; color: var(--ink-soft); text-shadow: 0 0 8px #000; }

  /* A part's notes when the pointer rests on it. */
  .obs-tip {
    position: absolute;
    left: 0;
    top: 0;
    width: 260px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(6, 8, 13, 0.94);
    border: 1px solid var(--line-strong);
    box-shadow: 0 20px 40px -20px #000;
    opacity: 0;
    transform: translate3d(-999px, 0, 0);
    transition: opacity 160ms var(--ease-glass);
  }
  .obs-tip.is-on { opacity: 1; }
  .obs-tip p { margin: 0; }
  .tip-kind { font-size: 0.6875rem; color: rgba(var(--obs-rgb), 0.9); font-weight: 500; }
  .tip-name { font-size: 0.9375rem; font-weight: 600; letter-spacing: -0.015em; margin-top: 2px !important; }
  .tip-sub { font-size: 0.75rem; color: var(--ink-faint); margin-top: 1px !important; }
  .tip-fails { font-size: 0.75rem; line-height: 1.45; color: #ffc2c8; margin-top: 8px !important; padding-top: 8px; border-top: 1px solid rgba(var(--fail-rgb), 0.3); }
  .tip-fails:empty { display: none; }

  /* On phones: one caption for the part the light just reached. */
  .obs-wake {
    position: absolute;
    left: 50%;
    top: 0;
    margin: 0;
    padding: 5px 11px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink);
    background: rgba(4, 6, 10, 0.82);
    border: 1px solid rgba(var(--obs-rgb), 0.45);
    white-space: nowrap;
    opacity: 0;
    transform: translate3d(-50%, 0, 0);
    transition: opacity 200ms var(--ease-glass);
  }
  .obs-wake.is-on { opacity: 1; }

  /* ------------------------------------------------------------- the hero */
  .obs-hero {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: clamp(110px, 12vw, 150px);
    padding-bottom: 48px;
    pointer-events: none;
  }
  .obs-hero > * { pointer-events: auto; }
  .obs-title { max-width: 15ch; margin-top: 18px; }
  .obs-title .t-tail { max-width: 22ch; }
  .obs-totals {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    max-width: 560px;
    margin: 30px 0 24px;
    padding: 0;
    list-style: none;
  }
  .obs-totals li {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px 16px;
