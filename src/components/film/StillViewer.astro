---
// A calm viewer for film stills, shared by the filmmaking pages. Any button
// with data-still (and data-group, data-index, data-full, data-caption)
// opens it: arrows or a swipe move through its group, Escape or the
// backdrop closes it, focus stays inside while it is open and returns to
// the still that opened it.
---

<div id="flb" class="lb" hidden role="dialog" aria-modal="true" aria-label="Still viewer">
  <div class="lb-backdrop" data-lb-close></div>
  <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Close viewer">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
  </button>
  <figure class="lb-stage">
    <img id="flb-img" class="lb-img" alt="" />
    <figcaption class="lb-cap"><span id="flb-cap" class="t-small"></span></figcaption>
  </figure>
  <div class="lb-bar">
    <button type="button" class="lb-btn" data-lb-prev aria-label="Previous still">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
    </button>
    <span id="flb-count" class="t-meta lb-count" aria-live="polite"></span>
    <button type="button" class="lb-btn" data-lb-next aria-label="Next still">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </button>
  </div>
</div>

<script>
  import { onPage } from "../../scripts/lifecycle";

  onPage("film-still-viewer", (signal) => {
    const lb = document.getElementById("flb");
    const img = document.getElementById("flb-img") as HTMLImageElement | null;
    const cap = document.getElementById("flb-cap");
    const count = document.getElementById("flb-count");
    if (!lb || !img || !cap || !count) return;
    const html = document.documentElement;

    type Item = { src: string; caption: string; alt: string };
    let items: Item[] = [];
    let cursor = 0;
    let opener: HTMLElement | null = null;
    let hideTimer = 0;

    const collect = (group: string): Item[] =>
      Array.from(document.querySelectorAll<HTMLElement>(`[data-still][data-group="${group}"]`)).map((el) => ({
        src: el.dataset.full || "",
        caption: el.dataset.caption || "",
        alt: el.querySelector("img")?.getAttribute("alt") || "",
      }));
    const preload = (i: number) => {
      const it = items[i];
      if (it) new Image().src = it.src;
    };
    const render = () => {
      const it = items[cursor];
      if (!it) return;
      img.classList.remove("is-in");
      img.onload = () => img.classList.add("is-in");
      img.src = it.src;
      img.alt = it.alt;
      cap.textContent = it.caption;
      count.textContent = `${cursor + 1} / ${items.length}`;
      preload(cursor + 1);
      preload(cursor - 1);
    };
    const open = (el: HTMLElement) => {
      clearTimeout(hideTimer);
      opener = el;
      items = collect(el.dataset.group || "");
      cursor = Math.min(Math.max(Number(el.dataset.index || 0), 0), items.length - 1);
      lb.hidden = false;
      requestAnimationFrame(() => lb.classList.add("is-open"));
      html.classList.add("lb-lock");
      render();
      lb.querySelector<HTMLElement>(".lb-close")?.focus();
    };
    const close = () => {
      if (lb.hidden) return;
      lb.classList.remove("is-open");
      html.classList.remove("lb-lock");
      hideTimer = window.setTimeout(() => {
        lb.hidden = true;
      }, 220);
      opener?.focus();
    };
    const step = (delta: number) => {
      if (!items.length) return;
      cursor = (cursor + delta + items.length) % items.length;
      render();
    };

    document.addEventListener(
      "click",
      (e) => {
        const target = e.target as HTMLElement;
        const still = target.closest<HTMLElement>("[data-still]");
        if (still) {
          open(still);
          return;
        }
        if (target.closest("[data-lb-close]")) close();
        if (target.closest("[data-lb-prev]")) step(-1);
        if (target.closest("[data-lb-next]")) step(1);
      },
      { signal },
    );
    document.addEventListener(
      "keydown",
      (e) => {
        if (lb.hidden) return;
        if (e.key === "Escape") close();
        if (e.key === "ArrowLeft") step(-1);
        if (e.key === "ArrowRight") step(1);
        if (e.key === "Tab") {
          const stops = Array.from(lb.querySelectorAll<HTMLElement>("button"));
          const at = stops.indexOf(document.activeElement as HTMLElement);
          e.preventDefault();
          stops[(at + (e.shiftKey ? -1 : 1) + stops.length) % stops.length]?.focus();
        }
      },
      { signal },
    );
    let touchX: number | null = null;
    lb.addEventListener("touchstart", (e) => (touchX = e.touches[0]?.clientX ?? null), { passive: true, signal });
    lb.addEventListener(
      "touchend",
      (e) => {
        if (touchX === null) return;
        const dx = (e.changedTouches[0]?.clientX ?? touchX) - touchX;
        if (Math.abs(dx) > 48) step(dx < 0 ? 1 : -1);
        touchX = null;
      },
      { passive: true, signal },
    );

    return () => {
      clearTimeout(hideTimer);
      lb.hidden = true;
      lb.classList.remove("is-open");
      html.classList.remove("lb-lock");
    };
  });
</script>

<style>
  :global(html.lb-lock), :global(html.lb-lock body) { overflow: hidden; }
  .lb {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 72px 16px 104px;
    opacity: 0;
    transition: opacity 220ms var(--ease-glass);
  }
  .lb[hidden] { display: none; }
  .lb.is-open { opacity: 1; }
  .lb-backdrop { position: absolute; inset: 0; background: rgba(3, 0, 1, 0.94); }
  .lb-stage {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: min(1400px, 100%);
    max-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    pointer-events: none;
  }
  .lb-img {
    max-width: 100%;
    max-height: calc(100svh - 220px);
    object-fit: contain;
    border-radius: 6px;
    box-shadow: 0 0 0 1px var(--line), 0 40px 120px -40px rgba(244, 63, 94, 0.5);
    opacity: 0;
    transform: scale(0.985);
    transition: opacity 280ms var(--ease-glass), transform 280ms var(--ease-glass);
    pointer-events: auto;
  }
  .lb-img.is-in { opacity: 1; transform: none; }
  .lb-cap { pointer-events: auto; text-align: center; }
  .lb-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    color: var(--ink);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: background-color 150ms var(--ease-glass);
  }
  .lb-btn:hover { background: var(--wash-strong); }
  .lb-btn:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(244, 63, 94, 0.6); }
  .lb-close { position: absolute; top: 16px; right: 16px; z-index: 2; background: rgba(20, 10, 13, 0.92); border: 1px solid var(--line-strong); }
  .lb-bar {
    position: absolute;
    left: 50%;
    bottom: 28px;
    z-index: 2;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px;
    border-radius: 9999px;
    background: rgba(20, 10, 13, 0.92);
    border: 1px solid var(--line-strong);
  }
  .lb-count { min-width: 64px; text-align: center; }
  @media (prefers-reduced-motion: reduce) {
    .lb, .lb-img { transition: none; }
  }
</style>
