---
// Full-page universe backdrop, hand-written WebGL (no dependencies), on
// every page via BaseLayout. Three systems share one canvas:
//  - Nebula (desktop): a faint fbm-noise gas layer tinted by the section
//    theme, drifting slowly and sliding with the camera.
//  - Stars: ~1400 soft gaussian points at many depths. Each star is born,
//    drifts, twinkles, fades out, and respawns somewhere new. Scrolling
//    flies the camera forward; fast scrolling streaks the stars radially
//    like accelerating through space.
// All colours come from the section theme: the ambient field writes
// --amb1/--amb2 as it lerps on scroll and the shaders tint from the same
// values. Off under reduced motion and when WebGL is unavailable.
//
// The drawing lives in src/scripts/spacefield-gl.ts and runs in a worker on
// an OffscreenCanvas, so starting WebGL and drawing each frame never use the
// page's main thread. Browsers without OffscreenCanvas draw here instead.
//
// One sky for the whole visit: the canvas persists across client side
// navigation (transition:persist) and the script below runs once. On a page
// swap the camera keeps the distance it has flown, so the new page's scroll
// position and the loader's arrival add on instead of flying it back.
---

<canvas class="spacefield" data-spacefield aria-hidden="true" transition:persist="spacefield"></canvas>

<style>
  .spacefield {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    /* On phones the address bar folds away as you scroll. Sized to the
       viewport with the bar gone, the canvas keeps one size either way, so
       the sky never has to rebuild in the middle of a scroll. */
    height: 100lvh;
    bottom: auto;
    z-index: -1; /* above the body background, below all content */
    pointer-events: none;
    opacity: 0;
  }
  :global(html.spacefield-on) .spacefield { opacity: 1; transition: opacity 0.9s ease-out; }
</style>

<script>
  import SkyWorker from "../../scripts/spacefield.worker.ts?worker";
  import { createSky, type SkyInput } from "../../scripts/spacefield-gl";

  (function () {
    const canvas = document.querySelector<HTMLCanvasElement>("[data-spacefield]");
    // Once a visit: the canvas persists, and it can only be handed over once.
    if (!canvas || canvas.dataset.sky) return;
    canvas.dataset.sky = "1";
    const cv: HTMLCanvasElement = canvas;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const isMobile = window.matchMedia("(max-width: 1023px)").matches;

    // What the sky needs from the page.
    const ambientEl = document.querySelector<HTMLElement>("[data-ambient]");
    const parseRgb = (s: string, fb: number[]) => {
      const p = (s || "").split(",").map(Number);
      return p.length === 3 && p.every((n) => !isNaN(n)) ? p.map((n) => n / 255) : fb;
    };
    const colours = () => ({
      th1: parseRgb(ambientEl?.style.getPropertyValue("--amb1") ?? "", [0.36, 0.55, 0.94]),
      th2: parseRgb(ambientEl?.style.getPropertyValue("--amb2") ?? "", [0.2, 0.83, 0.6]),
    });
    // The loader (WarpLoader) stamps when it hands over, on this page's clock.
    const w = window as Window & { __warpArrive?: number };
    const arrival = () => (w.__warpArrive ? performance.timeOrigin + w.__warpArrive : null);
    const input: SkyInput = { scrollY: window.scrollY, ...colours(), arrivedAt: arrival() };
    const size = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      return { w: Math.floor(cv.clientWidth * dpr), h: Math.floor(cv.clientHeight * dpr), dpr };
    };
    const on = () => document.documentElement.classList.add("spacefield-on");

    // Keep the sky told: scroll, colour changes, the loader's hand over,
    // size and visibility. `send` is wired to the worker or to this thread.
    let send: (m: Record<string, unknown>) => void = () => {};
    const update = (part: Partial<SkyInput>) => {
      Object.assign(input, part);
      send({ type: "input", input: part });
    };
    window.addEventListener("scroll", () => update({ scrollY: window.scrollY }), { passive: true });
    if (ambientEl) new MutationObserver(() => update(colours())).observe(ambientEl, { attributes: true, attributeFilter: ["style"] });
    // The loader hands over on the first page and again after every move to
    // another page. Each arrival coasts the camera forward; the coast of the
    // one before is kept as distance travelled, so a new one never pulls back.
    const coastNow = () => {
      if (!input.arrivedAt) return 0;
      const p = Math.min(1, (performance.timeOrigin + performance.now() - input.arrivedAt) / 1800);
      return 7 * (1 - Math.pow(1 - p, 3));
    };
    let stamp = w.__warpArrive;
    Object.defineProperty(w, "__warpArrive", {
      configurable: true,
      get: () => stamp,
      set: (v: number) => {
        const travel = (input.travel || 0) + coastNow();
        stamp = v;
        update({ travel, arrivedAt: arrival() });
      },
    });
    // A page swap: the router scrolls the new page to its top (or where it
    // was left). Fold the old page's scroll into the distance travelled.
    let leftAt = window.scrollY;
    document.addEventListener("astro:before-swap", () => {
      leftAt = window.scrollY;
    });
    document.addEventListener("astro:after-swap", () => {
      const y = window.scrollY;
      update({ travel: (input.travel || 0) + (leftAt - y) * 0.006, scrollY: y });
    });
    // Phones fire resize as the address bar comes and goes. Resizing a canvas
    // clears it, so only pass on a real change of size.
    const key = (s: { w: number; h: number; dpr: number }) => `${s.w}x${s.h}@${s.dpr}`;
    let sized = key(size());
    window.addEventListener(
      "resize",
      () => {
        const s = size();
        if (key(s) === sized) return;
        sized = key(s);
        send({ type: "resize", ...s });
      },
      { passive: true },
    );
    // Rest while the tab is hidden, or while an opaque world covers this sky
    // (the home flight, the Projects system, the Work station): two scenes
    // drawing at once would only cost phones their frame rate.
    const COVERED = ["in-journey", "in-pw", "in-ww"];
    let told: boolean | null = null;
    const tellHidden = () => {
      const root = document.documentElement.classList;
      const hide = document.hidden || COVERED.some((c) => root.contains(c));
      if (hide === told) return;
      told = hide;
      send({ type: "hidden", hidden: hide });
    };
    document.addEventListener("visibilitychange", tellHidden);
    new MutationObserver(tellHidden).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

    // Either way the sky starts after the page's first paint: compiling the
    // shaders keeps the browser's graphics process busy, and that process
    // also puts the page on screen.
    const later = (window as Window & { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => number }).requestIdleCallback;
    const afterPaint = (cb: () => void) => (later ? later(cb, { timeout: 600 }) : setTimeout(cb, 120));

    if ("transferControlToOffscreen" in cv && typeof Worker !== "undefined") {
      afterPaint(() => {
        const off = cv.transferControlToOffscreen();
        const worker = new SkyWorker();
        worker.onmessage = (e: MessageEvent<{ type: string }>) => {
          if (e.data.type === "ready") on();
          else if (e.data.type === "fail") worker.terminate();
        };
        send = (m) => worker.postMessage(m);
        worker.postMessage({ type: "init", canvas: off, isMobile, ...size(), input }, [off]);
        told = null;
        tellHidden();
      });
      return;
    }

    // No OffscreenCanvas: draw on this thread.
    const start = () => {
      const sky = createSky(cv, isMobile);
      if (!sky) return;
      let hidden = document.hidden;
      const resize = () => {
        const s = size();
        sky.resize(s.w, s.h, s.dpr);
      };
      resize();
      send = (m) => {
        if (m.type === "resize") resize();
        else if (m.type === "hidden") hidden = !!m.hidden;
      };
      told = null;
      tellHidden();
      sky.whenReady((ok) => {
        if (!ok) return;
        on();
        (function frame() {
          requestAnimationFrame(frame);
          if (!hidden) sky.frame(input);
        })();
      }, (cb) => requestAnimationFrame(cb));
    };
    afterPaint(start);
  })();
</script>
