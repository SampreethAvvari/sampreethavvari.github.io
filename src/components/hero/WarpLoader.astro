---
// Page loader: a jump to light speed. Stars stream out from the center like
// the scroll warp in SpaceField, comets in the tab's colour cut across, and a
// small "loading" sits in the middle. It covers the first paint of a visit
// and comes back up for every move to another page (Astro's client side
// router), so moving between pages reads as one trip.
//
// Arrival: the streaks slow back into points and the loader drops behind the
// page, so the stars you flew through become the sky, while SpaceField coasts
// out of its own warp. The page itself flies in from deep space toward the
// viewer. Plain 2D canvas and inline script, so it runs before the rest of
// the body has parsed. Under reduced motion it is a quick fade on the first
// page and stays down after that.
//
// The loader persists across navigation (transition:persist) and its script
// runs once a visit: it is the same text on every page, so the router does
// not run it again, and it checks a flag besides. Each page's palette rides
// on data attributes, read when that page arrives.
//
// Between tabs the colour travels too. Leaving starts the stars, comets and
// glow blending toward the next tab's colour and leaves a note of where the
// blend began; the next page finishes the same blend on the same clock, and
// its sky and accents follow (src/scripts/toneTween.ts).
interface Props {
  // "r,g,b" strings. The first is the tab's colour; home passes every tab.
  palette: string[];
  // First path segment to that tab's "r,g,b"; "" is home.
  toneMap: Record<string, string>;
}
const { palette, toneMap } = Astro.props;
const rgb = palette[0];
const rgb2 = palette[1] ?? palette[0];
---

<!-- In the page itself, not a stylesheet: the loader has to paint before any
     stylesheet has arrived. The site's stylesheets sit right after it in the
     body (BaseLayout, scripts/late-css.mjs). -->
<style is:inline>
  .warp {
    position: fixed;
    inset: 0;
    z-index: 2147483000; /* over the nav, chat and everything else */
    display: grid;
    place-items: center;
  }
  .warp[hidden] { display: none; }
  /* While the page under the loader is still parsing, the browser lays out what
     it has so far again and again, and on a phone that is most of the wait. It
     skips the work until the last tag has arrived (BaseLayout), or this script
     gives up on it. */
  html.parsing main { content-visibility: hidden; }
  html.parsing .site-foot, html.parsing .page-comets { display: none; }
  /* Should this file's own script never run, the loader still lets go. The
     script cancels this as its first act. */
  .warp:not(.is-run) { animation: warp-letgo 0.4s ease 7s forwards; }
  @keyframes warp-letgo { to { opacity: 0; visibility: hidden; } }
  .warp-sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(34% 30% at 50% 50%, rgba(var(--warp-rgb), 0.14) 0%, rgba(var(--warp-rgb), 0.1366) 7.2%, rgba(var(--warp-rgb), 0.1266) 14.4%, rgba(var(--warp-rgb), 0.1111) 21.6%, rgba(var(--warp-rgb), 0.0916) 28.8%, rgba(var(--warp-rgb), 0.07) 36%, rgba(var(--warp-rgb), 0.0484) 43.2%, rgba(var(--warp-rgb), 0.0289) 50.4%, rgba(var(--warp-rgb), 0.0134) 57.6%, rgba(var(--warp-rgb), 0.0034) 64.8%, rgba(var(--warp-rgb), 0) 72%),
      radial-gradient(70% 60% at 18% 22%, rgba(var(--warp-rgb), 0.12) 0%, rgba(var(--warp-rgb), 0.1171) 7%, rgba(var(--warp-rgb), 0.1085) 14%, rgba(var(--warp-rgb), 0.0953) 21%, rgba(var(--warp-rgb), 0.0785) 28%, rgba(var(--warp-rgb), 0.06) 35%, rgba(var(--warp-rgb), 0.0415) 42%, rgba(var(--warp-rgb), 0.0247) 49%, rgba(var(--warp-rgb), 0.0115) 56%, rgba(var(--warp-rgb), 0.0029) 63%, rgba(var(--warp-rgb), 0) 70%),
      radial-gradient(60% 55% at 84% 72%, rgba(var(--warp-rgb2), 0.1) 0%, rgba(var(--warp-rgb2), 0.0976) 7%, rgba(var(--warp-rgb2), 0.0905) 14%, rgba(var(--warp-rgb2), 0.0794) 21%, rgba(var(--warp-rgb2), 0.0655) 28%, rgba(var(--warp-rgb2), 0.05) 35%, rgba(var(--warp-rgb2), 0.0345) 42%, rgba(var(--warp-rgb2), 0.0206) 49%, rgba(var(--warp-rgb2), 0.0095) 56%, rgba(var(--warp-rgb2), 0.0024) 63%, rgba(var(--warp-rgb2), 0) 70%),
      #000;
    transition: opacity 1s ease;
  }
  .warp-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* The slowed stars hang on as the sky for a moment before handing over. */
    transition: opacity 1.5s ease 0.45s;
  }

  /* The sound choice: one quiet line, two small pills, a whisper of a hint. */
  .warp-gate {
    position: absolute;
    left: 50%;
    top: calc(50% + 40px);
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 12px;
    width: max-content;
    max-width: calc(100vw - 32px);
    font-family: "Inter", "Inter Fallback", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    pointer-events: auto;
    animation: warp-gate-in 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .warp-gate[hidden] { display: none; }
  .warp.is-gate .warp-label { opacity: 0; transform: translateY(-6px); }
  .warp-gate-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .warp-gate-wave { display: inline-flex; align-items: center; gap: 1.5px; height: 10px; }
  .warp-gate-wave i {
    width: 1.5px;
    height: 100%;
    border-radius: 2px;
    background: rgb(var(--warp-rgb));
    transform-origin: center;
    animation: warp-gate-bar 1.2s ease-in-out infinite;
  }
  .warp-gate-wave i:nth-child(2) { animation-delay: -0.2s; }
  .warp-gate-wave i:nth-child(3) { animation-delay: -0.45s; }
  .warp-gate-wave i:nth-child(4) { animation-delay: -0.7s; }
  .warp-gate-wave i:nth-child(5) { animation-delay: -0.9s; }
  .warp-gate-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 6px; }
  .warp-gate-btn {
    position: relative;
    height: 32px;
    padding: 0 15px;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    font: inherit;
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1), background-color 200ms ease, border-color 200ms ease, box-shadow 240ms ease, color 200ms ease;
    -webkit-tap-highlight-color: transparent;
  }
  .warp-gate-btn:hover { border-color: rgba(255, 255, 255, 0.32); background: rgba(255, 255, 255, 0.08); }
  .warp-gate-btn:active { transform: scale(0.95); transition-duration: 80ms; }
  .warp-gate-btn.is-on {
    color: #05070c;
    border-color: transparent;
    background: linear-gradient(180deg, #fff, rgba(var(--warp-rgb), 0.92));
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.4) inset, 0 6px 22px -8px rgba(var(--warp-rgb), 0.95);
  }
  .warp-gate-btn.is-on:hover { box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.5) inset, 0 8px 28px -6px rgba(var(--warp-rgb), 1); }
  .warp-gate-btn.is-quiet { border-color: transparent; background: transparent; color: rgba(255, 255, 255, 0.55); }
  .warp-gate-btn.is-quiet:hover { color: #fff; background: rgba(255, 255, 255, 0.06); }
  .warp-gate-btn:focus-visible { outline: 1.5px solid rgb(var(--warp-rgb)); outline-offset: 3px; }
  /* the pressed pill gives a short light pulse before the jump */
  .warp-gate-btn.is-picked { animation: warp-gate-pick 420ms cubic-bezier(0.16, 1, 0.3, 1); }
  .warp-gate-hint { margin: 0; font-size: 10.5px; color: rgba(255, 255, 255, 0.32); letter-spacing: 0.01em; }
  .warp.is-done .warp-gate { opacity: 0; transform: translate(-50%, -6px); transition: opacity 0.35s ease, transform 0.35s ease; pointer-events: none; }
  @keyframes warp-gate-in { from { opacity: 0; transform: translate(-50%, 8px); filter: blur(6px); } to { opacity: 1; transform: translate(-50%, 0); filter: none; } }
  @keyframes warp-gate-bar { 0%, 100% { transform: scaleY(0.3); } 50% { transform: scaleY(1); } }
  @keyframes warp-gate-pick { 0% { box-shadow: 0 0 0 0 rgba(var(--warp-rgb), 0.7); } 100% { box-shadow: 0 0 0 14px rgba(var(--warp-rgb), 0); } }
  @media (prefers-reduced-motion: reduce) { .warp-gate, .warp-gate-wave i, .warp-gate-btn.is-picked { animation: none; } }

  /* Arrival: behind the page, the backdrop goes and the stars settle out. */
  .warp.is-done { z-index: -1; pointer-events: none; }
  .warp.is-done .warp-sky,
  .warp.is-done .warp-canvas { opacity: 0; }
  .warp.is-done .warp-label { opacity: 0; transform: translateY(-4px); }
  /* Coming back up on a link click: fast, so the next page is not kept waiting. */
  .warp.is-quick .warp-sky,
  .warp.is-quick .warp-canvas,
  .warp.is-quick .warp-label { transition-duration: 0.16s; transition-delay: 0s; }

  .warp-label {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  /* Held back until Inter has loaded, so it never shows in a fallback face. */
  .warp.is-font-wait .warp-label { opacity: 0; }
  /* A soft dark pool so the word stays readable over passing streaks. */
  .warp-label::before {
    content: "";
    position: absolute;
    inset: -34px -70px;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.6), transparent);
  }

  /* Set like the site's kicker: Inter 500, the tab's dot. */
  .warp-text {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: "Inter", "Inter Fallback", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1;
  }
  .warp-text::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: rgb(var(--warp-rgb));
    box-shadow: 0 0 12px rgba(var(--warp-rgb), 0.7);
    animation: warp-dot 1.25s ease-in-out infinite;
  }
  /* The word lives in CSS so it never ends up in the page's text. A bright
     copy sweeps across it through a soft window half the word wide. The
     window slides one way and the copy inside slides back by the same
     amount, so the copy holds still under the light. Both are transforms,
     so the shimmer keeps going while the page is busy loading. */
  .warp-word {
    position: relative;
    display: inline-block;
  }
  .warp-word::before {
    content: "loading";
    color: rgba(255, 255, 255, 0.5);
  }
  .warp-shine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 50%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 50%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 50%, transparent);
    animation: warp-sweep 1.9s linear infinite;
  }
  .warp-shine::before {
    content: "loading";
    position: absolute;
    top: 0;
    left: 0;
    color: #fff;
    white-space: nowrap;
    animation: warp-sweep-back 1.9s linear infinite;
  }
  @keyframes warp-dot {
    0%, 100% { transform: scale(0.8); opacity: 0.6; }
    50% { transform: scale(1.15); opacity: 1; }
  }
  @keyframes warp-sweep {
    from { transform: translateX(-100%); }
    to { transform: translateX(200%); }
  }
  @keyframes warp-sweep-back {
    from { transform: translateX(50%); }
    to { transform: translateX(-100%); }
  }

  .warp-bar {
    position: relative;
    width: 76px;
    height: 1px;
    overflow: hidden;
    border-radius: 1px;
    background: rgba(255, 255, 255, 0.1);
  }
  .warp-bar::after {
    content: "";
    position: absolute;
    inset: 0;
    width: 42%;
    background: linear-gradient(90deg, transparent, rgba(var(--warp-rgb), 1), transparent);
    animation: warp-scan 1.25s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  @keyframes warp-scan {
    from { transform: translateX(-100%); }
    to { transform: translateX(240%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .warp-canvas { display: none; }
    .warp-text::before, .warp-bar::after { animation: none; }
    .warp-shine { display: none; }
  }
  @media print {
    .warp { display: none; }
  }
</style>

<div
  id="warp"
  class="warp"
  style={`--warp-rgb:${rgb};--warp-rgb2:${rgb2};`}
  aria-hidden="true"
  data-palette={JSON.stringify(palette)}
  data-tones={JSON.stringify(toneMap)}
  transition:persist="warp"
>
  <div class="warp-sky"></div>
  <canvas class="warp-canvas"></canvas>
  <div class="warp-label">
    <span class="warp-text"><span class="warp-word"><span class="warp-shine"></span></span></span>
    <span class="warp-bar"></span>
  </div>
  <!-- Once a visit, the jump ends on a choice: sound or silence. -->
  <div class="warp-gate" hidden>
    <p class="warp-gate-kicker"><span class="warp-gate-wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>This site has a score in eight movements</p>
    <div class="warp-gate-actions">
      <button type="button" class="warp-gate-btn is-on" data-sound-choice="on">Enter with sound</button>
      <button type="button" class="warp-gate-btn is-quiet" data-sound-choice="off">Without sound</button>
    </div>
    <p class="warp-gate-hint">Spatial sound, best on headphones · change it or read about it in the top bar</p>
  </div>
</div>
<noscript><style>#warp { display: none !important; }</style></noscript>

<script is:inline>
  // The jump itself: stars streaking toward the viewer and comets crossing.
  // Self contained, so it can run in a worker on an OffscreenCanvas, where a
  // phone busy laying out the page underneath cannot stall it, or on the
  // page's own thread where workers cannot draw. `pal` is the colour blend:
  // where it starts (`base`), where it is heading (`to`), and since when.
  function warpSky(canvas, mobile, pal) {
    var ctx = canvas.getContext("2d");
    if (!ctx) return null;
    var raf = self.requestAnimationFrame
      ? self.requestAnimationFrame.bind(self)
      : function (cb) { return setTimeout(function () { cb(performance.now()); }, 16); };
    var caf = self.cancelAnimationFrame ? self.cancelAnimationFrame.bind(self) : clearTimeout;
    var BLEND = 1400;
    var base = pal.base, toPal = pal.to, mixed = pal.to.slice(), blendAt = pal.at, blending = pal.on;
    function rgbMix(a, b, t) {
      var A = a.split(","), B = b.split(",");
      return [0, 1, 2].map(function (k) { return Math.round(+A[k] + (B[k] - A[k]) * t); }).join(",");
    }
    function blendNow() {
      if (!blending) return;
      var t = Math.min(1, Math.max(0, (Date.now() - blendAt) / BLEND));
      t = t * t * (3 - 2 * t);
      for (var i = 0; i < toPal.length; i++) mixed[i] = rgbMix(base[i % base.length], toPal[i], t);
      if (t >= 1) blending = false;
    }
    blendNow();

    var N = mobile ? 260 : 600;
    var W = 0, H = 0, R = 0;
    var stars = [], comets = [];
    // Camera speed in depth units per second. It eases toward the target, so
    // the jump starts at cruise and builds to warp.
    var v = 0.22, vTarget = 0.95;
    var loop = 0, last = 0, nextComet = 0, leaving = false;

    function size(w, h, dpr) {
      W = w;
      H = h;
      R = Math.max(W, H) * 0.5;
      canvas.width = Math.floor(W * dpr);
      canvas.height = Math.floor(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    // A colour slot: an index into the palette, read through `mixed`.
    function pick() {
      return (Math.random() * 997) | 0;
    }
    function col(ci) {
      return ci < 0 ? "236,241,255" : mixed[ci % mixed.length];
    }
    // A star sits at (x, y) on a plane z deep; the camera flies toward it.
    function star(s, far) {
      s.x = Math.random() * 2 - 1;
      s.y = Math.random() * 2 - 1;
      s.z = far ? 1 : 0.08 + Math.random() * 0.92;
      s.c = Math.random() < 0.35 ? pick() : -1;
      return s;
    }
    // A comet crosses through a random point in view. `back` is how far
    // behind that point it starts: 1 is off screen, small values put it
    // already in flight so even a short load shows comets passing.
    function comet(back) {
      var a = Math.random() * Math.PI * 2;
      var dx = Math.cos(a), dy = Math.sin(a);
      var reach = Math.sqrt(W * W + H * H) * 0.62;
      var px = W * (0.12 + Math.random() * 0.76);
      var py = H * (0.12 + Math.random() * 0.76);
      comets.push({
        x: px - dx * reach * back,
        y: py - dy * reach * back,
        dx: dx,
        dy: dy,
        sp: (mobile ? 520 : 760) + Math.random() * 760,
        len: (mobile ? 100 : 150) + Math.random() * 220,
        w: 1.1 + Math.random() * 1.3,
        c: pick(),
        d: 0,
        age: 0,
        max: reach * (1 + back) + 400,
      });
    }

    function frame(now) {
      loop = raf(frame);
      var dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      blendNow();
      v += (vTarget - v) * Math.min(1, dt * 2.4);
      var cx = W / 2, cy = H / 2;

      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = "lighter";
      ctx.lineCap = "round";

      // Stars: each draws a streak from where it was a moment ago, so the
      // trails lengthen as the speed builds and shrink to points as it drops.
      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        s.z -= v * dt;
        if (s.z <= 0.03) { star(s, true); continue; }
        var x1 = cx + (s.x / s.z) * R, y1 = cy + (s.y / s.z) * R;
        if (x1 < -60 || x1 > W + 60 || y1 < -60 || y1 > H + 60) { star(s, true); continue; }
        var tz = Math.min(1, s.z + 0.006 + v * 0.075);
        var x0 = cx + (s.x / tz) * R, y0 = cy + (s.y / tz) * R;
        var k = 1 - s.z;
        ctx.strokeStyle = "rgba(" + col(s.c) + "," + Math.min(1, 0.04 + k * k * 1.1).toFixed(3) + ")";
        ctx.lineWidth = 0.5 + k * k * 2.4;
        ctx.beginPath();
        ctx.moveTo(x0, y0);
        ctx.lineTo(x1, y1);
        ctx.stroke();
      }

      // Comets: a soft wide tail, a bright core tail, and a glowing head.
      for (var j = comets.length - 1; j >= 0; j--) {
        var c = comets[j];
        var step = c.sp * dt * (0.7 + v * 0.35);
        c.x += c.dx * step;
        c.y += c.dy * step;
        c.d += step;
        c.age += dt;
        if (c.d > c.max) { comets.splice(j, 1); continue; }
        var tx = c.x - c.dx * c.len, ty = c.y - c.dy * c.len;
        var cc = col(c.c);
        // Fade in, so one born in view does not pop.
        ctx.globalAlpha = Math.min(1, c.age / 0.15);

        var glow = ctx.createLinearGradient(tx, ty, c.x, c.y);
        glow.addColorStop(0, "rgba(" + cc + ",0)");
        glow.addColorStop(1, "rgba(" + cc + ",0.16)");
        ctx.strokeStyle = glow;
        ctx.lineWidth = c.w * 7;
        ctx.beginPath();
        ctx.moveTo(tx, ty);
        ctx.lineTo(c.x, c.y);
        ctx.stroke();

        var tail = ctx.createLinearGradient(tx, ty, c.x, c.y);
        tail.addColorStop(0, "rgba(" + cc + ",0)");
        tail.addColorStop(0.72, "rgba(" + cc + ",0.5)");
        tail.addColorStop(1, "rgba(255,255,255,0.95)");
        ctx.strokeStyle = tail;
        ctx.lineWidth = c.w;
        ctx.beginPath();
        ctx.moveTo(tx, ty);
        ctx.lineTo(c.x, c.y);
        ctx.stroke();

        var r = 11 * c.w;
        var head = ctx.createRadialGradient(c.x, c.y, 0, c.x, c.y, r);
        head.addColorStop(0, "rgba(255,255,255,0.95)");
        head.addColorStop(0.2, "rgba(" + cc + ",0.6)");
        head.addColorStop(1, "rgba(" + cc + ",0)");
        ctx.fillStyle = head;
        ctx.beginPath();
        ctx.arc(c.x, c.y, r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (!leaving && now > nextComet && comets.length < (mobile ? 4 : 7)) {
        comet(1);
        nextComet = now + 160 + Math.random() * 460;
      }
      ctx.globalCompositeOperation = "source-over";
    }

    function start() {
      if (!stars.length) for (var i = 0; i < N; i++) stars.push(star({}, false));
      for (var k = 0; k < (mobile ? 2 : 3); k++) comet(0.1 + Math.random() * 0.45);
      last = performance.now();
      nextComet = last + 220;
      if (!loop) loop = raf(frame);
    }

    return {
      size: size,
      start: start,
      // The jump ends: the streaks shrink back to points and stay as the sky.
      leave: function () {
        leaving = true;
        vTarget = 0;
      },
      // Leaving for another page: back up to speed, blending toward its colour.
      enter: function (from, to, at) {
        base = from;
        toPal = to;
        mixed = [mixed[0]];
        blendAt = at;
        blending = true;
        leaving = false;
        v = 0.45;
        vTarget = 1.1;
        start();
      },
      // The next page has arrived: the blend, on the same clock, now ends on
      // that page's whole palette.
      aim: function (to) {
        toPal = to;
        blending = true;
      },
      stop: function () {
        caf(loop);
        loop = 0;
        comets.length = 0;
      },
    };
  }

  // The worker's side: build the sky on the canvas it is handed, then pass
  // each call from the page on to it.
  function warpWorker() {
    var sky = null;
    onmessage = function (e) {
      var m = e.data;
      if (m.type === "init") {
        sky = warpSky(m.canvas, m.mobile, m.pal);
        if (sky) {
          sky.size.apply(null, m.dims);
          sky.start();
        }
      } else if (sky) sky[m.type].apply(null, m.args || []);
    };
  }

  (function () {
    var root = document.getElementById("warp");
    // Once a visit: the loader persists across pages, and so does this.
    if (!root || window.__warpLoader) return;
    window.__warpLoader = true;
    root.classList.add("is-run");
    document.documentElement.classList.add("parsing");
    var palette, toneMap;
    try {
      palette = JSON.parse(root.getAttribute("data-palette") || "[]");
      toneMap = JSON.parse(root.getAttribute("data-tones") || "{}");
    } catch (e) {
      palette = [];
      toneMap = {};
    }
    if (!palette.length) palette = ["91,141,239"];
    var canvas = root.querySelector("canvas");
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var mobile = window.matchMedia("(max-width: 767px)").matches;

    // Show the word only once Inter is ready (cached after the first page).
    if (document.fonts && document.fonts.load) {
      root.classList.add("is-font-wait");
      var showLabel = function () { root.classList.remove("is-font-wait"); };
      document.fonts.load('500 13px "Inter"').then(showLabel, showLabel);
      setTimeout(showLabel, 700);
    }

    // The first page of a visit gets the full jump; later pages a short one.
    var first = true;
    try {
      first = !sessionStorage.getItem("warp-seen");
      sessionStorage.setItem("warp-seen", "1");
    } catch (e) {}
    var MIN = reduce ? 0 : first ? 1500 : 800;
    // Moving between pages, the jump holds at least this long, the same as a
    // later page used to hold after loading.
    var HOLD = 800;

    // The colour handoff. `base` is where the colours started, `toPal` where
    // they are heading, `mixed` what is drawn now. Stars and comets keep an
    // index into the palette, so they all shift together. The sky behind the
    // stars and the label follow the same blend here, on the same clock.
    var BLEND = 1400;
    var base = palette, toPal = palette, mixed = palette.slice(), blendAt = 0, blending = false;
    // A note from a full page load that started the blend (a page the router
    // could not take, or a reload mid trip).
    try {
      var note = JSON.parse(sessionStorage.getItem("warp-from") || "null");
      sessionStorage.removeItem("warp-from");
      if (note && note.pal && note.pal.length && Date.now() - note.at < 5000) {
        base = note.pal;
        blendAt = note.at;
        blending = true;
      }
    } catch (e) {}
    window.__warpFrom = blending ? { pal: base, at: blendAt, dur: BLEND } : null;
    function rgbMix(a, b, t) {
      var A = a.split(","), B = b.split(",");
      return [0, 1, 2].map(function (k) { return Math.round(+A[k] + (B[k] - A[k]) * t); }).join(",");
    }
    function blendNow() {
      if (!blending) return;
      var t = Math.min(1, Math.max(0, (Date.now() - blendAt) / BLEND));
      t = t * t * (3 - 2 * t);
      for (var i = 0; i < toPal.length; i++) mixed[i] = rgbMix(base[i % base.length], toPal[i], t);
      root.style.setProperty("--warp-rgb", mixed[0]);
      root.style.setProperty("--warp-rgb2", mixed[1 % mixed.length]);
      if (t >= 1) blending = false;
    }
    var tinting = false;
    function tint() {
      tinting = false;
      blendNow();
      if (blending) {
        tinting = true;
        requestAnimationFrame(tint);
      }
    }
    function tintOn() {
      if (!tinting) tint();
    }
    tint();
    var MAX = 3500; // never hold the first page longer than this
    // Once the page's own scripts have run, only this much longer for its images.
    var GRACE = 500;
    var t0 = performance.now();

    // The sky draws in a worker when the browser can hand a canvas to one,
    // and on this thread otherwise. `call` reaches it either way.
    var sky = null, worker = null, running = false, leaving = false;
    // Bumped on every trip to another page, so timers from an earlier trip
    // are ignored. `away` is set while a trip waits for its page.
    var trip = 0, away = false, enteredAt = 0;
    function call(name, args) {
      if (worker) worker.postMessage({ type: name, args: args });
      else if (sky) sky[name].apply(null, args || []);
    }
    function dims() {
      return [window.innerWidth, window.innerHeight, Math.min(window.devicePixelRatio || 1, 1.5)];
    }
    if (!reduce && canvas && canvas.getContext) {
      var pal = { base: base, to: toPal, at: blendAt, on: blending };
      if (canvas.transferControlToOffscreen && window.Worker && window.Blob && window.URL) {
        try {
          var src = "var warpSky = " + warpSky + ";\n(" + warpWorker + ")();";
          var w = new Worker(URL.createObjectURL(new Blob([src], { type: "text/javascript" })));
          var off = canvas.transferControlToOffscreen();
          w.postMessage({ type: "init", canvas: off, mobile: mobile, pal: pal, dims: dims() }, [off]);
          worker = w;
          running = true;
        } catch (e) {
          if (w) w.terminate();
        }
      }
      // No worker drawing, and the canvas is still ours: draw here.
      if (!worker) {
        try {
          sky = warpSky(canvas, mobile, pal);
        } catch (e) {}
        if (sky) {
          sky.size.apply(null, dims());
          sky.start();
          running = true;
        }
      }
    }

    // The page flies in from deep space in layers. Every visible block
    // (heading, paragraph, button, card, image) starts at its own depth and
    // lands on its own beat: nearest the middle first, the edges a little
    // after, the deepest travelling longest. They all share the middle of
    // the screen as the vanishing point, so it reads as one 3D scene.
    var ARRIVE_EASE = "cubic-bezier(0.16, 1, 0.3, 1)";
    var BLOCK = "h1,h2,h3,h4,h5,h6,p,a,button,img,picture,video,canvas,svg,figure,article,li,blockquote,pre,table,form,input,textarea,select";
    var CLEAR = /^(transparent|rgba\(0, 0, 0, 0\))$/;

    // A block moves as one piece when it is a known block, holds loose text
    // or inline children (those cannot be transformed alone), or paints its
    // own box, like a card, so its frame travels with its contents.
    function isBlock(el, cs, r, vw, vh) {
      if (!el.firstElementChild || el.matches(BLOCK)) return true;
      for (var n = el.firstChild; n; n = n.nextSibling) {
        if (n.nodeType === 3 && n.nodeValue.trim()) return true;
        if (n.nodeType === 1 && getComputedStyle(n).display === "inline") return true;
      }
      var paints =
        cs.backgroundImage !== "none" || !CLEAR.test(cs.backgroundColor) ||
        parseFloat(cs.borderTopWidth) > 0 || cs.boxShadow !== "none";
      // A whole section's backdrop stays put; its contents fly instead.
      return paints && r.width * r.height < vw * vh * 0.5;
    }
    function collect(el, out, vw, vh) {
      if (out.length > 90) return;
      var r = el.getBoundingClientRect();
      if (!r.width && !r.height) {
        // display: contents, like the React islands. Look inside.
        for (var c = el.firstElementChild; c; c = c.nextElementSibling) collect(c, out, vw, vh);
        return;
      }
      if (r.bottom < 0 || r.top > vh || r.right < 0 || r.left > vw) return;
      var cs = getComputedStyle(el);
      if (cs.visibility === "hidden") return;
      if (isBlock(el, cs, r, vw, vh)) { out.push([el, r]); return; }
      for (var k = el.firstElementChild; k; k = k.nextElementSibling) collect(k, out, vw, vh);
    }

    function flyIn() {
      if (reduce || !Element.prototype.animate) return;
      var vw = window.innerWidth, vh = window.innerHeight;
      var blocks = [];
      var main = document.querySelector("main");
      var foot = document.querySelector("footer.site-foot");
      if (main) collect(main, blocks, vw, vh);
      if (foot) collect(foot, blocks, vw, vh);
      [document.querySelector("header.nav"), document.querySelector(".chat-launcher")].forEach(function (el) {
        if (el) blocks.push([el, el.getBoundingClientRect()]);
      });
      // A very busy screen, or a browser without the translate and scale
      // properties, gets the page flying in as one sheet instead.
      if (blocks.length > 90 || !(window.CSS && CSS.supports("scale", "1"))) {
        blocks = main ? [[main, main.getBoundingClientRect()]] : [];
      }
      var cx = vw / 2, cy = vh / 2, far = Math.sqrt(cx * cx + cy * cy);
      blocks.forEach(function (b) {
        var el = b[0], r = b[1];
        var dx = r.left + r.width / 2 - cx, dy = r.top + r.height / 2 - cy;
        var out = Math.min(1, Math.sqrt(dx * dx + dy * dy) / far);
        var s = 0.3 + Math.random() * 0.36; // apparent size at the start: its depth
        var delay = 30 + out * 260 + Math.random() * 130;
        var dur = 1100 + (1 - s) * 650;
        // Seen from deep, a block shrinks toward the vanishing point. The
        // individual translate and scale properties stack on any transform
        // the block already has, and the single offset 0 keyframe ends on
        // the block's own values, so nothing jumps when it lands.
        el.animate(
          [{ offset: 0, translate: (-dx * (1 - s)).toFixed(1) + "px " + (-dy * (1 - s)).toFixed(1) + "px", scale: s.toFixed(3) }],
          { duration: dur, delay: delay, easing: ARRIVE_EASE, fill: "backwards" }
        );
        // Out of the haze faster than it travels, so it reads early. It
        // starts at 0.001, not 0: that looks the same, and a block at exactly
        // 0 counts as gone, so the browser would forget it had already
        // painted the page under the loader.
        el.animate(
          [{ offset: 0, opacity: 0.001, filter: "blur(" + (3 + (1 - s) * 9).toFixed(1) + "px)" }],
          { duration: dur * 0.5, delay: delay, easing: "cubic-bezier(0.3, 0.7, 0.4, 1)", fill: "backwards" }
        );
      });
    }

    // Once a visit the jump ends on the sound choice and waits for it.
    var gate = root.querySelector(".warp-gate");
    var gating = false;
    try { gating = first && !sessionStorage.getItem("sound-asked") && !!gate; } catch (e) { gating = false; }
    function choose(v) {
      try {
        sessionStorage.setItem("sound-asked", "1");
        localStorage.setItem("sound", v ? "on" : "off");
      } catch (e) {}
      // still inside the click, so the page's sound may start right away
      window.dispatchEvent(new CustomEvent("sound:set", { detail: v }));
      gating = false;
      root.setAttribute("aria-hidden", "true");
      leave(0);
    }
    // The choice has faded out with the loader; it never comes back up on
    // a later trip.
    function closeGate() {
      if (!gate || gate.hidden) return;
      gate.hidden = true;
      root.classList.remove("is-gate");
      root.removeAttribute("role");
      root.removeAttribute("aria-label");
    }
    function showGate() {
      if (!gate.hidden) return;
      gate.hidden = false;
      root.classList.add("is-gate");
      root.removeAttribute("aria-hidden");
      root.setAttribute("role", "dialog");
      root.setAttribute("aria-label", "Sound");
      gate.querySelectorAll("[data-sound-choice]").forEach(function (b) {
        b.addEventListener("click", function () {
          b.classList.add("is-picked");
          choose(b.getAttribute("data-sound-choice") === "on");
        });
      });
      var first_btn = gate.querySelector(".is-on");
      if (first_btn) first_btn.focus({ preventScroll: true });
      document.addEventListener("keydown", function esc(e) {
        if (e.key === "Escape" && gating) { document.removeEventListener("keydown", esc); choose(false); }
      });
    }

    function leave(id) {
      if (gating) return;
      if (leaving || id !== trip) return;
      leaving = true;
      away = false;
      // The jump ends: the streaks shrink back to points and stay as the sky.
      call("leave");
      root.classList.remove("is-quick");
      root.classList.add("is-done");
      // SpaceField reads this and coasts out of its own warp.
      window.__warpArrive = performance.now();
      flyIn();
      setTimeout(function () {
        if (!leaving) return;
        root.hidden = true;
        closeGate();
        call("stop");
        running = false;
      }, 2100);
    }

    // Leaving for another page: the warp comes back up and holds until the
    // next page is in and its scripts have started.
    function enter(url) {
      var id = ++trip;
      away = true;
      enteredAt = performance.now();
      // Start blending toward the next tab now. The page that arrives
      // finishes the same blend on the same clock (toneTween).
      var seg = url.pathname.split("/").filter(Boolean)[0] || "";
      var dest = toneMap[seg] || toneMap[""];
      if (dest) {
        blendNow();
        base = mixed.slice();
        toPal = [dest];
        mixed = [mixed[0]];
        blendAt = Date.now();
        blending = true;
        window.__warpFrom = { pal: base, at: blendAt, dur: BLEND };
        // For a full page load in place of the router (a page it cannot
        // take), so that page can pick up the blend too.
        try { sessionStorage.setItem("warp-from", JSON.stringify({ pal: base, at: blendAt })); } catch (e) {}
        tintOn();
      }
      leaving = false;
      closeGate();
      root.hidden = false;
      root.classList.add("is-quick");
      void root.offsetWidth;
      root.classList.remove("is-done");
      sized = dims().join();
      call("size", dims());
      call("enter", [base, toPal, blendAt]);
      running = true;
      // If the navigation never happens (cancelled, offline), let go.
      setTimeout(function () { leave(id); }, 6000);
    }

    // The arriving page names its own palette; home's is every tab.
    function aim(next) {
      var el = next && next.getElementById("warp");
      var p;
      try { p = JSON.parse((el && el.getAttribute("data-palette")) || "null"); } catch (e) { p = null; }
      if (!p || !p.length) return;
      toPal = p;
      blending = true;
      tintOn();
      call("aim", [p]);
    }

    // Ready: the whole page has loaded, or its scripts have run and a moment
    // has passed, or the time is up. A slow image or a chunk that never comes
    // holds nothing back, and the sound choice comes up in time too.
    var isReady = false;
    function ready() {
      if (isReady) return;
      // A stylesheet that is still coming holds the page's body back: nothing to
      // reveal yet, so the sky stays, up to the time it can take to give up.
      if (!document.querySelector("main") && performance.now() - t0 < 15000) {
        setTimeout(ready, 250);
        return;
      }
      isReady = true;
      document.documentElement.classList.remove("parsing");
      setTimeout(function () {
        if (gating) showGate();
        else leave(0);
      }, Math.max(0, MIN - (performance.now() - t0)));
    }
    if (document.readyState === "complete") ready();
    else {
      window.addEventListener("load", ready, { once: true });
      document.addEventListener("DOMContentLoaded", function () { setTimeout(ready, GRACE); }, { once: true });
    }
    setTimeout(ready, MAX);

    // Phones fire resize as the address bar comes and goes; a canvas resize
    // clears it, so only pass on a real change of size.
    var sized = dims().join();
    window.addEventListener("resize", function () {
      var d = dims();
      if (!running || d.join() === sized) return;
      sized = d.join();
      call("size", d);
    }, { passive: true });

    // Back/forward cache restores the page as it was left, loader and all
    // (after following a link the router hands to the browser, like a PDF).
    window.addEventListener("pageshow", function (e) {
      if (!e.persisted) return;
      trip++;
      away = false;
      leaving = true;
      root.classList.remove("is-quick");
      root.classList.add("is-done");
      root.hidden = true;
      call("stop");
      running = false;
    });

    if (reduce) return;
    // The router moves between pages without a reload. It announces each
    // move before fetching the next page: the warp comes up then, blending
    // toward the next tab. Files (a PDF, an image) go to the browser.
    var FILE = /\.(pdf|png|jpe?g|webp|avif|gif|svg|xml|txt|zip|json|mp4|webm)$/i;
    document.addEventListener("astro:before-preparation", function (e) {
      if (e.defaultPrevented || FILE.test(e.to.pathname)) return;
      enter(e.to);
      var id = trip;
      var load = e.loader;
      e.loader = function () {
        return Promise.resolve(load()).then(function () {
          if (id === trip && e.newDocument && e.newDocument !== document) aim(e.newDocument);
        });
      };
    });
    // The new page is in and its scripts have started: arrive, once the jump
    // has had its moment.
    document.addEventListener("astro:page-load", function () {
      if (!away) return;
      try { sessionStorage.removeItem("warp-from"); } catch (e) {}
      var id = trip;
      setTimeout(function () { leave(id); }, Math.max(0, HOLD - (performance.now() - enteredAt)));
    });
  })();
</script>
