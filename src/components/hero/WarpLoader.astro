---
// Page loader: a jump to light speed. Stars stream out from the center like
// the scroll warp in SpaceField, comets in the tab's colour cut across, and a
// small "loading" sits in the middle. It covers the first paint of every page
// and comes back up when an internal link is clicked, so moving between pages
// reads as one trip.
//
// Arrival: the streaks slow back into points and the loader drops behind the
// page, so the stars you flew through become the sky, while SpaceField coasts
// out of its own warp. The page itself flies in from deep space toward the
// viewer. Plain 2D canvas and inline script, so it runs before the rest of
// the body has parsed. Under reduced motion it is a quick fade.
interface Props {
  // "r,g,b" strings. The first is the tab's colour; home passes every tab.
  palette: string[];
}
const { palette } = Astro.props;
const rgb = palette[0];
const rgb2 = palette[1] ?? palette[0];
---

<div id="warp" class="warp" style={`--warp-rgb:${rgb};--warp-rgb2:${rgb2};`} aria-hidden="true">
  <div class="warp-sky"></div>
  <canvas class="warp-canvas"></canvas>
  <div class="warp-label">
    <span class="warp-text"></span>
    <span class="warp-bar"></span>
  </div>
</div>
<noscript><style>#warp { display: none !important; }</style></noscript>

<style>
  .warp {
    position: fixed;
    inset: 0;
    z-index: 2147483000; /* over the nav, chat and everything else */
    display: grid;
    place-items: center;
  }
  .warp[hidden] { display: none; }
  .warp-sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(34% 30% at 50% 50%, rgba(var(--warp-rgb), 0.14), transparent 72%),
      radial-gradient(70% 60% at 18% 22%, rgba(var(--warp-rgb), 0.12), transparent 70%),
      radial-gradient(60% 55% at 84% 72%, rgba(var(--warp-rgb2), 0.1), transparent 70%),
      #000;
    transition: opacity 1s ease;
  }
  .warp-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* The slowed stars hang on as the sky for a moment before handing over. */
    transition: opacity 1.5s ease 0.45s;
  }

  /* Arrival: behind the page, the backdrop goes and the stars settle out. */
  .warp.is-done { z-index: -1; pointer-events: none; }
  .warp.is-done .warp-sky,
  .warp.is-done .warp-canvas { opacity: 0; }
  .warp.is-done .warp-label { opacity: 0; transform: translateY(-4px); }
  /* Coming back up on a link click: fast, so the next page is not kept waiting. */
  .warp.is-quick .warp-sky,
  .warp.is-quick .warp-canvas,
  .warp.is-quick .warp-label { transition-duration: 0.16s; transition-delay: 0s; }

  .warp-label {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  /* Held back until Inter has loaded, so it never shows in a fallback face. */
  .warp.is-font-wait .warp-label { opacity: 0; }
  /* A soft dark pool so the word stays readable over passing streaks. */
  .warp-label::before {
    content: "";
    position: absolute;
    inset: -34px -70px;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(0, 0, 0, 0.6), transparent);
  }

  /* Set like the site's kicker: Inter 500, the tab's dot. */
  .warp-text {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1;
  }
  .warp-text::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: rgb(var(--warp-rgb));
    box-shadow: 0 0 12px rgba(var(--warp-rgb), 0.7);
    animation: warp-dot 1.25s ease-in-out infinite;
  }
  /* The word lives in CSS so it never ends up in the page's text. */
  .warp-text::after {
    content: "loading";
    color: transparent;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.5) 0%,
      rgba(255, 255, 255, 0.5) 40%,
      #fff 50%,
      rgba(255, 255, 255, 0.5) 60%,
      rgba(255, 255, 255, 0.5) 100%
    );
    background-size: 250% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    animation: warp-shimmer 1.9s linear infinite;
  }
  @keyframes warp-dot {
    0%, 100% { transform: scale(0.8); opacity: 0.6; }
    50% { transform: scale(1.15); opacity: 1; }
  }
  @keyframes warp-shimmer {
    from { background-position: 100% 0; }
    to { background-position: 0% 0; }
  }

  .warp-bar {
    position: relative;
    width: 76px;
    height: 1px;
    overflow: hidden;
    border-radius: 1px;
    background: rgba(255, 255, 255, 0.1);
  }
  .warp-bar::after {
    content: "";
    position: absolute;
    inset: 0;
    width: 42%;
    background: linear-gradient(90deg, transparent, rgba(var(--warp-rgb), 1), transparent);
    animation: warp-scan 1.25s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  @keyframes warp-scan {
    from { transform: translateX(-100%); }
    to { transform: translateX(240%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .warp-canvas { display: none; }
    .warp-text::before, .warp-text::after, .warp-bar::after { animation: none; }
  }
  @media print {
    .warp { display: none; }
  }
</style>

<script is:inline define:vars={{ palette }}>
  (function () {
    var root = document.getElementById("warp");
    if (!root) return;
    var canvas = root.querySelector("canvas");
    var ctx = canvas && canvas.getContext ? canvas.getContext("2d") : null;
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var mobile = window.matchMedia("(max-width: 767px)").matches;

    // Show the word only once Inter is ready (cached after the first page).
    if (document.fonts && document.fonts.load) {
      root.classList.add("is-font-wait");
      var showLabel = function () { root.classList.remove("is-font-wait"); };
      document.fonts.load('500 13px "Inter"').then(showLabel, showLabel);
      setTimeout(showLabel, 700);
    }

    // The first page of a visit gets the full jump; later pages a short one.
    var first = true;
    try {
      first = !sessionStorage.getItem("warp-seen");
      sessionStorage.setItem("warp-seen", "1");
    } catch (e) {}
    var MIN = reduce ? 0 : first ? 1500 : 800;
    var MAX = 3500; // never hold the page longer than this
    var t0 = performance.now();

    var N = mobile ? 260 : 600;
    var W = 0, H = 0, R = 0;
    var stars = [], comets = [];
    // Camera speed in depth units per second. It eases toward the target, so
    // the jump starts at cruise and builds to warp.
    var v = 0.22, vTarget = 0.95;
    var raf = 0, last = 0, nextComet = 0, leaving = false;
    // Bumped on every link click, so timers from an earlier trip are ignored.
    var trip = 0;

    function size() {
      var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      W = window.innerWidth;
      H = window.innerHeight;
      R = Math.max(W, H) * 0.5;
      canvas.width = Math.floor(W * dpr);
      canvas.height = Math.floor(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    function pick() {
      return palette[(Math.random() * palette.length) | 0];
    }
    // A star sits at (x, y) on a plane z deep; the camera flies toward it.
    function star(s, far) {
      s.x = Math.random() * 2 - 1;
      s.y = Math.random() * 2 - 1;
      s.z = far ? 1 : 0.08 + Math.random() * 0.92;
      s.c = Math.random() < 0.35 ? pick() : "236,241,255";
      return s;
    }
    // A comet crosses through a random point in view. `back` is how far
    // behind that point it starts: 1 is off screen, small values put it
    // already in flight so even a short load shows comets passing.
    function comet(back) {
      var a = Math.random() * Math.PI * 2;
      var dx = Math.cos(a), dy = Math.sin(a);
      var reach = Math.sqrt(W * W + H * H) * 0.62;
      var px = W * (0.12 + Math.random() * 0.76);
      var py = H * (0.12 + Math.random() * 0.76);
      comets.push({
        x: px - dx * reach * back,
        y: py - dy * reach * back,
        dx: dx,
        dy: dy,
        sp: (mobile ? 520 : 760) + Math.random() * 760,
        len: (mobile ? 100 : 150) + Math.random() * 220,
        w: 1.1 + Math.random() * 1.3,
        c: pick(),
        d: 0,
        age: 0,
        max: reach * (1 + back) + 400,
      });
    }

    function frame(now) {
      raf = requestAnimationFrame(frame);
      var dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      v += (vTarget - v) * Math.min(1, dt * 2.4);
      var cx = W / 2, cy = H / 2;

      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = "lighter";
      ctx.lineCap = "round";

      // Stars: each draws a streak from where it was a moment ago, so the
      // trails lengthen as the speed builds and shrink to points as it drops.
      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        s.z -= v * dt;
        if (s.z <= 0.03) { star(s, true); continue; }
        var x1 = cx + (s.x / s.z) * R, y1 = cy + (s.y / s.z) * R;
        if (x1 < -60 || x1 > W + 60 || y1 < -60 || y1 > H + 60) { star(s, true); continue; }
        var tz = Math.min(1, s.z + 0.006 + v * 0.075);
        var x0 = cx + (s.x / tz) * R, y0 = cy + (s.y / tz) * R;
        var k = 1 - s.z;
        ctx.strokeStyle = "rgba(" + s.c + "," + Math.min(1, 0.04 + k * k * 1.1).toFixed(3) + ")";
        ctx.lineWidth = 0.5 + k * k * 2.4;
        ctx.beginPath();
        ctx.moveTo(x0, y0);
        ctx.lineTo(x1, y1);
        ctx.stroke();
      }

      // Comets: a soft wide tail, a bright core tail, and a glowing head.
      for (var j = comets.length - 1; j >= 0; j--) {
        var c = comets[j];
        var step = c.sp * dt * (0.7 + v * 0.35);
        c.x += c.dx * step;
        c.y += c.dy * step;
        c.d += step;
        c.age += dt;
        if (c.d > c.max) { comets.splice(j, 1); continue; }
        var tx = c.x - c.dx * c.len, ty = c.y - c.dy * c.len;
        // Fade in, so one born in view does not pop.
        ctx.globalAlpha = Math.min(1, c.age / 0.15);

        var glow = ctx.createLinearGradient(tx, ty, c.x, c.y);
        glow.addColorStop(0, "rgba(" + c.c + ",0)");
        glow.addColorStop(1, "rgba(" + c.c + ",0.16)");
        ctx.strokeStyle = glow;
        ctx.lineWidth = c.w * 7;
        ctx.beginPath();
        ctx.moveTo(tx, ty);
        ctx.lineTo(c.x, c.y);
        ctx.stroke();

        var tail = ctx.createLinearGradient(tx, ty, c.x, c.y);
        tail.addColorStop(0, "rgba(" + c.c + ",0)");
        tail.addColorStop(0.72, "rgba(" + c.c + ",0.5)");
        tail.addColorStop(1, "rgba(255,255,255,0.95)");
        ctx.strokeStyle = tail;
        ctx.lineWidth = c.w;
        ctx.beginPath();
        ctx.moveTo(tx, ty);
        ctx.lineTo(c.x, c.y);
        ctx.stroke();

        var r = 11 * c.w;
        var head = ctx.createRadialGradient(c.x, c.y, 0, c.x, c.y, r);
        head.addColorStop(0, "rgba(255,255,255,0.95)");
        head.addColorStop(0.2, "rgba(" + c.c + ",0.6)");
        head.addColorStop(1, "rgba(" + c.c + ",0)");
        ctx.fillStyle = head;
        ctx.beginPath();
        ctx.arc(c.x, c.y, r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (!leaving && now > nextComet && comets.length < (mobile ? 4 : 7)) {
        comet(1);
        nextComet = now + 160 + Math.random() * 460;
      }
      ctx.globalCompositeOperation = "source-over";
    }

    function start() {
      if (reduce || !ctx) return;
      size();
      if (!stars.length) for (var i = 0; i < N; i++) stars.push(star({}, false));
      for (var k = 0; k < (mobile ? 2 : 3); k++) comet(0.1 + Math.random() * 0.45);
      last = performance.now();
      nextComet = last + 220;
      if (!raf) raf = requestAnimationFrame(frame);
    }

    // The page flies in from deep space in layers. Every visible block
    // (heading, paragraph, button, card, image) starts at its own depth and
    // lands on its own beat: nearest the middle first, the edges a little
    // after, the deepest travelling longest. They all share the middle of
    // the screen as the vanishing point, so it reads as one 3D scene.
    var ARRIVE_EASE = "cubic-bezier(0.16, 1, 0.3, 1)";
    var BLOCK = "h1,h2,h3,h4,h5,h6,p,a,button,img,picture,video,canvas,svg,figure,article,li,blockquote,pre,table,form,input,textarea,select";
    var CLEAR = /^(transparent|rgba\(0, 0, 0, 0\))$/;

    // A block moves as one piece when it is a known block, holds loose text
    // or inline children (those cannot be transformed alone), or paints its
    // own box, like a card, so its frame travels with its contents.
    function isBlock(el, cs, r, vw, vh) {
      if (!el.firstElementChild || el.matches(BLOCK)) return true;
      for (var n = el.firstChild; n; n = n.nextSibling) {
        if (n.nodeType === 3 && n.nodeValue.trim()) return true;
        if (n.nodeType === 1 && getComputedStyle(n).display === "inline") return true;
      }
      var paints =
        cs.backgroundImage !== "none" || !CLEAR.test(cs.backgroundColor) ||
        parseFloat(cs.borderTopWidth) > 0 || cs.boxShadow !== "none";
      // A whole section's backdrop stays put; its contents fly instead.
      return paints && r.width * r.height < vw * vh * 0.5;
    }
    function collect(el, out, vw, vh) {
      if (out.length > 90) return;
      var r = el.getBoundingClientRect();
      if (!r.width && !r.height) {
        // display: contents, like the React islands. Look inside.
        for (var c = el.firstElementChild; c; c = c.nextElementSibling) collect(c, out, vw, vh);
        return;
      }
      if (r.bottom < 0 || r.top > vh || r.right < 0 || r.left > vw) return;
      var cs = getComputedStyle(el);
      if (cs.visibility === "hidden") return;
      if (isBlock(el, cs, r, vw, vh)) { out.push([el, r]); return; }
      for (var k = el.firstElementChild; k; k = k.nextElementSibling) collect(k, out, vw, vh);
    }

    function flyIn() {
      if (reduce || !Element.prototype.animate) return;
      var vw = window.innerWidth, vh = window.innerHeight;
      var blocks = [];
      var main = document.querySelector("main");
      var foot = document.querySelector("footer.site-foot");
      if (main) collect(main, blocks, vw, vh);
      if (foot) collect(foot, blocks, vw, vh);
      [document.querySelector("header.nav"), document.querySelector(".chat-launcher")].forEach(function (el) {
        if (el) blocks.push([el, el.getBoundingClientRect()]);
      });
      // A very busy screen, or a browser without the translate and scale
      // properties, gets the page flying in as one sheet instead.
      if (blocks.length > 90 || !(window.CSS && CSS.supports("scale", "1"))) {
        blocks = main ? [[main, main.getBoundingClientRect()]] : [];
      }
      var cx = vw / 2, cy = vh / 2, far = Math.sqrt(cx * cx + cy * cy);
      blocks.forEach(function (b) {
        var el = b[0], r = b[1];
        var dx = r.left + r.width / 2 - cx, dy = r.top + r.height / 2 - cy;
        var out = Math.min(1, Math.sqrt(dx * dx + dy * dy) / far);
        var s = 0.3 + Math.random() * 0.36; // apparent size at the start: its depth
        var delay = 30 + out * 260 + Math.random() * 130;
        var dur = 1100 + (1 - s) * 650;
        // Seen from deep, a block shrinks toward the vanishing point. The
        // individual translate and scale properties stack on any transform
        // the block already has, and the single offset 0 keyframe ends on
        // the block's own values, so nothing jumps when it lands.
        el.animate(
          [{ offset: 0, translate: (-dx * (1 - s)).toFixed(1) + "px " + (-dy * (1 - s)).toFixed(1) + "px", scale: s.toFixed(3) }],
          { duration: dur, delay: delay, easing: ARRIVE_EASE, fill: "backwards" }
        );
        // Out of the haze faster than it travels, so it reads early.
        el.animate(
          [{ offset: 0, opacity: 0, filter: "blur(" + (3 + (1 - s) * 9).toFixed(1) + "px)" }],
          { duration: dur * 0.5, delay: delay, easing: "cubic-bezier(0.3, 0.7, 0.4, 1)", fill: "backwards" }
        );
      });
    }

    function leave(id) {
      if (leaving || id !== trip) return;
      leaving = true;
      // The jump ends: the streaks shrink back to points and stay as the sky.
      vTarget = 0;
      root.classList.remove("is-quick");
      root.classList.add("is-done");
      // SpaceField reads this and coasts out of its own warp.
      window.__warpArrive = performance.now();
      flyIn();
      setTimeout(function () {
        if (!leaving) return;
        root.hidden = true;
        cancelAnimationFrame(raf);
        raf = 0;
        comets.length = 0;
      }, 2100);
    }

    // Leaving for another page: the warp comes back up and holds until the
    // next page paints its own.
    function enter() {
      var id = ++trip;
      leaving = false;
      v = 0.45;
      vTarget = 1.1;
      root.hidden = false;
      root.classList.add("is-quick");
      void root.offsetWidth;
      root.classList.remove("is-done");
      start();
      // If the navigation never happens (cancelled, offline), let go.
      setTimeout(function () { leave(id); }, 6000);
    }

    start();
    function ready() {
      setTimeout(function () { leave(0); }, Math.max(0, MIN - (performance.now() - t0)));
    }
    if (document.readyState === "complete") ready();
    else window.addEventListener("load", ready, { once: true });
    setTimeout(function () { leave(0); }, MAX);

    window.addEventListener("resize", function () { if (raf) size(); }, { passive: true });

    // Back/forward cache restores the page as it was left, loader and all.
    window.addEventListener("pageshow", function (e) {
      if (!e.persisted) return;
      leaving = true;
      root.classList.remove("is-quick");
      root.classList.add("is-done");
      root.hidden = true;
      cancelAnimationFrame(raf);
      raf = 0;
    });

    if (reduce) return;
    // Bubble phase on document, so React handlers that call preventDefault
    // (tabs, dialogs) have already run and are respected.
    document.addEventListener("click", function (e) {
      if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
      if (!a || (a.target && a.target !== "_self") || a.hasAttribute("download")) return;
      var url;
      try { url = new URL(a.href, location.href); } catch (err) { return; }
      if (url.origin !== location.origin) return;
      if (/\.(pdf|png|jpe?g|webp|avif|gif|svg|xml|txt|zip)$/i.test(url.pathname)) return;
      // Same page (an anchor on this page) just scrolls.
      if (url.pathname === location.pathname && url.search === location.search) return;
      enter();
    });
  })();
</script>
