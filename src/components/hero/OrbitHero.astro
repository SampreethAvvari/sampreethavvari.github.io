---
// The landing page's living element: the portrait at the centre of a small
// orbit system. Three thin rings in perspective, each carrying a comet with a
// short trail. The rings pass behind the portrait and in front of it (two
// canvases share one animation loop), lean toward the cursor, and the comets
// speed up a little while the cursor is over the hero. Colours come from the
// sky's scroll blend (--amb1, --amb2), so the orbit takes each section's
// colour with the rest of the space. One still frame for reduced motion; the
// loop pauses when the hero is off screen or the tab is hidden.
---

<div class="orbit" data-orbit>
  <canvas class="orbit-layer" data-orbit-back aria-hidden="true"></canvas>
  <figure class="orbit-portrait" data-amb>
    <slot />
  </figure>
  <canvas class="orbit-layer orbit-front" data-orbit-front aria-hidden="true"></canvas>
</div>

<style>
  .orbit {
    position: relative;
    width: min(560px, 92vw);
    aspect-ratio: 1 / 1;
  }
  .orbit-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .orbit-front { pointer-events: none; }
  .orbit-portrait {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 48%;
    margin: 0;
    transform: translate(-50%, -50%);
    padding: 8px;
    border-radius: 26px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02));
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      0 40px 80px -40px rgba(0, 0, 0, 1),
      0 0 80px -20px rgba(var(--amb1, 91, 141, 239), 0.35);
  }
  .orbit-portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 520 / 640;
    object-fit: cover;
    border-radius: 19px;
  }
</style>

<script>
  import OrbitWorker from "../../scripts/orbit.worker.ts?worker";
  import { createOrbit, type OrbitInput } from "../../scripts/orbit-draw";

  (function () {
    const root = document.querySelector<HTMLElement>("[data-orbit]");
    const back = root?.querySelector<HTMLCanvasElement>("[data-orbit-back]");
    const front = root?.querySelector<HTMLCanvasElement>("[data-orbit-front]");
    if (!root || !back || !front) return;
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // The sky's blend lands on data-amb elements (initAmbient), as inline
    // custom properties, so the colours are read from there without asking
    // the browser to compute styles.
    const amb = document.querySelector<HTMLElement>("[data-amb]");
    const input: OrbitInput = { targetX: 0, targetY: 0, targetBoost: 0, c1: "91,141,239", c2: "34,211,238" };
    const readColours = () => {
      let a1 = amb?.style.getPropertyValue("--amb1").replace(/\s/g, "") || "";
      let a2 = amb?.style.getPropertyValue("--amb2").replace(/\s/g, "") || "";
      if (!a1 || !a2) {
        const cs = getComputedStyle(amb || document.documentElement);
        a1 = a1 || cs.getPropertyValue("--amb1").replace(/\s/g, "");
        a2 = a2 || cs.getPropertyValue("--amb2").replace(/\s/g, "");
      }
      return { c1: a1 || input.c1, c2: a2 || input.c2 };
    };
    Object.assign(input, readColours());

    // Phones draw at 1.5x: sharp enough for thin rings, half the pixels.
    const dims = () => ({
      size: root.clientWidth,
      dpr: Math.min(window.matchMedia("(max-width: 767px)").matches ? 1.5 : 2, window.devicePixelRatio || 1),
    });

    // The rings draw in a worker when the browser can hand canvases to one,
    // so they keep turning while the page loads and scrolls. Elsewhere they
    // draw here, the same way.
    let send: (m: Record<string, unknown>) => void = () => {};
    let inWorker = false;
    if (!still && "transferControlToOffscreen" in back && typeof Worker !== "undefined") {
      let worker: Worker | null = null;
      try {
        worker = new OrbitWorker();
      } catch {
        worker = null;
      }
      if (worker) {
        const w = worker;
        const offBack = back.transferControlToOffscreen();
        const offFront = front.transferControlToOffscreen();
        w.postMessage({ type: "init", back: offBack, front: offFront, ...dims(), input }, [offBack, offFront]);
        send = (m) => w.postMessage(m);
        inWorker = true;
      }
    }
    if (!inWorker) {
      const orbit = createOrbit(back, front);
      if (!orbit) return;
      let raf = 0;
      let last = 0;
      let run = !still;
      const loop = (now: number) => {
        raf = 0;
        orbit.frame(last ? now - last : 0, input);
        last = now;
        if (run) raf = requestAnimationFrame(loop);
      };
      const d = dims();
      orbit.resize(d.size, d.dpr);
      orbit.draw(input);
      send = (m) => {
        if (m.type === "resize") {
          orbit.resize(m.size as number, m.dpr as number);
          orbit.draw(input);
        } else if (m.type === "run") {
          run = !!m.run && !still;
          if (run && !raf) {
            last = 0;
            raf = requestAnimationFrame(loop);
          }
        }
      };
      if (!still) raf = requestAnimationFrame(loop);
    }
    const update = (part: Partial<OrbitInput>) => {
      Object.assign(input, part);
      send({ type: "input", input: part });
    };

    // The rings lean toward the pointer. The frame's place on the page is
    // kept from the last layout, so a pointer move never forces a new one.
    let box = { left: 0, top: 0, width: 0, height: 0 };
    const measure = () => {
      const r = root.getBoundingClientRect();
      box = { left: r.left + window.scrollX, top: r.top + window.scrollY, width: r.width, height: r.height };
    };
    const hero = root.closest("section") || root;
    window.addEventListener(
      "pointermove",
      (e) => {
        if (!box.width) return;
        const cx = box.left - window.scrollX + box.width / 2;
        const cy = box.top - window.scrollY + box.height / 2;
        update({
          targetX: Math.max(-1, Math.min(1, (e.clientX - cx) / (window.innerWidth / 2))),
          targetY: Math.max(-1, Math.min(1, (e.clientY - cy) / (window.innerHeight / 2))),
        });
      },
      { passive: true },
    );
    hero.addEventListener("pointerenter", () => {
      measure();
      update({ targetBoost: 1 });
    });
    hero.addEventListener("pointerleave", () => update({ targetBoost: 0 }));
    window.addEventListener("load", measure, { once: true });

    if (amb) {
      new MutationObserver(() => {
        const c = readColours();
        if (c.c1 !== input.c1 || c.c2 !== input.c2) update(c);
      }).observe(amb, { attributes: true, attributeFilter: ["style"] });
    }
    if (still) return;

    // Pause while the hero is off screen or the tab is hidden.
    let visible = true;
    const run = () => send({ type: "run", run: visible && !document.hidden });
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((entries) => {
        visible = entries[0]?.isIntersecting ?? true;
        run();
      }).observe(root);
    }
    document.addEventListener("visibilitychange", run);
    // The frame can be zero wide when this first runs (in a production build
    // the portrait may not have laid out yet), so size the canvases whenever
    // the frame itself changes size, not only when the window does.
    let fitted = dims().size;
    const refit = () => {
      measure();
      const d = dims();
      if (d.size === fitted) return;
      fitted = d.size;
      send({ type: "resize", ...d });
    };
    if ("ResizeObserver" in window) new ResizeObserver(refit).observe(root);
    else window.addEventListener("resize", refit);
  })();
</script>
